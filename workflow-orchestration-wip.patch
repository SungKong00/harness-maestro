+    new_attempt = require_identity(new_attempt_id, field="attempt_id")
+    if (
+        resumed_receipt_digest == request["target_context_receipt_digest"]
+        or participant_receipt.get("receipt_id")
+        == request["target_context_receipt_id"]
+        or participant_receipt.get("attempt_id") != new_attempt
+        or attempt_receipt.get("attempt_id") != new_attempt
+        or new_attempt == request["target_attempt_id"]
