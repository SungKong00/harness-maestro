+def _validate_preselection_chain(
+    packet: dict[str, Any],
+    *,
+    plan: dict[str, Any],
+    repo: Path,
+    research_bundle: dict[str, Any] | None,
+    issues: list[dict[str, str]],
+) -> set[str]:
+    direction = packet.get("direction_context")
+    uncertainty = (
+        direction.get("uncertainty")
+        if isinstance(direction, dict)
+        else None
+    )
+    comparison = packet.get("comparison")
+    falsification = packet.get("falsification")
+    selection = packet.get("selection")
+    if uncertainty == "settled":
+        if any(
+            item is not None
+            for item in (comparison, falsification, selection)
+        ):
+            issues.append(
+                _issue(
+                    "DESIGN_SETTLED_PRESELECTION_UNEXPECTED",
+                    "comparison",
+                    "Settled reuse must not carry a new comparison, falsification, or selection chain.",
+                )
+            )
+        return set()
+    if uncertainty != "material":
+        return set()
+    if not all(
+        isinstance(item, dict)
+        for item in (comparison, falsification, selection)
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_PRESELECTION_CHAIN_REQUIRED",
+                "comparison",
+                "Material direction requires a complete comparison, independent falsification, and selection chain before mutation.",
+            )
+        )
+        return set()
+    assert isinstance(comparison, dict)
+    assert isinstance(falsification, dict)
+    assert isinstance(selection, dict)
+    comparison_result = validate_design_comparison(
+        comparison,
+        plan,
+        repo_path=repo,
+        research_bundle=research_bundle,
+    )
+    falsification_result = validate_design_falsification(
+        falsification,
+        comparison,
+        plan,
+        repo_path=repo,
+        research_bundle=research_bundle,
+    )
+    selection_result = validate_design_selection(
+        selection,
+        comparison,
+        falsification,
+        plan,
+        repo_path=repo,
+        research_bundle=research_bundle,
+    )
+    issues.extend(comparison_result["issues"])
+    issues.extend(falsification_result["issues"])
+    issues.extend(selection_result["issues"])
+    direction_alternatives = {
+        item.get("alternative_id"): item
+        for item in direction.get("alternatives", [])
+        if isinstance(item, dict)
+        and isinstance(item.get("alternative_id"), str)
+    }
+    compared_alternatives = {
+        item.get("alternative_id"): item
+        for item in comparison.get("alternatives", [])
+        if isinstance(item, dict)
+        and isinstance(item.get("alternative_id"), str)
+    }
+    if set(direction_alternatives) != set(compared_alternatives):
+        issues.append(
+            _issue(
+                "DESIGN_DIRECTION_COMPARISON_MISMATCH",
+                "comparison.alternatives",
+                "The direction alternatives must be the exact rendered comparison set.",
+            )
+        )
+    else:
+        for alternative_id in sorted(direction_alternatives):
+            direction_alternative = direction_alternatives[alternative_id]
+            compared_alternative = compared_alternatives[alternative_id]
+            if any(
+                direction_alternative.get(field)
+                != compared_alternative.get(field)
+                for field in (
+                    "summary",
+                    "material_differences",
+                    "tradeoffs",
+                    "basis_refs",
+                )
+            ):
+                issues.append(
+                    _issue(
+                        "DESIGN_DIRECTION_COMPARISON_MISMATCH",
+                        f"comparison.alternatives.{alternative_id}",
+                        "Rendered comparison descriptions and evidence must exactly match the selected direction context.",
+                    )
+                )
+    if (
+        comparison.get("direction_frame", {}).get("problem")
+        != direction.get("problem")
+        or comparison.get("direction_frame", {}).get("user_tasks")
+        != direction.get("user_tasks")
+        or comparison.get("direction_frame", {}).get(
+            "decision_criteria"
+        )
+        != direction.get("decision_criteria")
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_DIRECTION_FRAME_MISMATCH",
+                "comparison.direction_frame",
+                "The comparison must use the exact direction problem, tasks, and decision criteria.",
+            )
+        )
+    if (
+        selection.get("selected_alternative_id")
+        != direction.get("selected_alternative_id")
+        or selection.get("authority")
+        != direction.get("selection_authority")
+        or selection.get("selection_refs")
+        != direction.get("selection_refs")
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_DIRECTION_SELECTION_MISMATCH",
+                "selection",
+                "The final direction must exactly match the validated pre-selection artifact.",
+            )
+        )
