+def build_conflict_record(
+    *,
+    state: Mapping[str, Any],
+    conflict_id: str,
+    claim_id: str,
+    packet_digests: Sequence[str],
+    positions: Sequence[Mapping[str, Any]],
+    evidence_refs: Sequence[str],
+    limitations: Sequence[str],
+    supported_minority_risks: Sequence[str],
+    material: bool,
+) -> dict[str, Any]:
+    require_identity(conflict_id, field="conflict_id")
+    require_identity(claim_id, field="claim_id")
+    require_refs(list(packet_digests), field="packet_digests", allow_empty=False)
+    for digest in packet_digests:
+        require_digest(digest, field="packet_digest")
+    if len(packet_digests) < 2 or not isinstance(material, bool):
+        raise MaestroError(
+            "ORCH_CONFLICT_INVALID",
+            "A material ConflictRecord requires at least two immutable Packets.",
+        )
+    if (
+        not isinstance(positions, Sequence)
+        or len(positions) != len(packet_digests)
+        or not all(isinstance(item, Mapping) for item in positions)
+    ):
+        raise MaestroError(
+            "ORCH_CONFLICT_INVALID",
+            "Conflict positions must remain attributed one per Packet.",
+        )
+    record = {
+        "schema_version": CONFLICT_VERSION,
+        "conflict_id": conflict_id,
+        "conflict_digest": "",
+        "root_request_id": state["root_request_id"],
+        "root_execution_id": state["root_execution_id"],
+        "workflow_instance_id": state["workflow_instance_id"],
+        "definition_id": state["definition_id"],
+        "definition_revision": state["definition_revision"],
+        "definition_digest": state["definition_digest"],
+        "plan_revision": state["plan_revision"],
+        "claim_id": claim_id,
+        "packet_digests": list(packet_digests),
+        "positions": [copy.deepcopy(dict(item)) for item in positions],
+        "evidence_refs": list(evidence_refs),
+        "limitations": list(limitations),
+        "supported_minority_risks": list(supported_minority_risks),
+        "material": material,
+        "status": "open",
+        "resolution": None,
+        "rebuttal_round": 0,
+        "resolution_method": "evidence-and-authority",
+    }
+    if any(
+        key in record or any(key in position for position in positions)
+        for key in ("votes", "majority", "ballot", "consensus_score")
+    ):
+        raise MaestroError(
+            "ORCH_VOTE_AS_PROOF_FORBIDDEN",
+            "Conflict evidence cannot use a ballot or majority as proof.",
+        )
+    record["conflict_digest"] = _address(
+        record,
+        digest_field="conflict_digest",
+    )
+    return record
+
