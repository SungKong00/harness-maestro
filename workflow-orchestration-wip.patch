+            "optional-one",
+            "many"
+          ]
+        },
+        "packet_ids": {
+          "$ref": "#/$defs/stringList"
+        },
+        "packet_digests": {
+          "type": "array",
+          "items": {
+            "$ref": "#/$defs/digest"
+          }
+        },
+        "semantic_generations": {
+          "type": "array",
+          "items": {
+            "type": "integer",
+            "minimum": 0
+          }
+        }
+      }
+    },
+    "freshness": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "produced_at",
+        "expires_at",
+        "freshness_seconds"
+      ],
+      "properties": {
+        "produced_at": {
+          "type": "string",
+          "format": "date-time"
+        },
+        "expires_at": {
+          "type": "string",
+          "format": "date-time"
+        },
+        "freshness_seconds": {
+          "type": "integer",
+          "minimum": 1,
+          "maximum": 86400
+        }
+      }
+    },
+    "completeness": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "status",
+        "required_claim_ids",
+        "present_claim_ids",
+        "missing_claim_ids"
+      ],
+      "properties": {
+        "status": {
+          "const": "complete"
+        },
+        "required_claim_ids": {
+          "$ref": "#/$defs/stringList"
+        },
+        "present_claim_ids": {
+          "$ref": "#/$defs/stringList"
+        },
+        "missing_claim_ids": {
+          "type": "array",
+          "maxItems": 0
+        }
+      }
+    },
+    "claim": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "claim_id",
+        "statement",
+        "evidence_refs"
+      ],
+      "properties": {
+        "claim_id": {
+          "$ref": "#/$defs/identity"
+        },
+        "statement": {
+          "type": "string"
+        },
+        "evidence_refs": {
+          "$ref": "#/$defs/stringList"
+        }
+      }
+    }
+  }
+}
