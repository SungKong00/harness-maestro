+        context_receipt=participant_receipt,
+        attempt_receipt=attempt_receipt,
+    )
+    if (
+        resumption.get("context_instance_id")
+        != request["target_context_instance_id"]
+        or resumption.get("checkpoint_digest")
+        != request["controller_checkpoint_digest"]
+        or host_context.get("method") != "thread/resume"
+        or host_context.get("thread_id")
+        != request["target_host_thread_id"]
