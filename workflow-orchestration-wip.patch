+def _orchestration_flags(values: Sequence[str]) -> dict[str, bool]:
+    result: dict[str, bool] = {}
+    for raw in values:
+        if "=" not in raw:
+            raise MaestroError(
+                "ORCH_FLAG_INVALID",
+                "Each --flag must use NAME=true or NAME=false.",
+            )
+        name, raw_value = raw.split("=", 1)
+        if (
+            not name
+            or name in result
+            or raw_value.casefold() not in {"true", "false"}
+        ):
+            raise MaestroError(
+                "ORCH_FLAG_INVALID",
+                "Orchestration flags must be unique NAME=true or NAME=false values.",
+            )
+        result[name] = raw_value.casefold() == "true"
+    return result
+
+
+def _owner_workflow_binding_from_source(
+    *,
+    repo_path: str,
+    definition: dict[str, Any],
+    source_path: str,
+) -> tuple[str, str, dict[str, Any]]:
+    """Validate an exact Route v2 source before Controller admission."""
+
+    source = read_json(Path(source_path).expanduser().resolve())
+    validation = validate_route_v2(source, repo_path=repo_path)
+    if validation["status"] != "PASS":
+        issue = validation["issues"][0]
+        raise MaestroError(
+            "ORCH_WORKFLOW_SOURCE_INVALID",
+            f"{issue['code']}: {issue['message']}",
+        )
+    source_policy = source.get("task_contract", {}).get(
+        "workflow_policy"
+    )
+    definition_policy = definition.get("responsibility_plan", {}).get(
+        "workflow_policy"
+    )
+    if source_policy != definition_policy:
+        raise MaestroError(
+            "ORCH_WORKFLOW_SOURCE_MISMATCH",
+            "Workflow Definition policy differs from the validated Route v2 source.",
+        )
+    expected_source_binding = build_workflow_source_binding(
+        source_policy,
+        route_plan_id=source["plan_id"],
+        source_route_digest=source["source_route_digest"],
+        goal_digest=sha256_text(source["goal"]),
+        route_risk=source["risk"],
+        route_intent=source["intent"],
+        task_contract=source["task_contract"],
+    )
+    if definition.get("responsibility_plan", {}).get(
+        "workflow_source_binding"
+    ) != expected_source_binding:
+        raise MaestroError(
+            "ORCH_WORKFLOW_SOURCE_MISMATCH",
+            "Workflow Definition is not bound to this exact Route v2 plan and task contract.",
+        )
+    return (
+        workflow_policy_digest(source_policy),
+        owner_workflow_digest(source_policy),
+        expected_source_binding,
+    )
+
