+                expertise=plan.get("expertise", {}),
+                repo_path=repo,
+            )
+        except (MaestroError, OSError, TypeError, ValueError) as exc:
+            issues.append(
+                _issue(
+                    "DESIGN_COMPARISON_RESEARCH_INVALID",
