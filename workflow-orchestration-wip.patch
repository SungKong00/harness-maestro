+        **extra: object,
+    ) -> dict[str, object]:
+        return {
+            "session_id": "session-1",
+            "turn_id": turn_id,
+            "cwd": str(repo),
+            "hook_event_name": event,
+            "model": "gpt-5.6-sol",
