@@ -0,0 +1,213 @@
+from __future__ import annotations
+
+import copy
+import hashlib
+import hmac
+import os
+import secrets
+import stat
+from pathlib import Path
+from typing import Any
+
+from .errors import MaestroError
+from .project import checkout_id
+from .util import canonical_json, ensure_repo, read_json, safe_target, sha256_text
+
+
+HOST_RECEIPT_KEY_ENV = "MAESTRO_HOST_RECEIPT_KEY_FILE"
+OWNER_SELECTION_KEY_PURPOSE = b"harness-maestro-owner-selection-v2"
+
+
+def _host_key_path() -> Path:
+    configured = os.environ.get(HOST_RECEIPT_KEY_ENV)
+    if configured:
+        target = Path(configured).expanduser()
+        if not target.is_absolute():
+            raise MaestroError(
+                "HOST_RECEIPT_KEY_INVALID",
+                f"{HOST_RECEIPT_KEY_ENV} must be an absolute path.",
+            )
+        return target
+    state_home = os.environ.get("XDG_STATE_HOME")
+    root = (
+        Path(state_home).expanduser()
+        if state_home
+        else Path.home() / ".local" / "state"
+    )
+    if not root.is_absolute():
+        raise MaestroError(
+            "HOST_RECEIPT_KEY_INVALID",
+            "The Host state directory must be absolute.",
+        )
+    return root / "harness-maestro" / "codex-owner-selection.key"
+
+
+def _read_master_key(*, create: bool) -> bytes:
+    target = _host_key_path()
+    if create and not target.exists():
+        target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
+        if hasattr(os, "O_NOFOLLOW"):
+            flags |= os.O_NOFOLLOW
+        try:
+            descriptor = os.open(target, flags, 0o600)
+        except FileExistsError:
+            descriptor = None
+        except OSError as exc:
+            raise MaestroError(
+                "HOST_RECEIPT_KEY_INVALID",
+                "The Host receipt key could not be created safely.",
+            ) from exc
+        if descriptor is not None:
+            try:
+                key = secrets.token_bytes(32)
+                if os.write(descriptor, key) != len(key):
+                    raise OSError("short key write")
+                os.fsync(descriptor)
+            except OSError as exc:
+                raise MaestroError(
+                    "HOST_RECEIPT_KEY_INVALID",
+                    "The Host receipt key could not be written safely.",
+                ) from exc
+            finally:
+                os.close(descriptor)
+    try:
+        expected = target.lstat()
+    except FileNotFoundError as exc:
+        raise MaestroError(
+            "HOST_RECEIPT_KEY_MISSING",
+            "The Host receipt verification key is missing.",
+        ) from exc
+    if (
+        stat.S_ISLNK(expected.st_mode)
+        or not stat.S_ISREG(expected.st_mode)
+        or stat.S_IMODE(expected.st_mode) != 0o600
+    ):
+        raise MaestroError(
+            "HOST_RECEIPT_KEY_INVALID",
+            "The Host receipt key must be a regular non-symlink file with mode 0600.",
+        )
+    flags = os.O_RDONLY
+    if hasattr(os, "O_NOFOLLOW"):
+        flags |= os.O_NOFOLLOW
+    try:
+        descriptor = os.open(target, flags)
+    except OSError as exc:
+        raise MaestroError(
+            "HOST_RECEIPT_KEY_INVALID",
+            "The Host receipt key could not be opened safely.",
+        ) from exc
+    try:
+        current = os.fstat(descriptor)
+        if (
+            not stat.S_ISREG(current.st_mode)
+            or stat.S_IMODE(current.st_mode) != 0o600
+            or current.st_dev != expected.st_dev
+            or current.st_ino != expected.st_ino
+        ):
+            raise MaestroError(
+                "HOST_RECEIPT_KEY_INVALID",
+                "The Host receipt key changed during validation.",
+            )
+        chunks: list[bytes] = []
+        remaining = 33
+        while remaining:
+            chunk = os.read(descriptor, remaining)
+            if not chunk:
+                break
+            chunks.append(chunk)
+            remaining -= len(chunk)
+        key = b"".join(chunks)
+    except OSError as exc:
+        raise MaestroError(
+            "HOST_RECEIPT_KEY_INVALID",
+            "The Host receipt key could not be read safely.",
+        ) from exc
+    finally:
+        os.close(descriptor)
+    if len(key) != 32:
+        raise MaestroError(
+            "HOST_RECEIPT_KEY_INVALID",
+            "The Host receipt key must contain exactly 32 random bytes.",
+        )
+    return key
+
+
+def _project_identity(repo: Path) -> tuple[str, str]:
+    project_path = safe_target(repo, ".maestro/project.json")
+    if project_path.is_symlink() or not project_path.is_file():
+        raise MaestroError(
+            "HOST_RECEIPT_PROJECT_INVALID",
+            "Host receipts require an initialized project.",
+        )
+    project = read_json(project_path)
+    project_id = project.get("project_id") if isinstance(project, dict) else None
+    if not isinstance(project_id, str) or not project_id:
+        raise MaestroError(
+            "HOST_RECEIPT_PROJECT_INVALID",
+            "The project receipt identity is invalid.",
+        )
+    return project_id, checkout_id(repo)
+
+
+def signing_key(
+    repo_path: str | Path,
+    *,
+    purpose: bytes,
+    create: bool,
+) -> tuple[bytes, str]:
+    repo = ensure_repo(repo_path)
+    master = _read_master_key(create=create)
+    project_id, checkout = _project_identity(repo)
+    context = canonical_json(
+        {
+            "purpose": purpose.decode("ascii"),
+            "project_id": project_id,
+            "checkout_id": checkout,
+        }
+    ).encode("utf-8")
+    key = hmac.new(master, context, hashlib.sha256).digest()
+    return key, hashlib.sha256(key).hexdigest()
+
+
+def receipt_identity(value: dict[str, Any]) -> str:
+    payload = copy.deepcopy(value)
+    payload["receipt_id"] = ""
+    payload["auth_tag"] = ""
+    return sha256_text(canonical_json(payload))
+
+
+def auth_tag(value: dict[str, Any], *, key: bytes) -> str:
+    payload = copy.deepcopy(value)
+    payload["auth_tag"] = ""
+    return hmac.new(
+        key,
+        canonical_json(payload).encode("utf-8"),
+        hashlib.sha256,
+    ).hexdigest()
+
+
+def authenticated(
+    value: dict[str, Any],
+    *,
+    key: bytes,
+    expected_key_id: str,
+) -> bool:
+    actual_key_id = value.get("key_id")
+    actual_tag = value.get("auth_tag")
+    return (
+        isinstance(actual_key_id, str)
+        and isinstance(actual_tag, str)
+        and hmac.compare_digest(actual_key_id, expected_key_id)
+        and hmac.compare_digest(actual_tag, auth_tag(value, key=key))
+    )
+
+
+__all__ = [
+    "HOST_RECEIPT_KEY_ENV",
+    "OWNER_SELECTION_KEY_PURPOSE",
+    "auth_tag",
+    "authenticated",
+    "receipt_identity",
+    "signing_key",
+]
