+@dataclass
+class HostDispatchOutcome:
+    result: dict[str, Any]
+    semantic_validation_receipt: dict[str, Any]
+    completion_receipt: dict[str, Any]
+    effect_state: str
+    changed_paths: list[str]
+
+
+class HostSession(ABC):
+    participant_receipt: dict[str, Any]
+
+    @abstractmethod
+    def dispatch(
+        self,
+        *,
+        projection: Mapping[str, Any],
+        input_projection_sha256: str,
+    ) -> HostDispatchOutcome:
+        raise NotImplementedError
+
+    @abstractmethod
+    def cancel(self, *, reason: str) -> dict[str, Any]:
+        raise NotImplementedError
+
+    @abstractmethod
+    def close(self) -> None:
+        raise NotImplementedError
+
+
+class HostBoundary(ABC):
+    @abstractmethod
+    def acquire(
+        self,
+        *,
+        definition: Mapping[str, Any],
+        state: Mapping[str, Any],
+        stage_spec_id: str,
+        attempt_id: str,
+    ) -> HostSession:
+        raise NotImplementedError
+
+    @abstractmethod
+    def resume(
+        self,
+        *,
+        definition: Mapping[str, Any],
+        state: Mapping[str, Any],
+        stage_spec_id: str,
+        attempt_id: str,
+        correction_request: Mapping[str, Any],
+    ) -> HostSession:
+        raise NotImplementedError
+
+
+class CallbackHostSession(HostSession):
+    def __init__(
+        self,
+        *,
+        participant_receipt: dict[str, Any],
+        stage: Mapping[str, Any],
+        callback: Callable[[Mapping[str, Any]], Mapping[str, Any]],
+        repo: Path,
+        completed_at: str,
+    ) -> None:
+        self.participant_receipt = participant_receipt
+        self._stage = stage
+        self._callback = callback
+        self._repo = repo
+        self._completed_at = completed_at
+        self._before_snapshot = _repository_effect_snapshot(repo)
+
+    def dispatch(
+        self,
+        *,
+        projection: Mapping[str, Any],
+        input_projection_sha256: str,
+    ) -> HostDispatchOutcome:
+        raw = self._callback(projection)
+        result, semantic_receipt = validate_semantic_result(
+            self._stage,
+            raw,
+            participant_receipt=self.participant_receipt,
+            completed_at=self._completed_at,
+        )
+        after = _repository_effect_snapshot(self._repo)
+        changed_paths = _repository_snapshot_changed_paths(
+            self._repo,
+            self._before_snapshot,
+            after,
+        )
+        changed = _repository_snapshot_changed(
+            self._before_snapshot,
+            after,
+        )
+        if self.participant_receipt["read_only"] and changed:
+            raise MaestroError(
+                "ORCH_READ_ONLY_EFFECT_DETECTED",
+                "A scripted read-only stage changed repository-visible state.",
+            )
+        effect_state = "verified-writes" if changed else "no-writes"
+        thread_id = self.participant_receipt["host_context"]["thread_id"]
+        turn_id = (
+            "scripted-turn-"
+            + self.participant_receipt["attempt_id"]
+        )
+        events = [
+            _lifecycle_event(
+                sequence=1,
+                method="turn/started",
+                thread_id=thread_id,
+                turn_id=turn_id,
+                status="started",
+            ),
+            _lifecycle_event(
+                sequence=2,
+                method="turn/completed",
+                thread_id=thread_id,
+                turn_id=turn_id,
+                status="completed",
+            ),
+        ]
+        before_sha256 = sha256_text(canonical_json(self._before_snapshot))
+        after_sha256 = sha256_text(canonical_json(after))
+        read_only_zero_effect = (
+            self.participant_receipt["read_only"] and not changed
+        )
+        audit = {
+            "before_sha256": before_sha256,
+            "after_sha256": after_sha256,
+            "effect_state": effect_state,
+            "changed_paths": sorted(changed_paths),
+            "read_only_zero_effect": read_only_zero_effect,
+        }
+        completion = issue_attempt_evidence(
+            self._repo,
+            evidence_profile=self.participant_receipt[
+                "evidence_profile"
+            ],
+            evidence_kind="post-turn-attempt",
+            collector_integrity=_collector_integrity(),
+            root_request_id=self.participant_receipt["root_request_id"],
+            root_execution_id=self.participant_receipt[
+                "root_execution_id"
+            ],
+            workflow_instance_id=self.participant_receipt[
+                "workflow_instance_id"
+            ],
+            stage_spec_id=self._stage["stage_spec_id"],
+            role_spec_id=self.participant_receipt["role_spec_id"],
+            attempt_id=self.participant_receipt["attempt_id"],
+            context_receipt_id=self.participant_receipt["receipt_id"],
+            context_receipt_digest=host_receipt_digest(
+                self.participant_receipt
+            ),
+            thread_id=thread_id,
+            session_id=self.participant_receipt["host_context"][
+                "session_id"
+            ],
+            turn_id=turn_id,
+            turn_start_request_sha256=sha256_text(
+                canonical_json(
+                    {
+                        "projection_sha256": input_projection_sha256,
+                        "scripted": True,
+                    }
+                )
+            ),
+            turn_start_response_sha256=sha256_text(
+                canonical_json({"turn": {"id": turn_id}})
+            ),
+            lifecycle={
+                "events": events,
+                "event_count": len(events),
+                "event_chain_sha256": sha256_text(
+                    canonical_json(
+                        [event["event_sha256"] for event in events]
+                    )
+                ),
+                "turn_started": True,
+                "turn_completed": True,
+            },
+            telemetry={
+                "reroutes": [],
+                "tokens": "not_observed",
+                "applied_model": "not_observed",
+                "model_coverage": "scripted_test",
+            },
+            repository_effect={
+                "before_sha256": before_sha256,
+                "after_sha256": after_sha256,
+                "audit_sha256": sha256_text(canonical_json(audit)),
+                "read_only_zero_effect": read_only_zero_effect,
+            },
+            input_projection_sha256=input_projection_sha256,
+            semantic_validation_receipt_id=semantic_receipt["receipt_id"],
+            status="completed",
+            effect_state=effect_state,
+            changed_paths=sorted(changed_paths),
+            completed_at=self._completed_at,
+        )
+        validate_attempt_evidence(
+            self._repo,
+            completion,
+            context_receipt=self.participant_receipt,
+            expected_attempt_id=self.participant_receipt["attempt_id"],
+            expected_input_projection_sha256=input_projection_sha256,
+        )
+        return HostDispatchOutcome(
+            result=result,
+            semantic_validation_receipt=semantic_receipt,
+            completion_receipt=completion,
+            effect_state=effect_state,
+            changed_paths=sorted(changed_paths),
+        )
+
+    def cancel(self, *, reason: str) -> dict[str, Any]:
+        return {
+            "status": "cancelled",
+            "reason": require_line(reason, field="reason"),
+            "effect_state": "not_started",
+        }
+
+    def close(self) -> None:
+        return None
+
