+    )
+    if (
+        not isinstance(completeness, dict)
+        or set(completeness) != COMPLETENESS_FIELDS
+        or completeness["status"] != "complete"
+        or completeness["required_claim_ids"] != required_claims
+        or completeness["present_claim_ids"] != present_claims
+        or completeness["missing_claim_ids"]
+        or not set(required_claims).issubset(present_claims)
+        or semantic["present_claim_ids"] != present_claims
+    ):
+        _fail("Packet completeness is invalid.")
+    require_refs(packet["evidence_refs"], field="evidence_refs")
+    require_refs(packet["authority_refs"], field="authority_refs")
+    if not isinstance(packet["limitations"], list):
+        _fail("Packet limitations must be a bounded list.")
+    require_line(packet["return_intent"], field="return_intent", maximum=100)
+    return copy.deepcopy(packet)
