+def build_comparison_manifest(
+    comparison: dict[str, Any],
+    falsification: dict[str, Any],
+    plan: dict[str, Any],
+    *,
+    repo_path: str | Path,
+    research_bundle: dict[str, Any],
+    write: bool = True,
+) -> dict[str, Any]:
+    repo = ensure_repo(repo_path)
+    comparison_result = validate_design_comparison(
+        comparison,
+        plan,
+        repo_path=repo,
+        research_bundle=research_bundle,
+    )
+    falsification_result = validate_design_falsification(
+        falsification,
+        comparison,
+        plan,
+        repo_path=repo,
+        research_bundle=research_bundle,
+    )
+    combined_issues = [
+        *comparison_result["issues"],
+        *falsification_result["issues"],
+    ]
+    if combined_issues:
+        first = sorted(
+            combined_issues,
+            key=lambda item: (
+                item["code"],
+                item["path"],
+                item["message"],
+            ),
+        )[0]
+        raise MaestroError(first["code"], first["message"])
+    if falsification.get("verdict") != "pass":
+        raise MaestroError(
+            "DESIGN_COMPARISON_NOT_READY",
+            "Only alternatives that survived independent falsification may be presented for owner selection.",
+        )
+    review_by_alternative = {
+        item["alternative_id"]: item
+        for item in falsification["alternative_reviews"]
+    }
+    transfer_by_id = {
+        item["transfer_id"]: item
+        for item in comparison["transfers"]
+    }
+    alternatives = []
+    for index, alternative in enumerate(comparison["alternatives"]):
+        review = review_by_alternative[alternative["alternative_id"]]
+        alternatives.append(
+            {
+                "choice_key": chr(ord("A") + index),
+                "alternative_id": alternative["alternative_id"],
+                "summary": alternative["summary"],
+                "material_differences": copy.deepcopy(
+                    alternative["material_differences"]
+                ),
+                "tradeoffs": copy.deepcopy(alternative["tradeoffs"]),
+                "task_flow": copy.deepcopy(alternative["task_flow"]),
+                "region_hierarchy": copy.deepcopy(
+                    alternative["region_hierarchy"]
+                ),
+                "interaction_model": copy.deepcopy(
+                    alternative["interaction_model"]
+                ),
+                "basis_refs": copy.deepcopy(alternative["basis_refs"]),
+                "transfer_records": [
+                    {
+                        "transfer_id": transfer["transfer_id"],
+                        "reference_ids": copy.deepcopy(
+                            transfer["reference_ids"]
+                        ),
+                        "disposition": transfer["disposition"],
+                        "local_decision": transfer["local_decision"],
+                        "enabling_context": copy.deepcopy(
+                            transfer["enabling_context"]
+                        ),
+                        "rejected_surface_traits": copy.deepcopy(
+                            transfer["rejected_surface_traits"]
+                        ),
+                        "local_fit_observations": copy.deepcopy(
+                            transfer["local_fit_observations"]
+                        ),
+                    }
+                    for transfer_id in alternative["transfer_ids"]
+                    for transfer in [transfer_by_id[transfer_id]]
+                ],
+                "falsification_review": {
+                    "strongest_countercase": review[
+                        "strongest_countercase"
+                    ],
+                    "failure_conditions": copy.deepcopy(
+                        review["failure_conditions"]
+                    ),
+                    "counterevidence_refs": copy.deepcopy(
+                        review["counterevidence_refs"]
+                    ),
+                    "outcome": review["outcome"],
+                },
+                "render_artifacts": [
+                    {
+                        "render_id": render["render_id"],
+                        "artifact_path": render["artifact_path"],
+                        "artifact_sha256": render["artifact_sha256"],
+                    }
+                    for render in alternative["renders"]
+                ],
+            }
+        )
+    manifest = {
+        "schema_version": DESIGN_COMPARISON_MANIFEST_VERSION,
+        "manifest_id": "",
+        "project_id": _project_id(repo),
+        "checkout_id": checkout_id(repo),
+        "plan_id": plan["plan_id"],
+        "goal_digest": sha256_text(plan["goal"]),
+        "display_language": expected_display_language(plan["goal"]),
+        "comparison_id": comparison["comparison_id"],
+        "falsification_id": falsification["falsification_id"],
+        "problem": comparison["direction_frame"]["problem"],
+        "user_tasks": copy.deepcopy(
+            comparison["direction_frame"]["user_tasks"]
+        ),
+        "decision_criteria": copy.deepcopy(
+            comparison["direction_frame"]["decision_criteria"]
+        ),
+        "reference_observations": [
+            {
+                "reference_id": item["reference_id"],
+                "role": item["role"],
+                "source_ids": copy.deepcopy(item["source_ids"]),
+                "product_context": item["product_context"],
+                "observed_state": item["observed_state"],
+                "quality_rationale": item["quality_rationale"],
+                "task_fit": copy.deepcopy(item["task_fit"]),
+                "transferable_decisions": copy.deepcopy(
+                    item["transferable_decisions"]
+                ),
+                "non_transferable_context": copy.deepcopy(
+                    item["non_transferable_context"]
+                ),
+                "artifact_path": item["artifact_path"],
+                "artifact_sha256": item["artifact_sha256"],
+            }
+            for item in comparison["reference_observations"]
+        ],
+        "minority_risks": copy.deepcopy(
+            falsification["minority_risks"]
+        ),
+        "alternatives": alternatives,
+        "created_at": _now(),
+    }
+    manifest["manifest_id"] = _identity(manifest, "manifest_id")
+    if write:
+        target = comparison_manifest_path(
+            repo,
+            plan_id=plan["plan_id"],
+            manifest_id=manifest["manifest_id"],
+        )
+        target.parent.mkdir(parents=True, exist_ok=True)
+        atomic_write(target, pretty_json(manifest).encode("utf-8"))
+    result = copy.deepcopy(manifest)
+    result["marker"] = (
+        f"{DESIGN_COMPARISON_MARKER_PREFIX}{plan['plan_id']}:"
+        f"{manifest['manifest_id']}]"
+    )
+    result["presentation_markdown"] = (
+        comparison_presentation_markdown(
+            manifest,
+            repo_path=repo,
+        )
+    )
+    return result
+
