+
+def _artifact(
+    artifact_type: str,
+    label: str,
+    *,
+    namespace: str = "test-domain",
+) -> dict:
+    return build_artifact_envelope(
+        artifact_type=artifact_type,
+        namespace=namespace,
+        root_request_id=ROOT_REQUEST_ID,
+        workflow_instance_id=WORKFLOW_INSTANCE_ID,
+        payload_digest=sha256_text(label),
+        payload_ref=f".maestro/state/test-artifacts/{label}.json",
+        producer="test",
+    )
+
+
+def _command(
+    definition: dict,
+    state: dict,
+    command_type: str,
+    key: str,
+    payload: dict,
+) -> dict:
+    return build_command(
+        workflow_instance_id=WORKFLOW_INSTANCE_ID,
+        root_request_id=ROOT_REQUEST_ID,
+        definition_id=definition["definition_id"],
+        expected_revision=state["revision"],
+        idempotency_key=key,
+        command_type=command_type,
+        payload=payload,
+    )
+
+
+def _generic_outcome_contract() -> dict:
+    return build_outcome_contract(
+        outcome_statement="The user can verify one completed result.",
+        primary_user="operator",
+        job_to_be_done="Inspect a completed result.",
+        success_criteria=[
+            {
+                "criterion_id": "result-visible",
+                "statement": "The completed result is visible.",
+                "evidence_requirements": ["result artifact"],
+            }
+        ],
+        rejection_conditions=["result solves a different task"],
+        constraints=[],
+        authority="request-derived",
+    )
+
+
+def _start(
+    definition: dict,
+    *,
+    contract_artifact: dict | None = None,
+) -> tuple[dict, list[dict]]:
+    state = empty_workflow_state(
+        definition,
+        workflow_instance_id=WORKFLOW_INSTANCE_ID,
+        root_request_id=ROOT_REQUEST_ID,
+    )
+    contract = contract_artifact or _artifact(
+        "OutcomeContract", "outcome-contract"
+    )
+    command = _command(
+        definition,
+        state,
+        "START_WORKFLOW",
+        "workflow:start",
+        {
+            "outcome_contract": contract,
+            "responsibility_boundaries": [
+                "workflow-control",
+                "domain-evaluation",
+            ],
+        },
+    )
+    return reduce_command(state, definition, command)
