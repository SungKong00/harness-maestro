+        )
+
+        controller = OrchestrationController.start(
+            repo,
+            definition=definition,
+            expected_workflow_policy_digest=definition["responsibility_plan"]["workflow_source_binding"]["workflow_policy_digest"],
+            root_request_id=ROOT_REQUEST_ID,
+            root_execution_id="run-workflow-projection",
+            workflow_instance_id="workflow-policy-projection",
+            expected_owner_workflow_digest=plan[
+                "owner_workflow_digest"
+            ],
+        )
+        projection = stage_input_projection(
+            definition=definition,
+            state=controller.state,
+            stage_spec_id="stage-left",
+            predecessor_packets={},
+        )
+
+        self.assertEqual(
+            plan["workflow_policy"],
+            projection["workflow_policy"],
+        )
+        self.assertEqual(
+            plan["workflow_step_mapping"],
+            projection["workflow_step_mapping"],
+        )
+        self.assertEqual(
+            plan["workflow_source_binding"],
+            projection["workflow_source_binding"],
+        )
+        contaminated = copy.deepcopy(projection)
+        contaminated["workflow_step_mapping"]["entries"][0][
+            "stage_spec_ids"
+        ] = ["stage-right"]
+        contaminated["projection_sha256"] = projection_digest(
+            contaminated
+        )
+        with self.assertRaises(MaestroError) as raised:
+            validate_stage_input_projection(
+                contaminated,
+                definition=definition,
+                state=controller.state,
+                stage_spec_id="stage-left",
+            )
+        self.assertEqual(
+            "ORCH_PACKET_ADMISSION_FAILED",
+            raised.exception.code,
+        )
+        mutations = []
+        changed_stage = copy.deepcopy(projection)
+        changed_stage["stage_spec"]["stage_kind"] = "forged-stage"
+        mutations.append(changed_stage)
+        changed_role = copy.deepcopy(projection)
+        changed_role["role_spec"]["read_only"] = False
+        mutations.append(changed_role)
+        extra_authority = copy.deepcopy(projection)
+        extra_authority["forged_authority"] = "owner"
+        mutations.append(extra_authority)
+        extra_packet = copy.deepcopy(projection)
+        forged_packet = {"packet_digest": ""}
+        forged_packet["packet_digest"] = packet_digest(forged_packet)
+        extra_packet["predecessor_packets"].append(forged_packet)
+        mutations.append(extra_packet)
+        for mutation in mutations:
+            mutation["projection_sha256"] = projection_digest(mutation)
+            with self.subTest(fields=set(mutation)):
+                with self.assertRaises(MaestroError) as mutation_error:
+                    validate_stage_input_projection(
+                        mutation,
+                        definition=definition,
+                        state=controller.state,
+                        stage_spec_id="stage-left",
+                    )
+                self.assertEqual(
+                    "ORCH_PACKET_ADMISSION_FAILED",
+                    mutation_error.exception.code,
+                )
