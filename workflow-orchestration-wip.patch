+            "runtimeWorkspaceRoots": runtime_roots,
+        }
+        receipt = issue_context_evidence(
+            self.repo,
+            evidence_profile=evidence_profile(definition),
+            evidence_kind="pre-turn-context",
+            collector_integrity=_collector_integrity(),
+            root_request_id=state["root_request_id"],
+            root_execution_id=state["root_execution_id"],
+            workflow_instance_id=state["workflow_instance_id"],
+            stage_spec_id=stage_spec_id,
+            role_spec_id=stage["role_spec_id"],
+            attempt_id=attempt_id,
+            participant_instance_id=participant,
+            producer_principal_id="not_observed",
+            invocation_id="not_observed",
+            context_instance_id=context,
+            capability_lease_id="not_observed",
+            capabilities=[],
+            read_only=role["read_only"],
+            issued_by=self.source,
+            collected_at=self.timestamp,
+            metadata=_metadata(
+                requested=requested,
+                recommended=recommended,
+                applied=applied,
+            ),
+            observation_sources=observation_sources,
+            resumption={
+                "status": "controller_lineage",
+                "context_instance_id": context,
+                "checkpoint_digest": correction_request[
+                    "controller_checkpoint_digest"
+                ],
+                "source": "controller_lineage",
+            },
+            source_evidence_refs=[
+                "scripted-test-resume:"
+                + correction_request["correction_request_id"]
+            ],
+            host_context={
+                "thread_id": thread_id,
+                "session_id": "not_observed",
+                "method": "thread/resume",
+            },
+            runtime_binding={
+                "source_interface": "scripted-callback",
+                "runtime_version": "not_observed",
+                "generated_schema_sha256": "not_observed",
+                "coverage": "scripted_test",
+            },
+            host_returned={
+                "model": "not_observed",
+                "reasoning_effort": "not_observed",
+                "sandbox": returned_sandbox,
+                "approval_policy": "never",
+                "cwd": str(self.repo),
+                "runtime_workspace_roots": runtime_roots,
+            },
+            method_evidence={
+                "request_sha256": sha256_text(
+                    canonical_json(method_params)
+                ),
+                "response_sha256": sha256_text(
+                    canonical_json(method_result)
+                ),
+            },
+        )
+        return CallbackHostSession(
+            participant_receipt=receipt,
+            stage=stage,
+            callback=callback,
+            repo=self.repo,
+            completed_at=self.timestamp,
+        )
