+def _commit_workflow_projection(
+    target: Path,
+    *,
+    value: dict[str, Any],
+    runtime: dict[str, Any],
+    recorded_at: str,
+) -> bool:
+    ledger = ensure_execution_ledger(value)
+    updated_ledger, changed = append_workflow_projection(
+        ledger,
+        definition=runtime["definition"],
+        state=runtime["state"],
+        events=runtime["events"],
+        recorded_at=recorded_at,
+    )
+    if not changed:
+        return False
+    updated = copy.deepcopy(value)
+    updated["execution_ledger"] = updated_ledger
+    with observation_write_lock(target):
+        current = read_json(target)
+        if canonical_json(current) != canonical_json(value):
+            raise MaestroError(
+                "RUN_OBSERVATION_STALE_REVISION",
+                "The observation changed before workflow projection could be recorded.",
+            )
+        atomic_write(target, pretty_json(updated).encode("utf-8"))
+    return True
