+    if (
+        operation.get("path") != expected_path
+        or candidate["candidate_id"] != plan.get("candidate_id")
+        or candidate["fingerprint"] != plan.get("fingerprint")
+    ):
+        raise MaestroError(
+            "CONVENTION_CANDIDATE_PLAN_INVALID",
