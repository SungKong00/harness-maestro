+    "claims": {
+      "type": "array",
+      "maxItems": 64,
+      "items": {
+        "$ref": "#/$defs/claim"
+      }
+    },
+    "evidence_refs": {
+      "$ref": "#/$defs/stringList"
+    },
+    "authority_refs": {
+      "$ref": "#/$defs/stringList"
+    },
+    "limitations": {
+      "type": "array",
+      "maxItems": 64
+    },
+    "conflicts": {
