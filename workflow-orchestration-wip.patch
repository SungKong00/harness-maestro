+from __future__ import annotations
+
+import copy
+import json
+import re
+import secrets
+from contextlib import contextmanager
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Iterator
+
+from .errors import MaestroError
+from .design_selection import (
+    consume_owner_selection,
+    observe_comparison_presentation,
+)
+from .governance import finalize_run
+from .observations import (
+    attach_run_plan,
+    observation_receipt_fields,
+    record_execution_fallback,
+    record_stage_observation,
+    record_work_finish,
+    record_work_start,
+    start_desktop_request_observation,
+)
+from .planning import route_goal_v2
+from .util import (
+    atomic_write,
+    canonical_json,
+    ensure_repo,
+    pretty_json,
+    read_json,
+    safe_target,
+    sha256_text,
+)
+
+try:  # pragma: no cover - exercised on supported POSIX hosts.
+    import fcntl
+except ImportError:  # pragma: no cover
+    fcntl = None
+
+
+CODEX_HOOK_STATE_VERSION = "maestro_codex_hook_state_v1"
+CODEX_HOOK_ADAPTER_VERSION = "maestro_codex_hook_adapter_v1"
+CONTINUATION_PREFIX = "[MAESTRO_LIFECYCLE_CONTINUE:"
+_CONTINUATION_PATTERN = re.compile(
+    r"^\[MAESTRO_LIFECYCLE_CONTINUE:([a-f0-9]{32})\]"
+)
+_ID_PATTERN = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
+_SUPPORTED_EVENTS = {"UserPromptSubmit", "Stop"}
+_STATE_FIELDS = {
+    "schema_version",
+    "event_key",
+    "run_id",
+    "observation_id",
+    "root_work_id",
+    "display_language",
+    "stop_guard_count",
+    "created_at",
+    "updated_at",
+}
+_CONTINUATION_FIELDS = {
+    "schema_version",
+    "token_digest",
+    "run_id",
+    "observation_id",
+    "root_work_id",
+    "display_language",
+    "created_at",
+}
+_MAX_INPUT_BYTES = 1_000_000
+_MAX_ID_LENGTH = 160
+_LIFECYCLE_EVIDENCE = "codex-hook:lifecycle-incomplete"
+
+
+def _now() -> str:
+    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
+
+
+def _bounded_line(value: Any, *, field: str, maximum: int) -> str:
+    if (
+        not isinstance(value, str)
+        or not value.strip()
+        or len(value) > maximum
+        or any(character in value for character in "\r\n\x00")
+    ):
+        raise MaestroError(
+            "CODEX_HOOK_INPUT_INVALID",
+            f"{field} must be one bounded non-empty line.",
+        )
+    return value.strip()
+
+
+def _event_identity(payload: dict[str, Any]) -> tuple[str, str]:
+    session_id = _bounded_line(
+        payload.get("session_id"),
+        field="session_id",
+        maximum=_MAX_ID_LENGTH,
+    )
+    turn_id = _bounded_line(
+        payload.get("turn_id"),
+        field="turn_id",
+        maximum=_MAX_ID_LENGTH,
+    )
+    return session_id, turn_id
+
+
+def _event_key(repo: Path, payload: dict[str, Any]) -> str:
+    session_id, turn_id = _event_identity(payload)
+    project = read_json(safe_target(repo, ".maestro/project.json"))
+    return sha256_text(
+        canonical_json(
+            {
+                "project_id": project.get("project_id"),
+                "session_id": session_id,
+                "turn_id": turn_id,
+            }
+        )
+    )
+
+
+def _session_digest(repo: Path, payload: dict[str, Any]) -> str:
+    session_id, _ = _event_identity(payload)
+    project = read_json(safe_target(repo, ".maestro/project.json"))
+    return sha256_text(
+        canonical_json(
+            {
+                "project_id": project.get("project_id"),
+                "session_id": session_id,
+            }
+        )
+    )
+
+
+def _state_root(repo: Path) -> Path:
+    return safe_target(repo, ".maestro/state/hooks/codex")
+
+
+def _state_path(repo: Path, event_key: str) -> Path:
+    return safe_target(
+        repo,
+        f".maestro/state/hooks/codex/turns/{event_key}.json",
+    )
+
+
+def _continuation_path(repo: Path, token_digest: str) -> Path:
+    return safe_target(
+        repo,
+        f".maestro/state/hooks/codex/continuations/{token_digest}.json",
+    )
+
+
+@contextmanager
+def _hook_lock(repo: Path) -> Iterator[None]:
+    root = _state_root(repo)
+    root.mkdir(parents=True, exist_ok=True)
+    lock_path = safe_target(repo, ".maestro/state/hooks/codex/.lock")
+    with lock_path.open("a+b") as handle:
+        if fcntl is not None:
+            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
+        try:
+            yield
+        finally:
+            if fcntl is not None:
+                fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
+
+
+def _write_json(target: Path, value: dict[str, Any]) -> None:
+    target.parent.mkdir(parents=True, exist_ok=True)
+    atomic_write(target, pretty_json(value).encode("utf-8"))
+
+
+def _valid_state(value: Any, *, event_key: str | None = None) -> bool:
+    return (
+        isinstance(value, dict)
+        and set(value) == _STATE_FIELDS
+        and value.get("schema_version") == CODEX_HOOK_STATE_VERSION
+        and isinstance(value.get("event_key"), str)
+        and len(value["event_key"]) == 64
+        and (event_key is None or value["event_key"] == event_key)
+        and isinstance(value.get("run_id"), str)
+        and _ID_PATTERN.fullmatch(value["run_id"]) is not None
+        and isinstance(value.get("observation_id"), str)
+        and len(value["observation_id"]) == 32
+        and isinstance(value.get("root_work_id"), str)
+        and _ID_PATTERN.fullmatch(value["root_work_id"]) is not None
+        and value.get("display_language") in {"ko", "unverified"}
+        and isinstance(value.get("stop_guard_count"), int)
+        and not isinstance(value["stop_guard_count"], bool)
+        and 0 <= value["stop_guard_count"] <= 2
+        and isinstance(value.get("created_at"), str)
+        and isinstance(value.get("updated_at"), str)
+    )
+
+
+def _read_state(repo: Path, event_key: str) -> dict[str, Any] | None:
+    target = _state_path(repo, event_key)
+    if not target.is_file() or target.is_symlink():
+        return None
+    value = read_json(target)
+    if not _valid_state(value, event_key=event_key):
+        raise MaestroError(
+            "CODEX_HOOK_STATE_INVALID",
+            "Codex Hook turn state is invalid.",
+        )
+    return value
+
+
+def _display_language(prompt: Any) -> str:
+    if not isinstance(prompt, str):
+        return "unverified"
+    return (
+        "ko"
+        if any(
+            "\u1100" <= character <= "\u11ff"
+            or "\u3130" <= character <= "\u318f"
+            or "\ua960" <= character <= "\ua97f"
+            or "\uac00" <= character <= "\ud7a3"
+            or "\ud7b0" <= character <= "\ud7ff"
+            for character in prompt
+        )
+        else "unverified"
+    )
+
+
+def _placeholder_label(language: str, event_key: str) -> str:
+    suffix = event_key[:8]
+    return (
+        f"Codex 요청 · {suffix}"
+        if language == "ko"
+        else f"Codex request · {suffix}"
+    )
+
+
+def _hook_source_binding(event_key: str) -> dict[str, Any]:
+    return {
+        "interface": "host_adapter",
+        "version": CODEX_HOOK_ADAPTER_VERSION,
+        "schema_digest": None,
+        "capability": "lifecycle_only",
+        "correlation_id": event_key[:40],
+        "event_coverage": "hook_lifecycle",
+    }
+
+
+def _root_summary(language: str) -> str:
+    return (
+        "Codex 요청의 시작·작업·종료 생명주기"
+        if language == "ko"
+        else "Codex request start, work, and stop lifecycle"
+    )
+
+
+def _context(state: dict[str, Any]) -> str:
+    observation_id = state["observation_id"]
+    run_id = state["run_id"]
+    root_work_id = state["root_work_id"]
+    if state["display_language"] == "ko":
+        return (
+            "Maestro 자동 관측이 이 사용자 요청의 루트 기록을 이미 시작했습니다.\n"
+            f"- observation_id: {observation_id}\n"
+            f"- run_id: {run_id}\n"
+            f"- root_work_id: {root_work_id}\n"
+            "이 요청에는 새 root/child/retry 기록을 만들지 말고 위 기록 하나만 사용하세요. "
+            "사용자 의도를 요약한 한국어 작업명으로 `maestro observe label`을 먼저 "
+            "갱신하고, $maestro 절차에 따라 하나의 route plan을 붙인 뒤 같은 기록에 "
+            "WorkSpan과 Assignment 종료 결과를 남기세요. 현재 Desktop에서 수행한다면 "
+            "명시적 fallback을 기록하세요. 최종 답변 전 root work와 모든 계획 단계를 "
+            "terminal로 닫고 `maestro finalize`까지 완료해야 합니다. 프롬프트·응답 "
+            "원문·숨은 추론은 기록하지 마세요. Hook의 model 값은 해당 시점 모델 "
+            "관측일 뿐 실제 적용 모델·추론 토큰·전체 이벤트 증명이 아닙니다."
+        )
+    return (
+        "Maestro automatic observation already started the one root record "
+        "for this user request.\n"
+        f"- observation_id: {observation_id}\n"
+        f"- run_id: {run_id}\n"
+        f"- root_work_id: {root_work_id}\n"
+        "Do not create another root, child, or retry record for this request. "
+        "Use `maestro observe label` to replace the placeholder with a concise "
+        "semantic task label, follow the $maestro workflow, attach one route "
+        "plan, and append all WorkSpans and Assignment terminal results to this "
+        "record. Record an explicit fallback when the current Desktop performs "
+        "the work. Before the final response, finish the root work and every "
+        "planned stage, then run `maestro finalize`. Never store prompt text, "
+        "assistant messages, hidden reasoning, or transcripts. The Hook model "
+        "is a point-in-time observation, not proof of the applied model, "
+        "reasoning tokens, or a complete event stream."
+    )
+
+
+def _hook_output(event_name: str, context: str) -> dict[str, Any]:
+    return {
+        "hookSpecificOutput": {
+            "hookEventName": event_name,
+            "additionalContext": context,
+        }
+    }
+
+
+def _new_state(
+    repo: Path,
+    payload: dict[str, Any],
+    *,
+    event_key: str,
+) -> dict[str, Any]:
+    session_id, turn_id = _event_identity(payload)
+    model = _bounded_line(
+        payload.get("model"),
+        field="model",
+        maximum=128,
+    )
+    language = _display_language(payload.get("prompt"))
+    run_id = f"codex-turn-{event_key[:24]}"
+    started = start_desktop_request_observation(
+        repo,
+        run_id=run_id,
+        task_label=_placeholder_label(language, event_key),
+        thread_id=session_id,
+        turn_id=turn_id,
+        requested_model=model,
+    )
+    observation_id = started["observation_id"]
+    root_work_id = f"codex-root-{event_key[:24]}"
+    record_work_start(
+        repo,
+        observation_id=observation_id,
+        run_id=run_id,
+        work_id=root_work_id,
+        kind="orchestration",
+        role="Codex main turn",
+        executor_id="codex-main",
+        task_summary=_root_summary(language),
+        read_only=payload.get("permission_mode") in {
+            "read-only",
+            "read_only",
+        },
+        source="host_adapter",
+        model_evidence="hook_point",
+        source_binding=_hook_source_binding(event_key),
+        model_observation={
+            "observed_model": model,
+            "coverage": "hook_point",
+            "reroutes": [],
+        },
+    )
+    now = _now()
+    state = {
+        "schema_version": CODEX_HOOK_STATE_VERSION,
+        "event_key": event_key,
+        "run_id": run_id,
+        "observation_id": observation_id,
+        "root_work_id": root_work_id,
+        "display_language": language,
+        "stop_guard_count": 0,
+        "created_at": now,
+        "updated_at": now,
+    }
+    _write_json(_state_path(repo, event_key), state)
+    return state
+
+
+def _continuation_state(
+    repo: Path,
+    payload: dict[str, Any],
+) -> dict[str, Any] | None:
+    prompt = payload.get("prompt")
+    match = (
+        _CONTINUATION_PATTERN.match(prompt)
+        if isinstance(prompt, str)
+        else None
+    )
+    if match is None:
+        return None
+    token_digest = sha256_text(match.group(1))
+    target = _continuation_path(repo, token_digest)
+    if not target.is_file() or target.is_symlink():
+        return None
+    continuation = read_json(target)
+    if (
+        not isinstance(continuation, dict)
+        or set(continuation) != _CONTINUATION_FIELDS
+        or continuation.get("schema_version") != CODEX_HOOK_STATE_VERSION
+        or continuation.get("token_digest") != token_digest
+    ):
+        raise MaestroError(
+            "CODEX_HOOK_CONTINUATION_INVALID",
+            "Codex Hook continuation state is invalid.",
+        )
+    event_key = _event_key(repo, payload)
+    existing = _read_state(repo, event_key)
+    now = _now()
+    state = {
+        "schema_version": CODEX_HOOK_STATE_VERSION,
+        "event_key": event_key,
+        "run_id": continuation["run_id"],
+        "observation_id": continuation["observation_id"],
+        "root_work_id": continuation["root_work_id"],
+        "display_language": continuation["display_language"],
+        "stop_guard_count": 1,
+        "created_at": (
+            existing["created_at"] if existing is not None else now
+        ),
+        "updated_at": now,
+    }
+    if existing is not None and (
+        existing["run_id"] != state["run_id"]
+        or existing["observation_id"] != state["observation_id"]
+    ):
+        raise MaestroError(
+            "CODEX_HOOK_CONTINUATION_CONFLICT",
+            "The continuation turn already belongs to another request.",
+        )
+    _write_json(_state_path(repo, event_key), state)
+    return state
+
+
+def _request_submit(repo: Path, payload: dict[str, Any]) -> dict[str, Any]:
+    event_key = _event_key(repo, payload)
+    owner_selection = consume_owner_selection(
+        repo,
+        prompt=payload.get("prompt"),
+        session_digest=_session_digest(repo, payload),
+        event_key=event_key,
+    )
+    receipt: dict[str, Any] | None = None
+    if owner_selection is not None:
+        presentation, receipt = owner_selection
+        existing = _read_state(repo, event_key)
+        now = _now()
+        state = {
+            "schema_version": CODEX_HOOK_STATE_VERSION,
+            "event_key": event_key,
+            "run_id": presentation["run_id"],
+            "observation_id": presentation["observation_id"],
+            "root_work_id": presentation["root_work_id"],
+            "display_language": presentation["display_language"],
+            "stop_guard_count": 0,
+            "created_at": (
+                existing["created_at"]
+                if existing is not None
+                else now
+            ),
+            "updated_at": now,
+        }
+        if existing is not None and (
+            existing["run_id"] != state["run_id"]
+            or existing["observation_id"]
+            != state["observation_id"]
+        ):
+            raise MaestroError(
+                "DESIGN_OWNER_SELECTION_TURN_CONFLICT",
+                "The selection turn already belongs to another request.",
+            )
+        _write_json(_state_path(repo, event_key), state)
+    else:
+        state = _continuation_state(repo, payload)
+    if state is None:
+        state = _read_state(repo, event_key)
+        if state is None:
+            state = _new_state(repo, payload, event_key=event_key)
+    context = _context(state)
+    if receipt is not None:
+        if state["display_language"] == "ko":
+            context += (
+                "\nMaestro가 동일 세션의 대안 제시와 사용자 선택을 관찰해 "
+                "owner selection receipt를 발급했습니다.\n"
+                f"- owner_selection_receipt_id: {receipt['receipt_id']}\n"
+                f"- selected_alternative_id: "
+                f"{receipt['selected_alternative_id']}\n"
+                "새 작업 기록을 만들지 말고 이 receipt를 최종 selection과 "
+                "Design Decision Packet에 정확히 결박하세요."
+            )
+        else:
+            context += (
+                "\nMaestro observed the same-session comparison and user "
+                "selection and issued an owner selection receipt.\n"
+                f"- owner_selection_receipt_id: {receipt['receipt_id']}\n"
+                f"- selected_alternative_id: "
+                f"{receipt['selected_alternative_id']}\n"
+                "Keep this request record and bind the exact receipt into "
+                "the final selection and Design Decision Packet."
+            )
+    return _hook_output("UserPromptSubmit", context)
+
+
+def _observation_complete(repo: Path, state: dict[str, Any]) -> bool:
+    observed = observation_receipt_fields(
+        repo,
+        observation_id=state["observation_id"],
+        run_id=state["run_id"],
+    )
+    return observed.get("completion_closure") is not None
+
+
+def _issue_continuation(
+    repo: Path,
+    state: dict[str, Any],
+) -> dict[str, Any]:
+    token = secrets.token_hex(16)
+    token_digest = sha256_text(token)
+    continuation = {
+        "schema_version": CODEX_HOOK_STATE_VERSION,
+        "token_digest": token_digest,
+        "run_id": state["run_id"],
+        "observation_id": state["observation_id"],
+        "root_work_id": state["root_work_id"],
+        "display_language": state["display_language"],
+        "created_at": _now(),
+    }
+    _write_json(_continuation_path(repo, token_digest), continuation)
+    updated = copy.deepcopy(state)
+    updated["stop_guard_count"] = 1
+    updated["updated_at"] = _now()
+    _write_json(_state_path(repo, state["event_key"]), updated)
+    reason = (
+        f"{CONTINUATION_PREFIX}{token}] Maestro 기록이 아직 종료되지 않았습니다. "
+        f"observation_id={state['observation_id']}, run_id={state['run_id']}, "
+        f"root_work_id={state['root_work_id']}를 그대로 사용해 작업명·계획·WorkSpan·"
+        "단계 결과를 보완하고 finalize한 뒤 최종 답변을 다시 작성하세요. 새 작업 "
+        "기록은 만들지 마세요."
+        if state["display_language"] == "ko"
+        else (
+            f"{CONTINUATION_PREFIX}{token}] The Maestro record is still open. "
+            f"Use observation_id={state['observation_id']}, "
+            f"run_id={state['run_id']}, and root_work_id={state['root_work_id']} "
+            "to finish the label, plan, WorkSpans, stage results, and finalization. "
+            "Do not create another task record."
+        )
+    )
+    return {"decision": "block", "reason": reason}
+
+
+def _recovery_plan(repo: Path, state: dict[str, Any]) -> Path:
+    goal = (
+        "자동 관측 생명주기를 완료하지 못한 Codex 요청을 실패 상태로 종료한다"
+        if state["display_language"] == "ko"
+        else "Close an incomplete Codex automatic observation as a failure"
+    )
+    plan = route_goal_v2(
+        goal,
+        "low",
+        host_id="codex",
+        intent="review",
+        repo_path=repo,
+    )
+    target = safe_target(
+        repo,
+        (
+            ".maestro/state/hooks/codex/recovery-plans/"
+            f"{state['event_key']}.json"
+        ),
+    )
+    _write_json(target, plan)
+    return target
+
+
+def _close_incomplete_observation(
+    repo: Path,
+    state: dict[str, Any],
+) -> None:
+    observed = observation_receipt_fields(
+        repo,
+        observation_id=state["observation_id"],
+        run_id=state["run_id"],
+    )
+    if observed.get("completion_closure") is not None:
+        return
+    if not isinstance(observed.get("plan_summary"), dict):
+        attach_run_plan(
+            repo,
+            observation_id=state["observation_id"],
+            run_id=state["run_id"],
+            plan_path=_recovery_plan(repo, state),
+        )
+        observed = observation_receipt_fields(
+            repo,
+            observation_id=state["observation_id"],
+            run_id=state["run_id"],
+        )
+    binding = observed.get("execution_binding")
+    if not isinstance(binding, dict) or binding.get("mode") != "explicit_fallback":
+        record_execution_fallback(
+            repo,
+            observation_id=state["observation_id"],
+            run_id=state["run_id"],
+            reason="capability_unavailable",
+            evidence=(
+                "Codex Stop Hook가 완료되지 않은 관측 생명주기를 감지함"
+                if state["display_language"] == "ko"
+                else "Codex Stop Hook detected an incomplete observation lifecycle"
+            ),
+        )
+    observed = observation_receipt_fields(
+        repo,
+        observation_id=state["observation_id"],
+        run_id=state["run_id"],
+    )
+    for span in observed.get("work_spans", []):
+        if span.get("status") == "running":
+            record_work_finish(
+                repo,
+                observation_id=state["observation_id"],
+                run_id=state["run_id"],
+                work_id=span["work_id"],
+                status="interrupted",
+                result_summary=(
+                    "최종 응답 전 기록 생명주기가 완료되지 않아 중단 처리"
+                    if state["display_language"] == "ko"
+                    else "Interrupted because the record lifecycle was not completed"
+                ),
+                evidence_refs=[_LIFECYCLE_EVIDENCE],
+            )
+    observed = observation_receipt_fields(
+        repo,
+        observation_id=state["observation_id"],
+        run_id=state["run_id"],
+    )
+    recorded = {
+        item["assignment_id"]
+        for item in observed.get("stage_results", [])
+    }
+    blocked_recorded = any(
+        item.get("status") in {"failed", "blocked", "interrupted"}
+        for item in observed.get("stage_results", [])
+    )
+    for assignment in observed["plan_summary"]["assignments"]:
+        assignment_id = assignment["assignment_id"]
+        if assignment_id in recorded:
+            continue
+        status = "skipped" if blocked_recorded else "blocked"
+        record_stage_observation(
+            repo,
+            observation_id=state["observation_id"],
+            run_id=state["run_id"],
+            assignment_id=assignment_id,
+            status=status,
+            evidence_source="current_host",
+            evidence_refs=[_LIFECYCLE_EVIDENCE],
+        )
+        blocked_recorded = True
+    observed = observation_receipt_fields(
+        repo,
+        observation_id=state["observation_id"],
+        run_id=state["run_id"],
+    )
+    stage_statuses = {
+        item["assignment_id"]: item["status"]
+        for item in observed.get("stage_results", [])
+    }
+    terminal_by_assignment: dict[str, list[str]] = {}
+    for span in observed.get("work_spans", []):
+        assignment_id = span.get("assignment_id")
+        if (
+            isinstance(assignment_id, str)
+            and span.get("status") != "running"
+        ):
+            terminal_by_assignment.setdefault(assignment_id, []).append(
+                span["work_id"]
+            )
+    for assignment in observed["plan_summary"]["assignments"]:
+        assignment_id = assignment["assignment_id"]
+        if (
+            stage_statuses.get(assignment_id) == "skipped"
+            or terminal_by_assignment.get(assignment_id)
+        ):
+            continue
+        dependency_work_ids = [
+            work_id
+            for dependency_id in assignment.get("depends_on", [])
+            for work_id in terminal_by_assignment.get(dependency_id, [])
+        ]
+        recovery_work_id = (
+            f"codex-recovery-{assignment_id}-{state['event_key'][:8]}"
+        )
+        record_work_start(
+            repo,
+            observation_id=state["observation_id"],
+            run_id=state["run_id"],
+            work_id=recovery_work_id,
+            assignment_id=assignment_id,
+            kind=assignment["kind"],
+            role="Codex Hook lifecycle recovery",
+            executor_id=assignment["executor_id"],
+            task_summary=(
+                "완료되지 않은 계획 단계를 기록 생명주기 실패로 종료"
+                if state["display_language"] == "ko"
+                else "Close the unfinished planned stage as a lifecycle failure"
+            ),
+            read_only=assignment["read_only"],
+            source="host_adapter",
+            depends_on_work_ids=dependency_work_ids,
+            source_binding=_hook_source_binding(state["event_key"]),
+        )
+        record_work_finish(
+            repo,
+            observation_id=state["observation_id"],
+            run_id=state["run_id"],
+            work_id=recovery_work_id,
+            status="blocked",
+            result_summary=(
+                "최종 응답 전에 단계 관측이 완료되지 않음"
+                if state["display_language"] == "ko"
+                else "Stage observation was not completed before the final response"
+            ),
+            evidence_refs=[_LIFECYCLE_EVIDENCE],
+        )
+        terminal_by_assignment.setdefault(assignment_id, []).append(
+            recovery_work_id
+        )
+    observed = observation_receipt_fields(
+        repo,
+        observation_id=state["observation_id"],
+        run_id=state["run_id"],
+    )
+    work_ids = {
+        span["work_id"]
+        for span in observed.get("work_spans", [])
+    }
+    non_leaves = {
+        predecessor
+        for span in observed.get("work_spans", [])
+        for predecessor in (
+            span.get("parent_work_id"),
+            span.get("followup_of_work_id"),
+            *span.get("depends_on_work_ids", []),
+            *span.get("joins_work_ids", []),
+        )
+        if predecessor in work_ids
+    }
+    leaves = sorted(work_ids - non_leaves)
+    final_work_id = f"codex-hook-final-{state['event_key'][:16]}"
+    if final_work_id not in work_ids:
+        record_work_start(
+            repo,
+            observation_id=state["observation_id"],
+            run_id=state["run_id"],
+            work_id=final_work_id,
+            kind="synthesis",
+            role="Codex Hook lifecycle finalizer",
+            executor_id="codex-hook-finalizer",
+            task_summary=(
+                "미완료 실행 leaf를 실패 종료 기록으로 합성"
+                if state["display_language"] == "ko"
+                else "Synthesize unfinished execution leaves into a failure record"
+            ),
+            read_only=True,
+            source="host_adapter",
+            joins_work_ids=leaves,
+            source_binding=_hook_source_binding(state["event_key"]),
+            outcome={
+                "finding_summary": (
+                    "최종 응답 전 Maestro 기록 생명주기가 완료되지 않음"
+                    if state["display_language"] == "ko"
+                    else "The Maestro record lifecycle was incomplete before the final response"
+                ),
+                "conclusion": (
+                    "사용자 작업의 성공을 추정하지 않고 관측 실패로 종료"
+                    if state["display_language"] == "ko"
+                    else "Closed as an observation failure without inferring task success"
+                ),
+                "decision": (
+                    "RunReceipt를 blocked 상태로 봉인"
+                    if state["display_language"] == "ko"
+                    else "Seal the RunReceipt with blocked status"
+                ),
+                "next_action": "finish",
+                "consumed_work_ids": leaves,
+                "handoff": None,
+                "artifacts": [],
+                "verification": None,
+            },
+        )
+        record_work_finish(
+            repo,
+            observation_id=state["observation_id"],
+            run_id=state["run_id"],
+            work_id=final_work_id,
+            status="completed",
+            result_summary=(
+                "미완료 관측을 blocked 기록으로 종료"
+                if state["display_language"] == "ko"
+                else "Closed the incomplete observation as a blocked record"
+            ),
+            evidence_refs=[_LIFECYCLE_EVIDENCE],
+        )
+    finalize_run(
+        repo,
+        run_id=state["run_id"],
+        observation_id=state["observation_id"],
+        outcome="blocked",
+        evidence_refs=[_LIFECYCLE_EVIDENCE],
+        verifier_result="not_run",
+        human_fix_required=True,
+    )
+
+
+def _stop(repo: Path, payload: dict[str, Any]) -> dict[str, Any]:
+    event_key = _event_key(repo, payload)
+    state = _read_state(repo, event_key)
+    if state is None:
+        state = _new_state(repo, payload, event_key=event_key)
+    if _observation_complete(repo, state):
+        return {}
+    observed = observation_receipt_fields(
+        repo,
+        observation_id=state["observation_id"],
+        run_id=state["run_id"],
+    )
+    plan_summary = observed.get("plan_summary")
+    expected_plan_id = (
+        plan_summary.get("plan_id")
+        if isinstance(plan_summary, dict)
+        else None
+    )
+    presentation = observe_comparison_presentation(
+        repo,
+        assistant_message=payload.get("last_assistant_message"),
+        session_digest=_session_digest(repo, payload),
+        event_key=event_key,
+        expected_plan_id=expected_plan_id,
+        observation_id=state["observation_id"],
+        run_id=state["run_id"],
+        root_work_id=state["root_work_id"],
+        display_language=state["display_language"],
+    )
+    if presentation is not None:
+        return {}
+    stop_hook_active = payload.get("stop_hook_active")
+    if not isinstance(stop_hook_active, bool):
+        raise MaestroError(
+            "CODEX_HOOK_INPUT_INVALID",
+            "stop_hook_active must be a boolean.",
+        )
+    if not stop_hook_active and state["stop_guard_count"] == 0:
+        return _issue_continuation(repo, state)
+    _close_incomplete_observation(repo, state)
+    updated = copy.deepcopy(state)
+    updated["stop_guard_count"] = 2
+    updated["updated_at"] = _now()
+    _write_json(_state_path(repo, event_key), updated)
+    return {}
+
+
+def handle_codex_hook(
+    repo_path: str | Path,
+    payload: dict[str, Any],
+) -> dict[str, Any]:
+    """Handle one allowlisted Codex Hook event without retaining message text."""
+
+    repo = ensure_repo(repo_path)
+    if not isinstance(payload, dict):
+        raise MaestroError(
+            "CODEX_HOOK_INPUT_INVALID",
+            "Codex Hook input must be a JSON object.",
+        )
+    event_name = payload.get("hook_event_name")
+    if event_name not in _SUPPORTED_EVENTS:
+        raise MaestroError(
+            "CODEX_HOOK_EVENT_UNSUPPORTED",
+            "This adapter accepts only UserPromptSubmit and Stop.",
+        )
+    declared_cwd = Path(
+        _bounded_line(
+            payload.get("cwd"),
+            field="cwd",
+            maximum=4096,
+        )
+    ).expanduser().resolve()
+    try:
+        declared_cwd.relative_to(repo)
+    except ValueError as exc:
+        raise MaestroError(
+            "CODEX_HOOK_REPO_MISMATCH",
+            "Hook cwd must stay inside the configured repository.",
+        ) from exc
+    with _hook_lock(repo):
+        if event_name == "UserPromptSubmit":
+            return _request_submit(repo, payload)
+        return _stop(repo, payload)
+
+
+def run_codex_hook(
+    repo_path: str | Path,
+    raw_input: bytes,
+) -> tuple[int, str, str]:
+    """Return a command-hook exit code and bounded stdout/stderr payloads."""
+
+    if len(raw_input) > _MAX_INPUT_BYTES:
+        return (
+            2,
+            "",
+            "Maestro Codex Hook input exceeded the bounded payload limit.",
+        )
+    try:
+        payload = json.loads(raw_input.decode("utf-8"))
+        output = handle_codex_hook(repo_path, payload)
+        return 0, json.dumps(output, ensure_ascii=False), ""
+    except (UnicodeDecodeError, json.JSONDecodeError):
+        return 2, "", "Maestro Codex Hook received invalid JSON."
+    except MaestroError as exc:
+        return 2, "", f"{exc.code}: {exc.message}"
+    except Exception:
+        return (
+            2,
+            "",
+            "CODEX_HOOK_INTERNAL_ERROR: Maestro could not preserve the request record.",
+        )
+
+
+__all__ = [
+    "CODEX_HOOK_ADAPTER_VERSION",
+    "CODEX_HOOK_STATE_VERSION",
+    "CONTINUATION_PREFIX",
+    "handle_codex_hook",
+    "run_codex_hook",
+]
diff --git a/src/maestro/design_evidence.py b/src/maestro/design_evidence.py
new file mode 100644
index 0000000000000000000000000000000000000000..9651daa42e847b5e5b554343e3e61735be217aa5
--- /dev/null
+++ b/src/maestro/design_evidence.py
@@ -0,0 +1,216 @@
+from __future__ import annotations
+
+import re
+from pathlib import Path, PurePosixPath
+from typing import Any
+
+from .errors import MaestroError
+from .png_evidence import inspect_png_file
+from .util import file_sha256, safe_target
+
+
+_DIGEST_PATTERN = re.compile(r"^[a-f0-9]{64}$")
+
+
+def bounded_line(value: Any, *, maximum: int = 1_000) -> bool:
+    return (
+        isinstance(value, str)
+        and bool(value.strip())
+        and len(value) <= maximum
+        and not any(character in value for character in "\r\n\x00")
+        and "```" not in value
+    )
+
+
+def digest(value: Any) -> bool:
+    return isinstance(value, str) and _DIGEST_PATTERN.fullmatch(value) is not None
+
+
+def relative_path(value: Any) -> bool:
+    if (
+        not isinstance(value, str)
+        or not value
+        or "\\" in value
+        or "\x00" in value
+        or len(value) > 500
+    ):
+        return False
+    path = PurePosixPath(value)
+    return (
+        not path.is_absolute()
+        and path.as_posix() not in {"", "."}
+        and all(part not in {"", ".", ".."} for part in path.parts)
+    )
+
+
+def regular_file(repo: Path, value: Any) -> Path | None:
+    if not relative_path(value):
+        return None
+    assert isinstance(value, str)
+    try:
+        target = safe_target(repo, value)
+    except (MaestroError, OSError):
+        return None
+    if target.is_symlink() or not target.is_file():
+        return None
+    return target
+
+
+def png_dimensions(target: Path) -> tuple[int, int] | None:
+    return inspect_png_file(target, require_visual_content=True)
+
+
+def research_claim_ids(bundle: Any) -> set[str]:
+    if not isinstance(bundle, dict):
+        return set()
+    return {
+        claim["claim_id"]
+        for packet in bundle.get("packets", [])
+        if isinstance(packet, dict)
+        for claim in packet.get("claims", [])
+        if isinstance(claim, dict)
+        and isinstance(claim.get("claim_id"), str)
+    }
+
+
+def constraint_ref_valid(
+    value: Any,
+    *,
+    repo: Path,
+    research_bundle: dict[str, Any] | None,
+) -> bool:
+    if not bounded_line(value):
+        return False
+    assert isinstance(value, str)
+    if value.startswith("research-claim:"):
+        return value.removeprefix("research-claim:") in research_claim_ids(
+            research_bundle
+        )
+    prefix = next(
+        (
+            candidate
+            for candidate in (
+                "project:",
+                "convention:",
+                "owner:",
+                "measurement:",
+            )
+            if value.startswith(candidate)
+        ),
+        None,
+    )
+    if prefix is None:
+        return False
+    suffix = value[len(prefix) :]
+    marker = "#sha256="
+    if marker not in suffix:
+        return False
+    relative, expected_digest = suffix.rsplit(marker, 1)
+    target = regular_file(repo, relative)
+    if (
+        target is None
+        or not digest(expected_digest)
+        or file_sha256(target) != expected_digest
+    ):
+        return False
+    if prefix == "convention:":
+        return relative.startswith("docs/conventions/")
+    if prefix == "owner:":
+        return relative.startswith("docs/decisions/")
+    return True
+
+
+def validate_viewport(
+    value: Any,
+    *,
+    path: str,
+) -> tuple[tuple[int, int] | None, list[dict[str, str]]]:
+    issues: list[dict[str, str]] = []
+    if not isinstance(value, dict) or set(value) != {
+        "width",
+        "height",
+        "device_scale_factor",
+    }:
+        return None, [
+            {
+                "code": "DESIGN_SELECTION_FIELDS_INVALID",
+                "path": path,
+                "message": "Viewport fields are incomplete or unsupported.",
+            }
+        ]
+    if (
+        not isinstance(value["width"], int)
+        or isinstance(value["width"], bool)
+        or not 320 <= value["width"] <= 8_192
+        or not isinstance(value["height"], int)
+        or isinstance(value["height"], bool)
+        or not 240 <= value["height"] <= 16_384
+        or not isinstance(value["device_scale_factor"], (int, float))
+        or isinstance(value["device_scale_factor"], bool)
+        or not 1 <= value["device_scale_factor"] <= 4
+    ):
+        issues.append(
+            {
+                "code": "DESIGN_VIEWPORT_INVALID",
+                "path": path,
+                "message": "Viewport width, height, and device scale factor are outside the bounded comparison contract.",
+            }
+        )
+        return None, issues
+    return (value["width"], value["height"]), issues
+
+
+def validate_png_artifact(
+    repo: Path,
+    *,
+    plan_id: str,
+    path_value: Any,
+    digest_value: Any,
+    expected_prefix: str,
+    viewport: tuple[int, int] | None,
+    path: str,
+) -> list[dict[str, str]]:
+    prefix = f".maestro/state/design-assurance/{plan_id}/{expected_prefix}/"
+    if (
+        not relative_path(path_value)
+        or not isinstance(path_value, str)
+        or not path_value.startswith(prefix)
+        or not path_value.casefold().endswith(".png")
+        or not digest(digest_value)
+    ):
+        return [
+            {
+                "code": "DESIGN_ARTIFACT_REF_INVALID",
+                "path": path,
+                "message": "Design evidence must reference a digest-bound plan-scoped PNG artifact.",
+            }
+        ]
+    target = regular_file(repo, path_value)
+    dimensions = png_dimensions(target) if target is not None else None
+    if (
+        target is None
+        or file_sha256(target) != digest_value
+        or dimensions is None
+        or (viewport is not None and dimensions != viewport)
+    ):
+        return [
+            {
+                "code": "DESIGN_ARTIFACT_MISMATCH",
+                "path": path,
+                "message": "The design evidence artifact is missing, malformed, stale, or has different dimensions.",
+            }
+        ]
+    return []
+
+
+__all__ = [
+    "bounded_line",
+    "constraint_ref_valid",
+    "digest",
+    "png_dimensions",
+    "regular_file",
+    "relative_path",
+    "research_claim_ids",
+    "validate_png_artifact",
+    "validate_viewport",
+]
