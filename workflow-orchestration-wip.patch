+class CodexHostBoundary(HostBoundary):
+    """Production Host boundary backed by an owned Codex App Server process."""
+
+    def __init__(
+        self,
+        repo_path: str | Path,
+        *,
+        command: Sequence[str] | None = None,
+        timeout_seconds: float = 1_800.0,
+    ) -> None:
+        self.repo = ensure_repo(repo_path)
+        self.command = _command(command)
+        self.timeout_seconds = timeout_seconds
+
+    def acquire(
+        self,
+        *,
+        definition: Mapping[str, Any],
+        state: Mapping[str, Any],
+        stage_spec_id: str,
+        attempt_id: str,
+    ) -> HostSession:
+        return self._open_session(
+            definition=definition,
+            state=state,
+            stage_spec_id=stage_spec_id,
+            attempt_id=attempt_id,
+            correction_request=None,
+        )
+
+    def resume(
+        self,
+        *,
+        definition: Mapping[str, Any],
+        state: Mapping[str, Any],
+        stage_spec_id: str,
+        attempt_id: str,
+        correction_request: Mapping[str, Any],
+    ) -> HostSession:
+        return self._open_session(
+            definition=definition,
+            state=state,
+            stage_spec_id=stage_spec_id,
+            attempt_id=attempt_id,
+            correction_request=correction_request,
+        )
+
+    def _open_session(
+        self,
+        *,
+        definition: Mapping[str, Any],
+        state: Mapping[str, Any],
+        stage_spec_id: str,
+        attempt_id: str,
+        correction_request: Mapping[str, Any] | None,
+    ) -> HostSession:
+        stage = stage_specs(definition)[stage_spec_id]
+        role = role_specs(definition)[stage["role_spec_id"]]
+        executor = executor_profiles(definition)[role["executor_profile_id"]]
+        _validate_repository_capability_policy(
+            required_capabilities=role["capability_requirements"],
+            read_only=role["read_only"],
+            executor_permissions=executor["permissions"],
+            executor_tools=executor["tools"],
+            context_policy=executor["context_policy"],
+        )
+        runtime_binding = _codex_runtime_binding(self.command[0])
+        mutation = stage["side_effect"] == "repository_mutation"
+        allowed_paths = definition["authorization"]["writer_allowed_paths"]
+        writable_roots = sorted(
+            {
+                str((self.repo / path).resolve().parent)
+                for path in allowed_paths
+            }
+        )
+        runtime_workspace_roots = (
+            writable_roots if mutation else [str(self.repo)]
+        )
+        runtime_roots_supported = (
+            runtime_binding.get("runtime_workspace_roots") is True
+        )
+        if mutation and not _supports_scoped_enactment(runtime_binding):
+            raise MaestroError(
+                "CODEX_HOST_SCOPED_SANDBOX_UNAVAILABLE",
+                "Mutation dispatch requires exact runtime roots, interrupt, background cleanup, and process quiescence.",
+            )
+        if (
+            not mutation
+            and runtime_binding.get("background_terminal_control") is not True
+        ):
+            raise MaestroError(
+                "CODEX_HOST_SCOPED_SANDBOX_UNAVAILABLE",
+                "Read-only dispatch requires background-terminal cleanup before zero-effect evidence.",
+            )
+        sandbox = "workspace-write" if mutation else "read-only"
+        sandbox_policy: dict[str, Any] = (
+            {
+                "type": "workspaceWrite",
+                "writableRoots": writable_roots,
+                "networkAccess": False,
+                "excludeSlashTmp": True,
+                "excludeTmpdirEnvVar": True,
+            }
+            if mutation
+            else {"type": "readOnly", "networkAccess": False}
+        )
+        capability_timeout = min(
+            self.timeout_seconds,
+            float(
+                definition["runtime_limits"][
+                    "capability_acquisition_deadline_seconds"
+                ]
+            ),
+        )
+        deadline = time.monotonic() + capability_timeout
+        server = _AppServer(self.command, cwd=self.repo, deadline=deadline)
+        try:
+            capabilities: dict[str, Any] = {
+                "optOutNotificationMethods": [
+                    "item/agentMessage/delta",
+                    "item/plan/delta",
+                    "item/reasoning/summaryTextDelta",
+                    "item/reasoning/summaryPartAdded",
+                    "item/reasoning/textDelta",
+                    "item/commandExecution/outputDelta",
+                    "item/fileChange/outputDelta",
+                ]
+            }
+            if runtime_binding.get("experimental_api") is True:
+                capabilities["experimentalApi"] = True
+            server.send(
+                {
+                    "jsonrpc": "2.0",
+                    "id": 1,
+                    "method": "initialize",
+                    "params": {
+                        "clientInfo": {
+                            "name": "harness-maestro-orchestration",
+                            "title": "Harness Maestro Orchestration",
+                            "version": "1",
+                        },
+                        "capabilities": capabilities,
+                    },
+                }
+            )
+            server.response(1)
+            server.send({"jsonrpc": "2.0", "method": "initialized"})
+            thread_params: dict[str, Any]
+            method: str
+            if correction_request is None:
+                method = "thread/start"
+                thread_params = {
+                    "cwd": str(self.repo),
+                    "approvalPolicy": "never",
+                    "sandbox": sandbox,
+                    "ephemeral": True,
+                    "serviceName": "harness-maestro-orchestration",
+                }
+                if runtime_roots_supported:
+                    thread_params[
+                        "runtimeWorkspaceRoots"
+                    ] = runtime_workspace_roots
+                if executor["requested_model"] is not None:
+                    thread_params["model"] = executor["requested_model"]
+            else:
+                expected = {
+                    "root_request_id": state["root_request_id"],
+                    "root_execution_id": state["root_execution_id"],
+                    "workflow_instance_id": state["workflow_instance_id"],
+                    "target_role_spec_id": stage["role_spec_id"],
+                }
+                if any(
+                    correction_request.get(field) != value
+                    for field, value in expected.items()
+                ):
+                    raise MaestroError(
+                        "ORCH_CORRECTION_CONTEXT_MISMATCH",
+                        "Correction resume does not bind the exact root, workflow, and RoleSpec.",
+                    )
+                context = correction_request.get(
+                    "resumable_context_identity"
+                )
+                target_context = correction_request.get(
+                    "target_context_instance_id"
+                )
+                if (
+                    not isinstance(context, str)
+                    or context != target_context
+                    or not context.startswith("codex-thread-")
+                ):
+                    raise MaestroError(
+                        "ORIGINAL_PRODUCER_CONTEXT_UNAVAILABLE",
+                        "The original producer context is not a resumable Codex thread.",
+                    )
+                method = "thread/resume"
+                thread_params = {
+                    "threadId": context.removeprefix("codex-thread-"),
+                    "cwd": str(self.repo),
+                    "approvalPolicy": "never",
+                    "sandbox": sandbox,
+                    "serviceName": "harness-maestro-orchestration",
+                }
+                if runtime_roots_supported:
+                    thread_params[
+                        "runtimeWorkspaceRoots"
+                    ] = runtime_workspace_roots
+            server.send(
+                {
+                    "jsonrpc": "2.0",
+                    "id": 2,
+                    "method": method,
+                    "params": thread_params,
+                }
+            )
+            thread_result = server.response(2)
+            thread = thread_result.get("thread")
+            if (
+                not isinstance(thread, dict)
+                or not isinstance(thread.get("id"), str)
+                or not thread["id"]
+            ):
