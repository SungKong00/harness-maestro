+def validate_design_falsification(
+    value: Any,
+    comparison: dict[str, Any],
+    plan: dict[str, Any],
+    *,
+    repo_path: str | Path,
+    research_bundle: dict[str, Any] | None,
+) -> dict[str, Any]:
+    repo = ensure_repo(repo_path)
+    issues: list[dict[str, str]] = []
+    fields = {
+        "schema_version",
+        "falsification_id",
+        "plan_id",
+        "goal_digest",
+        "comparison_id",
+        "proposal_assignment_id",
+        "proposal_packet_digest",
+        "proposal_projection_digest",
+        "reviewer_assignment_id",
+        "reviewer_projection_digest",
+        "reviewed_alternative_ids",
+        "reviewed_render_digests",
+        "reviewed_criteria",
+        "alternative_reviews",
+        "challenges",
+        "minority_risks",
+        "verdict",
+        "writes_performed",
+    }
+    if not _exact(value, fields, "$", issues):
+        return _validation("falsification", value, issues)
+    assert isinstance(value, dict)
+    if value["schema_version"] != DESIGN_FALSIFICATION_VERSION:
+        issues.append(
+            _issue(
+                "DESIGN_FALSIFICATION_VERSION_INVALID",
+                "schema_version",
+                f"Expected {DESIGN_FALSIFICATION_VERSION}.",
+            )
+        )
+    if (
+        value["plan_id"] != plan.get("plan_id")
+        or value["goal_digest"] != sha256_text(plan.get("goal", ""))
+        or value["comparison_id"] != comparison.get("comparison_id")
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_FALSIFICATION_BINDING_MISMATCH",
+                "comparison_id",
+                "Falsification must bind the exact route, goal, and comparison.",
+            )
+        )
+    if (
+        not _digest(value["falsification_id"])
+        or value["falsification_id"]
+        != _identity(value, "falsification_id")
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_FALSIFICATION_ID_MISMATCH",
+                "falsification_id",
+                "falsification_id must digest the complete review.",
+            )
+        )
+    if value["writes_performed"] is not False:
+        issues.append(
+            _issue(
+                "DESIGN_FALSIFICATION_WRITE_FORBIDDEN",
+                "writes_performed",
+                "Falsification is read-only.",
+            )
+        )
+    comparison_result = validate_design_comparison(
+        comparison,
+        plan,
+        repo_path=repo,
+        research_bundle=research_bundle,
+    )
+    issues.extend(comparison_result["issues"])
+    proposal_id = value["proposal_assignment_id"]
+    reviewer_id = value["reviewer_assignment_id"]
+    proposal = _plan_assignment(plan, proposal_id)
+    reviewer = _plan_assignment(plan, reviewer_id)
+    writer = _plan_assignment(
+        plan, plan.get("mutation_owner_assignment_id")
+    )
+    if (
+        proposal_id != comparison.get("proposal_assignment_id")
+        or value["proposal_projection_digest"]
+        != comparison.get("proposal_projection_digest")
+        or not _digest(value["proposal_packet_digest"])
+        or proposal_id == reviewer_id
+        or proposal is None
+        or reviewer is None
+        or reviewer_id != "design-falsification"
+        or reviewer.get("kind") != "review"
+        or reviewer.get("read_only") is not True
+        or reviewer.get("allowed_side_effects") != []
+        or reviewer.get("depends_on") != [proposal_id]
+        or writer is None
+        or reviewer_id not in writer.get("depends_on", [])
+        or not _digest(value["reviewer_projection_digest"])
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_FALSIFICATION_REVIEWER_INVALID",
+                "reviewer_assignment_id",
+                "A distinct read-only managed reviewer must depend on the proposal and precede the writer.",
+            )
+        )
+    alternatives = {
+        item["alternative_id"]: item
+        for item in comparison.get("alternatives", [])
+        if isinstance(item, dict)
+        and isinstance(item.get("alternative_id"), str)
+    }
+    render_digests = sorted(
+        render["artifact_sha256"]
+        for alternative in alternatives.values()
+        for render in alternative.get("renders", [])
+        if isinstance(render, dict)
+        and isinstance(render.get("artifact_sha256"), str)
+    )
+    criteria = comparison.get("direction_frame", {}).get(
+        "decision_criteria", []
+    )
+    evidence_refs = {
+        *comparison.get("constraint_refs", []),
+        *{
+            f"research-claim:{claim_id}"
+            for claim_id in _research_claim_ids(research_bundle)
+        },
+        *{
+            f"design-reference:{reference_id}"
+            for reference_id in {
+                item.get("reference_id")
+                for item in comparison.get("reference_observations", [])
+                if isinstance(item, dict)
+                and isinstance(item.get("reference_id"), str)
+            }
+        },
+        *{
+            f"design-render:{render.get('render_id')}"
+            for alternative in comparison.get("alternatives", [])
+            if isinstance(alternative, dict)
+            for render in alternative.get("renders", [])
+            if isinstance(render, dict)
+            and isinstance(render.get("render_id"), str)
+        },
+    }
+    if (
+        value["reviewed_alternative_ids"] != sorted(alternatives)
+        or value["reviewed_render_digests"] != render_digests
+        or value["reviewed_criteria"] != criteria
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_FALSIFICATION_COVERAGE_MISMATCH",
+                "reviewed_alternative_ids",
+                "The reviewer must cover every exact alternative, render digest, and decision criterion.",
+            )
+        )
+    review_fields = {
+        "alternative_id",
+        "strongest_countercase",
+        "failure_conditions",
+        "counterevidence_refs",
+        "outcome",
+    }
+    reviews = value["alternative_reviews"]
+    if (
+        not isinstance(reviews, list)
+        or len(reviews) != len(alternatives)
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_FALSIFICATION_REVIEWS_INVALID",
+                "alternative_reviews",
+                "Every compared alternative requires one falsification review.",
+            )
+        )
+        reviews = []
+    reviewed: set[str] = set()
+    outcomes: list[str] = []
+    for index, review in enumerate(reviews):
+        path = f"alternative_reviews[{index}]"
+        if not _exact(review, review_fields, path, issues):
+            continue
+        alternative_id = review["alternative_id"]
+        if alternative_id not in alternatives or alternative_id in reviewed:
+            issues.append(
+                _issue(
+                    "DESIGN_FALSIFICATION_ALTERNATIVE_INVALID",
+                    f"{path}.alternative_id",
+                    "Falsification reviews must cover each exact alternative once.",
+                )
+            )
+        else:
+            reviewed.add(alternative_id)
+        if (
+            not _line(review["strongest_countercase"])
+            or not _unique_lines(
+                review["failure_conditions"],
+                maximum=12,
+                nonempty=True,
+            )
+            or not _unique_lines(
+                review["counterevidence_refs"],
+                maximum=16,
+                nonempty=True,
+            )
+            or any(
+                item not in evidence_refs
+                for item in review["counterevidence_refs"]
+            )
+            or review["outcome"] not in FALSIFICATION_OUTCOMES
+        ):
+            issues.append(
+                _issue(
+                    "DESIGN_FALSIFICATION_REVIEW_INVALID",
+                    path,
+                    "Review must start from the strongest countercase, observable failure conditions, counterevidence, and a closed outcome.",
+                )
+            )
+        else:
+            outcomes.append(review["outcome"])
+    challenge_fields = {
+        "challenge_id",
+        "affected_alternative_ids",
+        "evidence_refs",
+        "materiality",
+        "statement",
+        "disposition",
+        "resolution",
+        "resolution_refs",
+    }
+    challenges = value["challenges"]
+    if not isinstance(challenges, list) or len(challenges) > 32:
+        issues.append(
+            _issue(
+                "DESIGN_CHALLENGE_SET_INVALID",
+                "challenges",
+                "Challenges must be a bounded list.",
+            )
+        )
+        challenges = []
+    challenge_ids: set[str] = set()
+    blocking_challenge = False
+    for index, challenge in enumerate(challenges):
+        path = f"challenges[{index}]"
+        if not _exact(challenge, challenge_fields, path, issues):
+            continue
+        challenge_id = challenge["challenge_id"]
+        if not _id(challenge_id) or challenge_id in challenge_ids:
+            issues.append(
+                _issue(
+                    "DESIGN_CHALLENGE_ID_INVALID",
+                    f"{path}.challenge_id",
+                    "Challenge IDs must be unique kebab-case values.",
+                )
+            )
+        else:
+            challenge_ids.add(challenge_id)
+        disposition = challenge["disposition"]
+        if (
+            not _unique_lines(
+                challenge["affected_alternative_ids"],
+                maximum=4,
+                nonempty=True,
+            )
+            or any(
+                item not in alternatives
+                for item in challenge["affected_alternative_ids"]
+            )
+            or not _unique_lines(
+                challenge["evidence_refs"],
+                maximum=16,
+                nonempty=True,
+            )
+            or any(
+                item not in evidence_refs
+                for item in challenge["evidence_refs"]
+            )
+            or challenge["materiality"] not in {"minor", "material"}
+            or not _line(challenge["statement"])
+            or disposition not in CHALLENGE_DISPOSITIONS
+            or not _line(challenge["resolution"])
+            or not _unique_lines(
+                challenge["resolution_refs"],
+                maximum=16,
+                nonempty=disposition
+                in {"resolved", "withdrawn-with-evidence"},
+            )
+            or any(
+                item not in evidence_refs
+                for item in challenge["resolution_refs"]
+            )
+        ):
+            issues.append(
+                _issue(
+                    "DESIGN_CHALLENGE_INVALID",
+                    path,
+                    "Challenges require affected alternatives, materiality, disposition, resolution, and evidence when withdrawn or resolved.",
+                )
+            )
+        if (
+            challenge.get("materiality") == "material"
+            and disposition
+            in {"unresolved", "upheld", "inconclusive"}
+        ):
+            blocking_challenge = True
+    if not _unique_lines(value["minority_risks"], maximum=16):
+        issues.append(
+            _issue(
+                "DESIGN_MINORITY_RISKS_INVALID",
+                "minority_risks",
+                "Minority risks must be preserved as a bounded list without voting.",
+            )
+        )
+    expected_verdict = (
+        "block"
+        if blocking_challenge or "rejected" in outcomes
+        else "revise"
+        if "revised" in outcomes
+        else "pass"
+    )
+    if (
+        value["verdict"] not in FALSIFICATION_VERDICTS
+        or value["verdict"] != expected_verdict
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_FALSIFICATION_VERDICT_INVALID",
+                "verdict",
+                f"Falsification verdict must be {expected_verdict} for the recorded outcomes and challenges.",
+            )
+        )
+    return _validation(
+        "falsification",
+        value,
+        issues,
+        metadata={
+            "verdict": value.get("verdict"),
+            "reviewer_assignment_id": reviewer_id,
+        },
+    )
+
+
+def validate_design_selection(
+    value: Any,
+    comparison: dict[str, Any],
+    falsification: dict[str, Any],
+    plan: dict[str, Any],
+    *,
+    repo_path: str | Path,
+    research_bundle: dict[str, Any] | None,
+) -> dict[str, Any]:
+    repo = ensure_repo(repo_path)
+    issues: list[dict[str, str]] = []
+    fields = {
+        "schema_version",
+        "selection_id",
+        "plan_id",
+        "goal_digest",
+        "comparison_id",
+        "falsification_id",
+        "proposal_packet_digest",
+        "proposal_projection_digest",
+        "reviewer_packet_digest",
+        "reviewer_projection_digest",
+        "authority",
+        "selected_alternative_id",
+        "compared_alternative_ids",
+        "compared_render_digests",
+        "selection_refs",
+        "owner_receipt_id",
+        "writes_performed",
+    }
+    if not _exact(value, fields, "$", issues):
+        return _validation("selection", value, issues)
+    assert isinstance(value, dict)
+    if value["schema_version"] != DESIGN_SELECTION_VERSION:
+        issues.append(
+            _issue(
+                "DESIGN_SELECTION_VERSION_INVALID",
+                "schema_version",
+                f"Expected {DESIGN_SELECTION_VERSION}.",
+            )
+        )
+    if (
+        value["plan_id"] != plan.get("plan_id")
+        or value["goal_digest"] != sha256_text(plan.get("goal", ""))
+        or value["comparison_id"] != comparison.get("comparison_id")
+        or value["falsification_id"]
+        != falsification.get("falsification_id")
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_SELECTION_BINDING_MISMATCH",
+                "comparison_id",
+                "Selection must bind the exact route, comparison, and falsification.",
+            )
+        )
+    if (
+        not _digest(value["selection_id"])
+        or value["selection_id"] != _identity(value, "selection_id")
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_SELECTION_ID_MISMATCH",
+                "selection_id",
+                "selection_id must digest the complete selection.",
+            )
+        )
+    if value["writes_performed"] is not False:
+        issues.append(
+            _issue(
+                "DESIGN_SELECTION_WRITE_FORBIDDEN",
+                "writes_performed",
+                "Selection precedes product mutation.",
+            )
+        )
+    comparison_result = validate_design_comparison(
+        comparison,
+        plan,
+        repo_path=repo,
+        research_bundle=research_bundle,
+    )
+    falsification_result = validate_design_falsification(
+        falsification,
+        comparison,
+        plan,
+        repo_path=repo,
+        research_bundle=research_bundle,
+    )
+    issues.extend(comparison_result["issues"])
+    issues.extend(falsification_result["issues"])
+    if (
+        not all(
+            _digest(value[field])
+            for field in (
+                "proposal_packet_digest",
+                "proposal_projection_digest",
+                "reviewer_packet_digest",
+                "reviewer_projection_digest",
+            )
+        )
+        or value["proposal_packet_digest"]
+        != falsification.get("proposal_packet_digest")
+        or value["proposal_projection_digest"]
+        != comparison.get("proposal_projection_digest")
+        or value["proposal_projection_digest"]
+        != falsification.get("proposal_projection_digest")
+        or value["reviewer_projection_digest"]
+        != falsification.get("reviewer_projection_digest")
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_SELECTION_DEPENDENCY_BINDING_INVALID",
+                "proposal_packet_digest",
+                "Selection must bind both exact managed proposal and falsification Packet/projection pairs.",
+            )
+        )
+    alternatives = {
+        item["alternative_id"]: item
+        for item in comparison.get("alternatives", [])
+        if isinstance(item, dict)
+        and isinstance(item.get("alternative_id"), str)
+    }
+    render_digests = sorted(
+        render["artifact_sha256"]
+        for alternative in alternatives.values()
+        for render in alternative.get("renders", [])
+        if isinstance(render, dict)
+        and isinstance(render.get("artifact_sha256"), str)
+    )
+    if (
+        falsification.get("verdict") != "pass"
+        or value["authority"] not in SELECTION_AUTHORITIES
+        or value["selected_alternative_id"] not in alternatives
+        or value["compared_alternative_ids"] != sorted(alternatives)
+        or value["compared_render_digests"] != render_digests
+        or not _unique_lines(
+            value["selection_refs"], maximum=16, nonempty=True
+        )
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_SELECTION_NOT_READY",
+                "$",
+                "Selection requires a passing falsification and the exact compared alternative and render set.",
+            )
+        )
+    authority = value["authority"]
+    receipt_id = value["owner_receipt_id"]
+    if authority == "evidence":
+        if receipt_id is not None:
+            issues.append(
+                _issue(
+                    "DESIGN_OWNER_RECEIPT_UNEXPECTED",
+                    "owner_receipt_id",
+                    "Evidence-dominant selection does not accept an owner receipt.",
+                )
+            )
+    elif authority == "owner":
+        if not _digest(receipt_id):
+            issues.append(
+                _issue(
+                    "DESIGN_OWNER_RECEIPT_REQUIRED",
+                    "owner_receipt_id",
+                    "Owner selection requires a Host-derived receipt ID.",
+                )
+            )
+        else:
+            try:
+                receipt = load_owner_selection_receipt(
+                    repo,
+                    plan_id=value["plan_id"],
+                    receipt_id=receipt_id,
+                )
+            except MaestroError as exc:
+                issues.append(
+                    _issue(
+                        exc.code,
+                        "owner_receipt_id",
+                        exc.message,
+                    )
+                )
+            else:
+                if (
+                    value["selection_refs"]
+                    != [f"owner-selection:{receipt_id}"]
+                    or receipt["comparison_id"]
+                    != value["comparison_id"]
+                    or receipt["falsification_id"]
+                    != value["falsification_id"]
+                    or receipt["selected_alternative_id"]
+                    != value["selected_alternative_id"]
+                    or receipt["compared_alternative_ids"]
+                    != value["compared_alternative_ids"]
+                    or receipt["compared_render_digests"]
+                    != value["compared_render_digests"]
+                    or receipt["goal_digest"] != value["goal_digest"]
+                    or receipt["project_id"]
+                    != _project_id(repo)
+                    or receipt["checkout_id"] != checkout_id(repo)
+                    or receipt["evidence_coverage"]
+                    != "assistant_output_and_user_submit_observed"
+                ):
+                    issues.append(
+                        _issue(
+                            "DESIGN_OWNER_RECEIPT_MISMATCH",
+                            "owner_receipt_id",
+                            "The Host receipt does not bind the exact displayed comparison and selected alternative.",
+                        )
+                    )
+    return _validation("selection", value, issues)
+
+
+def _validation(
+    artifact: str,
+    value: Any,
+    issues: list[dict[str, str]],
+    *,
+    metadata: dict[str, Any] | None = None,
+) -> dict[str, Any]:
+    result = {
+        "schema_version": "maestro_design_selection_validation_v1",
+        "artifact": artifact,
+        "status": "PASS" if not issues else "FAIL",
+        "execution_status": "READY" if not issues else "INVALID",
+        "issues": sorted(
+            issues,
+            key=lambda item: (
+                item["code"],
+                item["path"],
+                item["message"],
+            ),
+        ),
+        "writes_performed": False,
+    }
+    if metadata is not None:
+        result["metadata"] = metadata
+    if isinstance(value, dict):
+        result[f"{artifact}_id"] = value.get(f"{artifact}_id")
+    return result
+
+
+def _projection_input(value: Any) -> dict[str, Any] | None:
+    if (
+        isinstance(value, dict)
+        and isinstance(value.get("input"), dict)
+    ):
+        value = value["input"]
+    return value if isinstance(value, dict) else None
+
+
+def _projection_bound(
+    value: Any,
+    *,
+    plan_id: Any,
+    assignment_id: Any,
+) -> bool:
+    projected = _projection_input(value)
+    if (
+        projected is None
+        or projected.get("schema_version") != ASSIGNMENT_INPUT_VERSION
+        or projected.get("plan_id") != plan_id
+        or projected.get("assignment_id") != assignment_id
+        or not isinstance(projected.get("projection_digest"), str)
+    ):
+        return False
+    payload = copy.deepcopy(projected)
+    digest = payload.pop("projection_digest")
+    try:
+        return digest == sha256_text(canonical_json(payload))
+    except (TypeError, ValueError, OverflowError):
+        return False
+
+
+def _comparison_artifact_paths(
+    comparison: dict[str, Any],
+) -> list[str]:
+    return sorted(
+        {
+            *{
+                item["artifact_path"]
+                for item in comparison.get("reference_observations", [])
+                if isinstance(item, dict)
+                and isinstance(item.get("artifact_path"), str)
+            },
+            *{
+                render[field]
+                for alternative in comparison.get("alternatives", [])
+                if isinstance(alternative, dict)
+                for render in alternative.get("renders", [])
+                if isinstance(render, dict)
+                for field in ("artifact_path", "content_fixture_path")
+                if isinstance(render.get(field), str)
+            },
+        }
+    )
+
+
+def validate_design_proposal_packet(
+    packet: Any,
+    plan: dict[str, Any],
+    projection: Any,
+    *,
+    repo_path: str | Path,
+    research_bundle: dict[str, Any] | None,
+) -> dict[str, Any]:
+    issues: list[dict[str, str]] = []
+    fields = {
+        "schema_version",
+        "plan_id",
+        "assignment_id",
+        "projection_digest",
+        "comparison",
+        "evidence_artifact_paths",
+        "product_writes_performed",
+    }
+    if isinstance(packet, dict) and "expertise_dispositions" in packet:
+        fields.add("expertise_dispositions")
+    if not _exact(packet, fields, "$", issues):
+        return _validation("proposal_packet", packet, issues)
+    assert isinstance(packet, dict)
+    projected = _projection_input(projection)
+    assignment = _plan_assignment(plan, "design-proposal")
+    if packet["schema_version"] != DESIGN_PROPOSAL_PACKET_VERSION:
+        issues.append(
+            _issue(
+                "DESIGN_PROPOSAL_PACKET_VERSION_INVALID",
+                "schema_version",
+                f"Expected {DESIGN_PROPOSAL_PACKET_VERSION}.",
+            )
+        )
+    if (
+        packet["plan_id"] != plan.get("plan_id")
+        or packet["assignment_id"] != "design-proposal"
+        or assignment is None
+        or assignment.get("output_packet") != "DesignProposalPacket"
+        or not isinstance(projected, dict)
+        or not _projection_bound(
+            projection,
+            plan_id=plan.get("plan_id"),
+            assignment_id="design-proposal",
+        )
+        or packet["projection_digest"]
+        != projected.get("projection_digest")
+        or packet.get("comparison", {}).get(
+            "proposal_projection_digest"
+        )
+        != packet["projection_digest"]
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_PROPOSAL_PACKET_BINDING_INVALID",
+                "projection_digest",
+                "The proposal Packet must bind its exact managed Assignment projection.",
+            )
+        )
+    if packet["product_writes_performed"] is not False:
+        issues.append(
+            _issue(
+                "DESIGN_PROPOSAL_PRODUCT_WRITE_FORBIDDEN",
+                "product_writes_performed",
+                "The proposal may write only plan-scoped evidence, never product source.",
+            )
+        )
+    comparison = packet["comparison"]
+    comparison_result = validate_design_comparison(
+        comparison,
+        plan,
+        repo_path=repo_path,
+        research_bundle=research_bundle,
+    )
+    issues.extend(comparison_result["issues"])
+    expected_paths = (
+        _comparison_artifact_paths(comparison)
+        if isinstance(comparison, dict)
+        else []
+    )
+    if (
+        not _unique_lines(
+            packet["evidence_artifact_paths"],
+            maximum=64,
+            nonempty=True,
+        )
+        or packet["evidence_artifact_paths"] != expected_paths
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_PROPOSAL_ARTIFACT_SET_INVALID",
+                "evidence_artifact_paths",
+                "The proposal Packet must enumerate the exact reference, fixture, and render artifacts it produced.",
+            )
+        )
+    return _validation("proposal_packet", packet, issues)
+
+
+def validate_design_falsification_packet(
+    packet: Any,
+    plan: dict[str, Any],
+    projection: Any,
+    *,
+    repo_path: str | Path,
+    research_bundle: dict[str, Any] | None,
+) -> dict[str, Any]:
+    issues: list[dict[str, str]] = []
+    fields = {
+        "schema_version",
+        "plan_id",
+        "assignment_id",
+        "projection_digest",
+        "proposal_packet_digest",
+        "falsification",
+        "product_writes_performed",
+    }
+    if isinstance(packet, dict) and "expertise_dispositions" in packet:
+        fields.add("expertise_dispositions")
+    if not _exact(packet, fields, "$", issues):
+        return _validation("falsification_packet", packet, issues)
+    assert isinstance(packet, dict)
+    projected = _projection_input(projection)
+    assignment = _plan_assignment(plan, "design-falsification")
+    if packet["schema_version"] != DESIGN_FALSIFICATION_PACKET_VERSION:
+        issues.append(
+            _issue(
+                "DESIGN_FALSIFICATION_PACKET_VERSION_INVALID",
+                "schema_version",
+                f"Expected {DESIGN_FALSIFICATION_PACKET_VERSION}.",
+            )
+        )
+    if (
+        packet["plan_id"] != plan.get("plan_id")
+        or packet["assignment_id"] != "design-falsification"
+        or assignment is None
+        or assignment.get("output_packet")
+        != "DesignFalsificationPacket"
+        or not isinstance(projected, dict)
+        or not _projection_bound(
+            projection,
+            plan_id=plan.get("plan_id"),
+            assignment_id="design-falsification",
+        )
+        or packet["projection_digest"]
+        != projected.get("projection_digest")
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_FALSIFICATION_PACKET_BINDING_INVALID",
+                "projection_digest",
+                "The falsification Packet must bind its exact managed Assignment projection.",
+            )
+        )
+    dependencies = (
+        projected.get("dependency_packets", [])
+        if isinstance(projected, dict)
+        else []
+    )
+    proposal_entry = next(
+        (
+            item
+            for item in dependencies
+            if isinstance(item, dict)
+            and item.get("assignment_id") == "design-proposal"
+        ),
+        None,
+    )
+    proposal_packet = (
+        proposal_entry.get("packet")
+        if isinstance(proposal_entry, dict)
+        and isinstance(proposal_entry.get("packet"), dict)
+        else None
+    )
+    proposal_digest = (
+        sha256_text(canonical_json(proposal_packet))
+        if isinstance(proposal_packet, dict)
+        else None
+    )
+    comparison = (
+        proposal_packet.get("comparison")
+        if isinstance(proposal_packet, dict)
+        and isinstance(proposal_packet.get("comparison"), dict)
+        else None
+    )
+    proposal_fields = {
+        "schema_version",
+        "plan_id",
+        "assignment_id",
+        "projection_digest",
+        "comparison",
+        "evidence_artifact_paths",
+        "product_writes_performed",
+    }
+    if (
+        isinstance(proposal_packet, dict)
+        and "expertise_dispositions" in proposal_packet
+    ):
+        proposal_fields.add("expertise_dispositions")
+    proposal_envelope_valid = (
+        isinstance(proposal_packet, dict)
+        and set(proposal_packet) == proposal_fields
+        and proposal_packet.get("schema_version")
+        == DESIGN_PROPOSAL_PACKET_VERSION
+        and proposal_packet.get("plan_id") == plan.get("plan_id")
+        and proposal_packet.get("assignment_id") == "design-proposal"
+        and proposal_packet.get("projection_digest")
+        == (
+            proposal_entry.get("projection_digest")
+            if isinstance(proposal_entry, dict)
+            else None
+        )
+        and proposal_packet.get("product_writes_performed") is False
+        and isinstance(comparison, dict)
+        and proposal_packet.get("evidence_artifact_paths")
+        == _comparison_artifact_paths(comparison)
+    )
+    if (
+        not isinstance(proposal_entry, dict)
+        or not proposal_envelope_valid
+        or proposal_entry.get("packet_digest") != proposal_digest
+        or proposal_entry.get("projection_digest")
+        != (
+            proposal_packet.get("projection_digest")
+            if isinstance(proposal_packet, dict)
+            else None
+        )
+        or packet["proposal_packet_digest"] != proposal_digest
+        or not isinstance(comparison, dict)
+    ):
+        issues.append(
+            _issue(
+                "DESIGN_FALSIFICATION_PROPOSAL_INVALID",
+                "proposal_packet_digest",
+                "Falsification must consume the exact validated proposal Packet from its projection.",
+            )
+        )
+    if packet["product_writes_performed"] is not False:
+        issues.append(
+            _issue(
+                "DESIGN_FALSIFICATION_PRODUCT_WRITE_FORBIDDEN",
+                "product_writes_performed",
+                "Independent falsification is read-only.",
+            )
+        )
+    if isinstance(comparison, dict):
+        falsification = packet["falsification"]
+        result = validate_design_falsification(
+            falsification,
+            comparison,
+            plan,
+            repo_path=repo_path,
+            research_bundle=research_bundle,
+        )
+        issues.extend(result["issues"])
+        if (
+            not isinstance(falsification, dict)
+            or falsification.get("proposal_packet_digest")
+            != packet["proposal_packet_digest"]
+            or falsification.get("reviewer_projection_digest")
+            != packet["projection_digest"]
+        ):
+            issues.append(
+                _issue(
+                    "DESIGN_FALSIFICATION_PACKET_CONTENT_MISMATCH",
+                    "falsification",
+                    "The reviewer-owned falsification must bind the proposal Packet and its own projection.",
+                )
+            )
+    return _validation("falsification_packet", packet, issues)
+
+
+def build_design_proposal_packet(
+    comparison: dict[str, Any],
+    plan: dict[str, Any],
+    projection: Any,
+    *,
+    repo_path: str | Path,
+    research_bundle: dict[str, Any],
+) -> dict[str, Any]:
+    projected = _projection_input(projection)
+    if not isinstance(projected, dict):
+        raise MaestroError(
+            "DESIGN_PROPOSAL_PACKET_BINDING_INVALID",
+            "Proposal Packet requires the exact Assignment projection.",
+        )
+    packet = {
+        "schema_version": DESIGN_PROPOSAL_PACKET_VERSION,
+        "plan_id": plan["plan_id"],
+        "assignment_id": "design-proposal",
+        "projection_digest": projected["projection_digest"],
+        "comparison": copy.deepcopy(comparison),
+        "evidence_artifact_paths": _comparison_artifact_paths(
+            comparison
+        ),
+        "product_writes_performed": False,
+    }
+    validation = validate_design_proposal_packet(
+        packet,
+        plan,
+        projection,
+        repo_path=repo_path,
+        research_bundle=research_bundle,
+    )
+    if validation["status"] != "PASS":
+        first = validation["issues"][0]
+        raise MaestroError(first["code"], first["message"])
+    return packet
+
