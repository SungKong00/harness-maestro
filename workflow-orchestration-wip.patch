+def validate_workflow_definition(value: Any) -> dict[str, Any]:
+    keys = frozenset(value) if isinstance(value, dict) else frozenset()
+    if not isinstance(value, dict) or keys not in {
+        frozenset(_LEGACY_DEFINITION_FIELDS),
+        frozenset(_DEFINITION_FIELDS),
+    }:
+        actual = sorted(value) if isinstance(value, dict) else type(value).__name__
+        _fail(
+            "ORCH_CONTRACT_INVALID",
+            "WorkflowDefinition must match the closed legacy or v2 evidence "
+            f"contract; got {actual}.",
+        )
+    definition = value
+    if definition["schema_version"] != DEFINITION_VERSION:
+        _fail("ORCH_DEFINITION_INVALID", "Unsupported Workflow Definition contract.")
+    profile = evidence_profile(definition)
+    if profile not in EVIDENCE_PROFILES:
+        _fail(
+            "ORCH_EVIDENCE_PROFILE_INVALID",
+            "The Host evidence profile is unsupported.",
+        )
+    _identity(definition["definition_id"], field="definition_id")
+    if (
+        not isinstance(definition["definition_revision"], int)
+        or isinstance(definition["definition_revision"], bool)
+        or definition["definition_revision"] < 1
+        or definition["definition_revision"] > 4
+    ):
+        _fail(
+            "ORCH_PLAN_REVISION_REQUIRED",
+            "definition_revision must be between one and four.",
+        )
+    if definition["runtime_authority"] != RUNTIME_AUTHORITY:
+        _fail(
+            "ORCH_RUNTIME_AUTHORITY_CONFLICT",
+            f"New managed definitions require runtime_authority={RUNTIME_AUTHORITY}.",
+        )
+    if definition["risk_level"] not in RISK_LEVELS:
+        _fail("ORCH_DEFINITION_INVALID", "risk_level is invalid.")
+    if definition["outcome_judge_mode"] not in OUTCOME_JUDGE_MODES:
+        _fail(
+            "ORCH_OUTCOME_AUTOMATIC_FORBIDDEN",
+            "Outcome Judge mode must be off, shadow, or manual; automatic is unavailable.",
+        )
+    direct = _closed(
+        definition["direct_path"],
+        _DIRECT_PATH_FIELDS,
+        label="direct_path",
+    )
+    if not isinstance(direct["allowed"], bool) or not isinstance(
+        direct["independence_claimed"], bool
+    ):
+        _fail("ORCH_DIRECT_PATH_FORBIDDEN", "direct_path fields must be boolean.")
+    if direct["allowed"] and direct["independence_claimed"]:
+        _fail(
+            "ORCH_DIRECT_PATH_FORBIDDEN",
+            "A single-context direct path cannot claim independence.",
+        )
+    _validate_runtime_limits(definition["runtime_limits"])
+    _validate_authorization(definition["authorization"])
+    executor_ids = _validate_executor_profiles(definition["executor_profiles"])
+    lens_ids = _validate_lens_bindings(definition["lens_bindings"])
+    pack_hint_ids = _validate_pack_hints(definition["pack_hints"])
+    _validate_responsibility_plan(
+        definition["responsibility_plan"],
+        executor_ids=executor_ids,
+        lens_ids=lens_ids,
+        pack_hint_ids=pack_hint_ids,
+        risk_level=definition["risk_level"],
+        evidence_profile_name=profile,
+        direct_path_allowed=direct["allowed"],
+    )
+    metadata = _closed(
+        definition["metadata_policy"],
+        _METADATA_POLICY_FIELDS,
+        label="metadata_policy",
+    )
+    if (
+        metadata["requested_recommended_applied_separate"] is not True
+        or metadata["unobserved_applied_value"] != "not_observed"
+    ):
+        _fail(
+            "ORCH_TELEMETRY_INFERRED",
+            "Requested, recommended, and Host-applied metadata must remain separate.",
+        )
+    expected = definition_digest(definition)
+    if definition["definition_digest"] != expected:
+        _fail(
+            "ORCH_DEFINITION_DIGEST_MISMATCH",
+            "Workflow Definition digest does not match canonical content.",
+        )
+    return copy.deepcopy(definition)
