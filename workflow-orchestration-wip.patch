+function requestAttentionSummary(run) {
+  const signals = [];
+  const verification = run.verification?.result || run.verifier_result;
+  if (verification === "failed") {
+    signals.push("검증 실패 확인 필요");
+  } else if (!verification || verification === "not_run") {
+    signals.push("검증 근거 없음");
+  }
+  if (["failed", "blocked", "interrupted"].includes(run.outcome)) {
+    signals.push("완료 조건 확인 필요");
+  } else if (run.outcome === "corrected" || run.rework_count) {
+    signals.push(`수정 기록 ${run.rework_count || 1}회`);
+  }
+  if (run.stage_coverage?.available && !run.stage_coverage.complete) {
+    signals.push(
+      `단계 기록 ${run.stage_coverage.recorded}/${run.stage_coverage.planned}`,
+    );
+  }
+  if (
+    (run.display_language?.correction_summary || [])
+      .some(languageMismatch)
+  ) {
+    signals.push("서술 언어 확인");
+  }
+  return signals.length
+    ? signals.slice(0, 2).join(" · ")
+    : "추가 주의 신호 없음";
+}
