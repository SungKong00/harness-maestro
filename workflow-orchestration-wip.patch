+def validate_owner_workflow_binding(
+    definition: Mapping[str, Any],
+    expected_owner_workflow_digest: str | None,
+    expected_workflow_policy_digest: str | None = None,
+    expected_workflow_source_binding: Mapping[str, Any] | None = None,
+) -> str:
+    """Bind an explicit owner workflow to the trusted request-start input."""
+
+    policy = definition["responsibility_plan"]["workflow_policy"]
+    actual = definition["responsibility_plan"][
+        "owner_workflow_digest"
+    ]
+    actual_policy_digest = workflow_policy_digest(policy)
+    actual_source_binding = workflow_source_binding_contract(definition)
+    _digest(actual, field="owner_workflow_digest")
+    if (
+        actual_source_binding["source_kind"] == "route-v2"
+        and expected_workflow_source_binding is None
+    ):
