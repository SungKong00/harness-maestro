+        raise MaestroError(
+            "ORCH_REBUTTAL_INVALID",
+            "A rebuttal requires at least two conflict-relevant producer slices.",
+        )
+    seed = sha256_text(
+        canonical_json(
+            {
+                "conflict_digest": conflict["conflict_digest"],
+                "claim_id": conflict["claim_id"],
+                "rebuttal_round": 1,
+            }
+        )
+    )
+    request = {
+        "schema_version": REBUTTAL_REQUEST_VERSION,
+        "request_id": f"rebuttal-request-{seed[:40]}",
+        "request_digest": "",
+        "root_request_id": state["root_request_id"],
+        "root_execution_id": state["root_execution_id"],
+        "workflow_instance_id": state["workflow_instance_id"],
+        "definition_id": state["definition_id"],
+        "definition_revision": state["definition_revision"],
+        "definition_digest": state["definition_digest"],
+        "plan_revision": state["plan_revision"],
+        "conflict_id": conflict["conflict_id"],
+        "conflict_digest": conflict["conflict_digest"],
+        "claim_id": conflict["claim_id"],
+        "packet_digests": list(conflict["packet_digests"]),
+        "relevant_producers": relevant,
+        "prior_evidence_refs": sorted(prior_evidence),
+        "rebuttal_round": 1,
+    }
+    request["request_digest"] = _address(
+        request,
+        digest_field="request_digest",
+    )
+    return validate_rebuttal_request(
+        state=state,
+        conflict=conflict,
+        request=request,
+    )
+
+
+def validate_rebuttal_request(
+    *,
+    state: Mapping[str, Any],
+    conflict: Mapping[str, Any],
+    request: Any,
+) -> dict[str, Any]:
+    if (
+        not isinstance(request, dict)
+        or set(request) != REBUTTAL_REQUEST_FIELDS
+        or request.get("schema_version") != REBUTTAL_REQUEST_VERSION
+        or request.get("request_digest")
+        != _address(request, digest_field="request_digest")
+    ):
+        raise MaestroError(
+            "ORCH_REBUTTAL_INVALID",
+            "RebuttalRequest does not match the closed content-addressed contract.",
+        )
+    expected = {
+        "root_request_id": state["root_request_id"],
+        "root_execution_id": state["root_execution_id"],
+        "workflow_instance_id": state["workflow_instance_id"],
+        "definition_id": state["definition_id"],
+        "definition_revision": state["definition_revision"],
+        "definition_digest": state["definition_digest"],
+        "plan_revision": state["plan_revision"],
+        "conflict_id": conflict["conflict_id"],
+        "conflict_digest": conflict["conflict_digest"],
+        "claim_id": conflict["claim_id"],
+        "packet_digests": conflict["packet_digests"],
+        "rebuttal_round": 1,
+    }
+    for field, expected_value in expected.items():
+        if request.get(field) != expected_value:
+            raise MaestroError(
+                "ORCH_REBUTTAL_INVALID",
+                f"RebuttalRequest {field} is mismatched.",
+            )
+    producers = request["relevant_producers"]
+    if (
+        not isinstance(producers, list)
+        or len(producers) != len(request["packet_digests"])
+        or [
+            producer.get("packet_digest")
+            for producer in producers
+            if isinstance(producer, dict)
+        ]
+        != request["packet_digests"]
+    ):
+        raise MaestroError(
+            "ORCH_REBUTTAL_INVALID",
+            "RebuttalRequest producer slices do not match the conflict Packets.",
+        )
+    for producer in producers:
+        if (
+            not isinstance(producer, dict)
+            or set(producer) != RELEVANT_PRODUCER_FIELDS
+            or producer.get("producer_slice_digest")
+            != _address(producer, digest_field="producer_slice_digest")
+        ):
+            raise MaestroError(
+                "ORCH_REBUTTAL_INVALID",
+                "A relevant producer slice is not closed and content-addressed.",
+            )
+        require_identity(
+            producer.get("participant_instance_id"),
+            field="participant_instance_id",
+        )
+        require_identity(
+            producer.get("producer_principal_id"),
+            field="producer_principal_id",
+        )
+        require_identity(
+            producer.get("context_instance_id"),
+            field="context_instance_id",
+        )
+        if (
+            producer.get("claim_id") != request["claim_id"]
+            or not isinstance(producer.get("claim_statement"), str)
+            or not producer["claim_statement"].strip()
+            or not isinstance(producer.get("conflict_position"), dict)
+            or producer["conflict_position"].get("packet_digest")
+            != producer["packet_digest"]
+        ):
+            raise MaestroError(
+                "ORCH_REBUTTAL_INVALID",
+                "A producer slice must bind the exact claim and attributed position.",
+            )
+        require_refs(
+            producer.get("claim_evidence_refs"),
+            field="claim_evidence_refs",
+            allow_empty=False,
+        )
+    prior = require_refs(
+        request.get("prior_evidence_refs"),
+        field="prior_evidence_refs",
+        allow_empty=False,
+    )
+    required_prior = set(conflict.get("evidence_refs", []))
+    required_prior.update(
+        evidence
+        for producer in producers
+        for evidence in producer["claim_evidence_refs"]
+    )
+    if not required_prior.issubset(prior):
+        raise MaestroError(
+            "ORCH_REBUTTAL_INVALID",
+            "RebuttalRequest omits prior conflict or claim evidence.",
+        )
+    return copy.deepcopy(request)
+
+
+def build_rebuttal_response(
+    *,
+    state: Mapping[str, Any],
+    conflict: Mapping[str, Any],
+    request: Mapping[str, Any],
+    responding_packet_digest: str,
+    disposition: str,
+    new_evidence_refs: Sequence[str],
+    resulting_status: str,
+) -> dict[str, Any]:
+    response_seed = sha256_text(
+        canonical_json(
+            {
+                "request_digest": request["request_digest"],
+                "responding_packet_digest": responding_packet_digest,
+                "disposition": disposition,
+            }
+        )
+    )
+    evidence = list(new_evidence_refs)
+    response = {
+        "schema_version": REBUTTAL_RESPONSE_VERSION,
+        "response_id": f"rebuttal-response-{response_seed[:40]}",
+        "response_digest": "",
+        "request_id": request["request_id"],
+        "request_digest": request["request_digest"],
+        "root_request_id": state["root_request_id"],
+        "root_execution_id": state["root_execution_id"],
+        "workflow_instance_id": state["workflow_instance_id"],
+        "conflict_id": conflict["conflict_id"],
+        "conflict_digest": conflict["conflict_digest"],
+        "claim_id": conflict["claim_id"],
+        "packet_digests": list(conflict["packet_digests"]),
+        "relevant_producer_digests": [
+            producer["producer_slice_digest"]
+            for producer in request["relevant_producers"]
+        ],
+        "responding_packet_digest": responding_packet_digest,
+        "rebuttal_round": 1,
+        "disposition": disposition,
+        "new_evidence_refs": evidence,
+        "evidence_by_claim": {
+            "claim_id": conflict["claim_id"],
+            "evidence_refs": evidence,
+        },
+        "resulting_status": resulting_status,
+    }
+    response["response_digest"] = _address(
+        response,
+        digest_field="response_digest",
+    )
+    return validate_rebuttal_response(
+        state=state,
+        conflict=conflict,
+        request=request,
+        response=response,
+    )
+
+
+def validate_rebuttal_response(
+    *,
+    state: Mapping[str, Any],
+    conflict: Mapping[str, Any],
+    request: Mapping[str, Any],
+    response: Any,
+) -> dict[str, Any]:
+    validate_rebuttal_request(
+        state=state,
+        conflict=conflict,
+        request=request,
+    )
+    if (
+        not isinstance(response, dict)
+        or set(response) != REBUTTAL_RESPONSE_FIELDS
+        or response.get("schema_version") != REBUTTAL_RESPONSE_VERSION
+        or response.get("response_digest")
+        != _address(response, digest_field="response_digest")
+    ):
+        raise MaestroError(
+            "ORCH_REBUTTAL_INVALID",
+            "RebuttalResponse does not match the closed content-addressed contract.",
+        )
+    expected = {
+        "request_id": request["request_id"],
+        "request_digest": request["request_digest"],
+        "root_request_id": state["root_request_id"],
+        "root_execution_id": state["root_execution_id"],
+        "workflow_instance_id": state["workflow_instance_id"],
+        "conflict_id": conflict["conflict_id"],
+        "conflict_digest": conflict["conflict_digest"],
+        "claim_id": conflict["claim_id"],
+        "packet_digests": conflict["packet_digests"],
+        "relevant_producer_digests": [
+            producer["producer_slice_digest"]
+            for producer in request["relevant_producers"]
+        ],
+        "rebuttal_round": 1,
+    }
+    for field, expected_value in expected.items():
+        if response.get(field) != expected_value:
+            raise MaestroError(
+                "ORCH_REBUTTAL_INVALID",
+                f"RebuttalResponse {field} is mismatched.",
+            )
+    if (
+        response.get("responding_packet_digest")
+        not in request["packet_digests"]
+        or response.get("disposition") not in REBUTTAL_DISPOSITIONS
+    ):
+        raise MaestroError(
+            "ORCH_REBUTTAL_INVALID",
+            "Only a relevant producer may return a typed rebuttal disposition.",
+        )
+    raw_evidence = response.get("new_evidence_refs")
+    if not isinstance(raw_evidence, list) or not raw_evidence:
+        raise MaestroError(
+            "ORCH_REBUTTAL_INVALID",
+            "A rebuttal requires a non-empty genuinely new evidence set.",
+        )
+    evidence = require_refs(
+        raw_evidence,
+        field="new_evidence_refs",
+        allow_empty=False,
+    )
+    if set(evidence) & set(request["prior_evidence_refs"]):
+        raise MaestroError(
+            "ORCH_REBUTTAL_INVALID",
+            "A rebuttal must provide genuinely new evidence.",
+        )
+    evidence_by_claim = response.get("evidence_by_claim")
+    if evidence_by_claim != {
+        "claim_id": request["claim_id"],
+        "evidence_refs": evidence,
+    }:
+        raise MaestroError(
+            "ORCH_REBUTTAL_INVALID",
+            "Rebuttal evidence must be scoped only to the exact conflict claim.",
+        )
+    expected_status = (
+        "needs_decision"
+        if response["disposition"] == "INSUFFICIENT_EVIDENCE"
+        else "resolved"
+    )
+    if response.get("resulting_status") != expected_status:
+        raise MaestroError(
+            "ORCH_REBUTTAL_INVALID",
+            "A rebuttal must produce a typed disposition change.",
+        )
+    return copy.deepcopy(response)
+
+
+def build_reassessment(
+    *,
+    request: Mapping[str, Any],
+    participant_receipt: Mapping[str, Any],
+    plan_revision: int,
+    packet_digest: str,
+) -> dict[str, Any]:
+    if plan_revision <= request["plan_revision"]:
+        raise MaestroError(
+            "ORCH_PLAN_REVISION_REQUIRED",
+            "A replacement producer requires a new same-root PlanRevision.",
+        )
+    receipt_expected = {
+        "root_request_id": request["root_request_id"],
+        "root_execution_id": request["root_execution_id"],
+        "workflow_instance_id": request["workflow_instance_id"],
+        "role_spec_id": request["target_role_spec_id"],
+    }
+    if any(
+        participant_receipt.get(field) != expected
+        for field, expected in receipt_expected.items()
+    ):
+        raise MaestroError(
+            "ORCH_ROOT_LINEAGE_MISMATCH",
+            "Reassessment must remain on the same root and RoleSpec.",
+        )
+    if (
+        participant_receipt.get("participant_instance_id")
+        == request["target_producer_participant_instance_id"]
+        or participant_receipt.get("context_instance_id")
+        == request["target_context_instance_id"]
+    ):
+        raise MaestroError(
+            "ORCH_CORRECTION_REPLACEMENT_FORBIDDEN",
+            "The exact original producer must use CorrectionResponse.",
+        )
+    value = {
+        "schema_version": REASSESSMENT_VERSION,
+        "reassessment_id": "",
+        "closed_correction_request_id": request["correction_request_id"],
+        "closed_reason": "ORIGINAL_PRODUCER_CONTEXT_UNAVAILABLE",
+        "root_request_id": request["root_request_id"],
+        "root_execution_id": request["root_execution_id"],
+        "workflow_instance_id": request["workflow_instance_id"],
+        "plan_revision": plan_revision,
+        "role_spec_id": request["target_role_spec_id"],
+        "participant_instance_id": participant_receipt[
+            "participant_instance_id"
+        ],
+        "producer_principal_id": participant_receipt[
+            "producer_principal_id"
+        ],
+        "context_instance_id": participant_receipt["context_instance_id"],
+        "reassesses_packet_digest": request["target_packet_digest"],
+        "packet_digest": require_digest(packet_digest, field="packet_digest"),
+    }
+    value["reassessment_id"] = _address(value, digest_field="reassessment_id")
+    return value
+
+
+def _owner_checkpoint_step(
+    definition: Mapping[str, Any],
+    workflow_step_id: str,
+) -> tuple[Mapping[str, Any], Mapping[str, Any]]:
+    plan = definition["responsibility_plan"]
+    step = next(
+        (
+            item
+            for item in plan["workflow_policy"]["ordered_steps"]
+            if item["step_id"] == workflow_step_id
+        ),
+        None,
+    )
+    entry = next(
+        (
+            item
+            for item in plan["workflow_step_mapping"]["entries"]
+            if item["step_id"] == workflow_step_id
+        ),
+        None,
+    )
+    if (
+        not isinstance(step, Mapping)
+        or step.get("kind") != "owner-checkpoint"
+        or not isinstance(entry, Mapping)
+    ):
+        raise MaestroError(
+            "ORCH_DECISION_INVALID",
+            "Owner checkpoint request does not reference a mapped checkpoint step.",
+        )
+    return step, entry
+
+
+def build_owner_checkpoint_request(
+    *,
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+    workflow_step_id: str,
+    checkpoint_digest: str,
+) -> dict[str, Any]:
+    _, entry = _owner_checkpoint_step(definition, workflow_step_id)
+    checkpoint_contract = entry["checkpoint"]
+    plan = definition["responsibility_plan"]
+    checkpoint = require_digest(
+        checkpoint_digest,
+        field="checkpoint_digest",
+    )
+    if checkpoint != sha256_text(canonical_json(state)):
+        raise MaestroError(
+            "ORCH_DECISION_STALE",
+            "Owner checkpoint request must bind the exact pre-request Controller state.",
+        )
+    seed = sha256_text(
+        canonical_json(
+            {
+                "root_execution_id": state["root_execution_id"],
+                "definition_digest": definition["definition_digest"],
+                "workflow_step_id": workflow_step_id,
+                "checkpoint_digest": checkpoint,
+            }
+        )
+    )
+    request = {
+        "schema_version": OWNER_CHECKPOINT_REQUEST_VERSION,
+        "decision_id": f"owner-checkpoint-{seed[:40]}",
+        "request_digest": "",
+        "root_request_id": state["root_request_id"],
+        "root_execution_id": state["root_execution_id"],
+        "workflow_instance_id": state["workflow_instance_id"],
+        "definition_id": definition["definition_id"],
+        "definition_revision": definition["definition_revision"],
+        "definition_digest": definition["definition_digest"],
+        "plan_revision": state["plan_revision"],
+        "responsibility_plan_id": plan["plan_id"],
+        "workflow_policy_digest": plan["workflow_step_mapping"][
+            "workflow_policy_digest"
+        ],
+        "workflow_step_id": workflow_step_id,
+        "checkpoint_digest": checkpoint,
+        "question": checkpoint_contract["question"],
+        "options": copy.deepcopy(checkpoint_contract["options"]),
+        "evidence_refs": [
+            f"workflow-policy:{plan['workflow_step_mapping']['workflow_policy_digest']}",
+            f"workflow-step:{workflow_step_id}",
+            f"definition:{definition['definition_digest']}",
+        ],
+        "status": "pending",
+    }
+    request["request_digest"] = _address(
+        request,
+        digest_field="request_digest",
+    )
+    return validate_owner_checkpoint_request(
+        definition=definition,
+        state=state,
+        request=request,
+    )
+
+
+def validate_owner_checkpoint_request(
+    *,
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+    request: Any,
+) -> dict[str, Any]:
+    if (
+        not isinstance(request, dict)
+        or set(request) != OWNER_CHECKPOINT_REQUEST_FIELDS
+        or request.get("schema_version")
+        != OWNER_CHECKPOINT_REQUEST_VERSION
+        or request.get("request_digest")
+        != _address(request, digest_field="request_digest")
+        or request.get("status") != "pending"
+    ):
+        raise MaestroError(
+            "ORCH_DECISION_INVALID",
+            "Owner checkpoint request is not one closed content-addressed request.",
+        )
+    plan = definition["responsibility_plan"]
+    expected = {
+        "root_request_id": state["root_request_id"],
+        "root_execution_id": state["root_execution_id"],
+        "workflow_instance_id": state["workflow_instance_id"],
+        "definition_id": definition["definition_id"],
+        "definition_revision": definition["definition_revision"],
+        "definition_digest": definition["definition_digest"],
+        "plan_revision": state["plan_revision"],
+        "responsibility_plan_id": plan["plan_id"],
+        "workflow_policy_digest": plan["workflow_step_mapping"][
+            "workflow_policy_digest"
+        ],
+    }
+    if any(request.get(field) != value for field, value in expected.items()):
+        raise MaestroError(
+            "ORCH_DECISION_STALE",
+            "Owner checkpoint request is stale for this root or definition.",
+        )
+    require_identity(request.get("decision_id"), field="decision_id")
+    require_digest(request.get("checkpoint_digest"), field="checkpoint_digest")
+    step_id = require_identity(
+        request.get("workflow_step_id"),
+        field="workflow_step_id",
+    )
+    _, entry = _owner_checkpoint_step(definition, step_id)
+    require_line(request.get("question"), field="question")
+    checkpoint_contract = entry["checkpoint"]
+    if (
+        request.get("question") != checkpoint_contract["question"]
+        or request.get("options") != checkpoint_contract["options"]
+    ):
+        raise MaestroError(
+            "ORCH_DECISION_INVALID",
+            "Owner checkpoint question and options must match the Host mapping.",
+        )
+    require_refs(
+        request.get("evidence_refs"),
+        field="evidence_refs",
+        allow_empty=False,
+    )
+    return copy.deepcopy(request)
+
+
+def build_owner_checkpoint_resolution(
+    *,
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+    request: Mapping[str, Any],
+    checkpoint_digest: str,
+    option_id: str,
+    owner_authority_ref: str,
+) -> dict[str, Any]:
+    pending = validate_owner_checkpoint_request(
+        definition=definition,
+        state=state,
+        request=request,
+    )
+    if (
+        checkpoint_digest != pending["checkpoint_digest"]
+        or option_id
+        not in {
+            option["option_id"] for option in pending["options"]
+        }
+    ):
+        raise MaestroError(
+            "ORCH_DECISION_STALE",
+            "Owner resolution does not bind the exact pending checkpoint.",
+        )
+    receipt = {
+        "schema_version": OWNER_CHECKPOINT_RECEIPT_VERSION,
+        "receipt_digest": "",
+        "decision_id": pending["decision_id"],
+        "request_digest": pending["request_digest"],
+        "root_request_id": pending["root_request_id"],
+        "root_execution_id": pending["root_execution_id"],
+        "workflow_instance_id": pending["workflow_instance_id"],
+        "definition_id": pending["definition_id"],
+        "definition_revision": pending["definition_revision"],
+        "definition_digest": pending["definition_digest"],
+        "plan_revision": pending["plan_revision"],
+        "responsibility_plan_id": pending["responsibility_plan_id"],
+        "workflow_policy_digest": pending["workflow_policy_digest"],
+        "workflow_step_id": pending["workflow_step_id"],
+        "checkpoint_digest": pending["checkpoint_digest"],
+        "selected_option_id": require_identity(
+            option_id,
+            field="selected_option_id",
+        ),
+        "owner_authority_ref": require_line(
+            owner_authority_ref,
+            field="owner_authority_ref",
+        ),
+    }
+    receipt["receipt_digest"] = _address(
+        receipt,
+        digest_field="receipt_digest",
+    )
+    return validate_owner_checkpoint_resolution(
+        definition=definition,
+        state=state,
+        request=pending,
+        resolution=receipt,
+    )
+
+
+def validate_owner_checkpoint_resolution(
+    *,
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+    request: Mapping[str, Any],
+    resolution: Any,
+) -> dict[str, Any]:
+    pending = validate_owner_checkpoint_request(
+        definition=definition,
+        state=state,
+        request=request,
+    )
+    if (
+        not isinstance(resolution, dict)
+        or set(resolution) != OWNER_CHECKPOINT_RECEIPT_FIELDS
+        or resolution.get("schema_version")
+        != OWNER_CHECKPOINT_RECEIPT_VERSION
+        or resolution.get("receipt_digest")
+        != _address(resolution, digest_field="receipt_digest")
+    ):
+        raise MaestroError(
+            "ORCH_DECISION_INVALID",
+            "Owner checkpoint resolution is not one closed content-addressed receipt.",
+        )
+    for field in OWNER_CHECKPOINT_RECEIPT_FIELDS - {
+        "schema_version",
+        "receipt_digest",
+        "selected_option_id",
+        "owner_authority_ref",
+    }:
+        if resolution.get(field) != pending.get(field):
+            raise MaestroError(
+                "ORCH_DECISION_STALE",
+                f"Owner checkpoint receipt {field} is stale or mismatched.",
+            )
+    if resolution.get("selected_option_id") not in {
+        option["option_id"] for option in pending["options"]
+    }:
+        raise MaestroError(
+            "ORCH_DECISION_INVALID",
+            "Owner checkpoint receipt must select approve or stop.",
+        )
+    require_line(
+        resolution.get("owner_authority_ref"),
+        field="owner_authority_ref",
+    )
+    return copy.deepcopy(resolution)
+
+
+def build_decision_request(
+    *,
+    state: Mapping[str, Any],
+    checkpoint_digest: str,
+    question: str,
+    options: Sequence[Mapping[str, Any]],
+    evidence_refs: Sequence[str],
+) -> dict[str, Any]:
+    if (
+        len(options) < 2
+        or len(options) > 8
+        or not all(
+            isinstance(option, Mapping)
+            and set(option) == {"option_id", "label", "consequences"}
+            for option in options
+        )
+    ):
+        raise MaestroError(
+            "ORCH_DECISION_INVALID",
+            "DecisionRequest requires two to eight finite typed options.",
+        )
+    seed = sha256_text(
+        canonical_json(
+            {
+                "root_execution_id": state["root_execution_id"],
+                "revision": state["revision"],
+                "question": question,
+                "options": options,
+            }
+        )
+    )
+    return {
+        "schema_version": DECISION_REQUEST_VERSION,
+        "decision_id": f"decision-{seed[:40]}",
+        "root_request_id": state["root_request_id"],
+        "root_execution_id": state["root_execution_id"],
+        "workflow_instance_id": state["workflow_instance_id"],
+        "definition_id": state["definition_id"],
+        "definition_revision": state["definition_revision"],
+        "definition_digest": state["definition_digest"],
+        "plan_revision": state["plan_revision"],
+        "checkpoint_digest": require_digest(
+            checkpoint_digest,
+            field="checkpoint_digest",
+        ),
+        "question": require_line(question, field="question"),
+        "options": [copy.deepcopy(dict(option)) for option in options],
+        "evidence_refs": list(evidence_refs),
+        "status": "pending",
+    }
+
+
+def build_decision_resolution(
+    *,
+    request: Mapping[str, Any],
+    root_request_id: str,
+    checkpoint_digest: str,
+    option_id: str,
+    owner_authority_ref: str,
+) -> dict[str, Any]:
+    option_ids = [option["option_id"] for option in request["options"]]
+    if (
+        request.get("status") != "pending"
+        or request.get("root_request_id") != root_request_id
+        or request.get("checkpoint_digest") != checkpoint_digest
+        or option_id not in option_ids
+    ):
+        raise MaestroError(
+            "ORCH_DECISION_STALE",
+            "Owner resolution does not bind the exact pending checkpoint.",
+        )
+    return {
+        "schema_version": DECISION_RESOLUTION_VERSION,
+        "decision_id": request["decision_id"],
+        "root_request_id": root_request_id,
+        "root_execution_id": request["root_execution_id"],
+        "workflow_instance_id": request["workflow_instance_id"],
+        "definition_digest": request["definition_digest"],
+        "plan_revision": request["plan_revision"],
+        "checkpoint_digest": checkpoint_digest,
+        "selected_option_id": require_identity(
+            option_id,
+            field="selected_option_id",
+        ),
+        "owner_authority_ref": require_line(
+            owner_authority_ref,
+            field="owner_authority_ref",
+        ),
+    }
