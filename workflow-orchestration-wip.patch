+    document = _design_schema_document()
+    available = document["$defs"]
+    pending = [definition_id]
+    selected: dict[str, Any] = {}
+    while pending:
+        current = pending.pop()
+        if current in selected:
+            continue
+        definition = available.get(current)
+        if not isinstance(definition, dict):
+            raise MaestroError(
+                "PACKET_OUTPUT_SCHEMA_INVALID",
+                f"Missing Product Design definition: {current}.",
+            )
+        selected[current] = definition
+        pending.extend(
+            sorted(
+                _schema_definition_refs(definition) - set(selected),
+                reverse=True,
+            )
+        )
+    mapping = {
+        name: "designAssurance" + name[:1].upper() + name[1:]
+        for name in selected
+    }
+    definitions = schema.get("$defs")
+    properties = schema.get("properties")
+    if not isinstance(definitions, dict) or not isinstance(
+        properties, dict
+    ):
+        raise MaestroError(
+            "PACKET_OUTPUT_SCHEMA_INVALID",
+            "The Assignment output schema cannot embed Product Design definitions.",
+        )
+    definitions.update(
+        {
+            mapping[name]: _rewrite_definition_refs(
+                definition,
+                mapping,
+            )
+            for name, definition in selected.items()
+        }
+    )
+    properties[property_name] = {
+        "$ref": f"#/$defs/{mapping[definition_id]}"
+    }
