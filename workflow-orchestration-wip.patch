+                "work:Implement the contract",
+                "verification:Run contract verification",
+            ],
+        )
+        corrected_hints = normalize_route_hints(
+            work_kinds=["software-structure"],
+            route_attempt=2,
+            prior_plan_id=initial["plan_id"],
+            prior_source_route_digest=initial["source_route_digest"],
+        )
+
+        corrected = route_goal_v2(
+            "Implement the API contract",
+            "medium",
+            intent="implementation",
+            route_hints=corrected_hints,
+            prior_route_plan=initial,
+        )
+        self.assertEqual(
+            initial["task_contract"]["workflow_policy"]["ordered_steps"],
+            corrected["task_contract"]["workflow_policy"]["ordered_steps"],
+        )
+        with self.assertRaises(MaestroError) as raised:
+            route_goal_v2(
+                "Implement the API contract",
+                "medium",
+                intent="implementation",
+                route_hints=corrected_hints,
+                workflow_steps=["work:Replace the owner workflow"],
+                prior_route_plan=initial,
+            )
+        self.assertEqual(
+            "WORKFLOW_REROUTE_LINEAGE_MISMATCH",
+            raised.exception.code,
+        )
