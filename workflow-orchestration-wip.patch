+++ b/src/maestro/workflow_policy.py
@@ -0,0 +1,347 @@
+from __future__ import annotations
+
+import copy
+from typing import Any, Iterable
+
+from .errors import MaestroError
+from .util import canonical_json, sha256_text
+
+
+WORKFLOW_POLICY_VERSION = "maestro_workflow_policy_v1"
+WORKFLOW_MODES = {"guided", "controlled"}
+WORKFLOW_STEP_KINDS = {
+    "research",
+    "work",
+    "owner-checkpoint",
+    "verification",
+}
+CONTROLLED_WORK_KINDS = {
+    "data-change",
+    "delivery-operation",
+    "security-sensitive",
+}
+MAX_WORKFLOW_STEPS = 12
+MAX_WORKFLOW_STEP_CHARS = 500
+ORDER_POLICY = "preserve-within-safety-boundary"
+SEMANTIC_AUTHORITY = "owner-and-selected-skills"
+DETERMINISTIC_AUTHORITY = [
+    "permission-and-path-bounds",
+    "single-mutation-owner",
+    "risk-floor",
+    "effect-reconciliation",
+    "completion-evidence",
+]
+OWNER_WORKFLOW_BINDING_VERSION = "maestro_owner_workflow_binding_v1"
+WORKFLOW_POLICY_FIELDS = {
+    "schema_version",
+    "requested_mode",
+    "effective_mode",
+    "ordered_steps",
+    "order_policy",
+    "semantic_authority",
+    "deterministic_authority",
+    "escalation_reasons",
+}
+_UNBOUND_ROUTE_HINTS = object()
+_CANONICAL_ESCALATION_REASONS = [
+    "requested-controlled",
+    "risk-high",
+    "risk-critical",
+    "work-kind-data-change",
+    "work-kind-delivery-operation",
+    "work-kind-security-sensitive",
+    "design-assurance-compact",
+    "design-assurance-standard",
+    "design-assurance-system",
+]
+
+
+def _workflow_error(code: str, message: str) -> MaestroError:
+    return MaestroError(code, message)
+
+
+def _normalize_step(raw_step: Any, index: int) -> dict[str, str]:
+    if not isinstance(raw_step, str):
+        raise _workflow_error(
+            "WORKFLOW_STEP_INVALID",
+            "workflow steps must be strings.",
+        )
+    step = raw_step.strip()
+    if (
+        not step
+        or len(step) > MAX_WORKFLOW_STEP_CHARS
+        or "\n" in step
+        or "\r" in step
+    ):
+        raise _workflow_error(
+            "WORKFLOW_STEP_INVALID",
+            (
+                "workflow steps must be non-empty single lines no longer "
+                f"than {MAX_WORKFLOW_STEP_CHARS} characters."
+            ),
+        )
+    prefix, separator, remainder = step.partition(":")
+    if separator and prefix.strip() in WORKFLOW_STEP_KINDS:
+        kind = prefix.strip()
+        instruction = remainder.strip()
+        if not instruction:
+            raise _workflow_error(
+                "WORKFLOW_STEP_INVALID",
+                "a typed workflow step must include an instruction after ':'.",
+            )
+    else:
+        kind = "work"
+        instruction = step
+    return {
+        "step_id": f"step-{index:02d}",
+        "kind": kind,
+        "instruction": instruction,
+    }
+
+
+def _escalation_reasons(
+    *,
+    risk: str,
+    route_hints: dict[str, Any] | None,
+    requested_mode: str | None,
+) -> list[str]:
+    reasons: list[str] = []
+    if requested_mode == "controlled":
+        reasons.append("requested-controlled")
+    if risk in {"high", "critical"}:
+        reasons.append(f"risk-{risk}")
+    hints = route_hints if isinstance(route_hints, dict) else {}
+    raw_work_kinds = hints.get("work_kinds")
+    work_kinds = (
+        set(raw_work_kinds)
+        if isinstance(raw_work_kinds, list)
+        and all(isinstance(item, str) for item in raw_work_kinds)
+        else set()
+    )
+    for work_kind in sorted(
+        work_kinds & CONTROLLED_WORK_KINDS
+    ):
+        reasons.append(f"work-kind-{work_kind}")
+    assurance_mode = hints.get("design_assurance_mode")
+    if assurance_mode in {"compact", "standard", "system"}:
+        reasons.append(f"design-assurance-{assurance_mode}")
+    return reasons
+
+
+def build_workflow_policy(
+    *,
+    risk: str,
+    route_hints: dict[str, Any] | None = None,
+    requested_mode: str | None = None,
+    workflow_steps: Iterable[str] | None = None,
+) -> dict[str, Any]:
+    """Build the route-bound hybrid workflow policy.
+
+    Skills and owner checkpoints decide task-specific semantics. Python keeps
+    the bounded safety, authority, effect, and completion contract.
+    """
+
+    if (
+        not isinstance(risk, str)
+        or risk not in {"low", "medium", "high", "critical"}
+    ):
+        raise _workflow_error(
+            "WORKFLOW_RISK_INVALID",
+            "workflow policy risk must be low, medium, high, or critical.",
+        )
+    if requested_mode is not None and (
+        not isinstance(requested_mode, str)
+        or requested_mode not in WORKFLOW_MODES
+    ):
+        raise _workflow_error(
+            "WORKFLOW_MODE_INVALID",
+            "workflow mode must be guided or controlled.",
+        )
+    raw_steps = list(workflow_steps or [])
+    if len(raw_steps) > MAX_WORKFLOW_STEPS:
+        raise _workflow_error(
+            "WORKFLOW_STEP_LIMIT_EXCEEDED",
+            f"at most {MAX_WORKFLOW_STEPS} owner workflow steps are supported.",
+        )
+    ordered_steps = [
+        _normalize_step(raw_step, index)
+        for index, raw_step in enumerate(raw_steps, start=1)
+    ]
+    reasons = _escalation_reasons(
+        risk=risk,
+        route_hints=route_hints,
+        requested_mode=requested_mode,
+    )
+    return {
+        "schema_version": WORKFLOW_POLICY_VERSION,
+        "requested_mode": requested_mode,
+        "effective_mode": "controlled" if reasons else "guided",
+        "ordered_steps": ordered_steps,
+        "order_policy": ORDER_POLICY,
+        "semantic_authority": SEMANTIC_AUTHORITY,
+        "deterministic_authority": list(DETERMINISTIC_AUTHORITY),
+        "escalation_reasons": reasons,
+    }
+
+
+def workflow_policy_digest(value: dict[str, Any]) -> str:
+    """Content-address one exact canonical workflow policy."""
+
+    if not isinstance(value, dict):
+        raise _workflow_error(
+            "WORKFLOW_POLICY_INVALID",
+            "workflow policy must be an object before it can be addressed.",
+        )
+    return sha256_text(canonical_json(value))
+
+
+def owner_workflow_digest(value: dict[str, Any]) -> str:
+    """Address only owner-controlled workflow inputs, excluding risk outputs."""
+
+    if (
+        not isinstance(value, dict)
+        or set(value) != WORKFLOW_POLICY_FIELDS
+        or value.get("requested_mode") not in {None, *WORKFLOW_MODES}
+        or not isinstance(value.get("ordered_steps"), list)
+    ):
+        raise _workflow_error(
+            "WORKFLOW_POLICY_INVALID",
+            "owner workflow digest requires one canonical workflow policy.",
+        )
+    projection = {
+        "schema_version": OWNER_WORKFLOW_BINDING_VERSION,
+        "requested_mode": value["requested_mode"],
+        "ordered_steps": copy.deepcopy(value["ordered_steps"]),
+    }
+    return sha256_text(canonical_json(projection))
+
+
+def owner_workflow_digest_from_inputs(
+    *,
+    requested_mode: str | None = None,
+    workflow_steps: Iterable[str] | None = None,
+) -> str:
+    """Create the immutable intake digest before routed risk is known."""
+
+    return owner_workflow_digest(
+        build_workflow_policy(
+            risk="low",
+            requested_mode=requested_mode,
+            workflow_steps=workflow_steps,
+        )
+    )
+
+
+def has_explicit_owner_workflow(value: dict[str, Any]) -> bool:
+    return bool(
+        isinstance(value, dict)
+        and (
+            value.get("requested_mode") is not None
+            or value.get("ordered_steps")
+        )
+    )
+
+
+def require_workflow_policy(
+    value: Any,
+    *,
+    risk: str,
+    route_hints: dict[str, Any] | None | object = _UNBOUND_ROUTE_HINTS,
+) -> dict[str, Any]:
+    """Validate one workflow policy at a route or domain-neutral boundary.
+
+    Route validation supplies ``route_hints`` and therefore checks the exact
+    derived policy.  The Controller intentionally has no domain hint
+    semantics, so omitting that argument validates the closed shape, owner
+    order, canonical escalation vocabulary, and deterministic risk floors.
+    """
+
+    if not isinstance(value, dict) or set(value) != WORKFLOW_POLICY_FIELDS:
+        raise _workflow_error(
+            "WORKFLOW_POLICY_INVALID",
+            "workflow policy fields are incomplete or unsupported.",
+        )
+    ordered_steps = value.get("ordered_steps")
+    if not isinstance(ordered_steps, list):
+        raise _workflow_error(
+            "WORKFLOW_POLICY_INVALID",
+            "ordered_steps must be a list.",
+        )
+    raw_steps: list[str] = []
+    for index, step in enumerate(ordered_steps, start=1):
+        if (
+            not isinstance(step, dict)
+            or set(step) != {"step_id", "kind", "instruction"}
+            or step.get("step_id") != f"step-{index:02d}"
+            or step.get("kind") not in WORKFLOW_STEP_KINDS
+            or not isinstance(step.get("instruction"), str)
+        ):
+            raise _workflow_error(
+                "WORKFLOW_POLICY_INVALID",
+                "ordered workflow steps must be canonical and contiguous.",
+            )
+        raw_steps.append(f"{step['kind']}:{step['instruction']}")
+    canonical_without_domain_hints = build_workflow_policy(
+        risk=risk,
+        route_hints=None,
+        requested_mode=value.get("requested_mode"),
+        workflow_steps=raw_steps,
+    )
+    if route_hints is not _UNBOUND_ROUTE_HINTS:
+        canonical = build_workflow_policy(
+            risk=risk,
+            route_hints=(
+                route_hints
+                if isinstance(route_hints, dict)
+                else None
+            ),
+            requested_mode=value.get("requested_mode"),
+            workflow_steps=raw_steps,
+        )
+        if value != canonical:
+            raise _workflow_error(
+                "WORKFLOW_POLICY_MISMATCH",
+                "workflow policy does not match its routed risk and owner inputs.",
+            )
+        return canonical
+
+    for field in WORKFLOW_POLICY_FIELDS - {
+        "effective_mode",
+        "escalation_reasons",
+    }:
+        if value.get(field) != canonical_without_domain_hints[field]:
+            raise _workflow_error(
+                "WORKFLOW_POLICY_MISMATCH",
+                "workflow policy fixed fields or owner steps are not canonical.",
+            )
+    reasons = value.get("escalation_reasons")
+    if (
+        not isinstance(reasons, list)
+        or len(reasons) != len(set(reasons))
+        or any(reason not in _CANONICAL_ESCALATION_REASONS for reason in reasons)
+    ):
+        raise _workflow_error(
+            "WORKFLOW_POLICY_MISMATCH",
+            "workflow policy escalation reasons are not canonical.",
+        )
+    required_reasons = canonical_without_domain_hints[
+        "escalation_reasons"
+    ]
+    if any(reason not in reasons for reason in required_reasons):
+        raise _workflow_error(
+            "WORKFLOW_POLICY_MISMATCH",
+            "workflow policy omits a deterministic controlled-mode floor.",
+        )
+    expected_reasons = [
+        reason
+        for reason in _CANONICAL_ESCALATION_REASONS
+        if reason in reasons
+    ]
+    if reasons != expected_reasons or value.get("effective_mode") != (
+        "controlled" if reasons else "guided"
+    ):
+        raise _workflow_error(
+            "WORKFLOW_POLICY_MISMATCH",
+            "workflow policy mode and escalation order do not agree.",
+        )
+    return copy.deepcopy(value)
