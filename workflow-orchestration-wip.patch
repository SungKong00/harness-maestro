+++ b/src/maestro/workflow/kernel.py
@@ -0,0 +1,1114 @@
+from __future__ import annotations
+
+import copy
+from typing import Any, Iterable
+
+from maestro.errors import MaestroError
+from maestro.util import canonical_json, sha256_text
+
+from .contracts import (
+    CORRECTION_INTENTS,
+    MAX_CORRECTION_CYCLES,
+    MAX_RESPONSIBILITY_BOUNDARY_EXPANSIONS,
+    OUTCOME_VERDICTS,
+    digest,
+    validate_artifact_envelope,
+    validate_command,
+    validate_workflow_definition,
+)
+
+
+WORKFLOW_EVENT_VERSION = "maestro_workflow_event_v1"
+WORKFLOW_STATE_VERSION = "maestro_workflow_state_v1"
+EVENT_TYPES = {
+    "WorkflowStarted",
+    "ArtifactRegistered",
+    "ActivityRequested",
+    "ActivityCompleted",
+    "ActivityFailed",
+    "StructuralVerdictRecorded",
+    "OutcomeJudgmentRecorded",
+    "DecisionRequested",
+    "DecisionResolved",
+    "WorkflowBlocked",
+}
+_COMMAND_BY_EVENT = {
+    "WorkflowStarted": "START_WORKFLOW",
+    "ArtifactRegistered": "REGISTER_ARTIFACT",
+    "ActivityRequested": "REQUEST_ACTIVITY",
+    "ActivityCompleted": "COMPLETE_ACTIVITY",
+    "ActivityFailed": "FAIL_ACTIVITY",
+    "StructuralVerdictRecorded": "RECORD_STRUCTURAL_VERDICT",
+    "OutcomeJudgmentRecorded": "RECORD_OUTCOME_JUDGMENT",
+    "DecisionRequested": "REQUEST_DECISION",
+    "DecisionResolved": "RESOLVE_DECISION",
+    "WorkflowBlocked": "BLOCK_WORKFLOW",
+}
+PHASES = {"new", "running", "waiting_activity", "waiting_decision", "terminal"}
+MAX_EVENTS = 256
+
+
+def _line(value: Any, *, maximum: int = 500) -> bool:
+    return (
+        isinstance(value, str)
+        and value == value.strip()
+        and bool(value)
+        and len(value) <= maximum
+        and not any(character in value for character in "\r\n\x00")
+    )
+
+
+def _identity(value: dict[str, Any], field: str) -> str:
+    payload = copy.deepcopy(value)
+    payload[field] = ""
+    return sha256_text(canonical_json(payload))
+
+
+def _state_identity(value: dict[str, Any]) -> str:
+    return _identity(value, "state_id")
+
+
+def _accepted_definition_ids(
+    definition: dict[str, Any],
+) -> set[str]:
+    return {
+        definition["definition_id"],
+        *definition["compatible_definition_digests"],
+    }
+
+
+def _transition_allowed(
+    definition: dict[str, Any],
+    *,
+    from_stage: str,
+    to_stage: str,
+    trigger: str,
+) -> bool:
+    return any(
+        transition == {
+            "from_stage": from_stage,
+            "to_stage": to_stage,
+            "trigger": trigger,
+        }
+        for transition in definition["transitions"]
+    )
+
+
+def _artifact_by_id(
+    state: dict[str, Any],
+    artifact_id: Any,
+) -> dict[str, Any] | None:
+    return next(
+        (
+            artifact
+            for artifact in state["artifacts"]
+            if artifact.get("artifact_id") == artifact_id
+        ),
+        None,
+    )
+
+
+def _artifact_matches_state(
+    artifact: Any,
+    state: dict[str, Any],
+    artifact_type: str | None = None,
+) -> bool:
+    return (
+        validate_artifact_envelope(artifact)
+        and artifact.get("root_request_id")
+        == state["root_request_id"]
+        and artifact.get("workflow_instance_id")
+        == state["workflow_instance_id"]
+        and (
+            artifact_type is None
+            or artifact.get("artifact_type") == artifact_type
+        )
+    )
+
+
+def _event(
+    state: dict[str, Any],
+    command: dict[str, Any],
+    event_type: str,
+    payload: dict[str, Any],
+) -> dict[str, Any]:
+    value = {
+        "schema_version": WORKFLOW_EVENT_VERSION,
+        "event_id": "",
+        "workflow_instance_id": state["workflow_instance_id"],
+        "root_request_id": state["root_request_id"],
+        "definition_id": command["definition_id"],
+        "sequence": state["revision"] + 1,
+        "command_id": command["command_id"],
+        "idempotency_key": command["idempotency_key"],
+        "event_type": event_type,
+        "payload": copy.deepcopy(payload),
+    }
+    value["event_id"] = _identity(value, "event_id")
+    return value
+
+
+def empty_workflow_state(
+    definition: dict[str, Any],
+    *,
+    workflow_instance_id: str,
+    root_request_id: str,
+) -> dict[str, Any]:
+    if (
+        not validate_workflow_definition(definition)
+        or not _line(workflow_instance_id, maximum=200)
+        or not _line(root_request_id, maximum=200)
+    ):
+        raise MaestroError(
+            "WORKFLOW_STATE_INITIALIZATION_INVALID",
+            "Workflow state requires a valid definition and stable root identities.",
+        )
+    value = {
+        "schema_version": WORKFLOW_STATE_VERSION,
+        "state_id": "",
+        "workflow_instance_id": workflow_instance_id,
+        "root_request_id": root_request_id,
+        "definition_id": definition["definition_id"],
+        "definition_version": definition["version"],
+        "history_definition_ids": [],
+        "revision": 0,
+        "status": "CONTINUE",
+        "phase": "new",
+        "current_stage": None,
+        "outcome_contract_artifact_id": None,
+        "pending_activity": None,
+        "pending_decision": None,
+        "structural_verdict_artifact_id": None,
+        "latest_outcome_judgment": None,
+        "artifacts": [],
+        "invalidated_artifact_ids": [],
+        "correction_count": 0,
+        "responsibility_boundary_expansions": 0,
+        "responsibility_boundaries": [],
+        "seen_correction_fingerprints": [],
+        "applied_commands": [],
+        "checkpoint_id": None,
+        "structure_review_reason": None,
+    }
+    value["state_id"] = _state_identity(value)
+    return value
+
+
+def validate_workflow_event(
+    value: Any,
+    definition: dict[str, Any],
+) -> bool:
+    fields = {
+        "schema_version",
+        "event_id",
+        "workflow_instance_id",
+        "root_request_id",
+        "definition_id",
+        "sequence",
+        "command_id",
+        "idempotency_key",
+        "event_type",
+        "payload",
+    }
+    return (
+        validate_workflow_definition(definition)
+        and isinstance(value, dict)
+        and set(value) == fields
+        and value.get("schema_version") == WORKFLOW_EVENT_VERSION
+        and digest(value.get("event_id"))
+        and value["event_id"] == _identity(value, "event_id")
+        and _line(value.get("workflow_instance_id"), maximum=200)
+        and _line(value.get("root_request_id"), maximum=200)
+        and value.get("definition_id")
+        in _accepted_definition_ids(definition)
+        and isinstance(value.get("sequence"), int)
+        and not isinstance(value.get("sequence"), bool)
+        and value["sequence"] >= 1
+        and digest(value.get("command_id"))
+        and _line(value.get("idempotency_key"), maximum=200)
+        and value.get("event_type") in EVENT_TYPES
+        and isinstance(value.get("payload"), dict)
+    )
+
+
+def validate_workflow_state(
+    value: Any,
+    definition: dict[str, Any],
+) -> bool:
+    fields = {
+        "schema_version",
+        "state_id",
+        "workflow_instance_id",
+        "root_request_id",
+        "definition_id",
+        "definition_version",
+        "history_definition_ids",
+        "revision",
+        "status",
+        "phase",
+        "current_stage",
+        "outcome_contract_artifact_id",
+        "pending_activity",
+        "pending_decision",
+        "structural_verdict_artifact_id",
+        "latest_outcome_judgment",
+        "artifacts",
+        "invalidated_artifact_ids",
+        "correction_count",
+        "responsibility_boundary_expansions",
+        "responsibility_boundaries",
+        "seen_correction_fingerprints",
+        "applied_commands",
+        "checkpoint_id",
+        "structure_review_reason",
+    }
+    if (
+        not validate_workflow_definition(definition)
+        or not isinstance(value, dict)
+        or set(value) != fields
+        or value.get("schema_version") != WORKFLOW_STATE_VERSION
+        or value.get("definition_id") != definition["definition_id"]
+        or value.get("definition_version") != definition["version"]
+        or not _line(value.get("workflow_instance_id"), maximum=200)
+        or not _line(value.get("root_request_id"), maximum=200)
+        or not isinstance(value.get("revision"), int)
+        or isinstance(value.get("revision"), bool)
+        or value["revision"] < 0
+        or value.get("status") not in OUTCOME_VERDICTS
+        or value.get("phase") not in PHASES
+        or (
+            value.get("current_stage") is not None
+            and value["current_stage"] not in definition["stages"]
+        )
+        or not isinstance(value.get("history_definition_ids"), list)
+        or len(value["history_definition_ids"]) > 16
+        or len(value["history_definition_ids"])
+        != len(set(value["history_definition_ids"]))
+        or not all(
+            item in _accepted_definition_ids(definition)
+            for item in value["history_definition_ids"]
+        )
+        or not isinstance(value.get("artifacts"), list)
+        or len(value["artifacts"]) > 128
+        or not all(
+            _artifact_matches_state(artifact, value)
+            for artifact in value["artifacts"]
+        )
+        or len(
+            {
+                artifact["artifact_id"]
+                for artifact in value["artifacts"]
+            }
+        )
+        != len(value["artifacts"])
+        or not isinstance(
+            value.get("invalidated_artifact_ids"), list
+        )
+        or len(value["invalidated_artifact_ids"])
+        != len(set(value["invalidated_artifact_ids"]))
+        or any(
+            _artifact_by_id(value, artifact_id) is None
+            for artifact_id in value["invalidated_artifact_ids"]
+        )
+        or not isinstance(value.get("correction_count"), int)
+        or isinstance(value.get("correction_count"), bool)
+        or value["correction_count"] < 0
+        or value["correction_count"] > MAX_CORRECTION_CYCLES + 1
+        or not isinstance(
+            value.get("responsibility_boundary_expansions"), int
+        )
+        or isinstance(
+            value.get("responsibility_boundary_expansions"), bool
+        )
+        or value["responsibility_boundary_expansions"] < 0
+        or value["responsibility_boundary_expansions"]
+        > MAX_RESPONSIBILITY_BOUNDARY_EXPANSIONS + 16
+        or not isinstance(
+            value.get("responsibility_boundaries"), list
+        )
+        or len(value["responsibility_boundaries"]) > 32
+        or len(value["responsibility_boundaries"])
+        != len(set(value["responsibility_boundaries"]))
+        or not all(
+            _line(item)
+            for item in value["responsibility_boundaries"]
+        )
+        or not isinstance(
+            value.get("seen_correction_fingerprints"), list
+        )
+        or len(value["seen_correction_fingerprints"])
+        > MAX_CORRECTION_CYCLES + 1
+        or len(value["seen_correction_fingerprints"])
+        != len(set(value["seen_correction_fingerprints"]))
+        or not all(
+            digest(item)
+            for item in value["seen_correction_fingerprints"]
+        )
+        or not isinstance(value.get("applied_commands"), list)
+        or len(value["applied_commands"]) > MAX_EVENTS
+    ):
+        return False
+    for item in value["applied_commands"]:
+        if (
+            not isinstance(item, dict)
+            or set(item) != {"idempotency_key", "command_id"}
+            or not _line(item.get("idempotency_key"), maximum=200)
+            or not digest(item.get("command_id"))
+        ):
+            return False
+    if len(
+        {
+            item["idempotency_key"]
+            for item in value["applied_commands"]
+        }
+    ) != len(value["applied_commands"]):
+        return False
+    pending_activity = value["pending_activity"]
+    if pending_activity is not None and (
+        not isinstance(pending_activity, dict)
+        or set(pending_activity)
+        != {
+            "activity_id",
+            "activity_type",
+            "input_artifact_ids",
+            "idempotency_key",
+        }
+        or not _line(pending_activity.get("activity_id"), maximum=200)
+        or not _line(pending_activity.get("activity_type"), maximum=100)
+        or not isinstance(
+            pending_activity.get("input_artifact_ids"), list
+        )
+    ):
+        return False
+    pending_decision = value["pending_decision"]
+    if pending_decision is not None and (
+        not isinstance(pending_decision, dict)
+        or set(pending_decision)
+        != {"request_artifact_id", "checkpoint_id"}
+        or _artifact_by_id(
+            value, pending_decision.get("request_artifact_id")
+        )
+        is None
+        or not digest(pending_decision.get("checkpoint_id"))
+    ):
+        return False
+    latest = value["latest_outcome_judgment"]
+    if latest is not None and (
+        not isinstance(latest, dict)
+        or set(latest)
+        != {
+            "artifact_id",
+            "verdict",
+            "correction_intent",
+            "correction_fingerprint",
+        }
+        or latest.get("verdict") not in OUTCOME_VERDICTS
+        or (
+            latest.get("correction_intent") is not None
+            and latest["correction_intent"] not in CORRECTION_INTENTS
+        )
+        or (
+            latest.get("correction_fingerprint") is not None
+            and not digest(latest["correction_fingerprint"])
+        )
+    ):
+        return False
+    if (
+        value["phase"] == "new"
+        and (
+            value["revision"] != 0
+            or value["current_stage"] is not None
+        )
+    ):
+        return False
+    if value["phase"] == "waiting_activity" and pending_activity is None:
+        return False
+    if value["phase"] == "waiting_decision" and pending_decision is None:
+        return False
+    if value["phase"] == "terminal" and value["status"] not in {
+        "DONE",
+        "BLOCKED",
+    }:
+        return False
+    if value["status"] == "DONE" and value["phase"] != "terminal":
+        return False
+    if (
+        value["outcome_contract_artifact_id"] is not None
+        and (
+            (
+                artifact := _artifact_by_id(
+                    value, value["outcome_contract_artifact_id"]
+                )
+            )
+            is None
+            or artifact.get("artifact_type") != "OutcomeContract"
+        )
+    ):
+        return False
+    if value["checkpoint_id"] is not None and not digest(
+        value["checkpoint_id"]
+    ):
+        return False
+    return (
+        digest(value.get("state_id"))
+        and value["state_id"] == _state_identity(value)
+    )
+
+
+def _command_payload_valid(
+    state: dict[str, Any],
+    definition: dict[str, Any],
+    command: dict[str, Any],
+) -> bool:
+    payload = command["payload"]
+    command_type = command["command_type"]
+    if command_type == "START_WORKFLOW":
+        return (
+            set(payload)
+            == {"outcome_contract", "responsibility_boundaries"}
+            and _artifact_matches_state(
+                payload.get("outcome_contract"),
+                state,
+                "OutcomeContract",
+            )
+            and isinstance(
+                payload.get("responsibility_boundaries"), list
+            )
+            and bool(payload["responsibility_boundaries"])
+            and len(payload["responsibility_boundaries"]) <= 16
+            and len(payload["responsibility_boundaries"])
+            == len(set(payload["responsibility_boundaries"]))
+            and all(
+                _line(item)
+                for item in payload["responsibility_boundaries"]
+            )
+        )
+    if command_type == "REGISTER_ARTIFACT":
+        return set(payload) == {"artifact"} and _artifact_matches_state(
+            payload.get("artifact"), state
+        )
+    if command_type == "REQUEST_ACTIVITY":
+        return (
+            set(payload)
+            == {
+                "activity_id",
+                "activity_type",
+                "input_artifact_ids",
+            }
+            and _line(payload.get("activity_id"), maximum=200)
+            and _line(payload.get("activity_type"), maximum=100)
+            and isinstance(payload.get("input_artifact_ids"), list)
+            and len(payload["input_artifact_ids"]) <= 32
+            and len(payload["input_artifact_ids"])
+            == len(set(payload["input_artifact_ids"]))
+            and all(
+                _artifact_by_id(state, item) is not None
+                for item in payload["input_artifact_ids"]
+            )
+        )
+    if command_type == "COMPLETE_ACTIVITY":
+        return (
+            set(payload)
+            == {"activity_id", "result_artifact", "next_stage"}
+            and _line(payload.get("activity_id"), maximum=200)
+            and _artifact_matches_state(
+                payload.get("result_artifact"), state
+            )
+            and payload.get("next_stage") in definition["stages"]
+        )
+    if command_type == "FAIL_ACTIVITY":
+        return (
+            set(payload)
+            == {"activity_id", "evidence_artifact", "retryable"}
+            and _line(payload.get("activity_id"), maximum=200)
+            and _artifact_matches_state(
+                payload.get("evidence_artifact"),
+                state,
+                "EvidencePacket",
+            )
+            and isinstance(payload.get("retryable"), bool)
+        )
+    if command_type == "RECORD_STRUCTURAL_VERDICT":
+        return (
+            set(payload) == {"verdict_artifact", "status"}
+            and _artifact_matches_state(
+                payload.get("verdict_artifact"),
+                state,
+                "VerificationVerdict",
+            )
+            and payload.get("status") in {"PASS", "FAIL"}
+        )
+    if command_type == "RECORD_OUTCOME_JUDGMENT":
+        return (
+            set(payload)
+            == {
+                "judgment_artifact",
+                "verdict",
+                "correction_intent",
+                "correction_fingerprint",
+            }
+            and _artifact_matches_state(
+                payload.get("judgment_artifact"),
+                state,
+                "OutcomeJudgment",
+            )
+            and payload.get("verdict") in OUTCOME_VERDICTS
+            and (
+                payload.get("correction_intent") is None
+                or payload["correction_intent"] in CORRECTION_INTENTS
+            )
+            and (
+                payload.get("correction_fingerprint") is None
+                or digest(payload["correction_fingerprint"])
+            )
+        )
+    if command_type == "REQUEST_DECISION":
+        return set(payload) == {
+            "request_artifact"
+        } and _artifact_matches_state(
+            payload.get("request_artifact"),
+            state,
+            "DecisionRequest",
+        )
+    if command_type == "RESOLVE_DECISION":
+        return (
+            set(payload)
+            == {
+                "resolution_artifact",
+                "checkpoint_id",
+                "verdict",
+                "return_stage",
+                "invalidated_artifact_ids",
+                "correction_fingerprint",
+                "responsibility_boundary_additions",
+            }
+            and _artifact_matches_state(
+                payload.get("resolution_artifact"),
+                state,
+                "DecisionResolution",
+            )
+            and digest(payload.get("checkpoint_id"))
+            and payload.get("verdict") in {
+                "DONE",
+                "CONTINUE",
+                "BLOCKED",
+            }
+            and (
+                payload.get("return_stage") is None
+                or payload["return_stage"] in definition["stages"]
+            )
+            and isinstance(
+                payload.get("invalidated_artifact_ids"), list
+            )
+            and len(payload["invalidated_artifact_ids"]) <= 32
+            and len(payload["invalidated_artifact_ids"])
+            == len(set(payload["invalidated_artifact_ids"]))
+            and all(
+                _artifact_by_id(state, artifact_id) is not None
+                for artifact_id in payload[
+                    "invalidated_artifact_ids"
+                ]
+            )
+            and (
+                payload.get("correction_fingerprint") is None
+                or digest(payload["correction_fingerprint"])
+            )
+            and isinstance(
+                payload.get("responsibility_boundary_additions"),
+                list,
+            )
+            and len(payload["responsibility_boundary_additions"]) <= 16
+            and len(payload["responsibility_boundary_additions"])
+            == len(set(payload["responsibility_boundary_additions"]))
+            and all(
+                _line(item)
+                for item in payload[
+                    "responsibility_boundary_additions"
+                ]
+            )
+        )
+    if command_type == "BLOCK_WORKFLOW":
+        return (
+            set(payload) == {"reason", "evidence_artifact_id"}
+            and _line(payload.get("reason"))
+            and (
+                payload.get("evidence_artifact_id") is None
+                or _artifact_by_id(
+                    state, payload["evidence_artifact_id"]
+                )
+                is not None
+            )
+        )
+    return False
+
+
+def _events_for_command(
+    state: dict[str, Any],
+    definition: dict[str, Any],
+    command: dict[str, Any],
+) -> list[dict[str, Any]]:
+    command_type = command["command_type"]
+    payload = command["payload"]
+    if state["phase"] == "terminal":
+        raise MaestroError(
+            "WORKFLOW_TERMINAL",
+            "A terminal workflow cannot accept another command.",
+        )
+    if command_type == "START_WORKFLOW":
+        if state["phase"] != "new":
+            raise MaestroError(
+                "WORKFLOW_ALREADY_STARTED",
+                "Workflow start is allowed exactly once.",
+            )
+        return [_event(state, command, "WorkflowStarted", payload)]
+    if state["phase"] == "new":
+        raise MaestroError(
+            "WORKFLOW_NOT_STARTED",
+            "Start the workflow before applying other commands.",
+        )
+    if command_type == "REGISTER_ARTIFACT":
+        artifact = payload["artifact"]
+        existing = _artifact_by_id(state, artifact["artifact_id"])
+        if existing is not None and existing != artifact:
+            raise MaestroError(
+                "WORKFLOW_ARTIFACT_CONFLICT",
+                "The artifact identity already binds different facts.",
+            )
+        return [_event(state, command, "ArtifactRegistered", payload)]
+    if command_type == "REQUEST_ACTIVITY":
+        if (
+            state["phase"] != "running"
+            or state["pending_activity"] is not None
+        ):
+            raise MaestroError(
+                "WORKFLOW_ACTIVITY_NOT_REQUESTABLE",
+                "Only one Activity may be pending at a time.",
+            )
+        return [_event(state, command, "ActivityRequested", payload)]
+    if command_type in {"COMPLETE_ACTIVITY", "FAIL_ACTIVITY"}:
+        pending = state["pending_activity"]
+        if (
+            state["phase"] != "waiting_activity"
+            or not isinstance(pending, dict)
+            or pending["activity_id"] != payload["activity_id"]
+        ):
+            raise MaestroError(
+                "WORKFLOW_ACTIVITY_BINDING_MISMATCH",
+                "Activity result must match the exact pending Activity.",
+            )
+        if command_type == "COMPLETE_ACTIVITY" and not _transition_allowed(
+            definition,
+            from_stage=state["current_stage"],
+            to_stage=payload["next_stage"],
+            trigger="activity_completed",
+        ):
+            raise MaestroError(
+                "WORKFLOW_TRANSITION_FORBIDDEN",
+                "Activity completion requested an undeclared transition.",
+            )
+        return [
+            _event(
+                state,
+                command,
+                (
+                    "ActivityCompleted"
+                    if command_type == "COMPLETE_ACTIVITY"
+                    else "ActivityFailed"
+                ),
+                payload,
+            )
+        ]
+    if command_type == "RECORD_STRUCTURAL_VERDICT":
+        if state["phase"] != "running":
+            raise MaestroError(
+                "WORKFLOW_STRUCTURAL_GATE_NOT_READY",
+                "Structural verdict requires a running workflow.",
+            )
+        return [
+            _event(
+                state,
+                command,
+                "StructuralVerdictRecorded",
+                payload,
+            )
+        ]
+    if command_type == "RECORD_OUTCOME_JUDGMENT":
+        if (
+            state["phase"] != "running"
+            or state["structural_verdict_artifact_id"] is None
+        ):
+            raise MaestroError(
+                "WORKFLOW_OUTCOME_JUDGE_NOT_READY",
+                "Outcome Judgment requires a passed Structural Gate.",
+            )
+        return [
+            _event(
+                state,
+                command,
+                "OutcomeJudgmentRecorded",
+                payload,
+            )
+        ]
+    if command_type == "REQUEST_DECISION":
+        if (
+            state["phase"] != "running"
+            or state["pending_decision"] is not None
+        ):
+            raise MaestroError(
+                "WORKFLOW_DECISION_NOT_REQUESTABLE",
+                "Generic interrupt requires a running workflow with no pending decision.",
+            )
+        return [_event(state, command, "DecisionRequested", payload)]
+    if command_type == "RESOLVE_DECISION":
+        pending = state["pending_decision"]
+        if (
+            state["phase"] != "waiting_decision"
+            or not isinstance(pending, dict)
+            or payload["checkpoint_id"] != pending["checkpoint_id"]
+        ):
+            raise MaestroError(
+                "WORKFLOW_CHECKPOINT_MISMATCH",
+                "Decision resolution must resume the exact pending checkpoint.",
+            )
+        verdict = payload["verdict"]
+        return_stage = payload["return_stage"]
+        if verdict == "DONE":
+            if (
+                return_stage is not None
+                or state["current_stage"]
+                not in definition["terminal_stages"]
+            ):
+                raise MaestroError(
+                    "WORKFLOW_DONE_NOT_ALLOWED",
+                    "DONE requires a terminal workflow stage and no return stage.",
+                )
+        elif verdict == "BLOCKED":
+            if return_stage is not None:
+                raise MaestroError(
+                    "WORKFLOW_BLOCKED_RETURN_STAGE_INVALID",
+                    "BLOCKED cannot carry a return stage.",
+                )
+        else:
+            if (
+                return_stage is None
+                or not _transition_allowed(
+                    definition,
+                    from_stage=state["current_stage"],
+                    to_stage=return_stage,
+                    trigger="decision_resolved",
+                )
+            ):
+                raise MaestroError(
+                    "WORKFLOW_TRANSITION_FORBIDDEN",
+                    "Decision resolution requested an undeclared return transition.",
+                )
+        return [_event(state, command, "DecisionResolved", payload)]
+    if command_type == "BLOCK_WORKFLOW":
+        return [_event(state, command, "WorkflowBlocked", payload)]
+    raise MaestroError(
+        "WORKFLOW_COMMAND_UNSUPPORTED",
+        f"Unsupported workflow command: {command_type}",
+    )
+
+
+def apply_event(
+    state: dict[str, Any],
+    definition: dict[str, Any],
+    event: dict[str, Any],
+) -> dict[str, Any]:
+    if (
+        not validate_workflow_state(state, definition)
+        or not validate_workflow_event(event, definition)
+        or event["workflow_instance_id"]
+        != state["workflow_instance_id"]
+        or event["root_request_id"] != state["root_request_id"]
+        or event["sequence"] != state["revision"] + 1
+    ):
+        raise MaestroError(
+            "WORKFLOW_EVENT_NOT_APPLICABLE",
+            "Workflow event does not match the exact current state revision.",
+        )
+    replay_command = {
+        "command_id": event["command_id"],
+        "definition_id": event["definition_id"],
+        "idempotency_key": event["idempotency_key"],
+        "command_type": _COMMAND_BY_EVENT[event["event_type"]],
+        "payload": copy.deepcopy(event["payload"]),
+    }
+    if not _command_payload_valid(
+        state, definition, replay_command
+    ):
+        raise MaestroError(
+            "WORKFLOW_EVENT_PAYLOAD_INVALID",
+            "Workflow event payload violates the generic command contract.",
+        )
+    expected_events = _events_for_command(
+        state, definition, replay_command
+    )
+    if len(expected_events) != 1 or expected_events[0] != event:
+        raise MaestroError(
+            "WORKFLOW_EVENT_CAUSALITY_INVALID",
+            "Workflow event cannot be reproduced from the prior state and command identity.",
+        )
+    updated = copy.deepcopy(state)
+    event_type = event["event_type"]
+    payload = event["payload"]
+    definition_id = event["definition_id"]
+    if definition_id not in updated["history_definition_ids"]:
+        updated["history_definition_ids"].append(definition_id)
+
+    def register(artifact: dict[str, Any]) -> None:
+        existing = _artifact_by_id(updated, artifact["artifact_id"])
+        if existing is None:
+            updated["artifacts"].append(copy.deepcopy(artifact))
+        elif existing != artifact:
+            raise MaestroError(
+                "WORKFLOW_ARTIFACT_CONFLICT",
+                "Artifact replay encountered conflicting content.",
+            )
+
+    if event_type == "WorkflowStarted":
+        contract = payload["outcome_contract"]
+        register(contract)
+        updated["current_stage"] = definition["initial_stage"]
+        updated["outcome_contract_artifact_id"] = contract[
+            "artifact_id"
+        ]
+        updated["responsibility_boundaries"] = copy.deepcopy(
+            payload["responsibility_boundaries"]
+        )
+        updated["phase"] = "running"
+        updated["status"] = "CONTINUE"
+    elif event_type == "ArtifactRegistered":
+        register(payload["artifact"])
+    elif event_type == "ActivityRequested":
+        updated["pending_activity"] = {
+            **copy.deepcopy(payload),
+            "idempotency_key": event["idempotency_key"],
+        }
+        updated["phase"] = "waiting_activity"
+    elif event_type == "ActivityCompleted":
+        register(payload["result_artifact"])
+        updated["pending_activity"] = None
+        updated["current_stage"] = payload["next_stage"]
+        updated["phase"] = "running"
+        updated["status"] = "CONTINUE"
+    elif event_type == "ActivityFailed":
+        register(payload["evidence_artifact"])
+        updated["pending_activity"] = None
+        if payload["retryable"]:
+            updated["phase"] = "running"
+            updated["status"] = "CONTINUE"
+        else:
+            updated["phase"] = "terminal"
+            updated["status"] = "BLOCKED"
+            updated["structure_review_reason"] = (
+                "activity-failed-non-retryable"
+            )
+    elif event_type == "StructuralVerdictRecorded":
+        register(payload["verdict_artifact"])
+        updated["structural_verdict_artifact_id"] = payload[
+            "verdict_artifact"
+        ]["artifact_id"]
+        if payload["status"] == "FAIL":
+            updated["phase"] = "terminal"
+            updated["status"] = "BLOCKED"
+            updated["structure_review_reason"] = (
+                "structural-gate-failed"
+            )
+    elif event_type == "OutcomeJudgmentRecorded":
+        register(payload["judgment_artifact"])
+        updated["latest_outcome_judgment"] = {
+            "artifact_id": payload["judgment_artifact"][
+                "artifact_id"
+            ],
+            "verdict": payload["verdict"],
+            "correction_intent": payload["correction_intent"],
+            "correction_fingerprint": payload[
+                "correction_fingerprint"
+            ],
+        }
+    elif event_type == "DecisionRequested":
+        register(payload["request_artifact"])
+        updated["phase"] = "waiting_decision"
+        updated["status"] = "NEEDS_DECISION"
+        updated["checkpoint_id"] = event["event_id"]
+        updated["pending_decision"] = {
+            "request_artifact_id": payload["request_artifact"][
+                "artifact_id"
+            ],
+            "checkpoint_id": event["event_id"],
+        }
+    elif event_type == "DecisionResolved":
+        register(payload["resolution_artifact"])
+        updated["pending_decision"] = None
+        updated["checkpoint_id"] = None
+        verdict = payload["verdict"]
+        if verdict == "DONE":
+            updated["status"] = "DONE"
+            updated["phase"] = "terminal"
+        elif verdict == "BLOCKED":
+            updated["status"] = "BLOCKED"
+            updated["phase"] = "terminal"
+            updated["structure_review_reason"] = "owner-blocked"
+        else:
+            updated["status"] = "CONTINUE"
+            updated["phase"] = "running"
+            updated["current_stage"] = payload["return_stage"]
+            updated["correction_count"] += 1
+            fingerprint = payload["correction_fingerprint"]
+            repeated = (
+                fingerprint is not None
+                and fingerprint
+                in updated["seen_correction_fingerprints"]
+            )
+            if fingerprint is not None and not repeated:
+                updated["seen_correction_fingerprints"].append(
+                    fingerprint
+                )
+            for artifact_id in payload[
+                "invalidated_artifact_ids"
+            ]:
+                if (
+                    artifact_id
+                    not in updated["invalidated_artifact_ids"]
+                ):
+                    updated["invalidated_artifact_ids"].append(
+                        artifact_id
+                    )
+            additions = [
+                item
+                for item in payload[
+                    "responsibility_boundary_additions"
+                ]
+                if item not in updated["responsibility_boundaries"]
+            ]
+            updated["responsibility_boundaries"].extend(additions)
+            updated["responsibility_boundary_expansions"] += len(
+                additions
+            )
+            if repeated:
+                updated["status"] = "BLOCKED"
+                updated["phase"] = "terminal"
+                updated["current_stage"] = payload["return_stage"]
+                updated["structure_review_reason"] = (
+                    "repeated-failure-without-new-evidence"
+                )
+            elif updated["correction_count"] > MAX_CORRECTION_CYCLES:
+                updated["status"] = "BLOCKED"
+                updated["phase"] = "terminal"
+                updated["structure_review_reason"] = (
+                    "correction-limit-exceeded"
+                )
+            elif (
+                updated["responsibility_boundary_expansions"]
+                > MAX_RESPONSIBILITY_BOUNDARY_EXPANSIONS
+            ):
+                updated["status"] = "BLOCKED"
+                updated["phase"] = "terminal"
+                updated["structure_review_reason"] = (
+                    "responsibility-boundary-expansion-exceeded"
+                )
+    elif event_type == "WorkflowBlocked":
+        updated["status"] = "BLOCKED"
+        updated["phase"] = "terminal"
+        updated["structure_review_reason"] = payload["reason"]
+    else:  # pragma: no cover - closed by validation
+        raise MaestroError(
+            "WORKFLOW_EVENT_UNSUPPORTED",
+            f"Unsupported workflow event: {event_type}",
+        )
+    updated["revision"] = event["sequence"]
+    updated["applied_commands"].append(
+        {
+            "idempotency_key": event["idempotency_key"],
+            "command_id": event["command_id"],
+        }
+    )
+    updated["state_id"] = ""
+    updated["state_id"] = _state_identity(updated)
+    if not validate_workflow_state(updated, definition):
+        raise MaestroError(
+            "WORKFLOW_REDUCER_INVARIANT_FAILED",
+            "Applied event produced an invalid workflow state.",
+        )
+    return updated
+
+
+def reduce_command(
+    state: dict[str, Any],
+    definition: dict[str, Any],
+    command: dict[str, Any],
+) -> tuple[dict[str, Any], list[dict[str, Any]]]:
+    if (
+        not validate_workflow_state(state, definition)
+        or not validate_command(command)
+        or command["workflow_instance_id"]
+        != state["workflow_instance_id"]
+        or command["root_request_id"] != state["root_request_id"]
+        or command["definition_id"] != definition["definition_id"]
+    ):
+        raise MaestroError(
+            "WORKFLOW_COMMAND_BINDING_INVALID",
+            "Command must bind the exact workflow instance, root request, and active definition.",
+        )
+    existing = next(
+        (
+            item
+            for item in state["applied_commands"]
+            if item["idempotency_key"] == command["idempotency_key"]
+        ),
+        None,
+    )
+    if existing is not None:
+        if existing["command_id"] == command["command_id"]:
+            return copy.deepcopy(state), []
+        raise MaestroError(
+            "WORKFLOW_COMMAND_IDEMPOTENCY_CONFLICT",
+            "The idempotency key already binds a different command.",
+        )
+    if command["expected_revision"] != state["revision"]:
+        raise MaestroError(
+            "WORKFLOW_STALE_REVISION",
+            "Reload the current checkpoint before applying this command.",
+        )
+    if not _command_payload_valid(state, definition, command):
+        raise MaestroError(
+            "WORKFLOW_COMMAND_PAYLOAD_INVALID",
+            "Command payload violates the generic workflow contract.",
+        )
+    events = _events_for_command(state, definition, command)
+    updated = copy.deepcopy(state)
+    for event in events:
+        updated = apply_event(updated, definition, event)
+    return updated, events
+
+
+def replay_events(
+    definition: dict[str, Any],
+    *,
+    workflow_instance_id: str,
+    root_request_id: str,
+    events: Iterable[dict[str, Any]],
+) -> dict[str, Any]:
+    state = empty_workflow_state(
+        definition,
+        workflow_instance_id=workflow_instance_id,
+        root_request_id=root_request_id,
+    )
+    for event in events:
+        state = apply_event(state, definition, event)
+    return state
+
+
+__all__ = [
+    "EVENT_TYPES",
+    "WORKFLOW_EVENT_VERSION",
+    "WORKFLOW_STATE_VERSION",
+    "apply_event",
+    "empty_workflow_state",
+    "reduce_command",
+    "replay_events",
+    "validate_workflow_event",
+    "validate_workflow_state",
+]
