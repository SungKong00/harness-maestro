diff --git a/src/maestro/workflow/activities.py b/src/maestro/workflow/activities.py
new file mode 100644
index 0000000000000000000000000000000000000000..d6b92d4f7c13954a6fb3e5381bad7b723d76da31
--- /dev/null
+++ b/src/maestro/workflow/activities.py
@@ -0,0 +1,463 @@
+from __future__ import annotations
+
+import copy
+from pathlib import Path
+from typing import Any, Callable, Protocol
+
+from maestro.errors import MaestroError
+from maestro.util import (
+    atomic_write,
+    canonical_json,
+    pretty_json,
+    read_json,
+    sha256_text,
+)
+from maestro.work.ledger import observation_write_lock
+
+from .contracts import digest, validate_artifact_envelope
+from .kernel import validate_workflow_event
+
+
+ACTIVITY_REQUEST_VERSION = "maestro_activity_request_v1"
+ACTIVITY_RESULT_VERSION = "maestro_activity_result_v1"
+ACTIVITY_JOURNAL_VERSION = "maestro_activity_journal_v1"
+
+
+def _line(value: Any, *, maximum: int = 500) -> bool:
+    return (
+        isinstance(value, str)
+        and value == value.strip()
+        and bool(value)
+        and len(value) <= maximum
+        and not any(character in value for character in "\r\n\x00")
+    )
+
+
+def _identity(value: dict[str, Any], field: str) -> str:
+    payload = copy.deepcopy(value)
+    payload[field] = ""
+    return sha256_text(canonical_json(payload))
+
+
+def validate_activity_request(value: Any) -> bool:
+    fields = {
+        "schema_version",
+        "request_id",
+        "workflow_instance_id",
+        "root_request_id",
+        "activity_id",
+        "activity_type",
+        "idempotency_key",
+        "input_artifact_ids",
+        "input_digest",
+    }
+    return (
+        isinstance(value, dict)
+        and set(value) == fields
+        and value.get("schema_version") == ACTIVITY_REQUEST_VERSION
+        and digest(value.get("request_id"))
+        and value["request_id"] == _identity(value, "request_id")
+        and _line(value.get("workflow_instance_id"), maximum=200)
+        and _line(value.get("root_request_id"), maximum=200)
+        and _line(value.get("activity_id"), maximum=200)
+        and _line(value.get("activity_type"), maximum=100)
+        and _line(value.get("idempotency_key"), maximum=200)
+        and isinstance(value.get("input_artifact_ids"), list)
+        and len(value["input_artifact_ids"]) <= 32
+        and len(value["input_artifact_ids"])
+        == len(set(value["input_artifact_ids"]))
+        and all(digest(item) for item in value["input_artifact_ids"])
+        and digest(value.get("input_digest"))
+    )
+
+
+def activity_request_from_event(
+    event: dict[str, Any],
+    definition: dict[str, Any],
+) -> dict[str, Any]:
+    if (
+        not validate_workflow_event(event, definition)
+        or event.get("event_type") != "ActivityRequested"
+    ):
+        raise MaestroError(
+            "ACTIVITY_REQUEST_EVENT_INVALID",
+            "Activity Runner requires one validated ActivityRequested event.",
+        )
+    payload = event["payload"]
+    input_artifact_ids = copy.deepcopy(
+        payload["input_artifact_ids"]
+    )
+    value = {
+        "schema_version": ACTIVITY_REQUEST_VERSION,
+        "request_id": "",
+        "workflow_instance_id": event["workflow_instance_id"],
+        "root_request_id": event["root_request_id"],
+        "activity_id": payload["activity_id"],
+        "activity_type": payload["activity_type"],
+        "idempotency_key": event["idempotency_key"],
+        "input_artifact_ids": input_artifact_ids,
+        "input_digest": sha256_text(
+            canonical_json(
+                {
+                    "activity_id": payload["activity_id"],
+                    "activity_type": payload["activity_type"],
+                    "input_artifact_ids": input_artifact_ids,
+                }
+            )
+        ),
+    }
+    value["request_id"] = _identity(value, "request_id")
+    if not validate_activity_request(value):
+        raise MaestroError(
+            "ACTIVITY_REQUEST_INVALID",
+            "Activity request projection is invalid.",
+        )
+    return value
+
+
+def validate_activity_result(value: Any) -> bool:
+    fields = {
+        "schema_version",
+        "result_id",
+        "request_id",
+        "input_digest",
+        "status",
+        "result_artifact",
+        "error_digest",
+        "attempt",
+    }
+    if (
+        not isinstance(value, dict)
+        or set(value) != fields
+        or value.get("schema_version") != ACTIVITY_RESULT_VERSION
+        or not digest(value.get("result_id"))
+        or value["result_id"] != _identity(value, "result_id")
+        or not digest(value.get("request_id"))
+        or not digest(value.get("input_digest"))
+        or value.get("status") not in {"completed", "failed"}
+        or value.get("attempt") != 1
+    ):
+        return False
+    if value["status"] == "completed":
+        return (
+            validate_artifact_envelope(value["result_artifact"])
+            and value["error_digest"] is None
+        )
+    return value["result_artifact"] is None and digest(
+        value["error_digest"]
+    )
+
+
+class ActivityJournal(Protocol):
+    def begin(
+        self,
+        *,
+        idempotency_key: str,
+        input_digest: str,
+    ) -> dict[str, Any]:
+        ...
+
+    def complete(
+        self,
+        *,
+        idempotency_key: str,
+        input_digest: str,
+        result: dict[str, Any],
+    ) -> dict[str, Any]:
+        ...
+
+
+def _new_journal() -> dict[str, Any]:
+    return {
+        "schema_version": ACTIVITY_JOURNAL_VERSION,
+        "entries": [],
+    }
+
+
+def _valid_journal(value: Any) -> bool:
+    if (
+        not isinstance(value, dict)
+        or set(value) != {"schema_version", "entries"}
+        or value.get("schema_version") != ACTIVITY_JOURNAL_VERSION
+        or not isinstance(value.get("entries"), list)
+        or len(value["entries"]) > 256
+    ):
+        return False
+    keys: set[str] = set()
+    for entry in value["entries"]:
+        if (
+            not isinstance(entry, dict)
+            or set(entry)
+            != {
+                "idempotency_key",
+                "input_digest",
+                "status",
+                "result",
+            }
+            or not _line(
+                entry.get("idempotency_key"), maximum=200
+            )
+            or not digest(entry.get("input_digest"))
+            or entry.get("status") not in {"started", "completed"}
+            or (
+                entry["status"] == "started"
+                and entry["result"] is not None
+            )
+            or (
+                entry["status"] == "completed"
+                and not validate_activity_result(entry["result"])
+            )
+            or entry["idempotency_key"] in keys
+        ):
+            return False
+        keys.add(entry["idempotency_key"])
+    return True
+
+
+def _begin(
+    journal: dict[str, Any],
+    *,
+    idempotency_key: str,
+    input_digest: str,
+) -> tuple[dict[str, Any], dict[str, Any]]:
+    if not _valid_journal(journal):
+        raise MaestroError(
+            "ACTIVITY_JOURNAL_INVALID",
+            "Activity journal is corrupt.",
+        )
+    existing = next(
+        (
+            entry
+            for entry in journal["entries"]
+            if entry["idempotency_key"] == idempotency_key
+        ),
+        None,
+    )
+    if existing is not None:
+        if existing["input_digest"] != input_digest:
+            raise MaestroError(
+                "ACTIVITY_IDEMPOTENCY_CONFLICT",
+                "Activity idempotency key already binds different inputs.",
+            )
+        returned = copy.deepcopy(existing)
+        returned["_new"] = False
+        return copy.deepcopy(journal), returned
+    updated = copy.deepcopy(journal)
+    entry = {
+        "idempotency_key": idempotency_key,
+        "input_digest": input_digest,
+        "status": "started",
+        "result": None,
+    }
+    updated["entries"].append(entry)
+    returned = copy.deepcopy(entry)
+    returned["_new"] = True
+    return updated, returned
+
+
+def _complete(
+    journal: dict[str, Any],
+    *,
+    idempotency_key: str,
+    input_digest: str,
+    result: dict[str, Any],
+) -> dict[str, Any]:
+    if not _valid_journal(journal) or not validate_activity_result(
+        result
+    ):
+        raise MaestroError(
+            "ACTIVITY_JOURNAL_INVALID",
+            "Cannot complete an invalid Activity journal or result.",
+        )
+    updated = copy.deepcopy(journal)
+    entry = next(
+        (
+            item
+            for item in updated["entries"]
+            if item["idempotency_key"] == idempotency_key
+        ),
+        None,
+    )
+    if entry is None or entry["input_digest"] != input_digest:
+        raise MaestroError(
+            "ACTIVITY_JOURNAL_ENTRY_MISSING",
+            "Activity must be durably started before completion.",
+        )
+    if entry["status"] == "completed":
+        if entry["result"] != result:
+            raise MaestroError(
+                "ACTIVITY_RESULT_CONFLICT",
+                "Completed Activity cannot be replaced by another result.",
+            )
+        return updated
+    entry["status"] = "completed"
+    entry["result"] = copy.deepcopy(result)
+    return updated
+
+
+class InMemoryActivityJournal:
+    def __init__(self) -> None:
+        self.value = _new_journal()
+
+    def begin(
+        self,
+        *,
+        idempotency_key: str,
+        input_digest: str,
+    ) -> dict[str, Any]:
+        self.value, entry = _begin(
+            self.value,
+            idempotency_key=idempotency_key,
+            input_digest=input_digest,
+        )
+        return entry
+
+    def complete(
+        self,
+        *,
+        idempotency_key: str,
+        input_digest: str,
+        result: dict[str, Any],
+    ) -> dict[str, Any]:
+        self.value = _complete(
+            self.value,
+            idempotency_key=idempotency_key,
+            input_digest=input_digest,
+            result=result,
+        )
+        return copy.deepcopy(result)
+
+
+class FileActivityJournal:
+    def __init__(self, path: str | Path) -> None:
+        self.path = Path(path)
+
+    def _read(self) -> dict[str, Any]:
+        if not self.path.exists():
+            return _new_journal()
+        value = read_json(self.path)
+        if not _valid_journal(value):
+            raise MaestroError(
+                "ACTIVITY_JOURNAL_INVALID",
+                "Persistent Activity journal is corrupt.",
+            )
+        return value
+
+    def begin(
+        self,
+        *,
+        idempotency_key: str,
+        input_digest: str,
+    ) -> dict[str, Any]:
+        with observation_write_lock(self.path):
+            updated, entry = _begin(
+                self._read(),
+                idempotency_key=idempotency_key,
+                input_digest=input_digest,
+            )
+            atomic_write(
+                self.path, pretty_json(updated).encode("utf-8")
+            )
+            return entry
+
+    def complete(
+        self,
+        *,
+        idempotency_key: str,
+        input_digest: str,
+        result: dict[str, Any],
+    ) -> dict[str, Any]:
+        with observation_write_lock(self.path):
+            updated = _complete(
+                self._read(),
+                idempotency_key=idempotency_key,
+                input_digest=input_digest,
+                result=result,
+            )
+            atomic_write(
+                self.path, pretty_json(updated).encode("utf-8")
+            )
+            return copy.deepcopy(result)
+
+
+def run_activity(
+    request: dict[str, Any],
+    handler: Callable[[dict[str, Any]], dict[str, Any]],
+    *,
+    journal: ActivityJournal,
+) -> dict[str, Any]:
+    if not validate_activity_request(request):
+        raise MaestroError(
+            "ACTIVITY_REQUEST_INVALID",
+            "Activity Runner requires a valid request.",
+        )
+    entry = journal.begin(
+        idempotency_key=request["idempotency_key"],
+        input_digest=request["input_digest"],
+    )
+    if entry["status"] == "completed":
+        return copy.deepcopy(entry["result"])
+    if entry.get("_new") is False:
+        raise MaestroError(
+            "ACTIVITY_RECONCILIATION_REQUIRED",
+            "An Activity started before interruption; reconcile it instead of running the side effect twice.",
+        )
+    try:
+        artifact = handler(copy.deepcopy(request))
+        if (
+            not validate_artifact_envelope(artifact)
+            or artifact["root_request_id"]
+            != request["root_request_id"]
+            or artifact["workflow_instance_id"]
+            != request["workflow_instance_id"]
+        ):
+            raise MaestroError(
+                "ACTIVITY_RESULT_ARTIFACT_INVALID",
+                "Activity returned an invalid or cross-request artifact.",
+            )
+        result = {
+            "schema_version": ACTIVITY_RESULT_VERSION,
+            "result_id": "",
+            "request_id": request["request_id"],
+            "input_digest": request["input_digest"],
+            "status": "completed",
+            "result_artifact": copy.deepcopy(artifact),
+            "error_digest": None,
+            "attempt": 1,
+        }
+    except Exception as exc:
+        result = {
+            "schema_version": ACTIVITY_RESULT_VERSION,
+            "result_id": "",
+            "request_id": request["request_id"],
+            "input_digest": request["input_digest"],
+            "status": "failed",
+            "result_artifact": None,
+            "error_digest": sha256_text(
+                f"{type(exc).__name__}:{exc}"
+            ),
+            "attempt": 1,
+        }
+    result["result_id"] = _identity(result, "result_id")
+    if not validate_activity_result(result):
+        raise MaestroError(
+            "ACTIVITY_RESULT_INVALID",
+            "Activity Runner produced an invalid result.",
+        )
+    return journal.complete(
+        idempotency_key=request["idempotency_key"],
+        input_digest=request["input_digest"],
+        result=result,
+    )
+
+
+__all__ = [
+    "ACTIVITY_REQUEST_VERSION",
+    "ACTIVITY_RESULT_VERSION",
+    "FileActivityJournal",
+    "InMemoryActivityJournal",
+    "activity_request_from_event",
+    "run_activity",
+    "validate_activity_request",
+    "validate_activity_result",
+]
diff --git a/src/maestro/workflow/adapters.py b/src/maestro/workflow/adapters.py
new file mode 100644
index 0000000000000000000000000000000000000000..fce22ed243d1843d30ff297b7842f54fc1f8a9ce
--- /dev/null
+++ b/src/maestro/workflow/adapters.py
@@ -0,0 +1,49 @@
+from __future__ import annotations
+
+from typing import Any
+
+from maestro.errors import MaestroError
+
+from .contracts import CORRECTION_INTENTS, validate_workflow_definition
+
+
+def map_correction_intent_to_stage(
+    *,
+    definition: dict[str, Any],
+    correction_intent: str,
+    stage_mapping: dict[str, str],
+) -> str:
+    """Resolve a generic Pack intent through an explicit Definition adapter."""
+
+    if not validate_workflow_definition(definition):
+        raise MaestroError(
+            "WORKFLOW_DEFINITION_INVALID",
+            "Correction mapping requires a valid Workflow Definition.",
+        )
+    if correction_intent not in CORRECTION_INTENTS:
+        raise MaestroError(
+            "WORKFLOW_CORRECTION_INTENT_INVALID",
+            "The Pack returned an unsupported correction intent.",
+        )
+    if correction_intent == "request_owner_decision":
+        raise MaestroError(
+            "WORKFLOW_CORRECTION_REQUIRES_DECISION",
+            "Owner-decision intent must use a DecisionRequest, not a stage transition.",
+        )
+    if set(stage_mapping) != CORRECTION_INTENTS - {
+        "request_owner_decision"
+    }:
+        raise MaestroError(
+            "WORKFLOW_CORRECTION_MAPPING_INCOMPLETE",
+            "The Workflow adapter must map every stage-bearing correction intent explicitly.",
+        )
+    target = stage_mapping.get(correction_intent)
+    if target not in definition["stages"]:
+        raise MaestroError(
+            "WORKFLOW_CORRECTION_STAGE_UNMAPPED",
+            "The correction intent does not map to a declared Workflow Stage.",
+        )
+    return target
+
+
+__all__ = ["map_correction_intent_to_stage"]
diff --git a/src/maestro/workflow/artifacts.py b/src/maestro/workflow/artifacts.py
new file mode 100644
index 0000000000000000000000000000000000000000..b8d352f02d0194bc3417baf771c868275df7df51
--- /dev/null
+++ b/src/maestro/workflow/artifacts.py
@@ -0,0 +1,115 @@
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+from maestro.errors import MaestroError
+from maestro.util import (
+    atomic_write,
+    canonical_json,
+    ensure_repo,
+    read_json,
+    safe_target,
+    sha256_text,
+)
+
+from .contracts import (
+    build_artifact_envelope,
+    validate_artifact_envelope,
+)
+
+
+MAX_ARTIFACT_PAYLOAD_BYTES = 1_000_000
+
+
+def put_json_artifact(
+    repo_path: str | Path,
+    *,
+    artifact_type: str,
+    namespace: str,
+    root_request_id: str,
+    workflow_instance_id: str,
+    payload: dict[str, Any],
+    producer: str,
+) -> dict[str, Any]:
+    repo = ensure_repo(repo_path)
+    try:
+        encoded = canonical_json(payload).encode("utf-8")
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise MaestroError(
+            "WORKFLOW_ARTIFACT_PAYLOAD_INVALID",
+            "Artifact payload must be bounded canonical JSON.",
+        ) from exc
+    if not encoded or len(encoded) > MAX_ARTIFACT_PAYLOAD_BYTES:
+        raise MaestroError(
+            "WORKFLOW_ARTIFACT_PAYLOAD_INVALID",
+            "Artifact payload exceeds the bounded artifact store contract.",
+        )
+    payload_digest = sha256_text(encoded.decode("utf-8"))
+    relative_path = (
+        ".maestro/state/workflow-artifacts/"
+        f"{payload_digest}.json"
+    )
+    target = safe_target(repo, relative_path)
+    if target.exists():
+        if not target.is_file() or target.is_symlink():
+            raise MaestroError(
+                "WORKFLOW_ARTIFACT_STORE_UNSAFE",
+                "Artifact path is not a safe regular file.",
+            )
+        if target.read_bytes() != encoded:
+            raise MaestroError(
+                "WORKFLOW_ARTIFACT_STORE_CONFLICT",
+                "Content-addressed artifact path contains different bytes.",
+            )
+    else:
+        atomic_write(target, encoded)
+    return build_artifact_envelope(
+        artifact_type=artifact_type,
+        namespace=namespace,
+        root_request_id=root_request_id,
+        workflow_instance_id=workflow_instance_id,
+        payload_digest=payload_digest,
+        payload_ref=relative_path,
+        producer=producer,
+    )
+
+
+def read_json_artifact(
+    repo_path: str | Path,
+    envelope: dict[str, Any],
+) -> dict[str, Any]:
+    repo = ensure_repo(repo_path)
+    if not validate_artifact_envelope(envelope):
+        raise MaestroError(
+            "WORKFLOW_ARTIFACT_ENVELOPE_INVALID",
+            "Artifact payload reads require one valid envelope.",
+        )
+    target = safe_target(repo, envelope["payload_ref"])
+    if (
+        not target.is_file()
+        or target.is_symlink()
+        or target.stat().st_size > MAX_ARTIFACT_PAYLOAD_BYTES
+    ):
+        raise MaestroError(
+            "WORKFLOW_ARTIFACT_STORE_UNSAFE",
+            "Artifact payload path is missing or unsafe.",
+        )
+    value = read_json(target)
+    if (
+        not isinstance(value, dict)
+        or sha256_text(canonical_json(value))
+        != envelope["payload_digest"]
+    ):
+        raise MaestroError(
+            "WORKFLOW_ARTIFACT_STORE_CONFLICT",
+            "Artifact payload does not match its content-addressed envelope.",
+        )
+    return value
+
+
+__all__ = [
+    "MAX_ARTIFACT_PAYLOAD_BYTES",
+    "put_json_artifact",
+    "read_json_artifact",
+]
diff --git a/src/maestro/workflow/calibration.py b/src/maestro/workflow/calibration.py
