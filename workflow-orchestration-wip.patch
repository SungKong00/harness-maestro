+def validate_packet(
+    *,
+    repo_path: str | Path,
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+    packet: Any,
+    payload: Any,
+    participant_receipt: Mapping[str, Any],
+    semantic_validation_receipt: Mapping[str, Any],
+    attempt_receipt: Mapping[str, Any],
+    expected_stage_spec_id: str,
+    expected_attempt_id: str,
+    expected_input_projection_sha256: str,
+    expected_base_revision: str,
+    now: str,
+    expected_semantic_generation: int | None = None,
+) -> dict[str, Any]:
+    if (
+        not isinstance(packet, dict)
+        or set(packet) != PACKET_FIELDS
+        or packet.get("schema_version") != PACKET_VERSION
+    ):
+        _fail("PacketEnvelope does not match the closed v1 contract.")
+    require_identity(packet["packet_id"], field="packet_id")
+    require_digest(packet["packet_digest"], field="packet_digest")
+    if packet["packet_digest"] != packet_digest(packet):
+        _fail("PacketEnvelope content address is invalid.")
+    stage = stage_specs(definition).get(expected_stage_spec_id)
+    if stage is None:
+        _fail("PacketEnvelope references an unknown expected StageSpec.")
+    role = role_specs(definition)[stage["role_spec_id"]]
+    executor = executor_profiles(definition)[role["executor_profile_id"]]
+    runtime = state["stage_states"][expected_stage_spec_id]
+    generation = (
+        runtime["semantic_generation"]
+        if expected_semantic_generation is None
+        else expected_semantic_generation
+    )
+    if (
+        not isinstance(generation, int)
+        or generation < 0
+        or (
+            expected_semantic_generation is not None
+            and generation not in {
+                runtime["semantic_generation"],
+                runtime["semantic_generation"] + 1,
+            }
+        )
