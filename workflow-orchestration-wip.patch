+)
+
+
+def synthesis_definition(repo: Path) -> dict[str, Any]:
+    definition = high_risk_definition(
+        authorization=authorization_artifacts(repo)
+    )
+    plan = definition["responsibility_plan"]
+    plan["concerns"].append(
+        {
+            "responsibility_id": "concern-synthesis",
+            "summary": "Compare the immutable evidence lanes.",
+            "mandatory": True,
+            "risk_level": "high",
+            "owner_role_spec_id": "role-synthesis",
+            "evidence_refs": ["request:synthesis"],
+        }
+    )
+    plan["roles"].append(
+        {
+            "role_spec_id": "role-synthesis",
+            "responsibility_ids": ["concern-synthesis"],
+            "executor_profile_id": "executor-read",
+            "lens_binding_ids": ["lens-evidence"],
+            "pack_hint_ids": ["pack-hint"],
+            "read_only": True,
+            "mutation_owner": False,
+            "verifier": False,
+            "capability_requirements": ["repository-read"],
+        }
+    )
+    synthesis = stage_fixture(
+        "stage-synthesis",
+        "role-synthesis",
+        dependencies=["stage-left", "stage-right"],
+    )
+    synthesis["stage_kind"] = "evidence-synthesis"
+    plan["stages"].append(synthesis)
+    for role in ("role-left", "role-right"):
+        plan["independence_edges"].append(
+            {
+                "edge_id": f"edge-{role}-synthesis",
+                "left_role_spec_id": role,
+                "right_role_spec_id": "role-synthesis",
+                "dimensions": [
+                    "context",
+                    "invocation",
+                    "authority-effect",
+                ],
+                "mandatory": True,
+                "high_risk": True,
+            }
+        )
+    plan["plan_id"] = responsibility_plan_id(plan)
+    definition["definition_digest"] = definition_digest(definition)
+    return validate_workflow_definition(definition)
+
+
+def direct_definition(
+    repo: Path,
+    *,
+    evidence_profile: str = SCRIPTED_TEST_EVIDENCE_PROFILE,
+) -> dict[str, Any]:
+    return build_workflow_definition(
+        definition_id="definition-direct",
+        definition_revision=1,
+        risk_level="low",
+        outcome_judge_mode="off",
+        evidence_profile=evidence_profile,
+        direct_path={"allowed": True, "independence_claimed": False},
+        authorization=authorization_artifacts(repo),
+        executor_profiles=[
+            {
+                "executor_profile_id": "executor-direct",
+                "requested_model": None,
+                "recommended_model": None,
+                "requested_reasoning_effort": None,
+                "recommended_reasoning_effort": None,
+                "tools": ["read"],
+                "permissions": ["repository-read"],
+                "context_policy": {"fresh": False},
+            }
+        ],
+        lens_bindings=[],
+        pack_hints=[],
+        concerns=[
+            {
+                "responsibility_id": "concern-direct",
+                "summary": "Complete one bounded low-risk concern.",
+                "mandatory": True,
+                "risk_level": "low",
+                "owner_role_spec_id": "role-direct",
+                "evidence_refs": ["request:direct"],
+            }
+        ],
+        roles=[
+            {
+                "role_spec_id": "role-direct",
+                "responsibility_ids": ["concern-direct"],
+                "executor_profile_id": "executor-direct",
+                "lens_binding_ids": [],
+                "pack_hint_ids": [],
+                "read_only": True,
+                "mutation_owner": False,
+                "verifier": False,
+                "capability_requirements": ["repository-read"],
+            }
+        ],
+        stages=[stage_fixture("stage-direct", "role-direct")],
+        independence_edges=[],
+    )
+
+
+class OrchestrationProjectionTests(unittest.TestCase):
+    def test_sc03_synthesis_receives_exact_frozen_packet_set(self) -> None:
+        temporary = initialized_repo()
+        self.addCleanup(temporary.cleanup)
+        repo = Path(temporary.name)
+        definition = synthesis_definition(repo)
+        observed: dict[str, dict[str, Any]] = {}
+
+        def capture(stage_id: str):
+            def callback(projection: dict[str, Any]) -> dict[str, Any]:
+                observed[stage_id] = copy.deepcopy(projection)
+                return completed_result(statement=stage_id)
+
+            return callback
+
+        controller = OrchestrationController.start(
+            repo,
+            definition=definition,
+            root_request_id=ROOT_REQUEST_ID,
+            root_execution_id="run-synthesis-projection",
+            workflow_instance_id="workflow-synthesis-projection",
+            host_boundary=CallbackHostBoundary(
+                repo,
+                {
+                    stage: capture(stage)
+                    for stage in (
+                        "stage-left",
+                        "stage-right",
+                        "stage-synthesis",
+                    )
+                },
+                timestamp="2026-01-01T00:00:00Z",
+            ),
+            now=lambda: "2026-01-01T00:00:00Z",
+        )
+
+        controller.progress()
+
+        self.assertTrue(observed["stage-left"]["blind_initial_context"])
+        self.assertEqual(
+            observed["stage-left"]["predecessor_packets"],
+            [],
+        )
+        synthesis = observed["stage-synthesis"]
+        self.assertFalse(synthesis["blind_initial_context"])
+        self.assertEqual(
+            {
+                packet["packet_digest"]
+                for packet in synthesis["predecessor_packets"]
+            },
+            {
+                controller.state["packets"][stage]["packet_digest"]
+                for stage in ("stage-left", "stage-right")
+            },
+        )
+
+    def test_projection_keeps_requested_recommended_applied_separate(self) -> None:
+        temporary = initialized_repo()
+        self.addCleanup(temporary.cleanup)
+        repo = Path(temporary.name)
+        definition = direct_definition(repo)
+        controller = OrchestrationController.start(
+            repo,
+            definition=definition,
+            root_request_id=ROOT_REQUEST_ID,
+            root_execution_id="run-viewer-projection",
+            workflow_instance_id="workflow-viewer-projection",
+            expected_workflow_policy_digest=workflow_policy_digest(
+                definition["responsibility_plan"]["workflow_policy"]
+            ),
+            host_boundary=CallbackHostBoundary(
+                repo,
+                {
+                    "stage-direct": lambda _: completed_result(
+                        statement="direct"
+                    )
+                },
+                timestamp="2026-01-01T00:00:00Z",
+            ),
+            now=lambda: "2026-01-01T00:00:00Z",
+        )
+        controller.progress()
+        receipts = [
+            read_json(path)
+            for path in (
+                controller.run_root / "context-receipts"
+            ).glob("*.json")
+        ]
+        packets = [
+            read_json(path)
+            for path in (controller.run_root / "packets").glob("*.json")
+        ]
+
+        projection = viewer_projection(
+            state=controller.state,
+            host_receipts=receipts,
+            packet_envelopes=packets,
+        )
+
+        metadata = projection["participants"][0]["metadata"]
+        self.assertEqual(
+            set(metadata),
+            {"requested", "recommended", "applied"},
+        )
+        self.assertEqual(metadata["applied"]["model"], "not_observed")
+        self.assertFalse(projection["dispatch_allowed"])
+        self.assertFalse(
+            projection["telemetry_policy"]["inference_allowed"]
+        )
