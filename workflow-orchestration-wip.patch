index 0000000000000000000000000000000000000000..efb55b2fd3826e297b67b58f832c7ef657d00ba1
--- /dev/null
+++ b/src/maestro/orchestration/migration.py
@@ -0,0 +1,221 @@
+from __future__ import annotations
+
+import copy
+import os
+from contextlib import contextmanager
+from pathlib import Path
+from typing import Any, Iterator, Mapping
+
+try:
+    import fcntl
+except ImportError:  # pragma: no cover
+    fcntl = None  # type: ignore[assignment]
+
+from maestro.errors import MaestroError
+from maestro.util import (
+    atomic_write,
+    canonical_json,
+    ensure_repo,
+    read_json,
+    safe_target,
+)
+
+from .contracts import RUNTIME_AUTHORITY, require_identity, require_root_request_id
+
+
+AUTHORITY_REGISTRY_VERSION = "maestro_runtime_authority_registry_v1"
+LEGACY_PROJECTION_VERSION = "maestro_legacy_runtime_projection_v1"
+
+
+@contextmanager
+def _registry_lock(repo: Path) -> Iterator[None]:
+    if fcntl is None:
+        raise MaestroError(
+            "ORCH_RUNTIME_AUTHORITY_CONFLICT",
+            "Runtime authority registry requires an interprocess lock.",
+        )
+    path = safe_target(
+        repo,
+        ".maestro/state/orchestration/runtime-authorities.lock",
+    )
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    descriptor = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
+    try:
+        fcntl.flock(descriptor, fcntl.LOCK_EX)
+        yield
+    finally:
+        fcntl.flock(descriptor, fcntl.LOCK_UN)
+        os.close(descriptor)
+
+
+def _registry_path(repo: Path) -> Path:
+    return safe_target(
+        repo,
+        ".maestro/state/orchestration/runtime-authorities.json",
+    )
+
+
+def _load(repo: Path) -> dict[str, Any]:
+    path = _registry_path(repo)
+    if not path.exists():
+        return {"schema_version": AUTHORITY_REGISTRY_VERSION, "runs": {}}
+    value = read_json(path)
+    if (
+        value.get("schema_version") != AUTHORITY_REGISTRY_VERSION
+        or not isinstance(value.get("runs"), dict)
+    ):
+        raise MaestroError(
+            "ORCH_RUNTIME_AUTHORITY_CONFLICT",
+            "Runtime authority registry has an invalid contract.",
+        )
+    return value
+
+
+def register_runtime_authority(
+    repo_path: str | Path,
+    *,
+    root_request_id: str,
+    root_execution_id: str,
+    workflow_instance_id: str,
+    definition_digest: str,
+    registered_at: str,
+) -> dict[str, Any]:
+    repo = ensure_repo(repo_path)
+    require_root_request_id(root_request_id)
+    require_identity(root_execution_id, field="root_execution_id")
+    require_identity(workflow_instance_id, field="workflow_instance_id")
+    key = f"{root_request_id}:{root_execution_id}"
+    record = {
+        "root_request_id": root_request_id,
+        "root_execution_id": root_execution_id,
+        "workflow_instance_id": workflow_instance_id,
+        "runtime_authority": RUNTIME_AUTHORITY,
+        "definition_digest": definition_digest,
+        "dispatch_allowed": True,
+        "registered_at": registered_at,
+    }
+    with _registry_lock(repo):
+        registry = _load(repo)
+        existing = registry["runs"].get(key)
+        if existing is not None and existing != record:
+            raise MaestroError(
+                "ORCH_RUNTIME_AUTHORITY_CONFLICT",
+                "This root execution already has a different runtime authority binding.",
+            )
+        for other_key, other in registry["runs"].items():
+            if (
+                other_key != key
+                and isinstance(other, dict)
+                and other.get("root_request_id") == root_request_id
+                and other.get("workflow_instance_id") == workflow_instance_id
+                and other.get("dispatch_allowed") is True
+            ):
+                raise MaestroError(
+                    "ORCH_RUNTIME_AUTHORITY_CONFLICT",
+                    "The workflow already has an active authoritative run.",
+                )
+        registry["runs"][key] = record
+        atomic_write(
+            _registry_path(repo),
+            (canonical_json(registry) + "\n").encode("utf-8"),
+        )
+    return copy.deepcopy(record)
+
+
+def assert_runtime_authority(
+    repo_path: str | Path,
+    *,
+    root_request_id: str,
+    root_execution_id: str,
+    definition_digest: str,
+) -> dict[str, Any]:
+    repo = ensure_repo(repo_path)
+    key = f"{root_request_id}:{root_execution_id}"
+    with _registry_lock(repo):
+        record = _load(repo)["runs"].get(key)
+    if (
+        not isinstance(record, dict)
+        or record.get("runtime_authority") != RUNTIME_AUTHORITY
+        or record.get("definition_digest") != definition_digest
+        or record.get("dispatch_allowed") is not True
+    ):
+        raise MaestroError(
+            "ORCH_RUNTIME_AUTHORITY_CONFLICT",
+            "The controller is not the exact registered runtime authority.",
+        )
+    return copy.deepcopy(record)
+
+
+def close_runtime_authority(
+    repo_path: str | Path,
+    *,
+    root_request_id: str,
+    root_execution_id: str,
+    closed_at: str,
+) -> dict[str, Any]:
+    repo = ensure_repo(repo_path)
+    key = f"{root_request_id}:{root_execution_id}"
+    with _registry_lock(repo):
+        registry = _load(repo)
+        record = registry["runs"].get(key)
+        if not isinstance(record, dict):
+            raise MaestroError(
+                "ORCH_RUNTIME_AUTHORITY_CONFLICT",
+                "No matching runtime authority can be closed.",
+            )
+        record = copy.deepcopy(record)
+        record["dispatch_allowed"] = False
+        record["closed_at"] = closed_at
+        registry["runs"][key] = record
+        atomic_write(
+            _registry_path(repo),
+            (canonical_json(registry) + "\n").encode("utf-8"),
+        )
+    return copy.deepcopy(record)
+
+
+def project_legacy_runtime(
+    legacy: Mapping[str, Any],
+    *,
+    legacy_kind: str,
+    root_request_id: str | None = None,
+) -> dict[str, Any]:
+    """Produce a visibly legacy, non-dispatchable one-way projection.
+
+    Historical participant, Packet, root, and managed-authority values are
+    never backfilled from status labels or evidence references.
+    """
+
+    if legacy_kind not in {
+        "route-v2",
+        "decision-plan",
+        "research-bundle",
+        "workflow-kernel-v1",
+    }:
+        raise MaestroError(
+            "ORCH_LEGACY_ADAPTER_AMBIGUOUS",
+            "Unknown legacy input cannot be promoted to orchestration v1.",
+        )
+    if root_request_id is not None:
+        require_root_request_id(root_request_id)
+    return {
+        "schema_version": LEGACY_PROJECTION_VERSION,
+        "legacy_kind": legacy_kind,
+        "runtime_authority": "legacy-read-only",
+        "dispatch_allowed": False,
+        "root_request_id": root_request_id or "not_observed",
+        "root_execution_id": "not_observed",
+        "workflow_instance_id": "not_observed",
+        "participant_instances": [],
+        "packet_envelopes": [],
+        "managed_authority_imported": False,
+        "source_schema_version": legacy.get(
+            "schema_version",
+            "not_observed",
+        ),
+        "source_status": legacy.get("status", "not_observed"),
+        "limitations": [
+            "Legacy state is a read-only projection.",
+            "Historical participant, context, Packet, and root identities are not inferred.",
+        ],
+    }
