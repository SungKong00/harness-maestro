+def _valid_manifest(value: Any, *, repo: Path) -> bool:
+    fields = {
+        "schema_version",
+        "manifest_id",
+        "project_id",
+        "checkout_id",
+        "plan_id",
+        "goal_digest",
+        "display_language",
+        "comparison_id",
+        "falsification_id",
+        "problem",
+        "user_tasks",
+        "decision_criteria",
+        "reference_observations",
+        "minority_risks",
+        "alternatives",
+        "created_at",
+    }
+    if (
+        not isinstance(value, dict)
+        or set(value) != fields
+        or value.get("schema_version")
+        != DESIGN_COMPARISON_MANIFEST_VERSION
+        or not _digest(value.get("manifest_id"))
+        or value["manifest_id"] != _identity(value, "manifest_id")
+        or value.get("project_id") != _project_id(repo)
+        or value.get("checkout_id") != checkout_id(repo)
+        or not _digest(value.get("plan_id"))
+        or not _digest(value.get("goal_digest"))
+        or value.get("display_language") not in {"ko", "unverified"}
+        or not _digest(value.get("comparison_id"))
+        or not _digest(value.get("falsification_id"))
+        or not _line(value.get("problem"))
+        or not _unique_lines(
+            value.get("user_tasks"), maximum=16, nonempty=True
+        )
+        or not _unique_lines(
+            value.get("decision_criteria"), maximum=16, nonempty=True
+        )
+        or not _unique_lines(
+            value.get("minority_risks"), maximum=16
+        )
+        or not isinstance(value.get("reference_observations"), list)
+        or not 3 <= len(value["reference_observations"]) <= 16
+        or not _timestamp(value.get("created_at"))
+        or not isinstance(value.get("alternatives"), list)
+        or not 2 <= len(value["alternatives"]) <= 4
+    ):
+        return False
+    reference_fields = {
+        "reference_id",
+        "role",
+        "source_ids",
+        "product_context",
+        "observed_state",
+        "quality_rationale",
+        "task_fit",
+        "transferable_decisions",
+        "non_transferable_context",
+        "artifact_path",
+        "artifact_sha256",
+    }
+    seen_references: set[str] = set()
+    for reference in value["reference_observations"]:
+        if (
+            not isinstance(reference, dict)
+            or set(reference) != reference_fields
+            or not _id(reference.get("reference_id"))
+            or reference["reference_id"] in seen_references
+            or reference.get("role") not in REFERENCE_ROLES
+            or not _unique_lines(
+                reference.get("source_ids"), maximum=8, nonempty=True
+            )
+            or any(
+                not _line(reference.get(field))
+                for field in (
+                    "product_context",
+                    "observed_state",
+                    "quality_rationale",
+                )
+            )
+            or not _unique_lines(
+                reference.get("task_fit"), maximum=12, nonempty=True
+            )
+            or not _unique_lines(
+                reference.get("transferable_decisions"),
+                maximum=12,
+                nonempty=True,
+            )
+            or not _unique_lines(
+                reference.get("non_transferable_context"),
+                maximum=12,
+                nonempty=True,
+            )
+            or not _relative_path(reference.get("artifact_path"))
+            or not reference["artifact_path"].startswith(
+                ".maestro/state/design-assurance/"
+                f"{value['plan_id']}/references/"
+            )
+            or not _digest(reference.get("artifact_sha256"))
+        ):
+            return False
+        target = _regular_file(repo, reference["artifact_path"])
+        if (
+            target is None
+            or _png_dimensions(target) is None
+            or file_sha256(target) != reference["artifact_sha256"]
+        ):
+            return False
+        seen_references.add(reference["reference_id"])
+    if {
+        reference["role"]
+        for reference in value["reference_observations"]
+    } != REFERENCE_ROLES:
+        return False
+    expected_choices = [
+        chr(ord("A") + index)
+        for index in range(len(value["alternatives"]))
+    ]
+    if [
+        alternative.get("choice_key")
+        for alternative in value["alternatives"]
+        if isinstance(alternative, dict)
+    ] != expected_choices:
+        return False
+    seen_alternatives: set[str] = set()
+    seen_renders: set[str] = set()
+    for alternative in value["alternatives"]:
+        if (
+            not isinstance(alternative, dict)
+            or set(alternative)
+            != {
+                "choice_key",
+                "alternative_id",
+                "summary",
+                "material_differences",
+                "tradeoffs",
+                "task_flow",
+                "region_hierarchy",
+                "interaction_model",
+                "basis_refs",
+                "transfer_records",
+                "falsification_review",
+                "render_artifacts",
+            }
+            or not _id(alternative.get("alternative_id"))
+            or alternative["alternative_id"] in seen_alternatives
+            or not _line(alternative.get("summary"))
+            or any(
+                not _unique_lines(
+                    alternative.get(field),
+                    maximum=16,
+                    nonempty=True,
+                )
+                for field in (
+                    "material_differences",
+                    "tradeoffs",
+                    "task_flow",
+                    "region_hierarchy",
+                    "interaction_model",
+                    "basis_refs",
+                )
+            )
+            or not isinstance(alternative.get("transfer_records"), list)
+            or not alternative["transfer_records"]
+            or not isinstance(alternative.get("render_artifacts"), list)
+            or not alternative["render_artifacts"]
+        ):
+            return False
+        transfer_fields = {
+            "transfer_id",
+            "reference_ids",
+            "disposition",
+            "local_decision",
+            "enabling_context",
+            "rejected_surface_traits",
+            "local_fit_observations",
+        }
+        seen_transfer_ids: set[str] = set()
+        for transfer in alternative["transfer_records"]:
+            if (
+                not isinstance(transfer, dict)
+                or set(transfer) != transfer_fields
+                or not _id(transfer.get("transfer_id"))
+                or transfer["transfer_id"] in seen_transfer_ids
+                or transfer.get("disposition")
+                not in TRANSFER_DISPOSITIONS
+                or not _line(transfer.get("local_decision"))
+                or not _unique_lines(
+                    transfer.get("reference_ids"),
+                    maximum=16,
+                    nonempty=True,
+                )
+                or any(
+                    item not in seen_references
+                    for item in transfer["reference_ids"]
+                )
+                or any(
+                    not _unique_lines(
+                        transfer.get(field),
+                        maximum=12,
+                        nonempty=True,
+                    )
+                    for field in (
+                        "enabling_context",
+                        "rejected_surface_traits",
+                        "local_fit_observations",
+                    )
+                )
+            ):
+                return False
+            seen_transfer_ids.add(transfer["transfer_id"])
+        review = alternative["falsification_review"]
+        if (
+            not isinstance(review, dict)
+            or set(review)
+            != {
+                "strongest_countercase",
+                "failure_conditions",
+                "counterevidence_refs",
+                "outcome",
+            }
+            or not _line(review.get("strongest_countercase"))
+            or not _unique_lines(
+                review.get("failure_conditions"),
+                maximum=12,
+                nonempty=True,
+            )
+            or not _unique_lines(
+                review.get("counterevidence_refs"),
+                maximum=16,
+                nonempty=True,
+            )
+            or review.get("outcome") not in FALSIFICATION_OUTCOMES
+        ):
+            return False
+        seen_alternatives.add(alternative["alternative_id"])
+        for artifact in alternative["render_artifacts"]:
+            if (
+                not isinstance(artifact, dict)
+                or set(artifact)
+                != {
+                    "render_id",
+                    "artifact_path",
+                    "artifact_sha256",
+                }
+                or not _id(artifact.get("render_id"))
+                or artifact["render_id"] in seen_renders
+                or not _relative_path(artifact.get("artifact_path"))
+                or not _digest(artifact.get("artifact_sha256"))
+            ):
+                return False
+            seen_renders.add(artifact["render_id"])
+            target = _regular_file(repo, artifact["artifact_path"])
+            if (
+                target is None
+                or _png_dimensions(target) is None
+                or file_sha256(target) != artifact["artifact_sha256"]
+            ):
+                return False
+    return True
+
+
+def load_comparison_manifest(
+    repo_path: str | Path,
+    *,
+    plan_id: str,
+    manifest_id: str,
+) -> dict[str, Any]:
+    repo = ensure_repo(repo_path)
+    if not _digest(plan_id) or not _digest(manifest_id):
+        raise MaestroError(
+            "DESIGN_COMPARISON_MANIFEST_INVALID",
+            "Comparison manifest identifiers are invalid.",
+        )
+    target = comparison_manifest_path(
+        repo,
+        plan_id=plan_id,
+        manifest_id=manifest_id,
+    )
+    if not target.is_file() or target.is_symlink():
+        raise MaestroError(
+            "DESIGN_COMPARISON_MANIFEST_MISSING",
+            "The exact comparison manifest is missing.",
+        )
+    value = read_json(target)
+    if (
+        not _valid_manifest(value, repo=repo)
+        or value.get("plan_id") != plan_id
+        or value.get("manifest_id") != manifest_id
+    ):
+        raise MaestroError(
+            "DESIGN_COMPARISON_MANIFEST_INVALID",
+            "The comparison manifest is malformed, stale, or does not match its path.",
+        )
+    return value
+
+
+def _message_image_targets(
+    message: str,
+    *,
+    repo: Path,
+) -> list[Path]:
+    targets: list[Path] = []
+    for match in re.finditer(r"!\[[^\]\r\n]*\]\(([^)\r\n]+)\)", message):
+        raw = match.group(1).strip()
+        if raw.startswith("<") and raw.endswith(">"):
+            raw = raw[1:-1]
+        candidate = Path(raw).expanduser()
+        if not candidate.is_absolute():
+            candidate = repo / candidate
+        try:
+            targets.append(candidate.resolve())
+        except OSError:
+            targets.append(candidate)
+    return targets
+
+
+def _manifest_without_marker(value: dict[str, Any]) -> dict[str, Any]:
+    manifest = copy.deepcopy(value)
+    manifest.pop("marker", None)
+    manifest.pop("presentation_markdown", None)
+    return manifest
+
+
+def comparison_presentation_markdown(
+    manifest: dict[str, Any],
+    *,
+    repo_path: str | Path,
+) -> str:
+    """Return the only ordered comparison block accepted by the Hook."""
+
+    repo = ensure_repo(repo_path)
+    canonical_manifest = _manifest_without_marker(manifest)
+    if not _valid_manifest(canonical_manifest, repo=repo):
+        raise MaestroError(
+            "DESIGN_COMPARISON_MANIFEST_INVALID",
+            "The comparison manifest cannot be presented.",
+        )
+    korean = canonical_manifest["display_language"] == "ko"
+    labels = (
+        {
+            "problem": "판단할 문제",
+            "tasks": "핵심 과업",
+            "criteria": "판단 기준",
+            "references": "관찰한 실제 레퍼런스",
+            "reference": "레퍼런스",
+            "context": "제품 맥락",
+            "observed": "관찰 상태",
+            "fit": "과업 적합성",
+            "transfer": "차용할 결정",
+            "reject": "차용하지 않을 맥락",
+            "alternatives": "구조 대안",
+            "summary": "요약",
+            "differences": "구조적 차이",
+            "tradeoffs": "트레이드오프",
+            "flow": "과업 흐름",
+            "hierarchy": "영역 위계",
+            "interaction": "상호작용 모델",
+            "local_decision": "레퍼런스 전이 판단",
+            "countercase": "가장 강한 반론",
+            "failure": "실패 조건",
+            "outcome": "반증 결과",
+            "minority": "남은 소수 위험",
+            "select": "선택",
+        }
+        if korean
+        else {
+            "problem": "Decision problem",
+            "tasks": "Core tasks",
+            "criteria": "Decision criteria",
+            "references": "Observed shipped references",
+            "reference": "Reference",
+            "context": "Product context",
+            "observed": "Observed state",
+            "fit": "Task fit",
+            "transfer": "Transferable decisions",
+            "reject": "Non-transferable context",
+            "alternatives": "Structural alternatives",
+            "summary": "Summary",
+            "differences": "Structural differences",
+            "tradeoffs": "Trade-offs",
+            "flow": "Task flow",
+            "hierarchy": "Region hierarchy",
+            "interaction": "Interaction model",
+            "local_decision": "Reference transfer decision",
+            "countercase": "Strongest countercase",
+            "failure": "Failure conditions",
+            "outcome": "Falsification outcome",
+            "minority": "Remaining minority risks",
+            "select": "Selection",
+        }
+    )
+    lines = [
+        comparison_marker(
+            canonical_manifest["plan_id"],
+            canonical_manifest["manifest_id"],
+        ),
+        f"## {labels['problem']}",
+        canonical_manifest["problem"],
+        f"### {labels['tasks']}",
+        *(
+            f"- {item}"
+            for item in canonical_manifest["user_tasks"]
+        ),
+        f"### {labels['criteria']}",
+        *(
+            f"- {item}"
+            for item in canonical_manifest["decision_criteria"]
+        ),
+        f"## {labels['references']}",
+    ]
+    for reference in canonical_manifest["reference_observations"]:
+        lines.extend(
+            [
+                "[MAESTRO_DESIGN_REFERENCE:"
+                f"{reference['reference_id']}:"
+                f"{reference['artifact_sha256']}]",
+                f"### {labels['reference']} · "
+                f"{reference['reference_id']} · {reference['role']}",
+                f"- {labels['context']}: "
+                f"{reference['product_context']}",
+                f"- {labels['observed']}: "
+                f"{reference['observed_state']}",
+                f"- {labels['fit']}: "
+                + " · ".join(reference["task_fit"]),
+                f"- {labels['transfer']}: "
+                + " · ".join(reference["transferable_decisions"]),
+                f"- {labels['reject']}: "
+                + " · ".join(reference["non_transferable_context"]),
+            ]
+        )
+        target = safe_target(
+            repo, reference["artifact_path"]
+        ).resolve()
+        lines.append(
+            "![Maestro design reference "
+            f"{reference['reference_id']}](<{target}>)"
+        )
+    lines.append(f"## {labels['alternatives']}")
+    for alternative in canonical_manifest["alternatives"]:
+        choice = alternative["choice_key"]
+        alternative_id = alternative["alternative_id"]
+        lines.append(
+            f"[MAESTRO_DESIGN_OPTION:{choice}:{alternative_id}]"
+        )
+        lines.extend(
+            [
+                f"### {choice} · {alternative_id}",
+                f"- {labels['summary']}: {alternative['summary']}",
+                f"- {labels['differences']}: "
+                + " · ".join(alternative["material_differences"]),
+                f"- {labels['tradeoffs']}: "
+                + " · ".join(alternative["tradeoffs"]),
+                f"- {labels['flow']}: "
+                + " → ".join(alternative["task_flow"]),
+                f"- {labels['hierarchy']}: "
+                + " → ".join(alternative["region_hierarchy"]),
+                f"- {labels['interaction']}: "
+                + " → ".join(alternative["interaction_model"]),
+            ]
+        )
+        for transfer in alternative["transfer_records"]:
+            lines.append(
+                f"- {labels['local_decision']} "
+                f"({transfer['transfer_id']}): "
+                f"{transfer['local_decision']}"
+            )
+        review = alternative["falsification_review"]
+        lines.extend(
+            [
+                f"- {labels['countercase']}: "
+                f"{review['strongest_countercase']}",
+                f"- {labels['failure']}: "
+                + " · ".join(review["failure_conditions"]),
+                f"- {labels['outcome']}: {review['outcome']}",
+            ]
+        )
+        for render in alternative["render_artifacts"]:
+            lines.append(
+                "[MAESTRO_DESIGN_RENDER:"
+                f"{choice}:{alternative_id}:{render['render_id']}:"
+                f"{render['artifact_sha256']}]"
+            )
+            target = safe_target(
+                repo, render["artifact_path"]
+            ).resolve()
+            lines.append(
+                "![Maestro design alternative "
+                f"{choice} · {render['render_id']}](<{target}>)"
+            )
+    if canonical_manifest["minority_risks"]:
+        lines.extend(
+            [
+                f"## {labels['minority']}",
+                *(
+                    f"- {item}"
+                    for item in canonical_manifest["minority_risks"]
+                ),
+            ]
+        )
+    choices = "/".join(
+        item["choice_key"]
+        for item in canonical_manifest["alternatives"]
+    )
+    lines.append(
+        (
+            f"## {labels['select']}: `{choices}` 중 하나로 답해주세요."
+            if korean
+            else f"## {labels['select']}: reply with exactly one of `{choices}`."
+        )
+    )
+    return "\n".join(lines)
+
+
+def _presentation_files(repo: Path) -> list[Path]:
+    root = safe_target(
+        repo,
+        ".maestro/state/hooks/codex/design-presentations",
+    )
+    if not root.is_dir() or root.is_symlink():
+        return []
+    return sorted(
+        path
+        for path in root.glob("*/*.json")
+        if path.is_file()
+        and not path.is_symlink()
+        and not path.parent.is_symlink()
+    )
+
+
+def _load_presentations(repo: Path) -> list[dict[str, Any]]:
+    values: list[dict[str, Any]] = []
+    for target in _presentation_files(repo):
+        value = read_json(target)
+        if not _valid_presentation(value):
+            raise MaestroError(
+                "DESIGN_OWNER_SELECTION_STATE_INVALID",
+                "A design presentation state file is malformed.",
+            )
+        expected = design_presentation_path(
+            repo,
+            session_digest=value["session_digest"],
+            observation_id=value["observation_id"],
+        )
+        if expected != target:
+            raise MaestroError(
+                "DESIGN_OWNER_SELECTION_STATE_INVALID",
+                "A design presentation state file does not match its identity.",
+            )
+        values.append(value)
+    return values
+
+
+def observe_comparison_presentation(
+    repo_path: str | Path,
+    *,
+    assistant_message: Any,
+    session_digest: str,
+    event_key: str,
+    expected_plan_id: Any,
+    observation_id: str,
+    run_id: str,
+    root_work_id: str,
+    display_language: str,
+) -> dict[str, Any] | None:
+    repo = ensure_repo(repo_path)
+    if not isinstance(assistant_message, str):
+        return None
+    markers = list(_MARKER_PATTERN.finditer(assistant_message))
+    if not markers:
+        return None
+    if len(markers) != 1:
+        raise MaestroError(
+            "DESIGN_COMPARISON_PRESENTATION_INVALID",
+            "The assistant response must contain exactly one comparison marker.",
+        )
+    plan_id, manifest_id = markers[0].groups()
+    if not _digest(expected_plan_id) or plan_id != expected_plan_id:
+        raise MaestroError(
+            "DESIGN_COMPARISON_PRESENTATION_PLAN_MISMATCH",
+            "The comparison manifest must belong to the exact plan attached to this root request.",
+        )
+    manifest = load_comparison_manifest(
+        repo,
+        plan_id=plan_id,
+        manifest_id=manifest_id,
+    )
+    expected_block = comparison_presentation_markdown(
+        manifest,
+        repo_path=repo,
+    )
+    if assistant_message.strip() != expected_block:
+        raise MaestroError(
+            "DESIGN_COMPARISON_PRESENTATION_INVALID",
+            "The comparison response must be the exact generated owner-facing packet with no added, removed, or reordered claims.",
+        )
+    image_targets = _message_image_targets(assistant_message, repo=repo)
+    expected_targets = [
+        *[
+            safe_target(repo, reference["artifact_path"]).resolve()
+            for reference in manifest["reference_observations"]
+        ],
+        *[
+        safe_target(repo, artifact["artifact_path"]).resolve()
+        for alternative in manifest["alternatives"]
+        for artifact in alternative["render_artifacts"]
+        ],
+    ]
+    if image_targets != expected_targets:
+        raise MaestroError(
+            "DESIGN_COMPARISON_PRESENTATION_INVALID",
+            "The comparison response must show every manifest render exactly once and in the declared order.",
+        )
+    if (
+        not _digest(session_digest)
+        or not _digest(event_key)
+        or _OBSERVATION_ID_PATTERN.fullmatch(observation_id) is None
+    ):
+        raise MaestroError(
+            "DESIGN_COMPARISON_PRESENTATION_INVALID",
+            "The Hook session, event, or observation identity is invalid.",
+        )
+    existing_path = design_presentation_path(
+        repo,
+        session_digest=session_digest,
+        observation_id=observation_id,
+    )
+    if existing_path.is_file():
+        existing = read_json(existing_path)
+        if (
+            _valid_presentation(existing)
+            and existing.get("manifest_id") == manifest_id
+            and existing.get("presentation_event_key") == event_key
+        ):
+            return existing
+        raise MaestroError(
+            "DESIGN_COMPARISON_PRESENTATION_CONFLICT",
+            "This root request already has a different comparison presentation.",
+        )
+    current_session_pending = [
+        item
+        for item in _load_presentations(repo)
+        if item["session_digest"] == session_digest
+        and item["status"] == "pending"
+    ]
+    if current_session_pending:
+        raise MaestroError(
+            "DESIGN_COMPARISON_PRESENTATION_CONFLICT",
+            "This Codex session already has an unresolved comparison presentation.",
+        )
+    presented_at = _now()
+    presentation = {
+        "schema_version": DESIGN_PRESENTATION_VERSION,
+        "presentation_id": "",
+        "project_id": manifest["project_id"],
+        "checkout_id": manifest["checkout_id"],
+        "plan_id": plan_id,
+        "goal_digest": manifest["goal_digest"],
+        "manifest_id": manifest_id,
+        "comparison_id": manifest["comparison_id"],
+        "falsification_id": manifest["falsification_id"],
+        "owner_facing_digest": sha256_text(expected_block),
+        "session_digest": session_digest,
+        "presentation_event_key": event_key,
+        "selection_event_key": None,
+        "observation_id": observation_id,
+        "run_id": run_id,
+        "root_work_id": root_work_id,
+        "display_language": display_language,
+        "compared_alternative_ids": sorted(
+            item["alternative_id"] for item in manifest["alternatives"]
+        ),
+        "compared_render_digests": sorted(
+            artifact["artifact_sha256"]
+            for item in manifest["alternatives"]
+            for artifact in item["render_artifacts"]
+        ),
+        "status": "pending",
+        "selected_choice_key": None,
+        "selected_alternative_id": None,
+        "receipt_id": None,
+        "presented_at": presented_at,
+        "selected_at": None,
+    }
+    presentation["presentation_id"] = _identity(
+        presentation, "presentation_id"
+    )
+    existing_path.parent.mkdir(parents=True, exist_ok=True)
+    atomic_write(
+        existing_path,
+        pretty_json(presentation).encode("utf-8"),
+    )
+    return presentation
+
+
+def _valid_presentation(value: Any) -> bool:
+    fields = {
+        "schema_version",
+        "presentation_id",
+        "project_id",
+        "checkout_id",
+        "plan_id",
+        "goal_digest",
+        "manifest_id",
+        "comparison_id",
+        "falsification_id",
+        "owner_facing_digest",
+        "session_digest",
+        "presentation_event_key",
+        "selection_event_key",
+        "observation_id",
+        "run_id",
+        "root_work_id",
+        "display_language",
+        "compared_alternative_ids",
+        "compared_render_digests",
+        "status",
+        "selected_choice_key",
+        "selected_alternative_id",
+        "receipt_id",
+        "presented_at",
+        "selected_at",
+    }
+    if (
+        not isinstance(value, dict)
+        or set(value) != fields
+        or value.get("schema_version") != DESIGN_PRESENTATION_VERSION
+        or not _digest(value.get("presentation_id"))
+        or not _digest(value.get("plan_id"))
+        or not _digest(value.get("goal_digest"))
+        or not _digest(value.get("manifest_id"))
+        or not _digest(value.get("comparison_id"))
+        or not _digest(value.get("falsification_id"))
+        or not _digest(value.get("owner_facing_digest"))
+        or not _digest(value.get("session_digest"))
+        or not _digest(value.get("presentation_event_key"))
+        or _OBSERVATION_ID_PATTERN.fullmatch(
+            value.get("observation_id", "")
+        )
+        is None
+        or not _id(value.get("run_id"))
+        or not _id(value.get("root_work_id"))
+        or value.get("display_language") not in {"ko", "unverified"}
+        or not _unique_lines(
+            value.get("compared_alternative_ids"),
+            maximum=4,
+            nonempty=True,
+        )
+        or not isinstance(value.get("compared_render_digests"), list)
+        or not value["compared_render_digests"]
+        or not all(_digest(item) for item in value["compared_render_digests"])
+        or value["compared_render_digests"]
+        != sorted(set(value["compared_render_digests"]))
+        or value.get("status") not in {"pending", "selected"}
+        or not _timestamp(value.get("presented_at"))
+    ):
+        return False
+    identity_value = copy.deepcopy(value)
+    if value["status"] == "selected":
+        identity_value.update(
+            {
+                "selection_event_key": None,
+                "status": "pending",
+                "selected_choice_key": None,
+                "selected_alternative_id": None,
+                "receipt_id": None,
+                "selected_at": None,
+            }
+        )
+    if value["presentation_id"] != _identity(
+        identity_value, "presentation_id"
+    ):
+        return False
+    if value["status"] == "pending":
+        return all(
+            value[field] is None
+            for field in (
+                "selection_event_key",
+                "selected_choice_key",
+                "selected_alternative_id",
+                "receipt_id",
+                "selected_at",
+            )
+        )
+    return (
+        _digest(value.get("selection_event_key"))
+        and value.get("selected_choice_key") in {"A", "B", "C", "D"}
+        and _id(value.get("selected_alternative_id"))
+        and _digest(value.get("receipt_id"))
+        and _timestamp(value.get("selected_at"))
+    )
+
+
+def selection_choice(value: Any) -> str | None:
+    if not isinstance(value, str):
+        return None
+    match = _SELECTION_PATTERN.fullmatch(value.strip())
+    return match.group(1).upper() if match is not None else None
+
+
+def _receipt_signing_key(repo: Path, *, create: bool) -> tuple[bytes, str]:
+    try:
+        return host_receipt_signing_key(
+            repo,
+            purpose=OWNER_SELECTION_KEY_PURPOSE,
+            create=create,
+        )
+    except MaestroError as exc:
+        code = exc.code.replace("HOST_RECEIPT", "DESIGN_OWNER_RECEIPT")
+        raise MaestroError(code, exc.message) from exc
+
+
+def _receipt_identity(value: dict[str, Any]) -> str:
+    return host_receipt_identity(value)
+
+
+def _receipt_auth_tag(
+    value: dict[str, Any],
+    *,
+    key: bytes,
+) -> str:
+    return host_receipt_auth_tag(value, key=key)
+
+
+def consume_owner_selection(
+    repo_path: str | Path,
+    *,
+    prompt: Any,
+    session_digest: str,
+    event_key: str,
+) -> tuple[dict[str, Any], dict[str, Any]] | None:
+    repo = ensure_repo(repo_path)
+    if not _digest(session_digest) or not _digest(event_key):
+        raise MaestroError(
+            "DESIGN_OWNER_SELECTION_STATE_INVALID",
+            "The Hook session or event identity is invalid.",
+        )
+    choice = selection_choice(prompt)
+    presentations = _load_presentations(repo)
+    current_session = [
+        item
+        for item in presentations
+        if item["session_digest"] == session_digest
+    ]
+    pending = [
+        item for item in current_session if item["status"] == "pending"
+    ]
+    if len(pending) > 1:
+        raise MaestroError(
+            "DESIGN_OWNER_SELECTION_STATE_INVALID",
+            "The Codex session has more than one pending design comparison.",
+        )
+    if not pending:
+        exact_replays = [
+            item
+            for item in current_session
+            if item["status"] == "selected"
+            and item["selection_event_key"] == event_key
+        ]
+        if exact_replays:
+            if len(exact_replays) != 1:
+                raise MaestroError(
+                    "DESIGN_OWNER_SELECTION_STATE_INVALID",
+                    "The selection event is bound to multiple presentations.",
+                )
+            presentation = exact_replays[0]
+            if choice != presentation["selected_choice_key"]:
+                raise MaestroError(
+                    "DESIGN_OWNER_SELECTION_CONFLICT",
+                    "A replayed selection event must preserve its exact choice.",
+                )
+            receipt = load_owner_selection_receipt(
+                repo,
+                plan_id=presentation["plan_id"],
+                receipt_id=presentation["receipt_id"],
+            )
+            return presentation, receipt
+        if choice is not None:
+            if any(
+                item["status"] == "pending"
+                and item["session_digest"] != session_digest
+                for item in presentations
+            ):
+                raise MaestroError(
+                    "DESIGN_OWNER_SELECTION_SESSION_MISMATCH",
+                    "A design choice may be submitted only from the Codex session that received the comparison.",
+                )
+        return None
+    presentation = pending[0]
+    target = design_presentation_path(
+        repo,
+        session_digest=session_digest,
+        observation_id=presentation["observation_id"],
+    )
+    if choice is None:
+        raise MaestroError(
+            "DESIGN_OWNER_SELECTION_INPUT_INVALID",
+            "Reply with only A, B, C, D, or '선택: A' while a design comparison is pending.",
+        )
+    manifest = load_comparison_manifest(
+        repo,
+        plan_id=presentation["plan_id"],
+        manifest_id=presentation["manifest_id"],
+    )
+    if presentation["owner_facing_digest"] != sha256_text(
+        comparison_presentation_markdown(manifest, repo_path=repo)
+    ):
+        raise MaestroError(
+            "DESIGN_OWNER_SELECTION_STATE_INVALID",
+            "The pending presentation no longer matches the exact owner-facing comparison packet.",
+        )
+    selected = next(
+        (
+            item
+            for item in manifest["alternatives"]
+            if item["choice_key"] == choice
+        ),
+        None,
+    )
+    if selected is None:
+        raise MaestroError(
+            "DESIGN_OWNER_SELECTION_UNKNOWN",
+            "The selected choice is not present in the comparison manifest.",
+        )
+    selected_at = _now()
+    signing_key, key_id = _receipt_signing_key(repo, create=True)
+    receipt = {
+        "schema_version": DESIGN_OWNER_SELECTION_RECEIPT_VERSION,
+        "receipt_id": "",
+        "key_id": key_id,
+        "auth_tag": "",
+        "project_id": presentation["project_id"],
+        "checkout_id": presentation["checkout_id"],
+        "plan_id": presentation["plan_id"],
+        "goal_digest": presentation["goal_digest"],
+        "manifest_id": presentation["manifest_id"],
+        "comparison_id": presentation["comparison_id"],
+        "falsification_id": presentation["falsification_id"],
+        "presentation_id": presentation["presentation_id"],
+        "owner_facing_digest": presentation["owner_facing_digest"],
+        "presentation_correlation_id": presentation[
+            "presentation_event_key"
+        ],
+        "selection_correlation_id": event_key,
+        "session_digest": presentation["session_digest"],
+        "observation_id": presentation["observation_id"],
+        "run_id": presentation["run_id"],
+        "root_work_id": presentation["root_work_id"],
+        "selected_choice_key": choice,
+        "selected_alternative_id": selected["alternative_id"],
+        "compared_alternative_ids": presentation[
+            "compared_alternative_ids"
+        ],
+        "compared_render_digests": presentation[
+            "compared_render_digests"
+        ],
+        "source": "codex-desktop-hook",
+        "evidence_coverage": (
+            "assistant_output_and_user_submit_observed"
+        ),
+        "selected_at": selected_at,
+    }
+    receipt["receipt_id"] = _receipt_identity(receipt)
+    receipt["auth_tag"] = _receipt_auth_tag(
+        receipt,
+        key=signing_key,
+    )
+    receipt_target = owner_selection_receipt_path(
+        repo,
+        plan_id=receipt["plan_id"],
+        receipt_id=receipt["receipt_id"],
+    )
+    receipt_target.parent.mkdir(parents=True, exist_ok=True)
+    atomic_write(
+        receipt_target,
+        pretty_json(receipt).encode("utf-8"),
+    )
+    updated = copy.deepcopy(presentation)
+    updated.update(
+        {
+            "selection_event_key": event_key,
+            "status": "selected",
+            "selected_choice_key": choice,
+            "selected_alternative_id": selected["alternative_id"],
+            "receipt_id": receipt["receipt_id"],
+            "selected_at": selected_at,
+        }
+    )
+    atomic_write(target, pretty_json(updated).encode("utf-8"))
+    return updated, receipt
+
+
+def load_owner_selection_receipt(
+    repo_path: str | Path,
+    *,
+    plan_id: str,
+    receipt_id: str,
+) -> dict[str, Any]:
+    repo = ensure_repo(repo_path)
+    if not _digest(plan_id) or not _digest(receipt_id):
+        raise MaestroError(
+            "DESIGN_OWNER_RECEIPT_INVALID",
+            "Owner selection receipt identifiers are invalid.",
+        )
+    target = owner_selection_receipt_path(
+        repo,
+        plan_id=plan_id,
+        receipt_id=receipt_id,
+    )
+    if not target.is_file() or target.is_symlink():
+        raise MaestroError(
+            "DESIGN_OWNER_RECEIPT_MISSING",
+            "The Host-derived owner selection receipt is missing.",
+        )
+    value = read_json(target)
+    fields = {
+        "schema_version",
+        "receipt_id",
+        "key_id",
+        "auth_tag",
+        "project_id",
+        "checkout_id",
+        "plan_id",
+        "goal_digest",
+        "manifest_id",
+        "comparison_id",
+        "falsification_id",
+        "presentation_id",
+        "owner_facing_digest",
+        "presentation_correlation_id",
+        "selection_correlation_id",
+        "session_digest",
+        "observation_id",
+        "run_id",
+        "root_work_id",
+        "selected_choice_key",
+        "selected_alternative_id",
+        "compared_alternative_ids",
+        "compared_render_digests",
+        "source",
+        "evidence_coverage",
+        "selected_at",
+    }
+    if (
+        not isinstance(value, dict)
+        or set(value) != fields
+        or value.get("schema_version")
+        != DESIGN_OWNER_SELECTION_RECEIPT_VERSION
+        or value.get("receipt_id") != receipt_id
+        or value.get("plan_id") != plan_id
+        or value["receipt_id"] != _receipt_identity(value)
+        or value.get("project_id") != _project_id(repo)
+        or value.get("checkout_id") != checkout_id(repo)
+        or not all(
+            _digest(value.get(field))
+            for field in (
+                "goal_digest",
+                "manifest_id",
+                "comparison_id",
+                "falsification_id",
+                "presentation_id",
+                "owner_facing_digest",
+                "presentation_correlation_id",
+                "selection_correlation_id",
+                "session_digest",
+            )
+        )
+        or _OBSERVATION_ID_PATTERN.fullmatch(
+            value.get("observation_id", "")
+        )
+        is None
+        or not _id(value.get("run_id"))
+        or not _id(value.get("root_work_id"))
+        or not _digest(value.get("key_id"))
+        or not _digest(value.get("auth_tag"))
+        or value.get("selected_choice_key") not in {"A", "B", "C", "D"}
+        or not _id(value.get("selected_alternative_id"))
+        or not _unique_lines(
+            value.get("compared_alternative_ids"),
+            maximum=4,
+            nonempty=True,
+        )
+        or not isinstance(value.get("compared_render_digests"), list)
+        or not value["compared_render_digests"]
+        or value["compared_render_digests"]
+        != sorted(set(value["compared_render_digests"]))
+        or not all(
+            _digest(item) for item in value["compared_render_digests"]
+        )
+        or value.get("source") != "codex-desktop-hook"
+        or value.get("evidence_coverage")
+        != "assistant_output_and_user_submit_observed"
+        or not _timestamp(value.get("selected_at"))
+    ):
+        raise MaestroError(
+            "DESIGN_OWNER_RECEIPT_INVALID",
+            "The owner selection receipt is malformed or does not match its content address.",
+        )
+    signing_key, expected_key_id = _receipt_signing_key(
+        repo,
+        create=False,
+    )
+    if not host_receipt_authenticated(
+        value,
+        key=signing_key,
+        expected_key_id=expected_key_id,
+    ):
+        raise MaestroError(
+            "DESIGN_OWNER_RECEIPT_AUTH_INVALID",
+            "The owner selection receipt was not authenticated by this Host.",
+        )
+    manifest = load_comparison_manifest(
+        repo,
+        plan_id=plan_id,
+        manifest_id=value["manifest_id"],
+    )
+    expected_alternatives = sorted(
+        item["alternative_id"] for item in manifest["alternatives"]
+    )
+    expected_renders = sorted(
+        artifact["artifact_sha256"]
+        for item in manifest["alternatives"]
+        for artifact in item["render_artifacts"]
+    )
+    expected_owner_facing_digest = sha256_text(
+        comparison_presentation_markdown(manifest, repo_path=repo)
+    )
+    selected = next(
+        (
+            item["alternative_id"]
+            for item in manifest["alternatives"]
+            if item["choice_key"] == value["selected_choice_key"]
+        ),
+        None,
+    )
+    if (
+        value["comparison_id"] != manifest["comparison_id"]
+        or value["falsification_id"] != manifest["falsification_id"]
+        or value["goal_digest"] != manifest["goal_digest"]
+        or value["owner_facing_digest"]
+        != expected_owner_facing_digest
+        or value["compared_alternative_ids"] != expected_alternatives
+        or value["compared_render_digests"] != expected_renders
+        or value["selected_alternative_id"] != selected
+    ):
+        raise MaestroError(
+            "DESIGN_OWNER_RECEIPT_MISMATCH",
+            "The owner selection receipt no longer matches the exact comparison manifest.",
+        )
+    presentation_target = design_presentation_path(
+        repo,
+        session_digest=value["session_digest"],
+        observation_id=value["observation_id"],
+    )
+    if (
+        not presentation_target.is_file()
+        or presentation_target.is_symlink()
+    ):
+        raise MaestroError(
+            "DESIGN_OWNER_RECEIPT_PRESENTATION_MISSING",
+            "The immutable presentation state for this receipt is missing.",
+        )
+    presentation = read_json(presentation_target)
+    if (
+        not _valid_presentation(presentation)
+        or presentation.get("status") != "selected"
+        or presentation.get("receipt_id") != receipt_id
+        or presentation.get("plan_id") != plan_id
+        or presentation.get("manifest_id") != value["manifest_id"]
+        or presentation.get("presentation_id")
+        != value["presentation_id"]
+        or presentation.get("owner_facing_digest")
+        != value["owner_facing_digest"]
+        or presentation.get("presentation_event_key")
+        != value["presentation_correlation_id"]
+        or presentation.get("selection_event_key")
+        != value["selection_correlation_id"]
+        or presentation.get("session_digest")
+        != value["session_digest"]
+        or presentation.get("observation_id")
+        != value["observation_id"]
+        or presentation.get("run_id") != value["run_id"]
+        or presentation.get("root_work_id")
+        != value["root_work_id"]
+        or presentation.get("selected_choice_key")
+        != value["selected_choice_key"]
+        or presentation.get("selected_alternative_id")
+        != value["selected_alternative_id"]
+        or presentation.get("compared_alternative_ids")
+        != value["compared_alternative_ids"]
+        or presentation.get("compared_render_digests")
+        != value["compared_render_digests"]
+        or presentation.get("selected_at") != value["selected_at"]
+    ):
+        raise MaestroError(
+            "DESIGN_OWNER_RECEIPT_PRESENTATION_MISMATCH",
+            "The owner receipt does not match the exact selected presentation state.",
+        )
+    return value
+
+
+def dependency_binding(
+    *,
+    packet: dict[str, Any],
+    projection: dict[str, Any],
+) -> tuple[str, str]:
+    projected = (
+        projection.get("input")
+        if isinstance(projection, dict)
+        and isinstance(projection.get("input"), dict)
+        else projection
+    )
+    if not isinstance(projected, dict):
+        raise MaestroError(
+            "DESIGN_DEPENDENCY_PROJECTION_INVALID",
+            "The managed design dependency projection is invalid.",
+        )
+    projection_digest = projected.get("projection_digest")
+    if not _digest(projection_digest):
+        raise MaestroError(
+            "DESIGN_DEPENDENCY_PROJECTION_INVALID",
+            "The managed design dependency projection digest is invalid.",
+        )
+    return (
+        sha256_text(canonical_json(packet)),
+        projection_digest,
+    )
+
+
+def comparison_marker(
+    plan_id: str,
+    manifest_id: str,
+) -> str:
+    if not _digest(plan_id) or not _digest(manifest_id):
+        raise MaestroError(
+            "DESIGN_COMPARISON_MANIFEST_INVALID",
+            "Comparison marker identifiers are invalid.",
+        )
+    return f"{DESIGN_COMPARISON_MARKER_PREFIX}{plan_id}:{manifest_id}]"
+
+
+__all__ = [
+    "DESIGN_COMPARISON_MANIFEST_VERSION",
+    "DESIGN_COMPARISON_MARKER_PREFIX",
+    "DESIGN_COMPARISON_VERSION",
+    "DESIGN_FALSIFICATION_PACKET_VERSION",
+    "DESIGN_FALSIFICATION_VERSION",
+    "DESIGN_OWNER_SELECTION_RECEIPT_VERSION",
+    "DESIGN_PRESENTATION_VERSION",
+    "DESIGN_PROPOSAL_PACKET_VERSION",
+    "DESIGN_SELECTION_VERSION",
+    "build_comparison_manifest",
+    "build_design_comparison",
+    "build_design_falsification",
+    "build_design_falsification_packet",
+    "build_design_proposal_packet",
+    "build_design_selection",
+    "comparison_marker",
+    "comparison_presentation_markdown",
+    "consume_owner_selection",
+    "dependency_binding",
+    "load_comparison_manifest",
+    "load_owner_selection_receipt",
+    "observe_comparison_presentation",
+    "selection_choice",
+    "validate_design_comparison",
+    "validate_design_falsification",
+    "validate_design_falsification_packet",
+    "validate_design_proposal_packet",
+    "validate_design_selection",
+]
diff --git a/src/maestro/display_language.py b/src/maestro/display_language.py
