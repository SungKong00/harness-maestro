+def owner_workflow_definition(repo: Path) -> dict[str, Any]:
+    definition = high_risk_definition(
+        authorization=authorization_artifacts(repo)
+    )
+    policy = build_workflow_policy(
+        risk="high",
+        workflow_steps=[
+            "work:Build the representative artifact",
+            "owner-checkpoint:Approve the representative artifact",
+            "verification:Verify the approved result",
+        ],
+    )
+    plan = definition["responsibility_plan"]
+    plan["stages"] = [
+        stage_fixture("stage-left", "role-left"),
+        stage_fixture(
+            "stage-right",
+            "role-right",
+            dependencies=["stage-left"],
+        ),
+    ]
+    plan["workflow_policy"] = policy
+    plan["owner_workflow_digest"] = owner_workflow_digest(policy)
+    plan["workflow_source_binding"] = build_workflow_source_binding(
+        policy
+    )
+    plan["workflow_step_mapping"] = build_workflow_step_mapping(
+        policy,
+        [
+            {
+                "step_id": "step-01",
+                "stage_spec_ids": ["stage-left"],
+                "after_step_id": None,
+                "before_step_id": None,
+                "checkpoint": None,
+            },
+            {
+                "step_id": "step-02",
+                "stage_spec_ids": [],
+                "after_step_id": "step-01",
+                "before_step_id": "step-03",
+                "checkpoint": {
+                    "checkpoint_id": "checkpoint-representative",
+                    "question": "Approve the representative artifact?",
+                    "options": [
+                        {
+                            "option_id": "approve",
+                            "label": "Approve",
+                            "consequences": ["resume-owner-workflow"],
+                        },
+                        {
+                            "option_id": "stop",
+                            "label": "Stop",
+                            "consequences": ["block-owner-workflow"],
+                        },
+                    ],
+                    "resume_option_id": "approve",
+                },
+            },
+            {
+                "step_id": "step-03",
+                "stage_spec_ids": ["stage-right"],
+                "after_step_id": None,
+                "before_step_id": None,
+                "checkpoint": None,
+            },
+        ],
+    )
+    plan["plan_id"] = responsibility_plan_id(plan)
+    definition["definition_digest"] = definition_digest(definition)
+    return validate_workflow_definition(definition)
