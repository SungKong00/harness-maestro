+    def test_v2_pack_preview_payload_reaches_endpoint_contract(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
+            repo = Path(temporary) / "repo"
+            repo.mkdir()
+            apply_fresh_init(repo)
+            server, token, url = create_dashboard_server(repo)
+            thread = threading.Thread(target=server.serve_forever, daemon=True)
+            thread.start()
+            base = url.split("/#token=", 1)[0]
+
+            def rejected_code(payload: dict[str, object]) -> str:
+                request = urllib.request.Request(
+                    f"{base}/api/expertise-actions/preview",
+                    method="POST",
+                    data=json.dumps(payload).encode("utf-8"),
+                    headers={
