+        if isinstance(receipt, Mapping)
+        and isinstance(receipt.get("participant_instance_id"), str)
+    }
+    participants = []
+    for participant_id, participant in sorted(state["participants"].items()):
+        receipt = receipt_by_participant.get(participant_id)
+        participants.append(
+            {
+                "participant_instance_id": participant_id,
+                "role_spec_id": participant.get(
+                    "role_spec_id",
+                    "not_observed",
+                ),
+                "producer_principal_id": (
+                    receipt.get("producer_principal_id", "not_observed")
+                    if receipt
+                    else "not_observed"
+                ),
+                "context_instance_id": (
+                    receipt.get("context_instance_id", "not_observed")
+                    if receipt
+                    else "not_observed"
+                ),
+                "capability_lease_id": (
+                    receipt.get("capability_lease_id", "not_observed")
+                    if receipt
+                    else "not_observed"
+                ),
+                "read_only": (
+                    receipt.get("read_only", "not_observed")
+                    if receipt
+                    else "not_observed"
+                ),
+                "metadata": _metadata_projection(
+                    receipt.get("metadata") if receipt else None
+                ),
+                "source": (
+                    receipt.get("issued_by", "not_observed")
+                    if receipt
+                    else "not_observed"
+                ),
+            }
+        )
+    return {
+        "schema_version": VIEWER_PROJECTION_VERSION,
+        "source_authority": state["runtime_authority"],
+        "projection_only": True,
+        "dispatch_allowed": False,
+        "root": {
+            "root_request_id": state["root_request_id"],
+            "root_execution_id": state["root_execution_id"],
+            "workflow_instance_id": state["workflow_instance_id"],
+            "definition_id": state["definition_id"],
+            "definition_revision": state["definition_revision"],
+            "definition_digest": state["definition_digest"],
+            "plan_revision": state["plan_revision"],
+            "status": state["status"],
+            "revision": state["revision"],
+        },
+        "stages": [
+            {
+                "stage_spec_id": stage_id,
+                **copy.deepcopy(runtime),
+            }
+            for stage_id, runtime in sorted(state["stage_states"].items())
+        ],
+        "participants": participants,
+        "attempts": [
+            copy.deepcopy(attempt)
+            for _, attempt in sorted(state["attempts"].items())
+        ],
+        "packets": [
+            copy.deepcopy(dict(packet))
+            for packet in sorted(
+                packet_envelopes,
+                key=lambda item: str(item.get("packet_id", "")),
+            )
+        ],
+        "conflicts": [
+            copy.deepcopy(conflict)
+            for _, conflict in sorted(state["conflicts"].items())
+        ],
+        "decisions": [
+            copy.deepcopy(decision)
+            for _, decision in sorted(state["decisions"].items())
+        ],
+        "corrections": [copy.deepcopy(dict(item)) for item in corrections],
+        "judgments": [copy.deepcopy(dict(item)) for item in judgments],
+        "effects": copy.deepcopy(state["effects"]),
+        "telemetry_policy": {
+            "requested_recommended_applied_separate": True,
+            "missing_applied_value": "not_observed",
+            "inference_allowed": False,
+        },
+    }
+
+
+def request_record_projection(state: Mapping[str, Any]) -> dict[str, Any]:
+    return {
+        "schema_version": REQUEST_PROJECTION_VERSION,
+        "root_request_id": state["root_request_id"],
+        "orchestration": {
+            "runtime_authority": state["runtime_authority"],
+            "root_execution_id": state["root_execution_id"],
+            "workflow_instance_id": state["workflow_instance_id"],
+            "definition_id": state["definition_id"],
+            "definition_revision": state["definition_revision"],
+            "definition_digest": state["definition_digest"],
+            "plan_revision": state["plan_revision"],
+            "status": state["status"],
+            "controller_revision": state["revision"],
+            "dispatch_allowed": False,
+            "projection_only": True,
+        },
+    }
diff --git a/src/maestro/orchestration/readiness.py b/src/maestro/orchestration/readiness.py
new file mode 100644
index 0000000000000000000000000000000000000000..01ab595f8424876984f8b411892036277c7ad470
--- /dev/null
+++ b/src/maestro/orchestration/readiness.py
@@ -0,0 +1,422 @@
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+from maestro.errors import MaestroError
+from maestro.util import canonical_json, sha256_text
+
+from .contracts import role_specs, stage_specs
+from .conflicts import (
+    OWNER_CHECKPOINT_RECEIPT_VERSION,
+    OWNER_CHECKPOINT_REQUEST_VERSION,
+)
+
+
+def _mapping_entries(definition: Mapping[str, Any]) -> list[dict[str, Any]]:
+    return definition["responsibility_plan"]["workflow_step_mapping"][
+        "entries"
+    ]
+
+
+def _mapped_stage_ids(
+    definition: Mapping[str, Any],
+    step_id: str | None,
+) -> list[str]:
+    if step_id is None:
+        return []
+    entry = next(
+        (
+            item
+            for item in _mapping_entries(definition)
+            if item["step_id"] == step_id
+        ),
+        None,
+    )
+    return list(entry["stage_spec_ids"]) if entry is not None else []
+
+
+def _mapped_stage_frontier(
+    definition: Mapping[str, Any],
+    step_id: str | None,
+) -> list[str]:
+    """Return the entry StageSpecs of one mapped owner phase."""
+
+    mapped = set(_mapped_stage_ids(definition, step_id))
+    stages = stage_specs(definition)
+    return sorted(
+        stage_id
+        for stage_id in mapped
+        if not any(
+            dependency in mapped
+            for dependency in stages[stage_id]["dependencies"]
+        )
+    )
+
+
+def _checkpoint_decision(
+    state: Mapping[str, Any],
+    workflow_step_id: str,
+) -> Mapping[str, Any] | None:
+    matches = [
+        decision
+        for decision in state["decisions"].values()
+        if isinstance(decision, Mapping)
+        and decision.get("schema_version")
+        == OWNER_CHECKPOINT_REQUEST_VERSION
+        and decision.get("workflow_step_id") == workflow_step_id
+    ]
+    if len(matches) > 1:
+        raise MaestroError(
+            "ORCH_DECISION_INVALID",
+            "One owner checkpoint has multiple DecisionRequests.",
+        )
+    return matches[0] if matches else None
+
+
+def owner_checkpoint_approved(
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+    entry: Mapping[str, Any],
+) -> bool:
+    decision = _checkpoint_decision(state, entry["step_id"])
+    if not isinstance(decision, Mapping) or decision.get("status") != "resolved":
+        return False
+    resolution = decision.get("resolution")
+    checkpoint = entry["checkpoint"]
+    if (
+        not isinstance(resolution, Mapping)
+        or resolution.get("schema_version")
+        != OWNER_CHECKPOINT_RECEIPT_VERSION
+        or resolution.get("workflow_step_id") != entry["step_id"]
+        or resolution.get("selected_option_id")
+        != checkpoint["resume_option_id"]
+    ):
+        return False
+    candidate = dict(resolution)
+    candidate["receipt_digest"] = ""
+    plan = definition["responsibility_plan"]
+    return (
+        resolution.get("receipt_digest")
+        == sha256_text(canonical_json(candidate))
+        and resolution.get("root_request_id")
+        == state["root_request_id"]
+        and resolution.get("root_execution_id")
+        == state["root_execution_id"]
+        and resolution.get("workflow_instance_id")
+        == state["workflow_instance_id"]
+        and resolution.get("definition_digest")
+        == definition["definition_digest"]
+        and resolution.get("plan_revision") == state["plan_revision"]
+        and resolution.get("responsibility_plan_id") == plan["plan_id"]
+        and resolution.get("workflow_policy_digest")
+        == plan["workflow_step_mapping"]["workflow_policy_digest"]
+    )
+
+
+def condition_active(
+    condition: Mapping[str, Any],
+    state: Mapping[str, Any],
+) -> bool:
+    kind = condition["kind"]
+    if kind == "always":
+        return True
+    if kind == "flag":
+        return state["flags"].get(condition["flag"]) is True
+    if kind == "conflict-open":
+        return any(
+            isinstance(conflict, dict)
+            and conflict.get("status") == "open"
+            for conflict in state["conflicts"].values()
+        )
+    if kind == "decision-resolved":
+        return any(
+            isinstance(decision, dict)
+            and decision.get("status") == "resolved"
+            for decision in state["decisions"].values()
+        )
+    raise MaestroError("ORCH_DAG_INVALID", f"Unknown condition kind: {kind}.")
+
+
+def expected_predecessor_slots(
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+    stage_spec_id: str,
+) -> list[dict[str, Any]]:
+    stage = stage_specs(definition)[stage_spec_id]
+    slots: list[dict[str, Any]] = []
+    for slot in stage["input_slots"]:
+        predecessor = slot["predecessor_stage_spec_id"]
+        packet = state["packets"].get(predecessor)
+        candidates = [] if packet is None else [packet]
+        cardinality = slot["cardinality"]
+        if cardinality == "one" and len(candidates) != 1:
+            raise MaestroError(
+                "ORCH_PACKET_SLOT_CARDINALITY",
+                f"Input slot {slot['slot_id']} requires exactly one accepted Packet.",
+            )
+        if cardinality == "optional-one" and len(candidates) > 1:
+            raise MaestroError(
+                "ORCH_PACKET_SLOT_CARDINALITY",
+                f"Input slot {slot['slot_id']} accepts at most one Packet.",
+            )
+        slots.append(
+            {
+                "slot_id": slot["slot_id"],
+                "predecessor_stage_spec_id": predecessor,
+                "cardinality": cardinality,
+                "packet_ids": [item["packet_id"] for item in candidates],
+                "packet_digests": [
+                    item["packet_digest"] for item in candidates
+                ],
+                "semantic_generations": [
+                    item["semantic_generation"] for item in candidates
+                ],
+            }
+        )
+    return slots
+
+
+def _stage_ready_without_owner_checkpoint(
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+    stage_spec_id: str,
+) -> bool:
+    stage = stage_specs(definition)[stage_spec_id]
+    runtime = state["stage_states"][stage_spec_id]
+    if (
+        state["status"] != "running"
+        or runtime["status"] != "pending"
+        or not condition_active(stage["condition"], state)
+    ):
+        return False
+    for dependency in stage["dependencies"]:
+        if state["stage_states"][dependency]["status"] != "completed":
+            return False
+    try:
+        expected_predecessor_slots(definition, state, stage_spec_id)
+    except MaestroError as exc:
+        if exc.code == "ORCH_PACKET_SLOT_CARDINALITY":
+            return False
+        raise
+    return True
+
+
+def stage_ready(
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+    stage_spec_id: str,
+) -> bool:
+    if not _stage_ready_without_owner_checkpoint(
+        definition,
+        state,
+        stage_spec_id,
+    ):
+        return False
+    for entry in _mapping_entries(definition):
+        checkpoint = entry.get("checkpoint")
+        if (
+            checkpoint is None
+            or stage_spec_id
+            not in _mapped_stage_ids(
+                definition,
+                entry["before_step_id"],
+            )
+        ):
+            continue
+        if not owner_checkpoint_approved(definition, state, entry):
+            return False
+    return True
+
+
+def next_reached_owner_checkpoint(
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+) -> dict[str, Any] | None:
+    """Return the first reached, unresolved checkpoint in owner order."""
+
+    if state["status"] != "running":
+        return None
+    for entry in _mapping_entries(definition):
+        if entry.get("checkpoint") is None:
+            continue
+        existing = _checkpoint_decision(state, entry["step_id"])
+        if existing is not None:
+            if owner_checkpoint_approved(definition, state, entry):
+                continue
+            return None
+        after_stage_ids = _mapped_stage_ids(
+            definition,
+            entry["after_step_id"],
+        )
+        if any(
+            state["stage_states"][stage_id]["status"] != "completed"
+            for stage_id in after_stage_ids
+        ):
+            continue
+        before_stage_ids = _mapped_stage_frontier(
+            definition,
+            entry["before_step_id"],
+        )
+        if before_stage_ids and not all(
+            _stage_ready_without_owner_checkpoint(
+                definition,
+                state,
+                stage_id,
+            )
+            for stage_id in before_stage_ids
+        ):
+            continue
+        return dict(entry)
+    return None
+
+
+def unresolved_owner_checkpoint_ids(
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+) -> list[str]:
+    return [
+        entry["step_id"]
+        for entry in _mapping_entries(definition)
+        if entry.get("checkpoint") is not None
+        and not owner_checkpoint_approved(definition, state, entry)
+    ]
+
+
+def deterministic_ready_set(
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+) -> list[str]:
+    return sorted(
+        stage_id
+        for stage_id in stage_specs(definition)
+        if stage_ready(definition, state, stage_id)
+    )
+
+
+def dispatch_waves(
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+) -> list[list[str]]:
+    """Return deterministic waves without claiming they already executed."""
+
+    ready = sorted(
+        set(deterministic_ready_set(definition, state))
+        | {
+            stage_id
+            for stage_id, runtime in state["stage_states"].items()
+            if state["status"] == "running"
+            and runtime["status"] == "ready"
+        }
+    )
+    stages = stage_specs(definition)
+    roles = role_specs(definition)
+    read_only = [
+        stage_id
+        for stage_id in ready
+        if (
+            stages[stage_id]["side_effect"] == "none"
+            and roles[stages[stage_id]["role_spec_id"]]["read_only"]
+        )
+    ]
+    mutation = [stage_id for stage_id in ready if stage_id not in read_only]
+    waves: list[list[str]] = []
+    if read_only:
+        maximum = definition["runtime_limits"][
+            "max_concurrent_read_only_stage_instances"
+        ]
+        pending = list(read_only)
+        while pending:
+            wave: list[str] = []
+            deferred: list[str] = []
+            wave_roles: set[str] = set()
+            for stage_id in pending:
+                role_id = stages[stage_id]["role_spec_id"]
+                if len(wave) < maximum and role_id not in wave_roles:
+                    wave.append(stage_id)
+                    wave_roles.add(role_id)
+                else:
+                    deferred.append(stage_id)
+            waves.append(wave)
+            pending = deferred
+    waves.extend([[stage_id] for stage_id in mutation])
+    return waves
+
+
+def active_terminal_candidate(
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+) -> bool:
+    if state["status"] != "running":
+        return False
+    if unresolved_owner_checkpoint_ids(definition, state):
+        return False
+    for stage_id, stage in stage_specs(definition).items():
+        active = condition_active(stage["condition"], state)
+        if stage["mandatory"] and not active:
+            return False
+        if active and state["stage_states"][stage_id]["status"] != "completed":
+            return False
+    assert_terminal_admissible(definition, state)
+    return True
+
+
+def assert_terminal_admissible(
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+) -> None:
+    """Require exact accepted Packet evidence for every active completion."""
+
+    if state["status"] != "running":
+        raise MaestroError(
+            "ORCH_TRANSITION_INVALID",
+            "Only a running orchestration can become a terminal candidate.",
+        )
+    unresolved = unresolved_owner_checkpoint_ids(definition, state)
+    if unresolved:
+        raise MaestroError(
+            "ORCH_OWNER_CHECKPOINT_REQUIRED",
+            "Terminal admission is blocked by owner checkpoints: "
+            + ", ".join(unresolved),
+        )
+    stages = stage_specs(definition)
+    for stage_id, stage in stages.items():
+        runtime = state["stage_states"][stage_id]
+        active = condition_active(stage["condition"], state)
+        if stage["mandatory"] and not active:
+            raise MaestroError(
+                "ORCH_TRANSITION_INVALID",
+                f"Mandatory StageSpec {stage_id} is inactive.",
+            )
+        if not active:
+            continue
+        if runtime["status"] != "completed":
+            raise MaestroError(
+                "ORCH_TRANSITION_INVALID",
+                f"Active StageSpec {stage_id} is not completed.",
+            )
+        packet = state["packets"].get(stage_id)
+        expected = {
+            "packet_id": runtime["accepted_packet_id"],
+            "packet_digest": runtime["accepted_packet_digest"],
+            "role_spec_id": runtime["role_spec_id"],
+            "stage_instance_id": (
+                f"{stage_id}:g{runtime['semantic_generation']}"
+            ),
+            "semantic_generation": runtime["semantic_generation"],
+        }
+        if not isinstance(packet, dict) or any(
+            packet.get(field) != value or value is None
+            for field, value in expected.items()
+        ):
+            raise MaestroError(
+                "ORCH_PACKET_ADMISSION_FAILED",
+                f"Completed StageSpec {stage_id} lacks its exact accepted Packet.",
+            )
+
+
+def blocked_stage_ids(state: Mapping[str, Any]) -> list[str]:
+    return sorted(
+        stage_id
+        for stage_id, stage in state["stage_states"].items()
+        if stage["status"] in {"blocked", "reconciling"}
+    )
diff --git a/src/maestro/orchestration/reconciliation.py b/src/maestro/orchestration/reconciliation.py
new file mode 100644
index 0000000000000000000000000000000000000000..724c327548240c1a4c663860a409083dd93c82e1
--- /dev/null
+++ b/src/maestro/orchestration/reconciliation.py
@@ -0,0 +1,393 @@
+from __future__ import annotations
+
+import copy
+import json
+import os
+import stat
+import subprocess
+import time
+from pathlib import Path
+from typing import Any, Mapping, Sequence
+
+try:
+    import fcntl
+except ImportError:  # pragma: no cover
+    fcntl = None  # type: ignore[assignment]
+
+from maestro.codex_host import (
+    _repository_effect_snapshot,
+    _repository_snapshot_changed_paths,
+)
+from maestro.errors import MaestroError
+from maestro.util import (
+    atomic_write,
+    canonical_json,
+    ensure_repo,
+    read_json,
+    safe_target,
+    sha256_text,
+)
+
+from .contracts import require_identity, require_line
+
+
+WRITER_FENCE_VERSION = "maestro_orchestration_writer_fence_v1"
+EFFECT_RECEIPT_VERSION = "maestro_orchestration_effect_receipt_v1"
+
+
+def checkout_base_revision(repo_path: str | Path) -> str:
+    repo = ensure_repo(repo_path)
+    completed = subprocess.run(
+        ["git", "-C", str(repo), "rev-parse", "HEAD"],
+        check=False,
+        capture_output=True,
+        text=True,
+    )
+    value = completed.stdout.strip()
+    if completed.returncode != 0 or not value:
+        raise MaestroError(
+            "ORCH_WRITER_FENCE_INVALID",
+            "The checkout base revision cannot be resolved.",
+        )
+    return value
+
+
+def _safe_lock(repo: Path) -> tuple[int, Path]:
+    if fcntl is None:
+        raise MaestroError(
+            "ORCH_WRITER_FENCE_UNAVAILABLE",
+            "This platform cannot provide a checkout-wide writer fence.",
+        )
+    path = safe_target(repo, ".maestro/state/orchestration/writer-fence.lock")
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    flags = os.O_RDWR | os.O_CREAT
+    if hasattr(os, "O_NOFOLLOW"):
+        flags |= os.O_NOFOLLOW
+    descriptor = os.open(path, flags, 0o600)
+    details = os.fstat(descriptor)
+    if not stat.S_ISREG(details.st_mode) or details.st_nlink != 1:
+        os.close(descriptor)
+        raise MaestroError(
+            "ORCH_WRITER_FENCE_INVALID",
+            "Writer fence must be one regular non-linked file.",
+        )
+    try:
+        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    except BlockingIOError as exc:
+        os.close(descriptor)
+        raise MaestroError(
+            "ORCH_WRITER_FENCE_BUSY",
+            "Another checkout writer fence is active.",
+        ) from exc
+    return descriptor, path
+
+
+class CheckoutWriterFence:
+    """Crash-recoverable exclusive lease bound to checkout, base, and epoch."""
+
+    def __init__(
+        self,
+        repo_path: str | Path,
+        *,
+        root_execution_id: str,
+        stage_instance_id: str,
+        participant_instance_id: str,
+        allowed_paths: Sequence[str],
+        expected_base_revision: str,
+        acquired_at: str,
+    ) -> None:
+        self.repo = ensure_repo(repo_path)
+        self.root_execution_id = require_identity(
+            root_execution_id,
+            field="root_execution_id",
+        )
+        self.stage_instance_id = require_identity(
+            stage_instance_id,
+            field="stage_instance_id",
+        )
+        self.participant_instance_id = require_identity(
+            participant_instance_id,
+            field="participant_instance_id",
+        )
+        self.allowed_paths = sorted(set(allowed_paths))
+        self.expected_base_revision = require_line(
+            expected_base_revision,
+            field="base_revision",
+            maximum=200,
+        )
+        self.acquired_at = require_line(
+            acquired_at,
+            field="acquired_at",
+            maximum=64,
+        )
+        self.descriptor: int | None = None
+        self.receipt: dict[str, Any] | None = None
+        self.before_snapshot: dict[str, Any] | None = None
+
+    @property
+    def registry_path(self) -> Path:
+        return safe_target(
+            self.repo,
+            ".maestro/state/orchestration/writer-fence.json",
+        )
+
+    def acquire(self) -> dict[str, Any]:
+        if self.descriptor is not None:
+            raise MaestroError(
+                "ORCH_WRITER_FENCE_INVALID",
+                "Writer fence is already held by this object.",
+            )
+        if checkout_base_revision(self.repo) != self.expected_base_revision:
+            raise MaestroError(
+                "ORCH_BASE_REVISION_DRIFT",
+                "Checkout HEAD differs from the frozen writer base revision.",
+            )
+        descriptor, _ = _safe_lock(self.repo)
+        try:
+            prior_epoch = 0
+            if self.registry_path.exists():
+                prior = read_json(self.registry_path)
+                value = prior.get("writer_fence_epoch")
+                if isinstance(value, int) and not isinstance(value, bool):
+                    prior_epoch = value
+            epoch = prior_epoch + 1
+            fence_seed = sha256_text(
+                canonical_json(
+                    {
+                        "repo": str(self.repo),
+                        "base_revision": self.expected_base_revision,
+                        "root_execution_id": self.root_execution_id,
+                        "stage_instance_id": self.stage_instance_id,
+                        "participant_instance_id": self.participant_instance_id,
+                        "epoch": epoch,
+                    }
+                )
+            )
+            receipt = {
+                "schema_version": WRITER_FENCE_VERSION,
+                "writer_fence_id": f"writer-fence-{fence_seed[:40]}",
+                "writer_fence_digest": "",
+                "checkout_identity": sha256_text(str(self.repo)),
+                "base_revision": self.expected_base_revision,
+                "writer_fence_epoch": epoch,
+                "root_execution_id": self.root_execution_id,
+                "stage_instance_id": self.stage_instance_id,
+                "participant_instance_id": self.participant_instance_id,
+                "allowed_paths": self.allowed_paths,
+                "status": "active",
+                "acquired_at": self.acquired_at,
+                "released_at": None,
+            }
+            candidate = copy.deepcopy(receipt)
+            candidate["writer_fence_digest"] = ""
+            receipt["writer_fence_digest"] = sha256_text(
+                canonical_json(candidate)
+            )
+            atomic_write(
+                self.registry_path,
+                (canonical_json(receipt) + "\n").encode("utf-8"),
+            )
+            self.descriptor = descriptor
+            self.receipt = receipt
+            self.before_snapshot = _repository_effect_snapshot(self.repo)
+            return copy.deepcopy(receipt)
+        except Exception:
+            fcntl.flock(descriptor, fcntl.LOCK_UN)
+            os.close(descriptor)
+            raise
+
+    def validate_active(self) -> dict[str, Any]:
+        if (
+            self.descriptor is None
+            or self.receipt is None
+            or self.before_snapshot is None
+        ):
+            raise MaestroError(
+                "ORCH_WRITER_FENCE_STALE",
+                "No active writer fence is held.",
+            )
+        current = read_json(self.registry_path)
+        exact = {
+            "writer_fence_id",
+            "writer_fence_epoch",
+            "writer_fence_digest",
+            "base_revision",
+            "root_execution_id",
+            "stage_instance_id",
+            "participant_instance_id",
+            "status",
+        }
+        if any(current.get(field) != self.receipt.get(field) for field in exact):
+            raise MaestroError(
+                "ORCH_WRITER_FENCE_STALE",
+                "Writer fence registry no longer matches the held epoch.",
+            )
+        if (
+            current["status"] != "active"
+            or checkout_base_revision(self.repo) != self.expected_base_revision
+        ):
+            raise MaestroError(
+                "ORCH_WRITER_FENCE_STALE",
+                "A revoked fence or changed base cannot authorize a late effect.",
+            )
+        return copy.deepcopy(current)
+
+    def effect_receipt(
+        self,
+        *,
+        completion_receipt: Mapping[str, Any],
+        observed_at: str,
+    ) -> dict[str, Any]:
+        fence = self.validate_active()
+        assert self.before_snapshot is not None
+        after = _repository_effect_snapshot(self.repo)
+        changed = _repository_snapshot_changed_paths(
+            self.repo,
+            self.before_snapshot,
+            after,
+        )
+        unauthorized = sorted(set(changed) - set(self.allowed_paths))
+        if unauthorized:
+            raise MaestroError(
+                "ORCH_WRITER_SCOPE_VIOLATION",
+                "Writer changed unauthorized paths: " + ", ".join(unauthorized),
+            )
+        claimed = completion_receipt.get("changed_paths")
+        if (
+            not isinstance(claimed, list)
+            or sorted(claimed) != sorted(changed)
+            or completion_receipt.get("effect_state")
+            not in {"no-writes", "verified-writes"}
+        ):
+            raise MaestroError(
+                "ORCH_MUTATION_EFFECT_UNKNOWN",
+                "Host effect receipt differs from the checkout-wide audit.",
+            )
+        receipt = {
+            "schema_version": EFFECT_RECEIPT_VERSION,
+            "effect_receipt_id": "",
+            "root_execution_id": self.root_execution_id,
+            "stage_instance_id": self.stage_instance_id,
+            "participant_instance_id": self.participant_instance_id,
+            "writer_fence_id": fence["writer_fence_id"],
+            "writer_fence_epoch": fence["writer_fence_epoch"],
+            "base_revision": fence["base_revision"],
+            "before_snapshot_sha256": sha256_text(
+                canonical_json(self.before_snapshot)
+            ),
+            "after_snapshot_sha256": sha256_text(canonical_json(after)),
+            "changed_paths": sorted(changed),
+            "classification": (
+                "committed" if changed else "not_committed"
+            ),
+            "completion_receipt_id": completion_receipt.get(
+                "completion_receipt_id"
+            ),
+            "observed_at": require_line(
+                observed_at,
+                field="observed_at",
+                maximum=64,
+            ),
+        }
+        receipt["effect_receipt_id"] = _effect_identity(receipt)
+        return receipt
+
+    def release(self, *, released_at: str) -> None:
+        if self.descriptor is None:
+            return
+        try:
+            if self.receipt is not None:
+                value = copy.deepcopy(self.receipt)
+                value["status"] = "revoked"
+                value["released_at"] = require_line(
+                    released_at,
+                    field="released_at",
+                    maximum=64,
+                )
+                candidate = copy.deepcopy(value)
+                candidate["writer_fence_digest"] = ""
+                value["writer_fence_digest"] = sha256_text(
+                    canonical_json(candidate)
+                )
+                atomic_write(
+                    self.registry_path,
+                    (canonical_json(value) + "\n").encode("utf-8"),
+                )
+        finally:
+            assert fcntl is not None
+            fcntl.flock(self.descriptor, fcntl.LOCK_UN)
+            os.close(self.descriptor)
+            self.descriptor = None
+
+    def __enter__(self) -> "CheckoutWriterFence":
+        self.acquire()
+        return self
+
+    def __exit__(self, *_: object) -> None:
+        self.release(
+            released_at=time.strftime(
+                "%Y-%m-%dT%H:%M:%SZ",
+                time.gmtime(),
+            )
+        )
+
+
+def _effect_identity(value: Mapping[str, Any]) -> str:
+    candidate = copy.deepcopy(dict(value))
+    candidate["effect_receipt_id"] = ""
+    return sha256_text(canonical_json(candidate))
+
+
+def reconcile_mutation_effect(
+    *,
+    before_snapshot: Mapping[str, Any] | None,
+    after_snapshot: Mapping[str, Any] | None,
+    completion_receipt: Mapping[str, Any] | None,
+    changed_paths: Sequence[str] | None,
+    evidence_refs: Sequence[str],
+) -> dict[str, Any]:
+    """Classify an interrupted mutation without authorizing a blind retry."""
+
+    if before_snapshot is None:
+        classification = "not_started"
+        next_actions = ["redispatch", "block"]
+    elif after_snapshot is None or changed_paths is None:
+        classification = "unknown"
+        next_actions = ["block", "owner_decision"]
+    elif completion_receipt is None and not changed_paths:
+        classification = "not_committed"
+        next_actions = ["redispatch", "block"]
+    elif (
+        completion_receipt is not None
+        and completion_receipt.get("effect_state") == "verified-writes"
+        and sorted(completion_receipt.get("changed_paths", []))
+        == sorted(changed_paths)
+    ):
+        classification = "committed"
+        next_actions = ["verify", "block"]
+    elif not changed_paths:
+        classification = "not_committed"
+        next_actions = ["redispatch", "block"]
+    else:
+        classification = "unknown"
+        next_actions = ["block", "owner_decision"]
+    return {
+        "schema_version": EFFECT_RECEIPT_VERSION,
+        "classification": classification,
+        "allowed_next_actions": next_actions,
+        "blind_transport_retry_allowed": False,
+        "evidence_refs": list(evidence_refs),
+        "before_snapshot_sha256": (
+            sha256_text(canonical_json(before_snapshot))
+            if before_snapshot is not None
+            else None
+        ),
+        "after_snapshot_sha256": (
+            sha256_text(canonical_json(after_snapshot))
+            if after_snapshot is not None
+            else None
+        ),
+        "changed_paths": (
+            sorted(changed_paths) if changed_paths is not None else None
+        ),
+    }
diff --git a/src/maestro/orchestration/reducer.py b/src/maestro/orchestration/reducer.py
new file mode 100644
index 0000000000000000000000000000000000000000..93ae9ffc5dba1705c164028b23baedd9427984d4
--- /dev/null
+++ b/src/maestro/orchestration/reducer.py
@@ -0,0 +1,1043 @@
+from __future__ import annotations
+
+import copy
+from typing import Any, Mapping
+
+from maestro.errors import MaestroError
+from maestro.util import canonical_json, sha256_text
+
+from .conflicts import (
+    OWNER_CHECKPOINT_REQUEST_VERSION,
+    validate_correction_request,
+    validate_correction_response,
+    validate_owner_checkpoint_request,
+    validate_owner_checkpoint_resolution,
+    validate_rebuttal_request,
+    validate_rebuttal_response,
+)
+from .packets import packet_digest as packet_content_digest
+from .readiness import (
+    assert_terminal_admissible,
+    next_reached_owner_checkpoint,
+)
+from .contracts import (
+    CONTROLLER_STATE_VERSION,
+    EVENT_VERSION,
+    RUNTIME_AUTHORITY,
+    dependent_stage_ids,
+    require_digest,
+    require_identity,
+    require_line,
+    require_root_request_id,
+    role_specs,
+    stage_specs,
+)
+
+
+EVENT_TYPES = {
+    "RUN_STARTED",
+    "FLAG_SET",
+    "STAGE_READY",
+    "CAPABILITY_LEASED",
+    "CONTEXT_EVIDENCE_COLLECTED",
+    "DISPATCH_REQUESTED",
+    "ATTEMPT_STARTED",
+    "PACKET_ACCEPTED",
+    "PACKET_REJECTED",
+    "ATTEMPT_FAILED",
+    "STAGE_BLOCKED",
+    "STAGE_SKIPPED",
+    "CORRECTION_ACCEPTED",
+    "CORRECTION_BLOCKED",
+    "CONFLICT_RECORDED",
+    "REBUTTAL_RECORDED",
+    "DECISION_REQUESTED",
+    "DECISION_RESOLVED",
+    "CANCELLATION_REQUESTED",
+    "CANCELLATION_ACKNOWLEDGED",
+    "RECONCILIATION_REQUIRED",
+    "RECONCILIATION_RESOLVED",
+    "WRITER_REPAIR_REQUESTED",
+    "RUN_TERMINAL_CANDIDATE",
+    "RUN_BLOCKED",
+}
+STAGE_STATUSES = {
+    "pending",
+    "ready",
+    "dispatching",
+    "running",
+    "completed",
+    "blocked",
+    "skipped",
+    "cancelling",
+    "cancelled",
+    "reconciling",
+}
+TERMINAL_STAGE_STATUSES = {"completed", "blocked", "skipped", "cancelled"}
+
+
+def state_digest(state: Mapping[str, Any]) -> str:
+    return sha256_text(canonical_json(state))
+
+
+def event_identity(value: Mapping[str, Any]) -> str:
+    candidate = copy.deepcopy(dict(value))
+    candidate["event_id"] = ""
+    return sha256_text(canonical_json(candidate))
+
+
+def build_event(
+    state: Mapping[str, Any] | None,
+    *,
+    event_type: str,
+    payload: Mapping[str, Any],
+    occurred_at: str,
+    root_request_id: str,
+    root_execution_id: str,
+    workflow_instance_id: str,
+) -> dict[str, Any]:
+    if event_type not in EVENT_TYPES:
+        raise MaestroError(
+            "ORCH_EVENT_INVALID",
+            f"Unknown orchestration event type: {event_type}.",
+        )
+    require_root_request_id(root_request_id)
+    require_identity(root_execution_id, field="root_execution_id")
+    require_identity(workflow_instance_id, field="workflow_instance_id")
+    require_line(occurred_at, field="occurred_at", maximum=64)
+    revision = state["revision"] if state is not None else 0
+    event = {
+        "schema_version": EVENT_VERSION,
+        "event_id": "",
+        "sequence": revision + 1,
+        "expected_revision": revision,
+        "event_type": event_type,
+        "root_request_id": root_request_id,
+        "root_execution_id": root_execution_id,
+        "workflow_instance_id": workflow_instance_id,
+        "previous_state_sha256": (
+            state_digest(state) if state is not None else None
+        ),
+        "occurred_at": occurred_at,
+        "payload": copy.deepcopy(dict(payload)),
+    }
+    event["event_id"] = event_identity(event)
+    return event
+
+
+def _stage_state(
+    *,
+    role_spec_id: str,
+    semantic_generation: int = 0,
+) -> dict[str, Any]:
+    return {
+        "status": "pending",
+        "role_spec_id": role_spec_id,
+        "semantic_generation": semantic_generation,
+        "attempt_ids": [],
+        "participant_receipt_digests": [],
+        "accepted_packet_digest": None,
+        "accepted_packet_id": None,
+        "last_failure": None,
+        "effect_state": "not_started",
+        "cancel_requested": False,
+    }
+
+
+def _initial_state(
+    definition: Mapping[str, Any],
+    event: Mapping[str, Any],
+) -> dict[str, Any]:
+    payload = event["payload"]
+    required = {
+        "definition_id",
+        "definition_revision",
+        "definition_digest",
+        "plan_revision",
+        "flags",
+        "authorization_binding",
+        "execution_mode",
+    }
+    if not isinstance(payload, dict) or set(payload) != required:
+        raise MaestroError(
+            "ORCH_EVENT_INVALID",
+            "RUN_STARTED payload does not match the closed start contract.",
+        )
+    if (
+        payload["definition_id"] != definition["definition_id"]
+        or payload["definition_revision"] != definition["definition_revision"]
+        or payload["definition_digest"] != definition["definition_digest"]
+        or payload["plan_revision"] != definition["definition_revision"]
+    ):
+        raise MaestroError(
+            "ORCH_ROOT_LINEAGE_MISMATCH",
+            "RUN_STARTED does not bind the exact Workflow Definition.",
+        )
+    if not isinstance(payload["flags"], dict) or not all(
+        isinstance(key, str) and isinstance(value, bool)
+        for key, value in payload["flags"].items()
+    ):
+        raise MaestroError(
+            "ORCH_EVENT_INVALID",
+            "RUN_STARTED flags must be a string-to-boolean object.",
+        )
+    if payload["execution_mode"] not in {
+        "managed-independent",
+        "single-context-direct",
+    }:
+        raise MaestroError(
+            "ORCH_EVENT_INVALID",
+            "RUN_STARTED execution_mode is invalid.",
+        )
+    stages = stage_specs(definition)
+    state = {
+        "schema_version": CONTROLLER_STATE_VERSION,
+        "runtime_authority": RUNTIME_AUTHORITY,
+        "root_request_id": event["root_request_id"],
+        "root_execution_id": event["root_execution_id"],
+        "workflow_instance_id": event["workflow_instance_id"],
+        "definition_id": definition["definition_id"],
+        "definition_revision": definition["definition_revision"],
+        "definition_digest": definition["definition_digest"],
+        "plan_revision": payload["plan_revision"],
+        "revision": 0,
+        "status": "running",
+        "execution_mode": payload["execution_mode"],
+        "independence_claimed": payload["execution_mode"]
+        == "managed-independent",
+        "flags": copy.deepcopy(payload["flags"]),
+        "stage_states": {
+            stage_id: _stage_state(role_spec_id=stage["role_spec_id"])
+            for stage_id, stage in sorted(stages.items())
+        },
+        "participants": {},
+        "attempts": {},
+        "packets": {},
+        "conflicts": {},
+        "corrections": {},
+        "rebuttals": {},
+        "decisions": {},
+        "effects": {},
+        "counters": {
+            "semantic_corrections": 0,
+            "rebuttal_rounds": 0,
+            "writer_repairs": 0,
+            "plan_revisions": payload["plan_revision"] - 1,
+        },
+        "authorization_binding": copy.deepcopy(
+            payload["authorization_binding"]
+        ),
+        "created_at": event["occurred_at"],
+        "updated_at": event["occurred_at"],
+        "last_event_id": None,
+    }
+    return state
+
+
+def _stage(
+    state: dict[str, Any],
+    payload: Mapping[str, Any],
+) -> tuple[str, dict[str, Any]]:
+    stage_id = payload.get("stage_spec_id")
+    if not isinstance(stage_id, str) or stage_id not in state["stage_states"]:
+        raise MaestroError(
+            "ORCH_STAGE_INVALID",
+            "The event references an unknown StageSpec.",
+        )
+    return stage_id, state["stage_states"][stage_id]
+
+
+def _transition(
+    stage: dict[str, Any],
+    *,
+    allowed: set[str],
+    target: str,
+    event_type: str,
+) -> None:
+    if stage["status"] not in allowed or target not in STAGE_STATUSES:
+        raise MaestroError(
+            "ORCH_TRANSITION_INVALID",
+            f"{event_type} cannot transition {stage['status']} to {target}.",
+        )
+    stage["status"] = target
+
+
+def apply_event(
+    prior_state: Mapping[str, Any] | None,
+    event: Mapping[str, Any],
+    definition: Mapping[str, Any],
+) -> dict[str, Any]:
+    if (
+        not isinstance(event, dict)
+        or event.get("schema_version") != EVENT_VERSION
+        or event.get("event_type") not in EVENT_TYPES
+        or event.get("event_id") != event_identity(event)
+    ):
+        raise MaestroError(
+            "ORCH_EVENT_INVALID",
+            "The event shape or content address is invalid.",
+        )
+    if prior_state is None:
+        if (
+            event["event_type"] != "RUN_STARTED"
+            or event["sequence"] != 1
+            or event["expected_revision"] != 0
+            or event["previous_state_sha256"] is not None
+        ):
+            raise MaestroError(
+                "ORCH_REPLAY_DIVERGENCE",
+                "The first event must be a revision-zero RUN_STARTED.",
+            )
+        state = _initial_state(definition, event)
+    else:
+        state = copy.deepcopy(dict(prior_state))
+        if (
+            event["root_request_id"] != state["root_request_id"]
+            or event["root_execution_id"] != state["root_execution_id"]
+            or event["workflow_instance_id"] != state["workflow_instance_id"]
+        ):
+            raise MaestroError(
+                "ORCH_ROOT_LINEAGE_MISMATCH",
+                "The event root or workflow identity differs from the controller state.",
+            )
+        if (
+            event["expected_revision"] != state["revision"]
+            or event["sequence"] != state["revision"] + 1
+            or event["previous_state_sha256"] != state_digest(state)
+        ):
+            raise MaestroError(
+                "ORCH_REPLAY_DIVERGENCE",
+                "The event revision or prior-state digest is stale.",
+            )
+
+    event_type = event["event_type"]
+    payload = event["payload"]
+    if not isinstance(payload, dict):
+        raise MaestroError("ORCH_EVENT_INVALID", "Event payload must be an object.")
+    pending_owner_checkpoint_ids = {
+        decision_id
+        for decision_id, decision in state["decisions"].items()
+        if isinstance(decision, dict)
+        and decision.get("schema_version")
+        == OWNER_CHECKPOINT_REQUEST_VERSION
+        and decision.get("status") == "pending"
+    }
+    if pending_owner_checkpoint_ids and (
+        event_type != "DECISION_RESOLVED"
+        or payload.get("decision_id") not in pending_owner_checkpoint_ids
+    ):
+        raise MaestroError(
+            "ORCH_OWNER_CHECKPOINT_PENDING",
+            "Only the exact pending owner checkpoint resolution may change orchestration state.",
+        )
+
+    if event_type == "RUN_STARTED":
+        pass
+    elif event_type == "FLAG_SET":
+        flag = require_identity(payload.get("flag"), field="flag")
+        if not isinstance(payload.get("value"), bool):
+            raise MaestroError("ORCH_EVENT_INVALID", "FLAG_SET value must be boolean.")
+        state["flags"][flag] = payload["value"]
+    elif event_type == "STAGE_READY":
+        _, stage = _stage(state, payload)
+        _transition(
+            stage,
+            allowed={"pending"},
+            target="ready",
+            event_type=event_type,
+        )
+    elif event_type in {"CAPABILITY_LEASED", "CONTEXT_EVIDENCE_COLLECTED"}:
+        stage_id, stage = _stage(state, payload)
+        participant_id = require_identity(
+            payload.get("participant_instance_id"),
+            field="participant_instance_id",
+        )
+        digest_field = (
+            "context_receipt_digest"
+            if event_type == "CONTEXT_EVIDENCE_COLLECTED"
+            else "host_receipt_digest"
+        )
+        receipt_digest = require_digest(
+            payload.get(digest_field),
+            field=digest_field,
+        )
+        participant = payload.get("participant")
+        if not isinstance(participant, dict):
+            raise MaestroError(
+                "ORCH_EVENT_INVALID",
+                f"{event_type} requires a participant projection.",
+            )
+        if participant_id == "not_observed":
+            sources = participant.get("observation_sources")
+            if (
+                not isinstance(sources, dict)
+                or sources.get("participant_instance_id")
+                != "not_observed"
+            ):
+                raise MaestroError(
+                    "ORCH_TELEMETRY_INFERRED",
+                    "An unobserved participant must remain explicitly unobserved.",
+                )
+        else:
+            existing = state["participants"].get(participant_id)
+            stable_fields = {
+                "participant_instance_id",
+                "role_spec_id",
+                "producer_principal_id",
+                "read_only",
+                "issued_by",
+            }
+            if existing is not None and any(
+                existing.get(field) != participant.get(field)
+                for field in stable_fields
+            ):
+                raise MaestroError(
+                    "ORCH_REPLAY_DIVERGENCE",
+                    "A logical ParticipantInstance cannot be rebound.",
+                )
+            state["participants"][participant_id] = copy.deepcopy(
+                participant
+            )
+        if receipt_digest not in stage["participant_receipt_digests"]:
+            stage["participant_receipt_digests"].append(receipt_digest)
+    elif event_type == "DISPATCH_REQUESTED":
+        stage_id, stage = _stage(state, payload)
+        _transition(
+            stage,
+            allowed={"ready"},
+            target="dispatching",
+            event_type=event_type,
+        )
+        attempt_id = require_identity(payload.get("attempt_id"), field="attempt_id")
+        if attempt_id in state["attempts"]:
+            raise MaestroError(
+                "ORCH_REPLAY_DIVERGENCE",
+                "Every dispatch requires a new transport Attempt identity.",
+            )
+        attempt = payload.get("attempt")
+        if not isinstance(attempt, dict):
+            raise MaestroError(
+                "ORCH_EVENT_INVALID",
+                "DISPATCH_REQUESTED requires an Attempt projection.",
+            )
+        state["attempts"][attempt_id] = copy.deepcopy(attempt)
+        stage["attempt_ids"].append(attempt_id)
+        stage["effect_state"] = "not_started"
+    elif event_type == "ATTEMPT_STARTED":
+        _, stage = _stage(state, payload)
+        _transition(
+            stage,
+            allowed={"dispatching"},
+            target="running",
+            event_type=event_type,
+        )
+        attempt_id = payload.get("attempt_id")
+        if attempt_id not in state["attempts"]:
+            raise MaestroError(
+                "ORCH_EVENT_INVALID",
+                "ATTEMPT_STARTED references an unknown Attempt.",
+            )
+        state["attempts"][attempt_id]["status"] = "running"
+        stage["effect_state"] = payload.get("effect_state", "not_started")
+    elif event_type == "PACKET_ACCEPTED":
+        stage_id, stage = _stage(state, payload)
+        _transition(
+            stage,
+            allowed={"running", "dispatching"},
+            target="completed",
+            event_type=event_type,
+        )
+        packet_digest = require_digest(
+            payload.get("packet_digest"),
+            field="packet_digest",
+        )
+        packet_id = require_identity(payload.get("packet_id"), field="packet_id")
+        generation = payload.get("semantic_generation")
+        if generation != stage["semantic_generation"]:
+            raise MaestroError(
+                "ORCH_PACKET_ADMISSION_FAILED",
+                "Accepted Packet generation differs from the StageInstance.",
+            )
+        stage["accepted_packet_digest"] = packet_digest
+        stage["accepted_packet_id"] = packet_id
+        stage["effect_state"] = payload.get("effect_state", stage["effect_state"])
+        state["packets"][stage_id] = {
+            "packet_id": packet_id,
+            "packet_digest": packet_digest,
