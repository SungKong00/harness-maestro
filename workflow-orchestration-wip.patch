+  "additionalProperties": false,
+  "required": [
+    "schema_version",
+    "packet_contract_id",
+    "packet_contract_version",
+    "packet_id",
+    "packet_digest",
+    "payload_ref",
+    "payload_sha256",
+    "validation_receipt_digest",
+    "context_receipt_id",
+    "context_receipt_digest",
+    "attempt_receipt_id",
+    "attempt_receipt_digest",
+    "root_request_id",
+    "root_execution_id",
+    "workflow_instance_id",
+    "definition_id",
+    "definition_revision",
+    "definition_digest",
+    "plan_revision",
+    "stage_spec_id",
+    "role_spec_id",
+    "stage_instance_id",
+    "semantic_generation",
+    "producer_participant_instance_id",
+    "producer_principal_id",
+    "producer_context_instance_id",
+    "capability_lease_id",
+    "attempt_id",
+    "input_projection_sha256",
+    "predecessor_slots",
+    "base_revision",
+    "freshness",
+    "completeness",
+    "status",
+    "claims",
+    "evidence_refs",
+    "authority_refs",
+    "limitations",
+    "conflicts",
+    "gaps",
+    "return_intent"
+  ],
+  "properties": {
+    "schema_version": {
+      "const": "maestro_orchestration_packet_v1"
+    },
+    "packet_contract_id": {
+      "$ref": "#/$defs/identity"
+    },
+    "packet_contract_version": {
+      "$ref": "#/$defs/identity"
+    },
+    "packet_id": {
+      "$ref": "#/$defs/identity"
+    },
+    "packet_digest": {
+      "$ref": "#/$defs/digest"
+    },
+    "payload_ref": {
+      "type": "string"
+    },
+    "payload_sha256": {
+      "$ref": "#/$defs/digest"
+    },
+    "validation_receipt_digest": {
+      "$ref": "#/$defs/digest"
+    },
+    "context_receipt_id": {
+      "$ref": "#/$defs/digest"
+    },
+    "context_receipt_digest": {
+      "$ref": "#/$defs/digest"
+    },
+    "attempt_receipt_id": {
+      "$ref": "#/$defs/digest"
+    },
+    "attempt_receipt_digest": {
+      "$ref": "#/$defs/digest"
+    },
+    "root_request_id": {
+      "type": "string",
+      "pattern": "^request-[a-f0-9]{20,64}$"
+    },
+    "root_execution_id": {
+      "$ref": "#/$defs/identity"
+    },
+    "workflow_instance_id": {
+      "$ref": "#/$defs/identity"
+    },
+    "definition_id": {
+      "$ref": "#/$defs/identity"
+    },
+    "definition_revision": {
+      "type": "integer",
+      "minimum": 1
+    },
+    "definition_digest": {
+      "$ref": "#/$defs/digest"
+    },
+    "plan_revision": {
+      "type": "integer",
+      "minimum": 1
+    },
+    "stage_spec_id": {
+      "$ref": "#/$defs/identity"
+    },
+    "role_spec_id": {
+      "$ref": "#/$defs/identity"
+    },
+    "stage_instance_id": {
+      "$ref": "#/$defs/identity"
+    },
+    "semantic_generation": {
+      "type": "integer",
+      "minimum": 0
+    },
+    "producer_participant_instance_id": {
+      "$ref": "#/$defs/identity"
+    },
+    "producer_principal_id": {
+      "$ref": "#/$defs/identity"
+    },
+    "producer_context_instance_id": {
+      "$ref": "#/$defs/identity"
+    },
+    "capability_lease_id": {
+      "$ref": "#/$defs/identity"
+    },
+    "attempt_id": {
+      "$ref": "#/$defs/identity"
+    },
+    "input_projection_sha256": {
+      "$ref": "#/$defs/digest"
+    },
+    "predecessor_slots": {
+      "type": "array",
+      "maxItems": 32,
+      "items": {
+        "$ref": "#/$defs/slot"
+      }
+    },
+    "base_revision": {
+      "type": "string",
+      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
+    },
+    "freshness": {
+      "$ref": "#/$defs/freshness"
+    },
+    "completeness": {
+      "$ref": "#/$defs/completeness"
+    },
+    "status": {
+      "const": "accepted"
