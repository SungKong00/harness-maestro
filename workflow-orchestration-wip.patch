+        _fail("Packet freshness contract is invalid.")
+    produced = _utc(freshness["produced_at"], field="produced_at")
+    expires = _utc(freshness["expires_at"], field="expires_at")
+    if (
+        freshness["freshness_seconds"]
+        != stage["output_contract"]["freshness_seconds"]
+        or expires
+        != produced + timedelta(seconds=freshness["freshness_seconds"])
+        or _utc(now, field="now") > expires
+    ):
+        _fail("Packet freshness is stale or inconsistent.")
+    completeness = packet["completeness"]
+    required_claims = stage["output_contract"]["required_claim_ids"]
+    present_claims = sorted(
+        claim["claim_id"]
+        for claim in packet["claims"]
