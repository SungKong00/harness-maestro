+def _fail(code: str, message: str) -> None:
+    raise MaestroError(code, message)
+
+
+def _closed(value: Any, fields: set[str], *, label: str) -> dict[str, Any]:
+    if not isinstance(value, dict) or set(value) != fields:
+        actual = sorted(value) if isinstance(value, dict) else type(value).__name__
+        _fail(
+            "ORCH_CONTRACT_INVALID",
+            f"{label} must contain exactly {sorted(fields)}; got {actual}.",
+        )
+    return value
+
+
+def _identity(value: Any, *, field: str) -> str:
+    if not isinstance(value, str) or _IDENTITY.fullmatch(value) is None:
+        _fail(
+            "ORCH_IDENTITY_INVALID",
+            f"{field} must be a bounded orchestration identity.",
+        )
+    return value
+
+
+def _line(value: Any, *, field: str, maximum: int = 500) -> str:
+    if (
+        not isinstance(value, str)
+        or not value
+        or value != value.strip()
+        or len(value) > maximum
+        or any(character in value for character in "\r\n\x00")
+    ):
+        _fail("ORCH_CONTRACT_INVALID", f"{field} must be one bounded line.")
+    return value
+
+
+def _digest(value: Any, *, field: str) -> str:
+    if not isinstance(value, str) or _DIGEST.fullmatch(value) is None:
+        _fail("ORCH_DIGEST_INVALID", f"{field} must be one SHA-256 digest.")
+    return value
+
+
+def _identities(
+    values: Any,
+    *,
+    field: str,
+    allow_empty: bool = True,
+    maximum: int = 64,
+) -> list[str]:
+    if (
+        not isinstance(values, list)
+        or (not allow_empty and not values)
+        or len(values) > maximum
+        or len(values) != len(set(values))
+    ):
+        _fail(
+            "ORCH_CONTRACT_INVALID",
+            f"{field} must be a unique bounded identity list.",
+        )
+    return [_identity(item, field=field) for item in values]
+
+
+def _refs(
+    values: Any,
+    *,
+    field: str,
+    allow_empty: bool = True,
+    maximum: int = 64,
+) -> list[str]:
+    if (
+        not isinstance(values, list)
+        or (not allow_empty and not values)
+        or len(values) > maximum
+        or len(values) != len(set(values))
+    ):
+        _fail(
+            "ORCH_CONTRACT_INVALID",
+            f"{field} must be a unique bounded reference list.",
+        )
+    return [_line(item, field=field) for item in values]
+
+
+def _repository_paths(values: Any, *, field: str) -> list[str]:
+    if not isinstance(values, list) or len(values) != len(set(values)):
+        _fail("ORCH_CONTRACT_INVALID", f"{field} must be a unique path list.")
+    result: list[str] = []
+    for value in values:
+        line = _line(value, field=field)
+        parts = line.split("/")
+        if line.startswith("/") or ".." in parts or "." == line:
+            _fail("ORCH_PATH_INVALID", f"{field} contains an unsafe path: {line}.")
+        result.append(line)
+    return result
+
+
+def definition_digest(value: Mapping[str, Any]) -> str:
+    candidate = copy.deepcopy(dict(value))
+    candidate["definition_digest"] = ""
+    return sha256_text(canonical_json(candidate))
+
+
+def responsibility_plan_id(value: Mapping[str, Any]) -> str:
+    candidate = copy.deepcopy(dict(value))
+    candidate["plan_id"] = ""
+    return sha256_text(canonical_json(candidate))
+
+
+def build_workflow_step_mapping(
+    workflow_policy: Mapping[str, Any],
+    entries: Sequence[Mapping[str, Any]],
+) -> dict[str, Any]:
+    """Build a Host-authored, domain-neutral owner-step mapping envelope."""
+
+    if not isinstance(workflow_policy, Mapping):
+        _fail(
+            "ORCH_WORKFLOW_STEP_MAPPING_INVALID",
+            "Workflow step mapping requires one canonical workflow policy.",
+        )
+    if not isinstance(entries, Sequence) or isinstance(entries, (str, bytes)):
+        _fail(
+            "ORCH_WORKFLOW_STEP_MAPPING_INVALID",
+            "Workflow step mapping entries must be a bounded sequence.",
+        )
+    return {
+        "schema_version": WORKFLOW_STEP_MAPPING_VERSION,
+        "workflow_policy_digest": workflow_policy_digest(
+            dict(workflow_policy)
+        ),
+        "entries": [copy.deepcopy(dict(entry)) for entry in entries],
+    }
+
+
+def build_workflow_source_binding(
+    workflow_policy: Mapping[str, Any],
+    *,
+    route_plan_id: str | None = None,
+    source_route_digest: str | None = None,
+    goal_digest: str | None = None,
+    route_risk: str | None = None,
+    route_intent: str | None = None,
+    task_contract: Mapping[str, Any] | None = None,
+) -> dict[str, Any]:
+    """Bind a direct definition or the exact validated Route v2 source."""
+
+    route_values = (
+        route_plan_id,
+        source_route_digest,
+        goal_digest,
+        route_risk,
+        route_intent,
+        task_contract,
+    )
+    if any(value is not None for value in route_values) and not all(
+        value is not None for value in route_values
+    ):
+        _fail(
+            "ORCH_WORKFLOW_SOURCE_INVALID",
+            "Route workflow source binding requires all source identity fields.",
+        )
+    if task_contract is not None and not isinstance(task_contract, Mapping):
+        _fail(
+            "ORCH_WORKFLOW_SOURCE_INVALID",
+            "Route workflow source requires one task contract object.",
+        )
+    policy = dict(workflow_policy)
+    allowed_side_effects = (
+        copy.deepcopy(task_contract.get("allowed_side_effects"))
+        if task_contract is not None
+        else None
+    )
+    if task_contract is not None and allowed_side_effects not in (
+        [],
+        ["repository_write"],
+    ):
+        _fail(
+            "ORCH_WORKFLOW_SOURCE_INVALID",
+            "Route task contract has unsupported repository side-effect authority.",
+        )
+    return {
+        "schema_version": WORKFLOW_SOURCE_BINDING_VERSION,
+        "source_kind": (
+            "route-v2" if route_plan_id is not None else "direct-definition"
+        ),
+        "route_plan_id": route_plan_id,
+        "source_route_digest": source_route_digest,
+        "goal_digest": goal_digest,
+        "route_risk": route_risk,
+        "route_intent": route_intent,
+        "task_contract_digest": (
+            sha256_text(canonical_json(dict(task_contract)))
+            if task_contract is not None
+            else None
+        ),
+        "task_contract_allowed_side_effects": allowed_side_effects,
+        "workflow_policy_digest": workflow_policy_digest(policy),
+        "owner_workflow_digest": owner_workflow_digest(policy),
+    }
+
+
+def _validate_workflow_source_binding(
+    value: Any,
+    *,
+    workflow_policy: Mapping[str, Any],
+) -> dict[str, Any]:
+    binding = _closed(
+        value,
+        _WORKFLOW_SOURCE_BINDING_FIELDS,
+        label="workflow_source_binding",
+    )
+    if (
+        binding["schema_version"] != WORKFLOW_SOURCE_BINDING_VERSION
+        or binding["source_kind"] not in {"direct-definition", "route-v2"}
+        or binding["workflow_policy_digest"]
+        != workflow_policy_digest(dict(workflow_policy))
+        or binding["owner_workflow_digest"]
+        != owner_workflow_digest(dict(workflow_policy))
+    ):
+        _fail(
+            "ORCH_WORKFLOW_SOURCE_INVALID",
+            "Workflow source binding does not match the exact policy.",
+        )
+    route_fields = (
+        "route_plan_id",
+        "source_route_digest",
+        "goal_digest",
+        "task_contract_digest",
+        "route_risk",
+        "route_intent",
+        "task_contract_allowed_side_effects",
+    )
+    if binding["source_kind"] == "direct-definition":
+        if any(binding[field] is not None for field in route_fields):
+            _fail(
+                "ORCH_WORKFLOW_SOURCE_INVALID",
+                "Direct definitions cannot claim Route v2 source identity.",
+            )
+    else:
+        for field in (
+            "route_plan_id",
+            "source_route_digest",
+            "goal_digest",
+            "task_contract_digest",
+        ):
+            _digest(binding[field], field=field)
+        if (
+            binding["route_risk"] not in RISK_LEVELS
+            or binding["route_intent"]
+            not in {"implementation", "review", "research"}
+            or binding["task_contract_allowed_side_effects"]
+            not in ([], ["repository_write"])
+            or (
+                binding["route_intent"] != "implementation"
+                and binding["task_contract_allowed_side_effects"]
+            )
+        ):
+            _fail(
+                "ORCH_WORKFLOW_SOURCE_INVALID",
+                "Route source binding has inconsistent risk, intent, or side-effect authority.",
+            )
+    return binding
+
+
+def _validate_runtime_limits(value: Any) -> dict[str, int]:
+    if not isinstance(value, dict) or set(value) != set(RUNTIME_LIMITS):
+        _fail(
+            "ORCH_RUNTIME_LIMITS_INVALID",
+            "runtime_limits must provide the complete versioned limit set.",
+        )
+    normalized: dict[str, int] = {}
+    for field, default in RUNTIME_LIMITS.items():
+        current = value[field]
+        if (
+            not isinstance(current, int)
+            or isinstance(current, bool)
+            or current < 0
+        ):
+            _fail(
+                "ORCH_RUNTIME_LIMITS_INVALID",
+                f"runtime_limits.{field} must be a non-negative integer.",
+            )
+        normalized[field] = current
+        if field == "max_concurrent_mutating_stage_instances_per_checkout" and current != 1:
+            _fail(
+                "ORCH_RUNTIME_LIMITS_INVALID",
+                "The checkout mutation concurrency limit must remain exactly one.",
+            )
+        if field == "max_mutation_transport_retries_per_stage" and current != 0:
+            _fail(
+                "ORCH_RUNTIME_LIMITS_INVALID",
+                "Mutation transport retries remain disabled; reconcile effects instead.",
+            )
+        if field == "max_conflict_rebuttal_rounds_per_root" and current > 1:
+            _fail(
+                "ORCH_RUNTIME_LIMITS_INVALID",
+                "At most one conflict-only rebuttal round is permitted.",
+            )
+        if field == "max_stage_instances_per_plan_revision" and current > 63:
+            _fail(
+                "ORCH_RUNTIME_LIMITS_INVALID",
+                "A plan revision may not exceed 63 stage instances.",
+            )
+        if default > 0 and current == 0 and field.endswith("_seconds"):
+            _fail(
+                "ORCH_RUNTIME_LIMITS_INVALID",
+                f"runtime_limits.{field} must be finite and positive.",
+            )
+    return normalized
+
+
+def _validate_authorization(value: Any) -> dict[str, Any]:
+    result = _closed(value, _AUTHORIZATION_FIELDS, label="authorization")
+    _line(result["decision_packet_ref"], field="decision_packet_ref")
+    _digest(result["decision_packet_sha256"], field="decision_packet_sha256")
+    if (
+        not isinstance(result["decision_packet_plan_revision"], int)
+        or isinstance(result["decision_packet_plan_revision"], bool)
+        or result["decision_packet_plan_revision"] != 3
+    ):
+        _fail(
+            "ORCH_AUTHORIZATION_INVALID",
+            "The compound implementation authorization must bind PlanRevision 3.",
+        )
+    design_gate = _closed(
+        result["design_gate"],
+        _DESIGN_GATE_FIELDS,
+        label="authorization.design_gate",
+    )
+    _digest(
+        design_gate["judgment_sha256"],
+        field="design_gate.judgment_sha256",
+    )
+    _line(design_gate["judgment_ref"], field="design_gate.judgment_ref")
+    if (
+        not isinstance(design_gate["decision_packet_plan_revision"], int)
+        or isinstance(design_gate["decision_packet_plan_revision"], bool)
+        or design_gate["decision_packet_plan_revision"] != 2
+    ):
+        _fail(
+            "ORCH_AUTHORIZATION_INVALID",
+            "The design gate must bind the exact PlanRevision 2 lineage.",
+        )
+    _digest(
+        design_gate["decision_packet_sha256"],
+        field="design_gate.decision_packet_sha256",
+    )
+    if design_gate["required_decision"] != "PASS":
+        _fail(
+            "ORCH_AUTHORIZATION_INVALID",
+            "The PlanRevision design gate must require PASS.",
+        )
+    completion_ids = _identities(
+        design_gate["criterion_ids"],
+        field="design_gate.criterion_ids",
+        allow_empty=False,
+    )
+    if len(completion_ids) != 12 or completion_ids != [
+        f"CC-{index:02d}" for index in range(1, 13)
+    ]:
+        _fail(
+            "ORCH_AUTHORIZATION_INVALID",
+            "The frozen completion contract must bind CC-01 through CC-12 exactly.",
+        )
+    scope = _closed(
+        result["scope_judgment"],
+        _SCOPE_JUDGMENT_FIELDS,
+        label="authorization.scope_judgment",
+    )
+    _line(scope["judgment_ref"], field="scope_judgment.judgment_ref")
+    _digest(
+        scope["judgment_sha256"],
+        field="scope_judgment.judgment_sha256",
+    )
+    if (
+        scope["schema_version"] != "ImplementationScopeJudgment_v3"
+        or scope["required_decision"] != "PASS"
+    ):
+        _fail(
+            "ORCH_AUTHORIZATION_INVALID",
+            "The implementation scope gate must require the v3 PASS contract.",
+        )
+    scope_ids = _identities(
+        scope["criterion_ids"],
+        field="scope_judgment.criterion_ids",
+        allow_empty=False,
+    )
+    if scope_ids != [f"ISJ3-{index:02d}" for index in range(1, 8)]:
+        _fail(
+            "ORCH_AUTHORIZATION_INVALID",
+            "The scope judgment must bind ISJ3-01 through ISJ3-07 exactly.",
+        )
+    _repository_paths(
+        result["writer_allowed_paths"],
+        field="writer_allowed_paths",
+    )
+    base_revision = result["base_revision"]
+    if (
+        not isinstance(base_revision, str)
+        or re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", base_revision) is None
+    ):
+        _fail(
+            "ORCH_AUTHORIZATION_INVALID",
+            "base_revision must be a Git SHA-1 or SHA-256 object identity.",
+        )
+    return result
+
+
+def _validate_executor_profiles(values: Any) -> set[str]:
+    if not isinstance(values, list) or len(values) > 32:
+        _fail("ORCH_EXECUTOR_PROFILE_INVALID", "executor_profiles must be bounded.")
+    ids: set[str] = set()
+    for index, raw in enumerate(values):
+        value = _closed(
+            raw,
+            _EXECUTOR_FIELDS,
+            label=f"executor_profiles[{index}]",
+        )
+        identity = _identity(
+            value["executor_profile_id"],
+            field="executor_profile_id",
+        )
+        if identity in ids:
+            _fail("ORCH_EXECUTOR_PROFILE_INVALID", f"Duplicate ExecutorProfile {identity}.")
+        ids.add(identity)
+        for field in (
+            "requested_model",
+            "recommended_model",
+            "requested_reasoning_effort",
+            "recommended_reasoning_effort",
+        ):
+            if value[field] is not None:
+                _line(value[field], field=field, maximum=128)
+        _refs(value["tools"], field="tools")
+        _refs(value["permissions"], field="permissions")
+        if not isinstance(value["context_policy"], dict):
+            _fail(
+                "ORCH_EXECUTOR_PROFILE_INVALID",
+                "ExecutorProfile.context_policy must be an object.",
+            )
+    if not ids:
+        _fail("ORCH_EXECUTOR_PROFILE_INVALID", "At least one ExecutorProfile is required.")
+    return ids
+
+
+def _validate_lens_bindings(values: Any) -> set[str]:
+    if not isinstance(values, list) or len(values) > 32:
+        _fail("ORCH_LENS_BINDING_INVALID", "lens_bindings must be bounded.")
+    ids: set[str] = set()
+    for index, raw in enumerate(values):
+        value = _closed(raw, _LENS_FIELDS, label=f"lens_bindings[{index}]")
+        identity = _identity(value["lens_binding_id"], field="lens_binding_id")
+        if identity in ids:
+            _fail("ORCH_LENS_BINDING_INVALID", f"Duplicate Lens binding {identity}.")
+        ids.add(identity)
+        _identity(value["lens_id"], field="lens_id")
+        _line(value["questions_ref"], field="questions_ref")
+        if value["advisory"] is not True:
+            _fail(
+                "ORCH_LENS_BINDING_INVALID",
+                "Lens bindings provide questions, not execution authority.",
+            )
+    return ids
+
+
+def _validate_pack_hints(value: Any) -> set[str]:
+    envelope = _closed(
+        value,
+        {"schema_version", "hints"},
+        label="pack_hints",
+    )
+    if envelope["schema_version"] != PACK_HINTS_VERSION:
+        _fail("ORCH_PACK_HINT_INVALID", "Unsupported pack hints contract.")
+    hints = envelope["hints"]
+    if not isinstance(hints, list) or len(hints) > 16:
+        _fail("ORCH_PACK_HINT_INVALID", "Pack hints must be a bounded list.")
+    ids: set[str] = set()
+    for index, raw in enumerate(hints):
+        hint = _closed(raw, _PACK_HINT_FIELDS, label=f"pack_hints[{index}]")
+        identity = _identity(hint["pack_hint_id"], field="pack_hint_id")
+        if identity in ids:
+            _fail("ORCH_PACK_HINT_INVALID", f"Duplicate Pack hint {identity}.")
+        ids.add(identity)
+        _identity(hint["pack_id"], field="pack_id")
+        _identities(hint["guide_ids"], field="guide_ids")
+        if hint["advisory"] is not True:
+            _fail(
+                "ORCH_PACK_HINT_AUTHORITY_FORBIDDEN",
+                "Pack hints are advisory and cannot grant role or mutation authority.",
+            )
+    return ids
+
