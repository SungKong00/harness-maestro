+def _validate_output_contract(value: Any, *, stage: str) -> None:
+    output = _closed(
+        value,
+        _OUTPUT_CONTRACT_FIELDS,
+        label=f"{stage}.output_contract",
+    )
+    for field in (
+        "packet_contract_id",
+        "packet_contract_version",
+        "validator_id",
+        "validator_version",
+    ):
+        _identity(output[field], field=field)
+    _digest(output["validator_digest"], field="validator_digest")
+    _identities(output["required_claim_ids"], field="required_claim_ids")
+    freshness = output["freshness_seconds"]
+    if (
+        not isinstance(freshness, int)
+        or isinstance(freshness, bool)
+        or freshness < 1
+        or freshness > 86_400
+    ):
+        _fail(
+            "ORCH_PACKET_CONTRACT_INVALID",
+            f"{stage}.freshness_seconds must be between 1 and 86400.",
+        )
+
+
+def _stage_ancestors(
+    stage_id: str,
+    stage_by_id: Mapping[str, Mapping[str, Any]],
+) -> set[str]:
+    ancestors: set[str] = set()
+    pending = list(stage_by_id[stage_id]["dependencies"])
+    while pending:
+        dependency = pending.pop()
+        if dependency in ancestors:
+            continue
+        ancestors.add(dependency)
+        pending.extend(stage_by_id[dependency]["dependencies"])
+    return ancestors
+
+
+def _validate_workflow_step_mapping(
+    value: Any,
+    *,
+    workflow_policy: Mapping[str, Any],
+    stage_by_id: Mapping[str, Mapping[str, Any]],
+) -> dict[str, Any]:
+    mapping = _closed(
+        value,
+        _WORKFLOW_STEP_MAPPING_FIELDS,
+        label="workflow_step_mapping",
+    )
+    if mapping["schema_version"] != WORKFLOW_STEP_MAPPING_VERSION:
+        _fail(
+            "ORCH_WORKFLOW_STEP_MAPPING_INVALID",
+            "Unsupported workflow step mapping contract.",
+        )
+    if mapping["workflow_policy_digest"] != workflow_policy_digest(
+        dict(workflow_policy)
+    ):
+        _fail(
+            "ORCH_WORKFLOW_STEP_MAPPING_INVALID",
+            "Workflow step mapping is not bound to the exact workflow policy.",
+        )
+    entries = mapping["entries"]
+    steps = workflow_policy["ordered_steps"]
+    if (
+        not isinstance(entries, list)
+        or len(entries) != len(steps)
+        or len(entries) > 12
+    ):
+        _fail(
+            "ORCH_WORKFLOW_STEP_MAPPING_INVALID",
+            "Every owner workflow step must have exactly one mapping entry.",
+        )
+    step_by_id = {step["step_id"]: step for step in steps}
+    expected_step_ids = [step["step_id"] for step in steps]
+    actual_step_ids: list[str] = []
+    stage_ids_by_step: dict[str, list[str]] = {}
+    work_stage_owners: dict[str, str] = {}
+    for index, raw in enumerate(entries):
+        entry = _closed(
+            raw,
+            _WORKFLOW_STEP_MAPPING_ENTRY_FIELDS,
+            label=f"workflow_step_mapping.entries[{index}]",
+        )
+        step_id = _identity(entry["step_id"], field="step_id")
+        actual_step_ids.append(step_id)
+        step = step_by_id.get(step_id)
+        if step is None:
+            _fail(
+                "ORCH_WORKFLOW_STEP_MAPPING_INVALID",
+                f"Workflow step mapping references unknown step {step_id}.",
+            )
+        mapped_stage_ids = _identities(
+            entry["stage_spec_ids"],
+            field=f"{step_id}.stage_spec_ids",
+        )
+        if any(stage_id not in stage_by_id for stage_id in mapped_stage_ids):
+            _fail(
+                "ORCH_WORKFLOW_STEP_MAPPING_INVALID",
+                f"Workflow step {step_id} references an unknown StageSpec.",
+            )
+        stage_ids_by_step[step_id] = mapped_stage_ids
+        if step["kind"] == "owner-checkpoint":
+            if mapped_stage_ids:
+                _fail(
+                    "ORCH_WORKFLOW_STEP_MAPPING_INVALID",
+                    "Owner checkpoints map a boundary, not executable StageSpecs.",
+                )
+            checkpoint = _closed(
+                entry["checkpoint"],
+                _OWNER_CHECKPOINT_FIELDS,
+                label=f"{step_id}.checkpoint",
+            )
+            _identity(
+                checkpoint["checkpoint_id"],
+                field="checkpoint_id",
+            )
+            _line(checkpoint["question"], field="question")
+            options = checkpoint["options"]
+            if not isinstance(options, list) or not 2 <= len(options) <= 8:
+                _fail(
+                    "ORCH_WORKFLOW_STEP_MAPPING_INVALID",
+                    "Owner checkpoints require two to eight Host-authored options.",
+                )
+            option_ids: list[str] = []
+            for option_index, raw_option in enumerate(options):
+                option = _closed(
+                    raw_option,
+                    _OWNER_CHECKPOINT_OPTION_FIELDS,
+                    label=f"{step_id}.checkpoint.options[{option_index}]",
+                )
+                option_ids.append(
+                    _identity(option["option_id"], field="option_id")
+                )
+                _line(option["label"], field="label")
+                _refs(
+                    option["consequences"],
+                    field="consequences",
+                    allow_empty=False,
+                )
+            if (
+                len(option_ids) != len(set(option_ids))
+                or checkpoint["resume_option_id"] not in option_ids
+            ):
+                _fail(
+                    "ORCH_WORKFLOW_STEP_MAPPING_INVALID",
+                    "Checkpoint options must be unique and name one resume option.",
+                )
+        else:
+            if not mapped_stage_ids:
+                _fail(
+                    "ORCH_WORKFLOW_STEP_MAPPING_INVALID",
+                    f"Executable owner step {step_id} has no mapped StageSpec.",
+                )
+            if entry["after_step_id"] is not None or entry[
+                "before_step_id"
+            ] is not None or entry["checkpoint"] is not None:
+                _fail(
+                    "ORCH_WORKFLOW_STEP_MAPPING_INVALID",
+                    "Only owner checkpoints may name a before/after step boundary.",
+                )
+            for stage_id in mapped_stage_ids:
+                previous = work_stage_owners.get(stage_id)
+                if previous is not None:
+                    _fail(
+                        "ORCH_WORKFLOW_STEP_MAPPING_INVALID",
+                        f"StageSpec {stage_id} is mapped to both {previous} and {step_id}.",
+                    )
+                work_stage_owners[stage_id] = step_id
+    if actual_step_ids != expected_step_ids:
+        _fail(
+            "ORCH_WORKFLOW_STEP_MAPPING_INVALID",
+            "Workflow mapping entries must preserve the exact owner step order.",
+        )
+
+    executable_steps = [
+        step for step in steps if step["kind"] != "owner-checkpoint"
+    ]
+    for previous, current in zip(
+        executable_steps,
+        executable_steps[1:],
+        strict=False,
+    ):
+        previous_stages = stage_ids_by_step[previous["step_id"]]
+        current_stages = stage_ids_by_step[current["step_id"]]
+        for current_stage in current_stages:
+            ancestors = _stage_ancestors(current_stage, stage_by_id)
+            if any(
+                previous_stage not in ancestors
+                for previous_stage in previous_stages
+            ):
+                _fail(
+                    "ORCH_WORKFLOW_STEP_MAPPING_INVALID",
+                    "Mapped StageSpecs do not preserve the owner happens-before order.",
+                )
+
+    for index, step in enumerate(steps):
+        if step["kind"] != "owner-checkpoint":
+            continue
+        entry = entries[index]
+        prior = next(
+            (
+                candidate["step_id"]
+                for candidate in reversed(steps[:index])
+                if candidate["kind"] != "owner-checkpoint"
+            ),
+            None,
+        )
+        following = next(
+            (
+                candidate["step_id"]
+                for candidate in steps[index + 1 :]
+                if candidate["kind"] != "owner-checkpoint"
+            ),
+            None,
+        )
+        if (
+            entry["after_step_id"] != prior
+            or entry["before_step_id"] != following
+            or (prior is None and following is None)
+        ):
+            _fail(
+                "ORCH_WORKFLOW_STEP_MAPPING_INVALID",
+                "Owner checkpoint boundaries must name the adjacent executable owner steps.",
+            )
+    return mapping
+
+
+def _validate_responsibility_plan(
+    value: Any,
+    *,
+    executor_ids: set[str],
+    lens_ids: set[str],
+    pack_hint_ids: set[str],
+    risk_level: str,
+    evidence_profile_name: str,
+    direct_path_allowed: bool,
+) -> dict[str, Any]:
+    plan = _closed(
+        value,
+        _RESPONSIBILITY_PLAN_FIELDS,
+        label="responsibility_plan",
+    )
+    if plan["schema_version"] != RESPONSIBILITY_PLAN_VERSION:
+        _fail(
+            "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+            "Unsupported ResponsibilityPlan contract.",
+        )
+    workflow_policy = require_workflow_policy(
+        plan["workflow_policy"],
+        risk=risk_level,
+    )
+    expected_owner_digest = owner_workflow_digest(workflow_policy)
+    if plan["owner_workflow_digest"] != expected_owner_digest:
+        _fail(
+            "ORCH_OWNER_WORKFLOW_DIGEST_MISMATCH",
+            "ResponsibilityPlan does not bind the exact owner workflow inputs.",
+        )
+    workflow_source_binding = _validate_workflow_source_binding(
+        plan["workflow_source_binding"],
+        workflow_policy=workflow_policy,
+    )
+    if (
+        workflow_source_binding["source_kind"] == "route-v2"
+        and workflow_source_binding["route_risk"] != risk_level
+    ):
+        _fail(
+            "ORCH_WORKFLOW_SOURCE_AUTHORITY_MISMATCH",
+            "Workflow Definition risk differs from the exact Route v2 source.",
+        )
+    for forbidden in _FORBIDDEN_PLAN_FIELDS:
+        if forbidden in plan:
+            _fail(
+                "ORCH_DEFINITION_INSTANCE_COLLAPSE",
+                f"ResponsibilityPlan cannot contain runtime field {forbidden}.",
+            )
+    concerns = plan["concerns"]
+    roles = plan["roles"]
+    stages = plan["stages"]
+    edges = plan["independence_edges"]
+    if not isinstance(concerns, list) or not concerns or len(concerns) > 64:
+        _fail(
+            "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+            "ResponsibilityPlan requires one to 64 concerns.",
+        )
+    if not isinstance(roles, list) or not roles or len(roles) > 32:
+        _fail(
+            "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+            "ResponsibilityPlan requires one to 32 RoleSpecs.",
+        )
+    if not isinstance(stages, list) or not stages or len(stages) > 63:
+        _fail(
+            "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+            "ResponsibilityPlan requires one to 63 StageSpecs.",
+        )
+    if not isinstance(edges, list) or len(edges) > 128:
+        _fail(
+            "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+            "Independence edges must be bounded.",
+        )
+
+    role_by_id: dict[str, dict[str, Any]] = {}
+    writer_roles: list[str] = []
+    verifier_roles: list[str] = []
+    for index, raw in enumerate(roles):
+        role = _closed(raw, _ROLE_FIELDS, label=f"roles[{index}]")
+        if _FORBIDDEN_ROLE_FIELDS.intersection(role):
+            _fail(
+                "ORCH_DEFINITION_INSTANCE_COLLAPSE",
+                "RoleSpec cannot contain Executor or runtime-instance fields.",
+            )
+        role_id = _identity(role["role_spec_id"], field="role_spec_id")
+        if role_id in role_by_id:
+            _fail(
+                "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+                f"Duplicate RoleSpec {role_id}.",
+            )
+        _identities(role["responsibility_ids"], field="responsibility_ids")
+        if role["executor_profile_id"] not in executor_ids:
+            _fail(
+                "ORCH_EXECUTOR_PROFILE_INVALID",
+                f"RoleSpec {role_id} references an unknown ExecutorProfile.",
+            )
+        if not set(_identities(role["lens_binding_ids"], field="lens_binding_ids")).issubset(
+            lens_ids
+        ):
+            _fail(
+                "ORCH_LENS_BINDING_INVALID",
+                f"RoleSpec {role_id} references an unknown Lens binding.",
+            )
+        if not set(_identities(role["pack_hint_ids"], field="pack_hint_ids")).issubset(
+            pack_hint_ids
+        ):
+            _fail(
+                "ORCH_PACK_HINT_INVALID",
+                f"RoleSpec {role_id} references an unknown Pack hint.",
+            )
+        for field in ("read_only", "mutation_owner", "verifier"):
+            if not isinstance(role[field], bool):
+                _fail(
+                    "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+                    f"RoleSpec {role_id}.{field} must be boolean.",
+                )
+        if role["mutation_owner"]:
+            writer_roles.append(role_id)
+            if role["read_only"] or role["verifier"]:
+                _fail(
+                    "ORCH_RESPONSIBILITY_ROLE_MERGE",
+                    "The mutation owner cannot be read-only or the verifier.",
+                )
+        if role["verifier"]:
+            verifier_roles.append(role_id)
+            if not role["read_only"]:
+                _fail(
+                    "ORCH_VERIFIER_NOT_INDEPENDENT",
+                    "A verifier RoleSpec must be read-only.",
+                )
+        requirements = role["capability_requirements"]
+        if (
+            not isinstance(requirements, list)
+            or not requirements
+            or len(requirements) > 32
+            or len(requirements) != len(set(requirements))
+        ):
+            _fail(
+                "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+                f"RoleSpec {role_id} must declare bounded capabilities.",
+            )
+        for requirement in requirements:
+            _identity(requirement, field="capability_requirements")
+        role_by_id[role_id] = role
+    if len(writer_roles) > 1:
+        _fail("ORCH_WRITER_FENCE_CONFLICT", "Exactly zero or one writer RoleSpec is allowed.")
+
+    concern_ids: set[str] = set()
+    owned_responsibilities: dict[str, str] = {}
+    for index, raw in enumerate(concerns):
+        concern = _closed(raw, _CONCERN_FIELDS, label=f"concerns[{index}]")
+        concern_id = _identity(
+            concern["responsibility_id"],
+            field="responsibility_id",
+        )
+        if concern_id in concern_ids:
+            _fail(
+                "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+                f"Duplicate responsibility {concern_id}.",
+            )
+        concern_ids.add(concern_id)
+        _line(concern["summary"], field="summary")
+        if concern["risk_level"] not in RISK_LEVELS:
+            _fail(
+                "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+                f"Responsibility {concern_id} has an invalid risk level.",
+            )
+        if not isinstance(concern["mandatory"], bool):
+            _fail(
+                "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+                "Concern.mandatory must be boolean.",
+            )
+        owner = concern["owner_role_spec_id"]
+        if owner is None:
+            if concern["mandatory"]:
+                _fail(
+                    "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+                    f"Mandatory responsibility {concern_id} has no owner.",
+                )
+        elif owner not in role_by_id:
+            _fail(
+                "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+                f"Responsibility {concern_id} references an unknown owner.",
+            )
+        else:
+            owned_responsibilities[concern_id] = owner
+        _refs(concern["evidence_refs"], field="evidence_refs")
+    for role_id, role in role_by_id.items():
+        for responsibility_id in role["responsibility_ids"]:
+            if (
+                responsibility_id not in concern_ids
+                or owned_responsibilities.get(responsibility_id) != role_id
+            ):
+                _fail(
+                    "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+                    f"RoleSpec {role_id} does not exactly own responsibility {responsibility_id}.",
+                )
+    if set(owned_responsibilities) != {
+        responsibility_id
+        for role in role_by_id.values()
+        for responsibility_id in role["responsibility_ids"]
+    }:
+        _fail(
+            "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+            "Every owned responsibility must occur in exactly one RoleSpec.",
+        )
+
+    stage_by_id: dict[str, dict[str, Any]] = {}
+    stage_role_ids: dict[str, str] = {}
+    for index, raw in enumerate(stages):
+        stage = _closed(raw, _STAGE_FIELDS, label=f"stages[{index}]")
+        stage_id = _identity(stage["stage_spec_id"], field="stage_spec_id")
+        if stage_id in stage_by_id:
+            _fail("ORCH_DAG_INVALID", f"Duplicate StageSpec {stage_id}.")
+        role_id = stage["role_spec_id"]
+        if role_id not in role_by_id:
+            _fail("ORCH_DAG_INVALID", f"StageSpec {stage_id} has an unknown RoleSpec.")
+        _line(stage["stage_kind"], field="stage_kind", maximum=100)
+        _identities(stage["dependencies"], field="dependencies")
+        if not isinstance(stage["mandatory"], bool) or not isinstance(
+            stage["fresh_context"], bool
+        ):
+            _fail("ORCH_DAG_INVALID", "Stage mandatory and fresh_context fields are boolean.")
+        if stage["side_effect"] not in STAGE_SIDE_EFFECTS:
+            _fail("ORCH_DAG_INVALID", f"StageSpec {stage_id} has an invalid side effect.")
+        role = role_by_id[role_id]
+        if stage["side_effect"] == "repository_mutation" and (
+            not role["mutation_owner"] or role["read_only"]
+        ):
+            _fail(
+                "ORCH_WRITER_FENCE_CONFLICT",
+                f"StageSpec {stage_id} may mutate only through the mutation-owner RoleSpec.",
+            )
+        if stage["side_effect"] == "none" and not role["read_only"]:
+            _fail(
+                "ORCH_RESPONSIBILITY_ROLE_MERGE",
+                f"Non-mutating StageSpec {stage_id} must use a read-only RoleSpec.",
+            )
+        retry_count = stage["max_transport_retries"]
+        if (
+            not isinstance(retry_count, int)
+            or isinstance(retry_count, bool)
+            or retry_count < 0
+            or retry_count > 1
+            or (stage["side_effect"] == "repository_mutation" and retry_count != 0)
+        ):
+            _fail(
+                "ORCH_RECOVERY_KIND_COLLAPSE",
+                f"StageSpec {stage_id} has an invalid transport retry budget.",
+            )
+        slots = stage["input_slots"]
+        if not isinstance(slots, list) or len(slots) > 32:
+            _fail("ORCH_PACKET_SLOT_CARDINALITY", "Stage input slots must be bounded.")
+        slot_ids: set[str] = set()
+        for slot_index, raw_slot in enumerate(slots):
+            slot = _closed(
+                raw_slot,
+                _SLOT_FIELDS,
+                label=f"{stage_id}.input_slots[{slot_index}]",
+            )
+            slot_id = _identity(slot["slot_id"], field="slot_id")
+            if slot_id in slot_ids:
+                _fail(
+                    "ORCH_PACKET_SLOT_CARDINALITY",
+                    f"StageSpec {stage_id} has duplicate slot {slot_id}.",
+                )
+            slot_ids.add(slot_id)
+            _identity(
+                slot["predecessor_stage_spec_id"],
+                field="predecessor_stage_spec_id",
+            )
+            if slot["cardinality"] not in SLOT_CARDINALITIES:
+                _fail(
+                    "ORCH_PACKET_SLOT_CARDINALITY",
+                    f"StageSpec {stage_id} has invalid slot cardinality.",
+                )
+        _validate_output_contract(stage["output_contract"], stage=stage_id)
+        condition = _closed(
+            stage["condition"],
+            _CONDITION_FIELDS,
+            label=f"{stage_id}.condition",
+        )
+        if condition["kind"] not in CONDITION_KINDS:
+            _fail("ORCH_DAG_INVALID", f"StageSpec {stage_id} has an invalid condition.")
+        if condition["kind"] == "flag":
+            _identity(condition["flag"], field="condition.flag")
+        elif condition["flag"] is not None:
+            _fail(
+                "ORCH_DAG_INVALID",
+                f"StageSpec {stage_id} condition flag is only valid for kind=flag.",
+            )
+        stage_by_id[stage_id] = stage
+        stage_role_ids[stage_id] = role_id
+    if workflow_source_binding["source_kind"] == "route-v2":
+        mutation_authorized = workflow_source_binding[
+            "task_contract_allowed_side_effects"
+        ] == ["repository_write"]
+        has_mutation_stage = any(
+            stage["side_effect"] == "repository_mutation"
+            for stage in stage_by_id.values()
+        )
+        if (
+            bool(writer_roles) != mutation_authorized
+            or has_mutation_stage != mutation_authorized
+        ):
+            _fail(
+                "ORCH_WORKFLOW_SOURCE_AUTHORITY_MISMATCH",
+                "Workflow Definition mutation authority differs from the exact Route v2 task contract.",
+            )
+
+    for stage_id, stage in stage_by_id.items():
+        dependencies = stage["dependencies"]
+        if stage_id in dependencies or any(item not in stage_by_id for item in dependencies):
+            _fail("ORCH_DAG_INVALID", f"StageSpec {stage_id} has an invalid dependency.")
+        slot_predecessors = [
+            slot["predecessor_stage_spec_id"] for slot in stage["input_slots"]
+        ]
+        if any(item not in dependencies for item in slot_predecessors):
+            _fail(
+                "ORCH_PACKET_SLOT_CARDINALITY",
+                f"StageSpec {stage_id} input slots must reference declared dependencies.",
+            )
+    visiting: set[str] = set()
+    visited: set[str] = set()
+
+    def visit(stage_id: str) -> None:
+        if stage_id in visiting:
+            _fail("ORCH_DAG_INVALID", "Stage dependency graph contains a cycle.")
+        if stage_id in visited:
+            return
+        visiting.add(stage_id)
+        for dependency in stage_by_id[stage_id]["dependencies"]:
+            visit(dependency)
+        visiting.remove(stage_id)
+        visited.add(stage_id)
+
+    for stage_id in sorted(stage_by_id):
+        visit(stage_id)
+
+    _validate_workflow_step_mapping(
+        plan["workflow_step_mapping"],
+        workflow_policy=workflow_policy,
+        stage_by_id=stage_by_id,
+    )
+
+    edge_ids: set[str] = set()
+    mandatory_high_risk_pairs: set[frozenset[str]] = set()
+    for index, raw in enumerate(edges):
+        edge = _closed(raw, _INDEPENDENCE_FIELDS, label=f"independence_edges[{index}]")
+        edge_id = _identity(edge["edge_id"], field="edge_id")
+        if edge_id in edge_ids:
+            _fail("ORCH_RESPONSIBILITY_COVERAGE_INVALID", f"Duplicate edge {edge_id}.")
+        edge_ids.add(edge_id)
+        left = edge["left_role_spec_id"]
+        right = edge["right_role_spec_id"]
+        if left not in role_by_id or right not in role_by_id or left == right:
+            _fail(
+                "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+                f"Independence edge {edge_id} has invalid RoleSpecs.",
+            )
+        dimensions = set(
+            _identities(edge["dimensions"], field="independence_dimensions", allow_empty=False)
+        )
+        if not dimensions.issubset(_INDEPENDENCE_DIMENSIONS):
+            _fail(
+                "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+                f"Independence edge {edge_id} has an unknown dimension.",
+            )
+        if not isinstance(edge["mandatory"], bool) or not isinstance(edge["high_risk"], bool):
+            _fail(
+                "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+                "Independence edge flags must be boolean.",
+            )
+        if evidence_profile_name in {
+            PUBLIC_CODEX_EVIDENCE_PROFILE,
+            SCRIPTED_TEST_EVIDENCE_PROFILE,
+        }:
+            forbidden = {
+                "participant",
+                "principal",
+                "capability-lease",
+            }
+            if dimensions & forbidden:
+                _fail(
+                    "ORCH_EVIDENCE_PROFILE_INVALID",
+                    f"{evidence_profile_name} cannot claim principal, participant, or lease isolation.",
+                )
+        if edge["mandatory"] and edge["high_risk"]:
+            required = (
+                {
+                    "context",
+                    "invocation",
+                    "authority-effect",
+                }
+                if evidence_profile_name
+                in {
+                    PUBLIC_CODEX_EVIDENCE_PROFILE,
+                    SCRIPTED_TEST_EVIDENCE_PROFILE,
+                }
+                else {
+                    "participant",
+                    "principal",
+                    "invocation",
+                    "context",
+                    "capability-lease",
+                }
+            )
+            invalid_dimensions = (
+                dimensions != required
+                if evidence_profile_name
+                in {
+                    PUBLIC_CODEX_EVIDENCE_PROFILE,
+                    SCRIPTED_TEST_EVIDENCE_PROFILE,
+                }
+                else not required.issubset(dimensions)
+            )
+            if invalid_dimensions:
+                _fail(
+                    "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+                    f"High-risk edge {edge_id} has dimensions incompatible with {evidence_profile_name}.",
+                )
+            mandatory_high_risk_pairs.add(frozenset((left, right)))
+    if risk_level in {"high", "critical"} and len(role_by_id) > 1:
+        material_roles = {
+            role_id
+            for role_id, role in role_by_id.items()
+            if role["mutation_owner"] or role["verifier"] or role["responsibility_ids"]
+        }
+        if len(material_roles) > 1 and not mandatory_high_risk_pairs:
+            _fail(
+                "ORCH_RESPONSIBILITY_COVERAGE_INVALID",
+                "A high-risk multi-role plan requires mandatory evidence-backed independence.",
+            )
+    if verifier_roles and writer_roles and frozenset(
+        (verifier_roles[0], writer_roles[0])
+    ) not in mandatory_high_risk_pairs:
+        _fail(
+            "ORCH_VERIFIER_NOT_INDEPENDENT",
+            "Writer and verifier require an explicit mandatory independence edge.",
+        )
+    if direct_path_allowed and (
+        risk_level != "low" or len(role_by_id) != 1 or bool(edges)
+    ):
+        _fail(
+            "ORCH_DIRECT_PATH_FORBIDDEN",
+            "The single-context direct path is only valid for one low-risk role without independence edges.",
+        )
+
+    expected_plan_id = responsibility_plan_id(plan)
+    if plan["plan_id"] != expected_plan_id:
+        _fail(
+            "ORCH_PLAN_DIGEST_MISMATCH",
+            "ResponsibilityPlan.plan_id does not match its canonical content.",
+        )
+    return plan
+
