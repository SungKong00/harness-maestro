+from __future__ import annotations
+
+import zlib
+from pathlib import Path
+
+
+PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"
+MAX_PNG_BYTES = 20 * 1024 * 1024
+MAX_DECODED_BYTES = 128 * 1024 * 1024
+
+
+def _paeth(left: int, above: int, upper_left: int) -> int:
+    estimate = left + above - upper_left
+    left_distance = abs(estimate - left)
+    above_distance = abs(estimate - above)
+    upper_left_distance = abs(estimate - upper_left)
+    if left_distance <= above_distance and left_distance <= upper_left_distance:
+        return left
+    if above_distance <= upper_left_distance:
+        return above
+    return upper_left
+
+
+def inspect_png(
+    data: bytes,
+    *,
+    require_visual_content: bool = False,
+) -> tuple[int, int] | None:
+    """Validate the bounded PNG evidence wire contract.
+
+    Evidence images are non-interlaced 8-bit grayscale, RGB,
+    grayscale-alpha, or RGBA PNGs. The decoder validates chunk CRCs, the
+    complete zlib stream, exact scanline length, filter bytes, and—when
+    requested—at least two distinct decoded pixels.
+    """
+
+    if (
+        len(data) < 45
+        or len(data) > MAX_PNG_BYTES
+        or not data.startswith(PNG_SIGNATURE)
+    ):
+        return None
+    offset = 8
+    width = height = color_type = None
+    idat_parts: list[bytes] = []
+    seen_ihdr = False
+    seen_idat = False
+    idat_closed = False
+    while offset + 12 <= len(data):
+        length = int.from_bytes(data[offset : offset + 4], "big")
+        chunk_type = data[offset + 4 : offset + 8]
+        end = offset + 12 + length
+        if (
+            end > len(data)
+            or len(chunk_type) != 4
+            or not all(
+                65 <= item <= 90 or 97 <= item <= 122
+                for item in chunk_type
+            )
+        ):
+            return None
+        payload = data[offset + 8 : offset + 8 + length]
+        recorded_crc = int.from_bytes(
+            data[offset + 8 + length : end],
+            "big",
+        )
+        if zlib.crc32(chunk_type + payload) & 0xFFFFFFFF != recorded_crc:
+            return None
+        if not seen_ihdr:
+            if chunk_type != b"IHDR" or length != 13:
+                return None
+            width = int.from_bytes(payload[0:4], "big")
+            height = int.from_bytes(payload[4:8], "big")
+            color_type = payload[9]
+            if (
+                not 1 <= width <= 8_192
+                or not 1 <= height <= 16_384
+                or payload[8] != 8
+                or color_type not in {0, 2, 4, 6}
+                or payload[10:13] != b"\x00\x00\x00"
+            ):
+                return None
+            seen_ihdr = True
+        elif chunk_type == b"IHDR":
+            return None
+        elif chunk_type == b"IDAT":
+            if idat_closed or not payload:
+                return None
+            seen_idat = True
+            idat_parts.append(payload)
+        elif chunk_type == b"PLTE":
+            if seen_idat or length < 3 or length > 768 or length % 3:
+                return None
+        elif chunk_type == b"IEND":
+            if length != 0 or end != len(data) or not seen_idat:
+                return None
+            assert isinstance(width, int)
+            assert isinstance(height, int)
+            assert isinstance(color_type, int)
+            channels = {0: 1, 2: 3, 4: 2, 6: 4}[color_type]
+            row_bytes = width * channels
+            expected_size = height * (row_bytes + 1)
+            if expected_size > MAX_DECODED_BYTES:
+                return None
+            try:
+                decoder = zlib.decompressobj()
+                decoded = decoder.decompress(
+                    b"".join(idat_parts),
+                    expected_size + 1,
+                )
+                decoded += decoder.flush()
+            except zlib.error:
+                return None
+            if (
+                len(decoded) != expected_size
+                or not decoder.eof
+                or decoder.unused_data
+                or decoder.unconsumed_tail
+            ):
+                return None
+            previous = bytearray(row_bytes)
+            distinct_pixels: set[bytes] = set()
+            cursor = 0
+            for _ in range(height):
+                filter_type = decoded[cursor]
+                if filter_type > 4:
+                    return None
+                cursor += 1
+                filtered = decoded[cursor : cursor + row_bytes]
+                cursor += row_bytes
+                reconstructed = bytearray(row_bytes)
+                for index, source in enumerate(filtered):
+                    left = (
+                        reconstructed[index - channels]
+                        if index >= channels
+                        else 0
+                    )
+                    above = previous[index]
+                    upper_left = (
+                        previous[index - channels]
+                        if index >= channels
+                        else 0
+                    )
+                    if filter_type == 0:
+                        predictor = 0
+                    elif filter_type == 1:
+                        predictor = left
+                    elif filter_type == 2:
+                        predictor = above
+                    elif filter_type == 3:
+                        predictor = (left + above) // 2
+                    else:
+                        predictor = _paeth(left, above, upper_left)
+                    reconstructed[index] = (source + predictor) & 0xFF
+                if require_visual_content and len(distinct_pixels) < 2:
+                    for index in range(0, row_bytes, channels):
+                        distinct_pixels.add(
+                            bytes(
+                                reconstructed[
+                                    index : index + channels
+                                ]
+                            )
+                        )
+                        if len(distinct_pixels) >= 2:
+                            break
+                previous = reconstructed
+            if require_visual_content and len(distinct_pixels) < 2:
+                return None
+            return width, height
+        elif chunk_type[:1].isupper():
+            return None
+        elif seen_idat:
+            idat_closed = True
+        offset = end
+    return None
+
+
+def inspect_png_file(
+    target: Path,
+    *,
+    require_visual_content: bool = False,
+) -> tuple[int, int] | None:
+    try:
+        data = target.read_bytes()
+    except OSError:
+        return None
+    return inspect_png(
+        data,
+        require_visual_content=require_visual_content,
+    )
+
+
+__all__ = [
+    "MAX_DECODED_BYTES",
+    "MAX_PNG_BYTES",
+    "PNG_SIGNATURE",
+    "inspect_png",
+    "inspect_png_file",
+]
