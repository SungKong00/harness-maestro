+def dependent_stage_ids(
+    definition: Mapping[str, Any],
+    source_stage_ids: Iterable[str],
+) -> list[str]:
+    sources = set(source_stage_ids)
+    result: set[str] = set()
+    stages = stage_specs(definition)
+    changed = True
+    while changed:
+        changed = False
+        for stage_id, stage in stages.items():
+            if stage_id in result or stage_id in sources:
+                continue
+            if any(
+                dependency in sources or dependency in result
+                for dependency in stage["dependencies"]
+            ):
+                result.add(stage_id)
+                changed = True
+    return sorted(result)
+
