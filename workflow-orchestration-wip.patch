+    allowed = {
+        "schema_version",
+        "command",
+        "repo_realpath",
+        "base_revision",
+        "candidate_id",
+        "fingerprint",
+        "operation",
+        "warnings",
+        "writes_performed",
+        "plan_id",
+        "plan_digest",
+    }
+    if (
+        not isinstance(plan, dict)
+        or set(plan) != allowed
+        or plan.get("schema_version") != CONVENTION_CANDIDATE_PLAN_VERSION
+        or plan.get("command") != "convention-candidate"
+        or plan.get("writes_performed") is not False
+    ):
+        raise MaestroError(
+            "CONVENTION_CANDIDATE_PLAN_INVALID",
+            "Unsupported Convention candidate plan.",
+            exit_code=3,
+        )
+    unsigned = {
+        key: value
+        for key, value in plan.items()
+        if key not in {"plan_id", "plan_digest"}
+    }
+    digest = sha256_text(canonical_json(unsigned))
+    if (
+        plan.get("plan_digest") != digest
+        or plan.get("plan_id") != digest[:20]
+    ):
+        raise MaestroError(
+            "PLAN_TAMPERED",
+            "Convention candidate plan digest does not match.",
+            exit_code=3,
+        )
+    repo = ensure_repo(repo_override or plan.get("repo_realpath", ""))
+    if str(repo) != plan.get("repo_realpath"):
+        raise MaestroError(
+            "PLAN_REPO_MISMATCH",
+            "Convention candidate plan belongs to a different repository.",
+            exit_code=3,
+        )
+    if plan.get("base_revision") != repository_revision(repo):
+        raise MaestroError(
+            "PLAN_STALE",
+            "Repository checkout changed after Convention candidate preview.",
+            exit_code=3,
+        )
+    if _self_improvement_policy(repo)["mode"] != (
+        "verified-project-conventions"
+    ):
+        raise MaestroError(
+            "CONVENTION_CANDIDATE_DISABLED",
+            "Project Convention candidate persistence is disabled.",
+            exit_code=3,
+        )
+    operation = plan.get("operation")
+    if (
+        not isinstance(operation, dict)
+        or set(operation)
+        != {
+            "op",
+            "path",
+            "before_sha256",
+            "after_sha256",
+            "content",
+        }
+        or operation.get("op") not in {"create", "replace"}
+        or not isinstance(operation.get("content"), str)
+        or sha256_text(operation["content"])
+        != operation.get("after_sha256")
+    ):
+        raise MaestroError(
+            "CONVENTION_CANDIDATE_PLAN_INVALID",
+            "Convention candidate operation is invalid.",
+            exit_code=3,
+        )
