+                    "ORCH_CORRECTION_CONTEXT_MISMATCH",
+                    "The Host resumed a different context than the correction target.",
+                )
+            returned_runtime_roots: list[str] | str
+            if runtime_roots_supported and not _same_runtime_workspace_roots(
+                thread_result.get("runtimeWorkspaceRoots"),
+                runtime_workspace_roots,
