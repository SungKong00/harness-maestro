+def _workflow_runtime_errors(repo: Path) -> tuple[list[str], int, int]:
+    try:
+        inflight_root = safe_target(repo, ".maestro/state/inflight")
+    except MaestroError as exc:
+        return [f"runtime state path: {exc.code}"], 0, 0
+    if not inflight_root.exists():
+        return [], 0, 0
+    errors: list[str] = []
+    managed_count = 0
+    legacy_count = 0
+    paths = sorted(inflight_root.glob("*.json"))
+    if len(paths) > 1_000:
+        return ["inflight observation scan exceeds 1000 files"], 0, 0
+    for path in paths:
+        try:
+            observation = read_json(path)
+        except MaestroError as exc:
+            errors.append(f"{path.name}: {exc.code}")
+            continue
+        plan_summary = observation.get("plan_summary")
+        if not isinstance(plan_summary, dict):
+            continue
+        if (
+            plan_summary.get("runtime_authority")
+            != WORKFLOW_RUNTIME_AUTHORITY
+        ):
+            legacy_count += 1
+            continue
+        managed_count += 1
+        try:
+            definition = runtime_workflow_definition(
+                plan_summary.get("outcome_judge_mode", "shadow")
+            )
+        except MaestroError as exc:
+            errors.append(
+                f"{path.name}: workflow definition {exc.code}"
+            )
+            continue
+        observation_id = observation.get("observation_id")
+        if not isinstance(observation_id, str):
+            errors.append(f"{path.name}: missing observation identity")
+            continue
+        try:
+            checkpoint_path = safe_target(
+                repo,
+                f".maestro/state/workflows/{observation_id}.json",
+            )
+            checkpoint = read_json(checkpoint_path)
+        except MaestroError as exc:
+            errors.append(
+                f"{path.name}: workflow checkpoint {exc.code}"
+            )
+            continue
+        if not validate_checkpoint(checkpoint, definition):
+            errors.append(f"{path.name}: invalid workflow checkpoint")
+            continue
+        ledger = observation.get("execution_ledger")
+        projections = [
+            event.get("payload", {}).get("workflow_projection")
+            for event in (
+                ledger.get("events", [])
+                if isinstance(ledger, dict)
+                else []
+            )
+            if isinstance(event, dict)
+            and event.get("event_type") == "workflow_projected"
+        ]
+        latest = projections[-1] if projections else None
+        if (
+            not isinstance(latest, dict)
+            or latest.get("workflow_instance_id")
+            != checkpoint["workflow_instance_id"]
+            or latest.get("root_request_id")
+            != checkpoint["root_request_id"]
+            or latest.get("revision") != checkpoint["revision"]
+            or latest.get("state_id")
+            != checkpoint["state"]["state_id"]
+        ):
+            errors.append(
+                f"{path.name}: workflow projection is missing or stale"
+            )
+    return errors, managed_count, legacy_count
