+class CodexHostSession(HostSession):
+    def __init__(
+        self,
+        *,
+        repo: Path,
+        server: Any,
+        definition: Mapping[str, Any],
+        state: Mapping[str, Any],
+        stage: Mapping[str, Any],
+        role: Mapping[str, Any],
+        executor: Mapping[str, Any],
+        participant_receipt: dict[str, Any],
+        thread_id: str,
+        runtime_binding: Mapping[str, Any],
+        sandbox_policy: Mapping[str, Any],
+        runtime_workspace_roots: Sequence[str],
+        timeout_seconds: float,
+        before_snapshot: Mapping[str, Any],
+        mutation: bool,
+    ) -> None:
+        self.repo = repo
+        self.server = server
+        self.definition = definition
+        self.state = state
+        self.stage = stage
+        self.role = role
+        self.executor = executor
+        self.participant_receipt = participant_receipt
+        self.thread_id = thread_id
+        self.runtime_binding = runtime_binding
+        self.sandbox_policy = dict(sandbox_policy)
+        self.runtime_workspace_roots = list(runtime_workspace_roots)
+        self.timeout_seconds = timeout_seconds
+        self.before_snapshot = dict(before_snapshot)
+        self.mutation = mutation
+        self.turn_id: str | None = None
+        self.closed = False
+
+    def _prompt(self, projection: Mapping[str, Any]) -> str:
+        schema = result_output_schema(self.stage)
+        prompt = (
+            "Execute only this immutable orchestration Stage projection. "
+            "Do not infer missing authority, participants, predecessor Packets, "
+            "or applied metadata. Return exactly one JSON object matching the "
+            "closed output schema, without Markdown or commentary.\n"
+            f"Output schema:\n{canonical_json(schema)}\n"
+            f"Stage projection:\n{canonical_json(projection)}"
+        )
+        if len(prompt.encode("utf-8")) > 256_000:
+            raise MaestroError(
+                "ORCH_HOST_PROMPT_INVALID",
+                "The canonical Stage projection exceeds the Host prompt limit.",
+            )
+        return prompt
+
+    def dispatch(
+        self,
+        *,
+        projection: Mapping[str, Any],
+        input_projection_sha256: str,
+    ) -> HostDispatchOutcome:
+        turn_params: dict[str, Any] = {
+            "threadId": self.thread_id,
+            "input": [{"type": "text", "text": self._prompt(projection)}],
+            "cwd": str(self.repo),
+            "approvalPolicy": "never",
+            "sandboxPolicy": self.sandbox_policy,
+            "outputSchema": result_output_schema(self.stage),
+        }
+        if self.runtime_binding.get("runtime_workspace_roots") is True:
+            turn_params["runtimeWorkspaceRoots"] = (
+                self.runtime_workspace_roots
+            )
+        if self.executor["requested_model"] is not None:
+            turn_params["model"] = self.executor["requested_model"]
+        if self.executor["requested_reasoning_effort"] is not None:
+            turn_params["effort"] = self.executor[
+                "requested_reasoning_effort"
+            ]
+        turn_start_request_sha256 = sha256_text(
+            canonical_json(turn_params)
+        )
+        self.server.send(
+            {
+                "jsonrpc": "2.0",
+                "id": 3,
+                "method": "turn/start",
+                "params": turn_params,
+            }
+        )
+        turn_result = self.server.response(3)
+        turn_start_response_sha256 = sha256_text(
+            canonical_json(turn_result)
+        )
+        turn = turn_result.get("turn")
+        if (
+            not isinstance(turn, dict)
+            or not isinstance(turn.get("id"), str)
+            or not turn["id"]
+        ):
+            raise MaestroError(
+                "CODEX_HOST_PROTOCOL_INVALID",
+                "turn/start did not return a usable turn ID.",
+            )
+        self.turn_id = turn["id"]
+        lifecycle_events: list[dict[str, Any]] = []
+        capture = {
+            "thread_id": self.thread_id,
+            "turn_id": self.turn_id,
+            "completion": None,
+            "reroutes": [],
+            "tokens": None,
+            "tokens_last": None,
+            "token_updates": 0,
+            "error_count": 0,
+            "last_error": None,
+            "raw_errors": [],
+            "final_message": None,
+            "final_message_is_final": False,
+            "work_tracker": None,
+            "work_action_sink": None,
+        }
+        queued = list(self.server.notifications)
+        self.server.notifications.clear()
+        for value in queued:
+            event = _public_lifecycle_event(
+                value,
+                sequence=len(lifecycle_events) + 1,
+                expected_thread_id=self.thread_id,
+                expected_turn_id=self.turn_id,
+            )
+            if event is not None:
+                lifecycle_events.append(event)
+            _process_notification(value, capture)
+        while capture["completion"] is None:
+            value = self.server.next_message()
+            if isinstance(value, dict) and isinstance(value.get("method"), str):
+                event = _public_lifecycle_event(
+                    value,
+                    sequence=len(lifecycle_events) + 1,
+                    expected_thread_id=self.thread_id,
+                    expected_turn_id=self.turn_id,
+                )
+                if event is not None:
+                    lifecycle_events.append(event)
+                if value.get("method") == "error":
+                    capture["raw_errors"].append(
+                        canonical_json(value.get("params"))[:1000]
+                    )
+                _process_notification(value, capture)
+        completion = capture["completion"]
+        assert isinstance(completion, dict)
+        _capture_terminal_message(completion, capture)
+        if completion["status"] != "completed":
+            detail = capture.get("last_error")
+            if capture.get("raw_errors"):
+                detail = str(capture["raw_errors"][-1])
+            if not isinstance(detail, str) or not detail:
+                raw_detail = completion.get("error")
+                detail = (
+                    json.dumps(raw_detail, sort_keys=True)[:500]
+                    if raw_detail is not None
+                    else "no Host error detail"
+                )
+            raise MaestroError(
+                "ORCH_HOST_ATTEMPT_FAILED",
+                (
+                    f"Codex Host turn ended as {completion['status']}: "
+                    f"{detail}"
+                ),
+            )
+        message = capture["final_message"]
+        if not capture["final_message_is_final"] or not isinstance(message, str):
+            raise MaestroError(
+                "ORCH_PACKET_ADMISSION_FAILED",
+                "Codex Host did not return one final JSON result.",
+            )
+        try:
+            raw = json.loads(message)
+        except json.JSONDecodeError as exc:
+            raise MaestroError(
+                "ORCH_PACKET_ADMISSION_FAILED",
+                "Codex Host final result is not valid JSON.",
+            ) from exc
+        completed_at = time.strftime(
+            "%Y-%m-%dT%H:%M:%SZ",
+            time.gmtime(),
+        )
+        result, semantic_receipt = validate_semantic_result(
+            self.stage,
+            raw,
+            participant_receipt=self.participant_receipt,
+            completed_at=completed_at,
+        )
+        try:
+            _shutdown_and_audit_scoped_host(
+                self.server,
+                self.repo,
+                state={
+                    "thread_id": self.thread_id,
+                    "turn_id": self.turn_id,
+                    "completion": completion,
+                    "interrupt_requested": False,
+                },
+                before=self.before_snapshot,
+                allowed_roots=(
+                    self.runtime_workspace_roots if self.mutation else ()
+                ),
+            )
+        except MaestroError as exc:
+            if not self.mutation and exc.code == "CODEX_HOST_SCOPE_VIOLATION":
+                raise MaestroError(
+                    "ORCH_READ_ONLY_EFFECT_DETECTED",
+                    "A read-only Codex Host stage changed repository-visible state.",
+                ) from exc
+            raise
+        self.closed = True
+        after = _repository_effect_snapshot(self.repo)
+        changed_paths = _repository_snapshot_changed_paths(
+            self.repo,
+            self.before_snapshot,
+            after,
+        )
+        changed = _repository_snapshot_changed(self.before_snapshot, after)
+        if not self.mutation and changed:
+            raise MaestroError(
+                "ORCH_READ_ONLY_EFFECT_DETECTED",
+                "A read-only Codex Host stage changed repository-visible state.",
+            )
+        effect_state = "verified-writes" if changed else "no-writes"
+        before_sha256 = sha256_text(canonical_json(self.before_snapshot))
+        after_sha256 = sha256_text(canonical_json(after))
+        read_only_zero_effect = self.role["read_only"] and not changed
+        effect_audit = {
+            "before_sha256": before_sha256,
+            "after_sha256": after_sha256,
+            "effect_state": effect_state,
+            "changed_paths": sorted(changed_paths),
+            "read_only_zero_effect": read_only_zero_effect,
+        }
+        applied_model = self.participant_receipt["metadata"]["applied"][
+            "model"
+        ]
+        for reroute in capture["reroutes"]:
+            if isinstance(reroute.get("to_model"), str):
+                applied_model = reroute["to_model"]
+        event_digests = [
+            event["event_sha256"] for event in lifecycle_events
+        ]
+        completion_receipt = issue_attempt_evidence(
+            self.repo,
+            evidence_profile=self.participant_receipt[
+                "evidence_profile"
+            ],
+            evidence_kind="post-turn-attempt",
+            collector_integrity=_collector_integrity(),
+            root_request_id=self.state["root_request_id"],
+            root_execution_id=self.state["root_execution_id"],
+            workflow_instance_id=self.state["workflow_instance_id"],
+            stage_spec_id=self.stage["stage_spec_id"],
+            role_spec_id=self.role["role_spec_id"],
+            attempt_id=self.participant_receipt["attempt_id"],
+            context_receipt_id=self.participant_receipt["receipt_id"],
+            context_receipt_digest=host_receipt_digest(
+                self.participant_receipt
+            ),
+            thread_id=self.thread_id,
+            session_id=self.participant_receipt["host_context"][
+                "session_id"
+            ],
+            turn_id=self.turn_id,
+            turn_start_request_sha256=turn_start_request_sha256,
+            turn_start_response_sha256=turn_start_response_sha256,
+            lifecycle={
+                "events": lifecycle_events,
+                "event_count": len(lifecycle_events),
+                "event_chain_sha256": sha256_text(
+                    canonical_json(event_digests)
+                ),
+                "turn_started": any(
+                    event["method"] == "turn/started"
+                    for event in lifecycle_events
+                ),
+                "turn_completed": any(
+                    event["method"] == "turn/completed"
+                    for event in lifecycle_events
+                ),
+            },
+            telemetry={
+                "reroutes": copy.deepcopy(capture["reroutes"]),
+                "tokens": (
+                    copy.deepcopy(capture["tokens"])
+                    if capture["tokens"] is not None
+                    else "not_observed"
+                ),
+                "applied_model": applied_model,
+                "model_coverage": "complete_stream",
+            },
+            repository_effect={
+                "before_sha256": before_sha256,
+                "after_sha256": after_sha256,
+                "audit_sha256": sha256_text(
+                    canonical_json(effect_audit)
+                ),
+                "read_only_zero_effect": read_only_zero_effect,
+            },
+            input_projection_sha256=input_projection_sha256,
+            semantic_validation_receipt_id=semantic_receipt["receipt_id"],
+            status="completed",
+            effect_state=effect_state,
+            changed_paths=sorted(changed_paths),
+            completed_at=completed_at,
+        )
+        validate_attempt_evidence(
+            self.repo,
+            completion_receipt,
+            context_receipt=self.participant_receipt,
+            expected_root_request_id=self.state["root_request_id"],
+            expected_root_execution_id=self.state["root_execution_id"],
+            expected_workflow_instance_id=self.state[
+                "workflow_instance_id"
+            ],
+            expected_stage_spec_id=self.stage["stage_spec_id"],
+            expected_role_spec_id=self.role["role_spec_id"],
+            expected_attempt_id=self.participant_receipt["attempt_id"],
+            expected_input_projection_sha256=input_projection_sha256,
+        )
+        return HostDispatchOutcome(
+            result=result,
+            semantic_validation_receipt=semantic_receipt,
+            completion_receipt=completion_receipt,
+            effect_state=effect_state,
+            changed_paths=sorted(changed_paths),
+        )
+
+    def cancel(self, *, reason: str) -> dict[str, Any]:
+        require_line(reason, field="reason")
+        if self.turn_id is None:
+            return {
+                "status": "cancelled",
+                "effect_state": "not_started",
+                "reason": reason,
+            }
+        self.server.send(
+            {
+                "jsonrpc": "2.0",
+                "id": 4,
+                "method": "turn/interrupt",
+                "params": {
+                    "threadId": self.thread_id,
+                    "turnId": self.turn_id,
+                },
+            }
+        )
+        self.server.response(4)
+        return {
+            "status": "cancellation-requested",
+            "effect_state": "unknown" if self.mutation else "no-writes",
+            "reason": reason,
+        }
+
+    def close(self) -> None:
+        if not self.closed:
+            if not self.server.close():
+                raise MaestroError(
+                    "CODEX_HOST_TERMINATION_FAILED",
+                    "The Codex App Server process group did not terminate.",
+                )
+            self.closed = True
+
+
+def _codex_host_observations(
+    *,
+    thread_result: Mapping[str, Any],
+    thread_id: str,
+    role: Mapping[str, Any],
+) -> dict[str, Any]:
+    """Read only documented public ThreadStartResponse fields."""
+
+    if "hostAttestation" in thread_result:
+        raise MaestroError(
+            "ORCH_HOST_SELF_ATTESTATION_FORBIDDEN",
+            "Undocumented ThreadStartResponse.hostAttestation cannot grant "
+            "orchestration identity or authority.",
+        )
+    returned_model = thread_result.get("model")
+    if not isinstance(returned_model, str) or not returned_model:
+        returned_model = "not_observed"
+    returned_effort = thread_result.get("reasoningEffort")
+    if not isinstance(returned_effort, str) or not returned_effort:
+        returned_effort = "not_observed"
+    applied = {
+        "model": returned_model,
+        "reasoning_effort": returned_effort,
+        "tools": "not_observed",
+        "permissions": "not_observed",
+        "tokens": "not_observed",
+        "cost": "not_observed",
+    }
+    identity_values = {
+        "producer_principal_id": "not_observed",
+        "invocation_id": "not_observed",
+        "context_instance_id": f"codex-thread-{thread_id}",
+        "capability_lease_id": "not_observed",
+    }
+    capabilities: list[str] = []
+    read_only = bool(role["read_only"])
+    observation_sources = {
+        "participant_instance_id": "controller_assigned",
+        "producer_principal_id": "not_observed",
+        "invocation_id": "not_observed",
+        "context_instance_id": "public_host_returned",
+        "capability_lease_id": "not_observed",
+        "capabilities": "not_observed",
+        "read_only": "public_host_returned",
+        "model": (
+            "public_host_returned"
+            if returned_model != "not_observed"
+            else "not_observed"
+        ),
+        "reasoning_effort": (
+            "public_host_returned"
+            if returned_effort != "not_observed"
+            else "not_observed"
+        ),
+        "tools": "not_observed",
+        "permissions": "not_observed",
+        "tokens": "not_observed",
+        "cost": "not_observed",
+    }
+    return {
+        **identity_values,
+        "capabilities": capabilities,
+        "read_only": read_only,
+        "applied": applied,
+        "observation_sources": observation_sources,
+    }
