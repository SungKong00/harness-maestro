+        )
+    research_requirement = (
+        plan.get("expertise", {}).get("research_requirement", {})
+        if isinstance(plan.get("expertise"), dict)
+        else {}
+    )
+    expected_research_digest = research_requirement.get("evidence_digest")
+    if (
+        expected_research_digest is None
