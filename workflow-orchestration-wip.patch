+
+        for mode in ("unknown-method", "post-terminal"):
+            with self.subTest(mode=mode):
+                values = copy.deepcopy(receipt)
+                for field in (
+                    "schema_version",
+                    "receipt_id",
+                    "completion_receipt_id",
+                    "key_id",
