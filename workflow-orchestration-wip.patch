+++ b/src/maestro/orchestration/packets.py
@@ -0,0 +1,619 @@
+from __future__ import annotations
+
+import copy
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from typing import Any, Mapping
+
+from maestro.errors import MaestroError
+from maestro.util import canonical_json, sha256_text
+
+from .capabilities import (
+    SEMANTIC_RECEIPT_VERSION,
+    host_receipt_digest,
+    semantic_validator_binding,
+    validate_attempt_evidence,
+    validate_host_receipt,
+    validate_semantic_result,
+)
+from .contracts import (
+    PACKET_VERSION,
+    evidence_profile,
+    executor_profiles,
+    require_digest,
+    require_identity,
+    require_line,
+    require_refs,
+    role_specs,
+    stage_specs,
+)
+from .readiness import expected_predecessor_slots
+
+
+PACKET_FIELDS = {
+    "schema_version",
+    "packet_contract_id",
+    "packet_contract_version",
+    "packet_id",
+    "packet_digest",
+    "payload_ref",
+    "payload_sha256",
+    "validation_receipt_digest",
+    "context_receipt_id",
+    "context_receipt_digest",
+    "attempt_receipt_id",
+    "attempt_receipt_digest",
+    "root_request_id",
+    "root_execution_id",
+    "workflow_instance_id",
+    "definition_id",
+    "definition_revision",
+    "definition_digest",
+    "plan_revision",
+    "stage_spec_id",
+    "role_spec_id",
+    "stage_instance_id",
+    "semantic_generation",
+    "producer_participant_instance_id",
+    "producer_principal_id",
+    "producer_context_instance_id",
+    "capability_lease_id",
+    "attempt_id",
+    "input_projection_sha256",
+    "predecessor_slots",
+    "base_revision",
+    "freshness",
+    "completeness",
+    "status",
+    "claims",
+    "evidence_refs",
+    "authority_refs",
+    "limitations",
+    "conflicts",
+    "gaps",
+    "return_intent",
+}
+FRESHNESS_FIELDS = {
+    "produced_at",
+    "expires_at",
+    "freshness_seconds",
+}
+COMPLETENESS_FIELDS = {
+    "status",
+    "required_claim_ids",
+    "present_claim_ids",
+    "missing_claim_ids",
+}
+PREDECESSOR_SLOT_FIELDS = {
+    "slot_id",
+    "predecessor_stage_spec_id",
+    "cardinality",
+    "packet_ids",
+    "packet_digests",
+    "semantic_generations",
+}
+
+
+def _fail(message: str, *, code: str = "ORCH_PACKET_ADMISSION_FAILED") -> None:
+    raise MaestroError(code, message)
+
+
+def _utc(value: str, *, field: str) -> datetime:
+    require_line(value, field=field, maximum=64)
+    try:
+        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except ValueError as exc:
+        raise MaestroError(
+            "ORCH_PACKET_ADMISSION_FAILED",
+            f"{field} must be an ISO-8601 timestamp.",
+        ) from exc
+    if parsed.tzinfo is None:
+        _fail(f"{field} must include a timezone.")
+    return parsed.astimezone(timezone.utc)
+
+
+def packet_digest(value: Mapping[str, Any]) -> str:
+    candidate = copy.deepcopy(dict(value))
+    candidate["packet_digest"] = ""
+    return sha256_text(canonical_json(candidate))
+
+
+def payload_digest(value: Mapping[str, Any]) -> str:
+    return sha256_text(canonical_json(value))
+
+
+def semantic_receipt_digest(value: Mapping[str, Any]) -> str:
+    return sha256_text(canonical_json(value))
+
+
+def _validate_semantic_receipt(
+    stage: Mapping[str, Any],
+    participant_receipt: Mapping[str, Any],
+    value: Any,
+    *,
+    result: Mapping[str, Any] | None = None,
+) -> dict[str, Any]:
+    fields = {
+        "schema_version",
+        "receipt_id",
+        "validator_id",
+        "validator_version",
+        "validator_digest",
+        "validator_implementation_digest",
+        "stage_spec_id",
+        "participant_instance_id",
+        "host_receipt_id",
+        "status",
+        "validated_input_sha256",
+        "validator_result",
+        "validator_result_sha256",
+        "required_claim_ids",
+        "present_claim_ids",
+        "validated_at",
+    }
+    output = stage["output_contract"]
+    binding = semantic_validator_binding(
+        output["validator_id"],
+        output["validator_version"],
+    )
+    if (
+        not isinstance(value, dict)
+        or set(value) != fields
+        or value.get("schema_version") != SEMANTIC_RECEIPT_VERSION
+        or value.get("status") != "PASS"
+        or value.get("stage_spec_id") != stage["stage_spec_id"]
+        or value.get("participant_instance_id")
+        != participant_receipt["participant_instance_id"]
+        or value.get("host_receipt_id") != participant_receipt["receipt_id"]
+        or value.get("validator_id") != output["validator_id"]
+        or value.get("validator_version") != output["validator_version"]
+        or value.get("validator_digest") != output["validator_digest"]
+        or value.get("validator_implementation_digest")
+        != binding["validator_digest"]
+        or value.get("validator_digest") != binding["validator_digest"]
+        or value.get("required_claim_ids")
+        != output["required_claim_ids"]
+    ):
+        _fail(
+            "The semantic validation receipt is not the exact validator "
+            "receipt frozen by the StageSpec."
+        )
+    require_digest(
+        value.get("validated_input_sha256"),
+        field="validated_input_sha256",
+    )
+    validator_result = value.get("validator_result")
+    if (
+        not isinstance(validator_result, dict)
+        or value.get("validator_result_sha256")
+        != sha256_text(canonical_json(validator_result))
+    ):
+        _fail("The semantic validator execution result is not content-bound.")
+    candidate = copy.deepcopy(value)
+    candidate["receipt_id"] = ""
+    if value["receipt_id"] != sha256_text(canonical_json(candidate)):
+        _fail("The semantic validation receipt content address is invalid.")
+    _utc(value["validated_at"], field="validated_at")
+    if result is not None:
+        _, expected_receipt = validate_semantic_result(
+            stage,
+            result,
+            participant_receipt=participant_receipt,
+            completed_at=value["validated_at"],
+        )
+        if canonical_json(expected_receipt) != canonical_json(value):
+            _fail(
+                "The semantic validation receipt does not reproduce from "
+                "the exact admitted result and validator implementation."
+            )
+    return copy.deepcopy(value)
+
+
+def build_packet(
+    *,
+    repo_path: str | Path,
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+    stage_spec_id: str,
+    attempt_id: str,
+    participant_receipt: Mapping[str, Any],
+    result: Mapping[str, Any],
+    semantic_validation_receipt: Mapping[str, Any],
+    attempt_receipt: Mapping[str, Any],
+    input_projection_sha256: str,
+    payload_ref: str,
+    produced_at: str,
+    base_revision: str,
+    semantic_generation: int | None = None,
+) -> tuple[dict[str, Any], dict[str, Any]]:
+    stages = stage_specs(definition)
+    stage = stages.get(stage_spec_id)
+    if stage is None:
+        _fail("The Packet references an unknown StageSpec.")
+    role = role_specs(definition)[stage["role_spec_id"]]
+    executor = executor_profiles(definition)[role["executor_profile_id"]]
+    runtime = state["stage_states"][stage_spec_id]
+    generation = (
+        runtime["semantic_generation"]
+        if semantic_generation is None
+        else semantic_generation
+    )
+    if (
+        not isinstance(generation, int)
+        or generation < 0
+        or (
+            semantic_generation is not None
+            and generation != runtime["semantic_generation"] + 1
+        )
+    ):
+        _fail("A correction Packet must advance exactly one semantic generation.")
+    receipt = validate_host_receipt(
+        repo_path,
+        participant_receipt,
+        expected_evidence_profile=evidence_profile(definition),
+        expected_root_request_id=state["root_request_id"],
+        expected_root_execution_id=state["root_execution_id"],
+        expected_workflow_instance_id=state["workflow_instance_id"],
