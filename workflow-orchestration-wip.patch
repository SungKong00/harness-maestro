+                        "X-Maestro-Token": token,
+                        "Origin": base,
+                    },
+                )
+                with self.assertRaises(urllib.error.HTTPError) as rejected:
+                    urllib.request.urlopen(request, timeout=5)
+                return json.loads(rejected.exception.read())["code"]
+
+            try:
+                self.assertEqual(
+                    "EXPERTISE_DASHBOARD_PREVIEW_INVALID",
+                    rejected_code(
+                        {"action": "activate", "candidate_id": "missing"}
+                    ),
+                )
+                self.assertNotEqual(
