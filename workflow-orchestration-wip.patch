+def build_design_falsification_packet(
+    falsification: dict[str, Any],
+    plan: dict[str, Any],
+    projection: Any,
+    *,
+    repo_path: str | Path,
+    research_bundle: dict[str, Any],
+) -> dict[str, Any]:
+    projected = _projection_input(projection)
+    if not isinstance(projected, dict):
+        raise MaestroError(
+            "DESIGN_FALSIFICATION_PACKET_BINDING_INVALID",
+            "Falsification Packet requires the exact Assignment projection.",
+        )
+    proposal_entry = next(
+        (
+            item
+            for item in projected.get("dependency_packets", [])
+            if isinstance(item, dict)
+            and item.get("assignment_id") == "design-proposal"
+        ),
+        None,
+    )
+    if not isinstance(proposal_entry, dict):
+        raise MaestroError(
+            "DESIGN_FALSIFICATION_PROPOSAL_INVALID",
+            "Falsification Packet requires the exact proposal dependency.",
+        )
+    packet = {
+        "schema_version": DESIGN_FALSIFICATION_PACKET_VERSION,
+        "plan_id": plan["plan_id"],
+        "assignment_id": "design-falsification",
+        "projection_digest": projected["projection_digest"],
+        "proposal_packet_digest": proposal_entry["packet_digest"],
+        "falsification": copy.deepcopy(falsification),
+        "product_writes_performed": False,
+    }
+    validation = validate_design_falsification_packet(
+        packet,
+        plan,
+        projection,
+        repo_path=repo_path,
+        research_bundle=research_bundle,
+    )
+    if validation["status"] != "PASS":
+        first = validation["issues"][0]
+        raise MaestroError(first["code"], first["message"])
+    return packet
