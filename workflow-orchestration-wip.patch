+def _address(value: Mapping[str, Any], *, digest_field: str) -> str:
+    candidate = copy.deepcopy(dict(value))
+    candidate[digest_field] = ""
+    return sha256_text(canonical_json(candidate))
+
+
+def _receipt_digest(value: Mapping[str, Any]) -> str:
+    return sha256_text(canonical_json(value))
+
+
+def _correction_evidence(
+    *,
+    context_receipt: Mapping[str, Any],
+    attempt_receipt: Mapping[str, Any],
+) -> tuple[Mapping[str, Any], Mapping[str, Any], Mapping[str, Any]]:
+    if (
+        context_receipt.get("schema_version")
+        != "maestro_orchestration_context_evidence_v2"
+        or context_receipt.get("evidence_kind") != "pre-turn-context"
+        or attempt_receipt.get("schema_version")
+        != "maestro_orchestration_attempt_evidence_v2"
+        or attempt_receipt.get("evidence_kind") != "post-turn-attempt"
+    ):
+        raise MaestroError(
+            "ORIGINAL_PRODUCER_CONTEXT_UNAVAILABLE",
+            "Correction requires the split public context and attempt evidence.",
+        )
+    if context_receipt.get("evidence_profile") not in {
+        "public-codex-operational-v2",
+        "scripted-test-v1",
+    }:
+        raise MaestroError(
+            "ORCH_STRICT_PRINCIPAL_UNAVAILABLE",
+            "Strict principal mode cannot use public-thread correction lineage.",
+        )
+    integrity = context_receipt.get("collector_integrity")
+    if (
+        not isinstance(integrity, Mapping)
+        or integrity.get("host_attestation_claimed") is not False
+    ):
+        raise MaestroError(
+            "ORCH_HOST_SELF_ATTESTATION_FORBIDDEN",
+            "Correction evidence cannot claim Host self-attestation.",
+        )
+    resumption = context_receipt.get("resumption")
+    host_context = context_receipt.get("host_context")
+    if (
+        not isinstance(resumption, Mapping)
+        or resumption.get("status") != "controller_lineage"
+        or resumption.get("source") != "controller_lineage"
+        or resumption.get("context_instance_id")
+        != context_receipt.get("context_instance_id")
+        or not isinstance(host_context, Mapping)
+    ):
+        raise MaestroError(
+            "ORCH_CORRECTION_RESUME_UNATTESTED",
+            "Correction requires controller-owned lineage for one public thread.",
+        )
+    if (
+        attempt_receipt.get("context_receipt_id")
+        != context_receipt.get("receipt_id")
+        or attempt_receipt.get("context_receipt_digest")
+        != _receipt_digest(context_receipt)
+        or attempt_receipt.get("thread_id")
+        != host_context.get("thread_id")
+    ):
+        raise MaestroError(
+            "ORCH_CORRECTION_CONTEXT_MISMATCH",
+            "Attempt evidence is not bound to the exact public context receipt.",
+        )
+    require_identity(
+        host_context.get("thread_id"),
+        field="host_context.thread_id",
+    )
+    require_identity(attempt_receipt.get("turn_id"), field="turn_id")
+    require_digest(
+        resumption.get("checkpoint_digest"),
+        field="controller_checkpoint_digest",
+    )
+    return resumption, host_context, attempt_receipt
