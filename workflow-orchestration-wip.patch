+)
+from .packets import packet_digest as packet_content_digest
+from .readiness import expected_predecessor_slots
+
+
+VIEWER_PROJECTION_VERSION = "maestro_orchestration_viewer_projection_v1"
+REQUEST_PROJECTION_VERSION = "maestro_orchestration_request_projection_v1"
+
+
+def stage_input_projection(
+    *,
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+    stage_spec_id: str,
+    predecessor_packets: Mapping[str, Mapping[str, Any]],
+) -> dict[str, Any]:
+    stage = stage_specs(definition).get(stage_spec_id)
+    if stage is None:
+        raise MaestroError(
+            "ORCH_STAGE_INVALID",
+            "Cannot project an unknown StageSpec.",
+        )
+    role = role_specs(definition)[stage["role_spec_id"]]
+    executor = executor_profiles(definition)[role["executor_profile_id"]]
+    slots = expected_predecessor_slots(definition, state, stage_spec_id)
+    packets: list[dict[str, Any]] = []
+    for slot in slots:
+        for packet_id, packet_digest in zip(
+            slot["packet_ids"],
+            slot["packet_digests"],
+            strict=True,
+        ):
+            packet = predecessor_packets.get(packet_digest)
+            if (
+                not isinstance(packet, Mapping)
+                or packet.get("packet_id") != packet_id
+                or packet.get("packet_digest") != packet_digest
+            ):
+                raise MaestroError(
+                    "ORCH_PACKET_ADMISSION_FAILED",
+                    "Stage projection lacks an exact admitted predecessor Packet.",
+                )
+            packets.append(copy.deepcopy(dict(packet)))
+    projection = {
+        "schema_version": PROJECTION_VERSION,
+        "projection_sha256": "",
+        "root_request_id": state["root_request_id"],
+        "root_execution_id": state["root_execution_id"],
+        "workflow_instance_id": state["workflow_instance_id"],
+        "definition_id": definition["definition_id"],
+        "definition_revision": definition["definition_revision"],
+        "definition_digest": definition["definition_digest"],
+        "plan_revision": state["plan_revision"],
+        "runtime_authority": state["runtime_authority"],
+        "workflow_policy": copy.deepcopy(
+            definition["responsibility_plan"]["workflow_policy"]
+        ),
+        "owner_workflow_digest": definition["responsibility_plan"][
+            "owner_workflow_digest"
+        ],
+        "workflow_source_binding": copy.deepcopy(
+            definition["responsibility_plan"][
+                "workflow_source_binding"
+            ]
+        ),
+        "workflow_step_mapping": copy.deepcopy(
+            definition["responsibility_plan"][
+                "workflow_step_mapping"
+            ]
+        ),
+        "stage_spec": copy.deepcopy(stage),
+        "role_spec": copy.deepcopy(role),
+        "responsibilities": [
+            copy.deepcopy(concern)
+            for concern in definition["responsibility_plan"]["concerns"]
+            if concern["responsibility_id"]
+            in role["responsibility_ids"]
+        ],
+        "executor_request": {
+            "requested": {
+                "model": executor["requested_model"],
+                "reasoning_effort": executor[
+                    "requested_reasoning_effort"
+                ],
+                "tools": list(executor["tools"]),
+                "permissions": list(executor["permissions"]),
+                "context_policy": executor["context_policy"],
+            },
+            "recommended": {
+                "model": executor["recommended_model"],
+                "reasoning_effort": executor[
+                    "recommended_reasoning_effort"
+                ],
+            },
+            "applied": "not_observed",
+        },
+        "pack_hints": [
+            copy.deepcopy(hint)
+            for hint in definition["pack_hints"]["hints"]
+            if hint["pack_hint_id"] in role["pack_hint_ids"]
+        ],
+        "lens_bindings": [
+            copy.deepcopy(lens)
+            for lens in definition["lens_bindings"]
+            if lens["lens_binding_id"] in role["lens_binding_ids"]
+        ],
+        "input_slots": slots,
+        "predecessor_packets": packets,
+        "blind_initial_context": not stage["dependencies"],
+        "prohibited_inferences": [
+            "peer conclusions not present in predecessor_packets",
+            "participant identity from role labels",
+            "applied metadata from requested or recommended metadata",
+            "legacy completion or authority",
+        ],
+    }
+    projection["projection_sha256"] = projection_digest(projection)
+    return projection
+
+
+def projection_digest(value: Mapping[str, Any]) -> str:
+    candidate = copy.deepcopy(dict(value))
+    candidate["projection_sha256"] = ""
+    return sha256_text(canonical_json(candidate))
+
+
+def validate_stage_input_projection(
+    value: Mapping[str, Any],
+    *,
+    definition: Mapping[str, Any],
+    state: Mapping[str, Any],
+    stage_spec_id: str,
+) -> dict[str, Any]:
+    if not isinstance(value, Mapping):
+        raise MaestroError(
+            "ORCH_PACKET_ADMISSION_FAILED",
+            "Canonical Stage projection is stale, contaminated, or mismatched.",
+        )
+    packets = value.get("predecessor_packets")
+    if not isinstance(packets, list):
+        raise MaestroError(
+            "ORCH_PACKET_ADMISSION_FAILED",
+            "Canonical Stage projection is stale, contaminated, or mismatched.",
+        )
+    packet_by_digest: dict[str, Mapping[str, Any]] = {}
+    for packet in packets:
+        if (
+            not isinstance(packet, Mapping)
+            or not isinstance(packet.get("packet_digest"), str)
+            or packet.get("packet_digest") in packet_by_digest
+            or packet.get("packet_digest")
+            != packet_content_digest(packet)
+        ):
+            raise MaestroError(
+                "ORCH_PACKET_ADMISSION_FAILED",
+                "Stage projection contains a forged or duplicate predecessor Packet.",
+            )
+        packet_by_digest[packet["packet_digest"]] = packet
+    expected = stage_input_projection(
+        definition=definition,
+        state=state,
+        stage_spec_id=stage_spec_id,
+        predecessor_packets=packet_by_digest,
+    )
+    if canonical_json(dict(value)) != canonical_json(expected):
+        raise MaestroError(
+            "ORCH_PACKET_ADMISSION_FAILED",
+            "Canonical Stage projection is stale, contaminated, or mismatched.",
+        )
+    if not expected["stage_spec"]["dependencies"] and expected[
+        "predecessor_packets"
+    ]:
+        raise MaestroError(
+            "ORCH_BLIND_CONTEXT_CONTAMINATED",
+            "An initial blind lane cannot receive peer conclusions.",
+        )
+    return copy.deepcopy(dict(value))
+
+
+def _metadata_projection(value: Any) -> dict[str, Any]:
+    if (
+        isinstance(value, Mapping)
+        and set(value) == {"requested", "recommended", "applied"}
+        and all(isinstance(value[field], Mapping) for field in value)
+    ):
+        return {
+            field: copy.deepcopy(dict(value[field]))
+            for field in ("requested", "recommended", "applied")
+        }
+    return {
+        "requested": {},
+        "recommended": {},
+        "applied": {
+            "model": "not_observed",
+            "reasoning_effort": "not_observed",
+            "tools": "not_observed",
+            "permissions": "not_observed",
+            "tokens": "not_observed",
+            "cost": "not_observed",
+        },
+    }
+
+
+def viewer_projection(
+    *,
