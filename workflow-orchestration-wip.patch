+                    "CODEX_HOST_PROTOCOL_INVALID",
+                    f"{method} did not return a usable context.",
+                )
+            if correction_request is not None and (
+                f"codex-thread-{thread['id']}"
+                != correction_request["target_context_instance_id"]
+            ):
