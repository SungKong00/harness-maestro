+function workTopologyRelevant(work, hasObservedWork) {
+  const nodes = hasObservedWork
+    ? work.execution.cards
+    : work.stages;
+  const graph = hasObservedWork
+    ? work.execution.graph
+    : work.graph;
+  const incoming = new Map();
+  const outgoing = new Map();
+  (graph.edges || []).forEach((edge) => {
+    incoming.set(edge.to, (incoming.get(edge.to) || 0) + 1);
+    outgoing.set(edge.from, (outgoing.get(edge.from) || 0) + 1);
+  });
+  return (
+    [...incoming.values(), ...outgoing.values()].some((count) => count > 1)
+    || (
+      hasObservedWork
+      && graph.actual_concurrency === "observed"
+      && (graph.concurrent_work_pairs || []).length > 0
+    )
+    || (
+      hasObservedWork
+      && nodes.some((card) => (
+        card.relationships?.followup_of_work_id
+        || card.relationships?.joins_work_ids?.length
+      ))
+    )
+  );
+}
+
+function buildWorkTopologyDisclosure(run, work, hasObservedWork, onSelect) {
+  if (!workTopologyRelevant(work, hasObservedWork)) {
+    return element("p", {
+      className: "work-topology-linear-note",
+      text: "이 요청은 분기·합류·재작업 토폴로지 없이 각 단계의 선행 관계 텍스트로 충분히 읽을 수 있습니다.",
+    });
+  }
+  const details = element("details", {
+    className: "work-topology-disclosure",
+  });
+  const summary = element("summary");
+  summary.append(
+    element("strong", { text: "관계 토폴로지 보기" }),
+    element("span", {
+      text: "분기·합류·재작업 관계가 판단을 바꿀 때만 여는 보조 보기",
+    }),
+  );
+  const content = element("div", {
+    className: "work-topology-content",
+  });
+  const edgeGroups = hasObservedWork
+    ? displayEdgeGroups(
+      work.execution.graph,
+      work.execution.cards,
+      "work_id",
+    )
+    : displayEdgeGroups(work.graph, work.stages, "stage_id");
+  let built = false;
+  const build = () => {
+    if (built) return;
+    built = true;
+    content.append(
+      hasObservedWork
+        ? buildObservedWorkMap(run, work, onSelect)
+        : buildStageMap(run, work, onSelect),
+    );
+  };
+  const observe = () => {
+    state.activeWorkEdgeGroups = edgeGroups;
+    state.activeWorkEdgeMode = hasObservedWork ? "observed" : "plan";
+    const canvas = content.querySelector(".work-map-canvas");
+    if (canvas) observeWorkCanvas(canvas);
+    window.requestAnimationFrame(redrawActiveWorkEdges);
+  };
+  details.addEventListener("toggle", () => {
+    state.workTopologyOpen = details.open;
+    state.workTopologyRequest = requestRecordId(run);
+    if (details.open) {
+      build();
+      observe();
+    } else {
+      state.workResizeObserver?.disconnect();
+      state.activeWorkEdgeGroups = [];
+    }
+  });
+  details.append(summary, content);
+  if (
+    state.workTopologyOpen
+    && state.workTopologyRequest === requestRecordId(run)
+  ) {
+    details.open = true;
+    build();
+    observe();
+  }
+  return details;
+}
