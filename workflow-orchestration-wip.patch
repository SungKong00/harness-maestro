+            _issue(
+                "DESIGN_COMPARISON_RESEARCH_MISMATCH",
+                "research_evidence_digest",
+                "Material comparison must bind the route's completed contextual reference research.",
+            )
+        )
+    if isinstance(research_bundle, dict):
