+def valid_version_control_policy(value: Any) -> bool:
+    return (
+        isinstance(value, dict)
+        and set(value) == {"local_commit", "remote_write"}
+        and value.get("local_commit") in VERSION_CONTROL_LOCAL_COMMIT_MODES
+        and value.get("remote_write") == "explicit_only"
+    )
+
+
+def project_version_control_policy(
+    repo_path: str | Path | None,
+) -> dict[str, str]:
+    """Return one closed, safe project policy without granting authority."""
+
+    default_policy = dict(DEFAULT_VERSION_CONTROL_POLICY)
+    if repo_path is None:
+        return default_policy
+    project_path = safe_target(
+        Path(repo_path),
+        ".maestro/project.json",
+    )
+    if not project_path.is_file():
+        return default_policy
+    project = read_json(project_path)
+    if not isinstance(project, dict):
+        raise MaestroError(
+            "PROJECT_VERSION_CONTROL_POLICY_INVALID",
+            "project.json must contain an object before routing side effects.",
+        )
+    value = project.get("version_control")
+    if value is None:
+        return default_policy
+    if not valid_version_control_policy(value):
+        raise MaestroError(
+            "PROJECT_VERSION_CONTROL_POLICY_INVALID",
+            "project.json version_control policy is invalid.",
+        )
+    return {
+        "local_commit": value["local_commit"],
+        "remote_write": value["remote_write"],
+    }
+
+
+def resolve_version_control_policy(
+    goal: str,
+    intent: str,
+    *,
+    repo_path: str | Path | None,
+    repository_write_allowed: bool,
+) -> dict[str, Any]:
+    """Snapshot the effective local-commit decision for one route."""
+
+    configured = project_version_control_policy(repo_path)
+    request_contract = resolve_request_contract(goal, intent)
+    if (
+        not repository_write_allowed
+        or intent != "implementation"
+        or "git_commit" in request_contract["forbidden_side_effects"]
+    ):
+        effective_local_commit = "forbidden"
+    else:
+        effective_local_commit = configured["local_commit"]
+    return {
+        "configured_local_commit": configured["local_commit"],
+        "effective_local_commit": effective_local_commit,
+        "remote_write": configured["remote_write"],
+        "authorization_source": (
+            "project_policy"
+            if effective_local_commit == "implementation_units"
+            else None
+        ),
+        "policy_digest": sha256_text(canonical_json(configured)),
+    }
+
