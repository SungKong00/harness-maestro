+
+  async function applyPreview() {
+    const preview = state.actionPreview;
+    if (!canApplyPreview(preview, state.projectId, state.appliedPlanIds)) return;
+    preview.applying = true;
+    dom.actionApply.disabled = true;
+    dom.actionApply.textContent = "적용 중";
+    try {
+      await apiJson("/api/expertise-actions/apply", {
+        method: "POST",
+        body: { plan_id: preview.planId, plan_digest: preview.planDigest },
+      });
+      state.appliedPlanIds.add(preview.planId);
+      state.actionPreview = null;
+      dom.dialog.close();
+      dom.actionApply.textContent = "이 변경 적용";
+      toast("변경을 적용했습니다. 최신 Pack 상태를 확인합니다.");
+      state.refreshAfterApply = true;
+      await projectLoader.load(state.projectId);
+    } catch (reason) {
+      preview.applying = false;
+      dom.actionApply.textContent = "이 변경 적용";
+      dom.actionApply.disabled = !canApplyPreview(preview, state.projectId, state.appliedPlanIds);
+      dom.dialogBody.insertAdjacentHTML("afterbegin", `<div class="callout" data-tone="danger"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3 18 17H2zM10 7v4M10 14h.01"/></svg><span>${escapeHtml(reason.message || String(reason))}</span></div>`);
+    }
+  }
+
+  function refreshVisibleSnapshotIfStale() {
+    if (
+      document.visibilityState !== "visible"
+      || state.loading
+      || state.refreshAfterApply
+      || !state.projectId
+      || dom.dialog.open
+      || !snapshotIsStale(state.snapshot)
+    ) return;
+    projectLoader.load(state.projectId);
+  }
+
+  dom.navOpen.addEventListener("click", openNav);
+  dom.navClose.addEventListener("click", () => closeNav());
+  dom.navScrim.addEventListener("click", () => closeNav());
+  document.addEventListener("keydown", (event) => {
+    if (event.key === "Escape" && dom.body.dataset.navOpen === "true" && !dom.dialog.open) {
+      event.preventDefault();
+      closeNav();
+      return;
+    }
+    if (event.key === "Tab" && dom.body.dataset.navOpen === "true") {
+      const focusable = [...dom.nav.querySelectorAll('a[href], button:not([disabled]), select:not([disabled])')];
+      if (!focusable.length) return;
+      const first = focusable[0];
+      const last = focusable.at(-1);
+      if (event.shiftKey && document.activeElement === first) {
+        event.preventDefault();
+        last.focus();
+      } else if (!event.shiftKey && document.activeElement === last) {
+        event.preventDefault();
+        first.focus();
+      }
+    }
+  });
+
+  dom.navLinks.forEach((link) => link.addEventListener("click", (event) => {
+    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+    event.preventDefault();
+    const view = link.dataset.navView;
+    navigate({ view, run: null, stage: null, pack: null, from_run: null, from_stage: null }, { focusMain: true });
+  }));
+
+  dom.projectSelect.addEventListener("change", async () => {
+    const next = dom.projectSelect.value;
+    if (!next || next === state.projectId) return;
+    state.projectId = next;
+    state.snapshot = null;
+    state.loadError = null;
+    state.appliedPlanIds.clear();
+    invalidateActionState();
+    await projectLoader.load(next);
+  });
+
+  dom.root.addEventListener("click", (event) => {
+    const requestButton = event.target.closest("[data-request-id]");
+    if (requestButton) {
+      navigate({ view: "requests", run: requestButton.dataset.requestId, stage: null, pack: null });
+      focusDetail("#request-detail");
+      return;
+    }
+    const stageButton = event.target.closest("[data-stage-id]");
+    if (stageButton) {
+      navigate({ view: "requests", stage: stageButton.dataset.stageId }, { replace: true });
+      focusDetail(".stage-record");
+      return;
+    }
+    const packButton = event.target.closest("[data-pack-id]");
+    if (packButton) {
+      navigate({ view: "packs", pack: packButton.dataset.packId, run: null, stage: null });
+      focusDetail("#pack-detail");
+      return;
+    }
+    const packLink = event.target.closest("[data-pack-link]");
+    if (packLink) {
+      const route = currentRoute();
+      const activeRequest = packLink.closest("[data-active-request]")?.dataset.activeRequest;
+      navigate({ view: "packs", pack: packLink.dataset.packLink, from_run: route.run || activeRequest, from_stage: route.stage, run: null, stage: null });
+      focusDetail("#pack-detail");
+      return;
+    }
+    const requestLink = event.target.closest("[data-request-link]");
+    if (requestLink) {
+      navigate({ view: "requests", run: requestLink.dataset.requestLink, stage: null, pack: null, from_run: null, from_stage: null });
+      return;
+    }
+    const returnRequest = event.target.closest("[data-return-request]");
+    if (returnRequest) {
+      navigate({
+        view: "requests",
+        run: returnRequest.dataset.returnRequest,
+        stage: returnRequest.dataset.returnStage || null,
+        pack: null,
+        from_run: null,
+        from_stage: null,
+      });
+      focusDetail("#request-detail");
+      return;
+    }
+    const requestFilter = event.target.closest("[data-request-filter]");
+    if (requestFilter) {
+      state.requestFilter = requestFilter.dataset.requestFilter;
+      renderRequests();
+      return;
+    }
+    const packFilter = event.target.closest("[data-pack-filter]");
+    if (packFilter) {
+      state.packFilter = packFilter.dataset.packFilter;
+      renderPacks();
+      return;
+    }
+    const actionButton = event.target.closest("[data-action-preview]");
+    if (actionButton) {
+      previewAction(actionButton);
+      return;
+    }
+    const retry = event.target.closest("[data-retry-load]");
+    if (retry) {
+      if (state.projectId) projectLoader.load(state.projectId);
+      else loadProjects().catch((reason) => {
+        state.loading = false;
+        state.loadError = reason;
+        render();
+      });
+      return;
+    }
+    const scrollQueue = event.target.closest("[data-scroll-queue]");
+    if (scrollQueue) {
+      document.querySelector(currentRoute().view === "packs" ? "#pack-queue" : "#request-queue")?.scrollIntoView({ block: "start" });
+    }
+  });
+
+  function scheduleSearchRender(view, input) {
+    window.clearTimeout(state.searchRenderTimer);
+    const start = input.selectionStart;
+    const end = input.selectionEnd;
+    state.searchRenderTimer = window.setTimeout(() => {
+      if (view === "requests") renderRequests();
+      else renderPacks();
+      const next = document.querySelector(view === "requests" ? "#request-search" : "#pack-search");
+      next?.focus({ preventScroll: true });
+      if (Number.isInteger(start) && Number.isInteger(end)) next?.setSelectionRange(start, end);
+    }, 120);
+  }
+
+  dom.root.addEventListener("input", (event) => {
+    if (event.target.id === "request-search") {
+      state.requestSearch = event.target.value;
+      if (!state.composing) scheduleSearchRender("requests", event.target);
+    }
+    if (event.target.id === "pack-search") {
+      state.packSearch = event.target.value;
+      if (!state.composing) scheduleSearchRender("packs", event.target);
+    }
+  });
+  dom.root.addEventListener("compositionstart", () => { state.composing = true; });
+  dom.root.addEventListener("compositionend", (event) => {
+    state.composing = false;
+    if (event.target.id === "request-search") scheduleSearchRender("requests", event.target);
+    if (event.target.id === "pack-search") scheduleSearchRender("packs", event.target);
+  });
+
+  dom.actionApply.addEventListener("click", applyPreview);
+  dom.dialogBody.addEventListener("click", (event) => {
+    const retry = event.target.closest("[data-preview-retry]");
+    if (retry) previewAction(retry);
+  });
+  dom.dialog.addEventListener("close", () => {
+    state.previewSequence += 1;
+    if (!state.actionPreview?.applying) state.actionPreview = null;
+    dom.actionApply.disabled = true;
+    dom.actionApply.textContent = "이 변경 적용";
+  });
+
+  window.addEventListener("popstate", render);
+  document.addEventListener("visibilitychange", refreshVisibleSnapshotIfStale);
+  window.setInterval(refreshVisibleSnapshotIfStale, SNAPSHOT_REFRESH_MS);
+
+  if (!contract?.validateSnapshot || typeof createProjectSnapshotLoader !== "function") {
+    state.loading = false;
+    renderFatal("대시보드 계약을 불러오지 못했습니다.", "필수 snapshot 또는 project-switch 모듈이 제공되지 않았습니다.", false);
+  } else {
+    projectLoader = createSnapshotLoader();
+    loadProjects().catch((reason) => {
+      state.loading = false;
+      state.loadError = reason;
+      setSyncStatus("error", "연결 실패");
+      render();
+    });
+  }
+}(globalThis));
