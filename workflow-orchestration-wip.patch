+def _timestamp_epoch(value: str) -> int:
+    try:
+        return calendar.timegm(time.strptime(value, _TIMESTAMP_FORMAT))
+    except (OverflowError, ValueError) as exc:
+        raise MaestroError(
+            "ORCH_HOST_RECEIPT_INVALID",
+            "Host receipt timestamps must use canonical UTC second precision.",
+        ) from exc
+
+
+def _timestamp_after(value: str, seconds: float) -> str:
+    return time.strftime(
+        _TIMESTAMP_FORMAT,
+        time.gmtime(_timestamp_epoch(value) + max(1, int(seconds))),
+    )
+
+
+def _evidence_identity(
+    value: Mapping[str, Any],
+    *,
+    aliases: Sequence[str] = (),
+) -> str:
+    candidate = copy.deepcopy(dict(value))
+    candidate["receipt_id"] = ""
+    candidate["auth_tag"] = ""
+    for field in aliases:
+        candidate[field] = ""
+    return sha256_text(canonical_json(candidate))
+
+
+def _collector_integrity() -> dict[str, Any]:
+    return {
+        "scheme": "local-hmac-sha256",
+        "meaning": "collector-integrity-only",
+        "host_attestation_claimed": False,
+    }
+
+
+def _metadata(
+    *,
+    requested: Mapping[str, Any],
+    recommended: Mapping[str, Any],
+    applied: Mapping[str, Any],
+) -> dict[str, Any]:
+    return {
+        "requested": copy.deepcopy(dict(requested)),
+        "recommended": copy.deepcopy(dict(recommended)),
+        "applied": copy.deepcopy(dict(applied)),
+    }
+
+
+def _validate_metadata(value: Any) -> dict[str, Any]:
+    if (
+        not isinstance(value, dict)
+        or set(value) != {"requested", "recommended", "applied"}
+        or not all(isinstance(value[field], dict) for field in value)
+        or any(
+            set(value[field]) != _HOST_METADATA_FIELDS
+            for field in ("requested", "recommended", "applied")
+        )
+    ):
+        raise MaestroError(
+            "ORCH_TELEMETRY_INFERRED",
+            "Requested, recommended, and Host-returned metadata must remain separate.",
+        )
+    applied = value["applied"]
+    for field in ("model", "reasoning_effort"):
+        if applied[field] != "not_observed" and (
+            not isinstance(applied[field], str) or not applied[field]
+        ):
+            raise MaestroError(
+                "ORCH_TELEMETRY_INFERRED",
+                f"Host-returned {field} must be observed text or not_observed.",
+            )
+    for field in ("tools", "permissions"):
+        if applied[field] != "not_observed":
+            require_refs(
+                applied[field],
+                field=f"metadata.applied.{field}",
+                allow_empty=True,
+            )
+    for field in ("tokens", "cost"):
+        if applied[field] != "not_observed" and (
+            not isinstance(applied[field], (int, float))
+            or isinstance(applied[field], bool)
+            or applied[field] < 0
+        ):
+            raise MaestroError(
+                "ORCH_TELEMETRY_INFERRED",
+                f"Host-returned {field} must be non-negative or not_observed.",
+            )
+    return copy.deepcopy(value)
+
+
+def _returned_sandbox_policy(value: Any) -> dict[str, Any]:
+    if not isinstance(value, dict):
+        raise MaestroError(
+            "ORCH_HOST_RETURNED_BOUNDARY_MISMATCH",
+            "Host-returned sandbox must be the public policy object.",
+        )
+    policy_type = value.get("type")
+    if policy_type == "readOnly":
+        if (
+            set(value) != {"type", "networkAccess"}
+            or not isinstance(value.get("networkAccess"), bool)
+        ):
+            raise MaestroError(
+                "ORCH_HOST_RETURNED_BOUNDARY_MISMATCH",
+                "Host-returned readOnly sandbox shape is invalid.",
+            )
+        return {
+            "kind": "read-only",
+            "network_access": value["networkAccess"],
+            "writable_roots": [],
+        }
+    if policy_type == "workspaceWrite":
+        allowed = {
+            "type",
+            "networkAccess",
+            "writableRoots",
+            "excludeSlashTmp",
+            "excludeTmpdirEnvVar",
+        }
+        roots = value.get("writableRoots")
+        if (
+            not {"type", "networkAccess", "writableRoots"}.issubset(value)
+            or not set(value).issubset(allowed)
+            or not isinstance(value.get("networkAccess"), bool)
+            or not isinstance(roots, list)
+            or not all(
+                isinstance(item, str) and Path(item).is_absolute()
+                for item in roots
+            )
+            or any(
+                field in value and not isinstance(value[field], bool)
+                for field in ("excludeSlashTmp", "excludeTmpdirEnvVar")
+            )
+        ):
+            raise MaestroError(
+                "ORCH_HOST_RETURNED_BOUNDARY_MISMATCH",
+                "Host-returned workspaceWrite sandbox shape is invalid.",
+            )
+        return {
+            "kind": "workspace-write",
+            "network_access": value["networkAccess"],
+            "writable_roots": [str(Path(item).resolve()) for item in roots],
+        }
+    raise MaestroError(
+        "ORCH_HOST_RETURNED_BOUNDARY_MISMATCH",
+        "Host-returned sandbox policy type is unsupported.",
+    )
+
+
+def _validate_repository_capability_policy(
+    *,
+    required_capabilities: Sequence[str],
+    read_only: bool,
+    returned_sandbox: Mapping[str, Any] | None = None,
+    executor_permissions: Sequence[str] | None = None,
+    executor_tools: Sequence[str] | None = None,
+    context_policy: Mapping[str, Any] | None = None,
+    requested_metadata: Mapping[str, Any] | None = None,
+) -> None:
+    """Map the closed public Executor policy to enforceable Host facts."""
+
+    required = list(required_capabilities)
+    expected = {"repository-read"} if read_only else {"repository-write"}
+    if len(required) != len(set(required)) or set(required) != expected:
+        raise MaestroError(
+            "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+            "Public Codex supports only the exact repository-read or "
+            "repository-write Role capability.",
+        )
+    if executor_permissions is not None and set(executor_permissions) != expected:
+        raise MaestroError(
+            "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+            "Executor permissions do not match the Role repository capability.",
+        )
+    expected_tools = {"read"} if read_only else {"read", "write"}
+    if executor_tools is not None and (
+        len(executor_tools) != len(set(executor_tools))
+        or set(executor_tools) != expected_tools
+    ):
+        raise MaestroError(
+            "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+            "Public Codex supports only the closed read or read/write Executor tool set.",
+        )
+    if context_policy is not None:
+        valid_context_policy = (
+            set(context_policy) == {"fresh"}
+            and isinstance(context_policy.get("fresh"), bool)
+            if read_only
+            else context_policy == {"fresh": True, "scoped": True}
+        )
+        if not valid_context_policy:
+            raise MaestroError(
+                "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+                "Executor context policy cannot be enforced by the public Codex boundary.",
+            )
+    if requested_metadata is not None and (
+        executor_tools is None
+        or executor_permissions is None
+        or requested_metadata.get("tools") != list(executor_tools)
+        or requested_metadata.get("permissions") != list(executor_permissions)
+    ):
+        raise MaestroError(
+            "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+            "Context evidence requested metadata differs from the Executor policy.",
+        )
+    if returned_sandbox is None:
+        return
+    expected_kind = "read-only" if read_only else "workspace-write"
+    if (
+        returned_sandbox.get("kind") != expected_kind
+        or returned_sandbox.get("network_access") is not False
+    ):
+        raise MaestroError(
+            "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+            "Host-returned sandbox does not enforce the required repository capability.",
+        )
+
+
+def _scripted_returned_sandbox(
+    sandbox: str,
+    runtime_workspace_roots: Sequence[str],
+) -> dict[str, Any]:
+    if sandbox == "read-only":
+        return {"type": "readOnly", "networkAccess": False}
+    return {
+        "type": "workspaceWrite",
+        "writableRoots": list(runtime_workspace_roots),
+        "networkAccess": False,
+        "excludeSlashTmp": True,
+        "excludeTmpdirEnvVar": True,
+    }
+
+
+def issue_context_evidence(
+    repo_path: str | Path,
+    **values: Any,
+) -> dict[str, Any]:
+    receipt = {
+        "schema_version": CONTEXT_EVIDENCE_VERSION,
+        "receipt_id": "",
+        "key_id": "",
+        "auth_tag": "",
+        **copy.deepcopy(values),
+    }
+    key, key_id = signing_key(
+        repo_path,
+        purpose=_CONTEXT_EVIDENCE_KEY_PURPOSE,
+        create=True,
+    )
+    receipt["key_id"] = key_id
+    receipt["receipt_id"] = _evidence_identity(receipt)
+    receipt["auth_tag"] = auth_tag(receipt, key=key)
+    return validate_context_evidence(repo_path, receipt)
+
+
+def validate_context_evidence(
+    repo_path: str | Path,
+    value: Any,
+    *,
+    expected_evidence_profile: str | None = None,
+    expected_root_request_id: str | None = None,
+    expected_root_execution_id: str | None = None,
+    expected_workflow_instance_id: str | None = None,
+    expected_stage_spec_id: str | None = None,
+    expected_role_spec_id: str | None = None,
+    expected_attempt_id: str | None = None,
+    required_capabilities: Sequence[str] = (),
+    require_read_only: bool | None = None,
+    executor_permissions: Sequence[str] | None = None,
+    executor_tools: Sequence[str] | None = None,
+    context_policy: Mapping[str, Any] | None = None,
+) -> dict[str, Any]:
+    if (
+        not isinstance(value, dict)
+        or set(value) != _CONTEXT_EVIDENCE_FIELDS
+        or value.get("schema_version") != CONTEXT_EVIDENCE_VERSION
+        or value.get("evidence_kind") != "pre-turn-context"
+        or value.get("evidence_profile")
+        not in {
+            PUBLIC_CODEX_EVIDENCE_PROFILE,
+            STRICT_PRINCIPAL_EVIDENCE_PROFILE,
+            SCRIPTED_TEST_EVIDENCE_PROFILE,
+        }
+        or not isinstance(value.get("read_only"), bool)
+    ):
+        raise MaestroError(
+            "ORCH_HOST_RECEIPT_INVALID",
+            "Context evidence does not match the closed v2 contract.",
+        )
+    integrity = value.get("collector_integrity")
+    if (
+        not isinstance(integrity, dict)
+        or set(integrity)
+        != {"scheme", "meaning", "host_attestation_claimed"}
+        or integrity
+        != {
+            "scheme": "local-hmac-sha256",
+            "meaning": "collector-integrity-only",
+            "host_attestation_claimed": False,
+        }
+    ):
+        raise MaestroError(
+            "ORCH_HOST_SELF_ATTESTATION_FORBIDDEN",
+            "Local context signing may prove collector integrity only.",
+        )
+    key, key_id = signing_key(
+        repo_path,
+        purpose=_CONTEXT_EVIDENCE_KEY_PURPOSE,
+        create=False,
+    )
+    if (
+        value.get("receipt_id") != _evidence_identity(value)
+        or not authenticated(value, key=key, expected_key_id=key_id)
+    ):
+        raise MaestroError(
+            "ORCH_HOST_RECEIPT_INVALID",
+            "Context evidence collector integrity or content address is invalid.",
+        )
+    for field in (
+        "root_execution_id",
+        "workflow_instance_id",
+        "stage_spec_id",
+        "role_spec_id",
+        "attempt_id",
+        "participant_instance_id",
+        "producer_principal_id",
+        "invocation_id",
+        "context_instance_id",
+        "capability_lease_id",
+    ):
+        require_identity(value.get(field), field=field)
+    require_line(value.get("root_request_id"), field="root_request_id")
+    require_line(value.get("issued_by"), field="issued_by")
+    _timestamp_epoch(
+        require_line(value.get("collected_at"), field="collected_at", maximum=64)
+    )
+    metadata = _validate_metadata(value.get("metadata"))
+    sources = value.get("observation_sources")
+    allowed_sources = {
+        "controller_assigned",
+        "public_host_returned",
+        "scripted_test",
+        "controller_lineage",
+        "external_broker_attested",
+        "controller_enforced",
+        "not_observed",
+    }
+    if (
+        not isinstance(sources, dict)
+        or set(sources) != _OBSERVATION_SOURCE_FIELDS
+        or any(source not in allowed_sources for source in sources.values())
+    ):
+        raise MaestroError(
+            "ORCH_TELEMETRY_INFERRED",
+            "Context evidence requires exact provenance for every compatibility field.",
+        )
+    if (
+        value["producer_principal_id"] != "not_observed"
+        and sources["producer_principal_id"] != "external_broker_attested"
+    ):
+        raise MaestroError(
+            "ORCH_HOST_SELF_ATTESTATION_FORBIDDEN",
+            "A producer principal requires external broker attestation.",
+        )
+    for field in ("invocation_id", "capability_lease_id"):
+        if value[field] != "not_observed":
+            raise MaestroError(
+                "ORCH_HOST_SELF_ATTESTATION_FORBIDDEN",
+                "Pre-turn invocation and Host lease must remain not_observed.",
+            )
+    if (
+        value["capabilities"]
+        or sources["capabilities"] != "not_observed"
+        or sources["capability_lease_id"] != "not_observed"
+        or sources["invocation_id"] != "not_observed"
+    ):
+        raise MaestroError(
+            "ORCH_CAPABILITY_LEASE_INFERRED",
+            "Controller grants and deadlines are not Host capability leases.",
+        )
+    if sources["participant_instance_id"] not in {
+        "controller_assigned",
+        "scripted_test",
+        "external_broker_attested",
+    }:
+        raise MaestroError(
+            "ORCH_HOST_RECEIPT_INVALID",
+            "Logical participant provenance is missing.",
+        )
+    host_context = value.get("host_context")
+    if (
+        not isinstance(host_context, dict)
+        or set(host_context) != {"thread_id", "session_id", "method"}
+        or host_context.get("method") not in {"thread/start", "thread/resume"}
+    ):
+        raise MaestroError(
+            "ORCH_HOST_RECEIPT_INVALID",
+            "Context evidence must bind one public thread start or resume.",
+        )
+    thread_id = require_identity(
+        host_context.get("thread_id"),
+        field="host_context.thread_id",
+    )
+    session_id = host_context.get("session_id")
+    if session_id != "not_observed":
+        require_identity(session_id, field="host_context.session_id")
+    if value["context_instance_id"] != f"codex-thread-{thread_id}" and (
+        sources["context_instance_id"] != "scripted_test"
+    ):
+        raise MaestroError(
+            "ORCH_HOST_RECEIPT_INVALID",
+            "Context identity must derive only from the returned public thread ID.",
+        )
+    runtime = value.get("runtime_binding")
+    if (
+        not isinstance(runtime, dict)
+        or set(runtime) != {
+            "source_interface",
+            "runtime_version",
+            "generated_schema_sha256",
+            "coverage",
+        }
+        or runtime.get("coverage") not in {"complete_stream", "scripted_test"}
+    ):
+        raise MaestroError(
+            "ORCH_HOST_RECEIPT_INVALID",
+            "Context evidence lacks the runtime and generated-schema binding.",
+        )
+    if runtime["coverage"] == "complete_stream":
+        require_line(
+            runtime.get("runtime_version"),
+            field="runtime_version",
+            maximum=100,
+        )
+        require_digest(
+            runtime.get("generated_schema_sha256"),
+            field="generated_schema_sha256",
+        )
+    profile = value["evidence_profile"]
+    if (
+        expected_evidence_profile is not None
+        and profile != expected_evidence_profile
+    ):
+        raise MaestroError(
+            "ORCH_EVIDENCE_PROFILE_MISMATCH",
+            "Context evidence profile differs from the Workflow Definition.",
+        )
+    if profile == PUBLIC_CODEX_EVIDENCE_PROFILE and (
+        runtime["coverage"] != "complete_stream"
+        or sources["participant_instance_id"] != "controller_assigned"
+        or sources["context_instance_id"] != "public_host_returned"
+        or sources["read_only"] != "public_host_returned"
+        or value["issued_by"] != "codex-app-server"
+    ):
+        raise MaestroError(
+            "ORCH_SCRIPTED_EVIDENCE_FORBIDDEN",
+            "Public-Codex evidence requires complete public Host observations.",
+        )
+    if profile == SCRIPTED_TEST_EVIDENCE_PROFILE and (
+        runtime["coverage"] != "scripted_test"
+        or sources["participant_instance_id"] != "scripted_test"
+        or sources["context_instance_id"] != "scripted_test"
+        or sources["read_only"] != "scripted_test"
+    ):
+        raise MaestroError(
+            "ORCH_HOST_RECEIPT_INVALID",
+            "Scripted evidence must remain explicitly test-only.",
+        )
+    returned = value.get("host_returned")
+    if (
+        not isinstance(returned, dict)
+        or set(returned)
+        != {
+            "model",
+            "reasoning_effort",
+            "sandbox",
+            "approval_policy",
+            "cwd",
+            "runtime_workspace_roots",
+        }
+        or (
+            returned.get("runtime_workspace_roots") != "not_observed"
+            and (
+                not isinstance(
+                    returned.get("runtime_workspace_roots"),
+                    list,
+                )
+                or not all(
+                    isinstance(item, str) and Path(item).is_absolute()
+                    for item in returned["runtime_workspace_roots"]
+                )
+            )
+        )
+    ):
+        raise MaestroError(
+            "ORCH_HOST_RECEIPT_INVALID",
+            "Context evidence lacks the public Host-returned execution boundary.",
+        )
+    returned_sandbox = _returned_sandbox_policy(returned["sandbox"])
+    if required_capabilities:
+        _validate_repository_capability_policy(
+            required_capabilities=required_capabilities,
+            read_only=value["read_only"],
+            returned_sandbox=returned_sandbox,
+            executor_permissions=executor_permissions,
+            executor_tools=executor_tools,
+            context_policy=context_policy,
+            requested_metadata=metadata["requested"],
+        )
+    if returned["model"] != "not_observed":
+        require_line(returned["model"], field="host_returned.model", maximum=128)
+    if returned["reasoning_effort"] != "not_observed":
+        require_line(
+            returned["reasoning_effort"],
+            field="host_returned.reasoning_effort",
+            maximum=128,
+        )
+    require_line(
+        returned["approval_policy"],
+        field="host_returned.approval_policy",
+        maximum=128,
+    )
+    cwd = Path(
+        require_line(returned["cwd"], field="host_returned.cwd", maximum=1000)
+    )
+    if not cwd.is_absolute():
+        raise MaestroError(
+            "ORCH_HOST_RECEIPT_INVALID",
+            "Host-returned cwd must be absolute.",
+        )
+    method = value.get("method_evidence")
+    if (
+        not isinstance(method, dict)
+        or set(method) != {"request_sha256", "response_sha256"}
+    ):
+        raise MaestroError(
+            "ORCH_HOST_RECEIPT_INVALID",
+            "Context evidence lacks request/response digests.",
+        )
+    require_digest(method.get("request_sha256"), field="request_sha256")
+    require_digest(method.get("response_sha256"), field="response_sha256")
+    resumption = value.get("resumption")
+    if (
+        not isinstance(resumption, dict)
+        or set(resumption) != _RESUMPTION_FIELDS
+        or resumption.get("status") != "controller_lineage"
+        or resumption.get("source") != "controller_lineage"
+        or resumption.get("context_instance_id")
+        != value["context_instance_id"]
+    ):
+        raise MaestroError(
+            "ORCH_CORRECTION_RESUME_UNATTESTED",
+            "Public context resumption must use controller-owned lineage.",
+        )
+    require_digest(
+        resumption.get("checkpoint_digest"),
+        field="resumption.checkpoint_digest",
+    )
+    require_refs(
+        value.get("source_evidence_refs"),
+        field="source_evidence_refs",
+        allow_empty=False,
+    )
+    expected = {
+        "root_request_id": expected_root_request_id,
+        "root_execution_id": expected_root_execution_id,
+        "workflow_instance_id": expected_workflow_instance_id,
+        "stage_spec_id": expected_stage_spec_id,
+        "role_spec_id": expected_role_spec_id,
+        "attempt_id": expected_attempt_id,
+    }
+    for field, expected_value in expected.items():
+        if expected_value is not None and value.get(field) != expected_value:
+            raise MaestroError(
+                "ORCH_ROOT_LINEAGE_MISMATCH",
+                f"Context evidence {field} differs from dispatch intent.",
+            )
+    if require_read_only is not None and value["read_only"] != require_read_only:
+        raise MaestroError(
+            "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+            "Host-returned sandbox authority differs from the RoleSpec.",
+        )
+    if value["read_only"] and returned_sandbox["kind"] != "read-only":
+        raise MaestroError(
+            "ORCH_HOST_RETURNED_BOUNDARY_MISMATCH",
+            "Read-only context did not return the read-only sandbox.",
+        )
+    if (
+        not value["read_only"]
+        and returned_sandbox["kind"] != "workspace-write"
+    ):
+        raise MaestroError(
+            "ORCH_HOST_RETURNED_BOUNDARY_MISMATCH",
+            "Mutation context did not return the bounded writer sandbox.",
+        )
+    if returned_sandbox["network_access"] is not False:
+        raise MaestroError(
+            "ORCH_HOST_RETURNED_BOUNDARY_MISMATCH",
+            "Host-returned sandbox unexpectedly grants network access.",
+        )
+    if (
+        returned_sandbox["kind"] == "workspace-write"
+        and (
+            returned["runtime_workspace_roots"] == "not_observed"
+            or (
+                # The public Host reports additional legacy roots here;
+                # the effective workspace roots are returned separately.
+                returned_sandbox["writable_roots"]
+                and not _same_runtime_workspace_roots(
+                    returned_sandbox["writable_roots"],
+                    returned["runtime_workspace_roots"],
+                )
+            )
+        )
+    ):
+        raise MaestroError(
+            "ORCH_HOST_RETURNED_BOUNDARY_MISMATCH",
+            "Host-returned sandbox writable roots differ from runtime roots.",
+        )
+    if returned["approval_policy"] != "never":
+        raise MaestroError(
+            "ORCH_HOST_RETURNED_BOUNDARY_MISMATCH",
+            "Host-returned approval policy differs from the non-interactive boundary.",
+        )
+    if value["evidence_profile"] == STRICT_PRINCIPAL_EVIDENCE_PROFILE and (
+        sources["producer_principal_id"] != "external_broker_attested"
+        or value["producer_principal_id"] == "not_observed"
+    ):
+        raise MaestroError(
+            "ORCH_STRICT_PRINCIPAL_UNAVAILABLE",
+            "Strict security-principal evidence requires an external broker.",
+        )
+    # Preserve the closed metadata separation even though it is not authority.
+    del metadata
+    return copy.deepcopy(value)
+
+
+def _lifecycle_event(
+    *,
+    sequence: int,
+    method: str,
+    thread_id: str,
+    turn_id: str,
+    status: str,
+) -> dict[str, Any]:
+    event = {
+        "sequence": sequence,
+        "method": method,
+        "thread_id": thread_id,
+        "turn_id": turn_id,
+        "status": status,
+        "event_sha256": "",
+    }
+    event["event_sha256"] = sha256_text(canonical_json(event))
+    return event
+
+
+def _public_lifecycle_event(
+    value: Mapping[str, Any],
+    *,
+    sequence: int,
+    expected_thread_id: str,
+    expected_turn_id: str,
+) -> dict[str, Any] | None:
+    method = value.get("method")
+    if method not in _RELEVANT_LIFECYCLE_METHODS:
+        return None
+    params = value.get("params")
+    if not isinstance(params, dict):
+        raise MaestroError(
+            "ORCH_ATTEMPT_LIFECYCLE_INVALID",
+            f"{method} lacks public correlation parameters.",
+        )
+    thread_id = params.get("threadId")
+    turn_id = params.get("turnId")
+    turn = params.get("turn")
+    if isinstance(turn, dict):
+        turn_id = turn.get("id", turn_id)
+    if thread_id != expected_thread_id or turn_id != expected_turn_id:
+        raise MaestroError(
+            "ORCH_ATTEMPT_LIFECYCLE_INVALID",
+            f"{method} does not correlate to the started thread and turn.",
+        )
+    status = "observed"
+    if method == "turn/started":
+        status = "started"
+    elif method == "turn/completed":
+        status = turn.get("status") if isinstance(turn, dict) else None
+        if status != "completed":
+            raise MaestroError(
+                "ORCH_ATTEMPT_LIFECYCLE_INCOMPLETE",
+                "turn/completed must report the exact completed status.",
+            )
+    return _lifecycle_event(
+        sequence=sequence,
+        method=method,
+        thread_id=thread_id,
+        turn_id=turn_id,
+        status=status,
+    )
+
+
+def issue_attempt_evidence(
+    repo_path: str | Path,
+    **values: Any,
+) -> dict[str, Any]:
+    receipt = {
+        "schema_version": ATTEMPT_EVIDENCE_VERSION,
+        "receipt_id": "",
+        "completion_receipt_id": "",
+        "key_id": "",
+        "auth_tag": "",
+        **copy.deepcopy(values),
+    }
+    key, key_id = signing_key(
+        repo_path,
+        purpose=_ATTEMPT_EVIDENCE_KEY_PURPOSE,
+        create=True,
+    )
+    receipt["key_id"] = key_id
+    identity = _evidence_identity(
+        receipt,
+        aliases=("completion_receipt_id",),
+    )
+    receipt["receipt_id"] = identity
+    receipt["completion_receipt_id"] = identity
+    receipt["auth_tag"] = auth_tag(receipt, key=key)
+    return validate_attempt_evidence(repo_path, receipt)
+
+
+def validate_attempt_evidence(
+    repo_path: str | Path,
+    value: Any,
+    *,
+    context_receipt: Mapping[str, Any] | None = None,
+    expected_evidence_profile: str | None = None,
+    expected_root_request_id: str | None = None,
+    expected_root_execution_id: str | None = None,
+    expected_workflow_instance_id: str | None = None,
+    expected_stage_spec_id: str | None = None,
+    expected_role_spec_id: str | None = None,
+    expected_attempt_id: str | None = None,
+    expected_input_projection_sha256: str | None = None,
+) -> dict[str, Any]:
+    if (
+        not isinstance(value, dict)
+        or set(value) != _ATTEMPT_EVIDENCE_FIELDS
+        or value.get("schema_version") != ATTEMPT_EVIDENCE_VERSION
+        or value.get("evidence_kind") != "post-turn-attempt"
+        or value.get("evidence_profile")
+        not in {
+            PUBLIC_CODEX_EVIDENCE_PROFILE,
+            STRICT_PRINCIPAL_EVIDENCE_PROFILE,
+            SCRIPTED_TEST_EVIDENCE_PROFILE,
+        }
+    ):
+        raise MaestroError(
+            "ORCH_ATTEMPT_EVIDENCE_INVALID",
+            "Attempt evidence does not match the closed v2 contract.",
+        )
+    if (
+        expected_evidence_profile is not None
+        and value["evidence_profile"] != expected_evidence_profile
+    ):
+        raise MaestroError(
+            "ORCH_EVIDENCE_PROFILE_MISMATCH",
+            "Attempt evidence profile differs from the Workflow Definition.",
+        )
+    if value.get("collector_integrity") != _collector_integrity():
+        raise MaestroError(
+            "ORCH_HOST_SELF_ATTESTATION_FORBIDDEN",
+            "Attempt signing proves collector integrity only.",
+        )
+    for field in (
+        "root_execution_id",
+        "workflow_instance_id",
+        "stage_spec_id",
+        "role_spec_id",
+        "attempt_id",
+        "context_receipt_id",
+        "thread_id",
+        "turn_id",
+    ):
+        require_identity(value.get(field), field=field)
+    require_line(value.get("root_request_id"), field="root_request_id")
+    for field in (
+        "context_receipt_digest",
+        "turn_start_request_sha256",
+        "turn_start_response_sha256",
+        "input_projection_sha256",
+        "semantic_validation_receipt_id",
+    ):
+        require_digest(value.get(field), field=field)
+    lifecycle = value.get("lifecycle")
+    if (
+        not isinstance(lifecycle, dict)
+        or set(lifecycle)
+        != {
+            "events",
+            "event_count",
+            "event_chain_sha256",
+            "turn_started",
+            "turn_completed",
+        }
+        or lifecycle.get("turn_started") is not True
+        or lifecycle.get("turn_completed") is not True
+        or not isinstance(lifecycle.get("events"), list)
+        or lifecycle.get("event_count") != len(lifecycle["events"])
+        or not lifecycle["events"]
+    ):
+        raise MaestroError(
+            "ORCH_ATTEMPT_LIFECYCLE_INCOMPLETE",
+            "Attempt evidence requires a complete ordered lifecycle.",
+        )
+    methods: list[str] = []
+    event_digests: list[str] = []
+    for index, event in enumerate(lifecycle["events"], 1):
+        if (
+            not isinstance(event, dict)
+            or set(event) != _LIFECYCLE_EVENT_FIELDS
+            or event.get("sequence") != index
+            or event.get("thread_id") != value["thread_id"]
+            or event.get("turn_id") != value["turn_id"]
+        ):
+            raise MaestroError(
+                "ORCH_ATTEMPT_LIFECYCLE_INVALID",
+                "Attempt lifecycle sequence or correlation is invalid.",
+            )
+        candidate = copy.deepcopy(event)
+        candidate["event_sha256"] = ""
+        if event.get("event_sha256") != sha256_text(canonical_json(candidate)):
+            raise MaestroError(
+                "ORCH_ATTEMPT_LIFECYCLE_INVALID",
+                "Attempt lifecycle event content address is invalid.",
+            )
+        methods.append(event["method"])
+        event_digests.append(event["event_sha256"])
+    if (
+        any(method not in _RELEVANT_LIFECYCLE_METHODS for method in methods)
+        or methods.count("turn/started") != 1
+        or methods.count("turn/completed") != 1
+        or methods[0] != "turn/started"
+        or methods[-1] != "turn/completed"
+        or lifecycle["events"][0]["status"] != "started"
+        or lifecycle["events"][-1]["status"] != "completed"
+        or lifecycle.get("event_chain_sha256")
+        != sha256_text(canonical_json(event_digests))
+    ):
+        raise MaestroError(
+            "ORCH_ATTEMPT_LIFECYCLE_INCOMPLETE",
+            "Attempt lifecycle is missing, altered, or out of order.",
+        )
+    telemetry = value.get("telemetry")
+    if (
+        not isinstance(telemetry, dict)
+        or set(telemetry)
+        != {"reroutes", "tokens", "applied_model", "model_coverage"}
+        or not isinstance(telemetry.get("reroutes"), list)
+        or telemetry.get("model_coverage")
+        not in {"complete_stream", "scripted_test"}
+    ):
+        raise MaestroError(
+            "ORCH_ATTEMPT_EVIDENCE_INVALID",
+            "Attempt telemetry provenance is invalid.",
+        )
+    if (
+        value["evidence_profile"] == PUBLIC_CODEX_EVIDENCE_PROFILE
+        and telemetry["model_coverage"] != "complete_stream"
+    ):
+        raise MaestroError(
+            "ORCH_SCRIPTED_EVIDENCE_FORBIDDEN",
+            "Public attempt evidence requires complete App Server telemetry coverage.",
+        )
+    if (
+        value["evidence_profile"] == SCRIPTED_TEST_EVIDENCE_PROFILE
+        and telemetry["model_coverage"] != "scripted_test"
+    ):
+        raise MaestroError(
+            "ORCH_ATTEMPT_EVIDENCE_INVALID",
+            "Scripted attempt evidence must remain explicitly test-only.",
+        )
+    effect = value.get("repository_effect")
+    if (
+        not isinstance(effect, dict)
+        or set(effect)
+        != {
+            "before_sha256",
+            "after_sha256",
+            "audit_sha256",
+            "read_only_zero_effect",
+        }
+    ):
+        raise MaestroError(
+            "ORCH_ATTEMPT_EFFECT_INVALID",
+            "Attempt repository-effect audit is invalid.",
+        )
+    for field in ("before_sha256", "after_sha256", "audit_sha256"):
+        require_digest(effect.get(field), field=f"repository_effect.{field}")
+    audit = {
+        "before_sha256": effect["before_sha256"],
+        "after_sha256": effect["after_sha256"],
+        "effect_state": value["effect_state"],
+        "changed_paths": value["changed_paths"],
+        "read_only_zero_effect": effect["read_only_zero_effect"],
+    }
+    if effect["audit_sha256"] != sha256_text(canonical_json(audit)):
+        raise MaestroError(
+            "ORCH_ATTEMPT_EFFECT_INVALID",
+            "Attempt repository-effect audit digest is invalid.",
+        )
+    if (
+        not isinstance(value.get("changed_paths"), list)
+        or value["changed_paths"] != sorted(set(value["changed_paths"]))
+        or value.get("effect_state") not in {"no-writes", "verified-writes"}
+        or value.get("status") != "completed"
+    ):
+        raise MaestroError(
+            "ORCH_ATTEMPT_EFFECT_INVALID",
+            "Attempt effect or terminal status is invalid.",
+        )
+    if context_receipt is not None:
+        context = validate_context_evidence(repo_path, context_receipt)
+        if (
+            value["context_receipt_id"] != context["receipt_id"]
+            or value["context_receipt_digest"]
+            != host_receipt_digest(context)
+            or value["thread_id"] != context["host_context"]["thread_id"]
+            or value["session_id"] != context["host_context"]["session_id"]
+            or value["evidence_profile"] != context["evidence_profile"]
+        ):
+            raise MaestroError(
+                "ORCH_ATTEMPT_CONTEXT_MISMATCH",
+                "Attempt evidence is not bound to the exact context receipt.",
+            )
+        if context["read_only"] and (
+            value["effect_state"] != "no-writes"
+            or value["changed_paths"]
+            or effect["before_sha256"] != effect["after_sha256"]
+            or effect["read_only_zero_effect"] is not True
+        ):
+            raise MaestroError(
+                "ORCH_READ_ONLY_EFFECT_DETECTED",
+                "Read-only attempt evidence does not prove zero repository effect.",
+            )
+    expected = {
+        "root_request_id": expected_root_request_id,
+        "root_execution_id": expected_root_execution_id,
+        "workflow_instance_id": expected_workflow_instance_id,
+        "stage_spec_id": expected_stage_spec_id,
+        "role_spec_id": expected_role_spec_id,
+        "attempt_id": expected_attempt_id,
+        "input_projection_sha256": expected_input_projection_sha256,
+    }
+    for field, expected_value in expected.items():
+        if expected_value is not None and value.get(field) != expected_value:
+            raise MaestroError(
+                "ORCH_ROOT_LINEAGE_MISMATCH",
+                f"Attempt evidence {field} differs from dispatch intent.",
+            )
+    key, key_id = signing_key(
+        repo_path,
+        purpose=_ATTEMPT_EVIDENCE_KEY_PURPOSE,
+        create=False,
+    )
+    identity = _evidence_identity(
+        value,
+        aliases=("completion_receipt_id",),
+    )
+    if (
+        value.get("receipt_id") != identity
+        or value.get("completion_receipt_id") != identity
+        or not authenticated(value, key=key, expected_key_id=key_id)
+    ):
+        raise MaestroError(
+            "ORCH_ATTEMPT_EVIDENCE_INVALID",
+            "Attempt evidence collector integrity or content address is invalid.",
+        )
+    return copy.deepcopy(value)
+
+
+def _host_receipt_payload(
+    *,
+    root_request_id: str,
+    root_execution_id: str,
+    workflow_instance_id: str,
+    stage_spec_id: str,
+    role_spec_id: str,
+    participant_instance_id: str,
+    producer_principal_id: str,
+    invocation_id: str,
+    context_instance_id: str,
+    capability_lease_id: str,
+    capabilities: Sequence[str],
+    read_only: bool,
+    issued_by: str,
+    acquired_at: str,
+    expires_at: str,
+    requested: Mapping[str, Any],
+    recommended: Mapping[str, Any],
+    applied: Mapping[str, Any],
+    observation_sources: Mapping[str, str],
+    resumption: Mapping[str, Any],
+    source_evidence_refs: Sequence[str],
+) -> dict[str, Any]:
+    return {
+        "schema_version": HOST_RECEIPT_VERSION,
+        "receipt_id": "",
+        "key_id": "",
+        "auth_tag": "",
+        "root_request_id": root_request_id,
+        "root_execution_id": root_execution_id,
+        "workflow_instance_id": workflow_instance_id,
+        "stage_spec_id": stage_spec_id,
+        "role_spec_id": role_spec_id,
+        "participant_instance_id": participant_instance_id,
+        "producer_principal_id": producer_principal_id,
+        "invocation_id": invocation_id,
+        "context_instance_id": context_instance_id,
+        "capability_lease_id": capability_lease_id,
+        "capabilities": sorted(set(capabilities)),
+        "read_only": read_only,
+        "issued_by": issued_by,
+        "acquired_at": acquired_at,
+        "expires_at": expires_at,
+        "metadata": {
+            "requested": copy.deepcopy(dict(requested)),
+            "recommended": copy.deepcopy(dict(recommended)),
+            "applied": copy.deepcopy(dict(applied)),
+        },
+        "observation_sources": copy.deepcopy(dict(observation_sources)),
+        "resumption": copy.deepcopy(dict(resumption)),
+        "source_evidence_refs": list(source_evidence_refs),
+    }
+
+
+def issue_host_receipt(
+    repo_path: str | Path,
+    **values: Any,
+) -> dict[str, Any]:
+    receipt = _host_receipt_payload(**values)
+    key, key_id = signing_key(
+        repo_path,
+        purpose=ORCHESTRATION_HOST_RECEIPT_KEY_PURPOSE,
+        create=True,
+    )
+    receipt["key_id"] = key_id
+    receipt["receipt_id"] = receipt_identity(receipt)
+    receipt["auth_tag"] = auth_tag(receipt, key=key)
+    return validate_host_receipt(repo_path, receipt)
+
+
+def validate_host_receipt(
+    repo_path: str | Path,
+    value: Any,
+    *,
+    expected_evidence_profile: str | None = None,
+    expected_root_request_id: str | None = None,
+    expected_root_execution_id: str | None = None,
+    expected_workflow_instance_id: str | None = None,
+    expected_stage_spec_id: str | None = None,
+    expected_role_spec_id: str | None = None,
+    expected_attempt_id: str | None = None,
+    required_capabilities: Sequence[str] = (),
+    require_read_only: bool | None = None,
+    executor_permissions: Sequence[str] | None = None,
+    executor_tools: Sequence[str] | None = None,
+    context_policy: Mapping[str, Any] | None = None,
+) -> dict[str, Any]:
+    if (
+        isinstance(value, dict)
+        and value.get("schema_version") == CONTEXT_EVIDENCE_VERSION
+    ):
+        return validate_context_evidence(
+            repo_path,
+            value,
+            expected_evidence_profile=expected_evidence_profile,
+            expected_root_request_id=expected_root_request_id,
+            expected_root_execution_id=expected_root_execution_id,
+            expected_workflow_instance_id=expected_workflow_instance_id,
+            expected_stage_spec_id=expected_stage_spec_id,
+            expected_role_spec_id=expected_role_spec_id,
+            expected_attempt_id=expected_attempt_id,
+            required_capabilities=required_capabilities,
+            require_read_only=require_read_only,
+            executor_permissions=executor_permissions,
+            executor_tools=executor_tools,
+            context_policy=context_policy,
+        )
+    if expected_evidence_profile is not None:
+        raise MaestroError(
+            "ORCH_EVIDENCE_PROFILE_MISMATCH",
+            "Profile-bound orchestration requires matching v2 context evidence.",
+        )
+    fields = {
+        "schema_version",
+        "receipt_id",
+        "key_id",
+        "auth_tag",
+        "root_request_id",
+        "root_execution_id",
+        "workflow_instance_id",
+        "stage_spec_id",
+        "role_spec_id",
+        "participant_instance_id",
+        "producer_principal_id",
+        "invocation_id",
+        "context_instance_id",
+        "capability_lease_id",
+        "capabilities",
+        "read_only",
+        "issued_by",
+        "acquired_at",
+        "expires_at",
+        "metadata",
+        "observation_sources",
+        "resumption",
+        "source_evidence_refs",
+    }
+    if (
+        not isinstance(value, dict)
+        or set(value) != fields
+        or value.get("schema_version") != HOST_RECEIPT_VERSION
+        or not isinstance(value.get("read_only"), bool)
+    ):
+        raise MaestroError(
+            "ORCH_HOST_RECEIPT_INVALID",
+            "Host receipt does not match the closed receipt contract.",
+        )
+    for field in (
+        "root_execution_id",
+        "workflow_instance_id",
+        "stage_spec_id",
+        "role_spec_id",
+        "participant_instance_id",
+        "producer_principal_id",
+        "invocation_id",
+        "context_instance_id",
+        "capability_lease_id",
+    ):
+        require_identity(value.get(field), field=field)
+    require_line(value.get("root_request_id"), field="root_request_id")
+    require_line(value.get("issued_by"), field="issued_by")
+    acquired_at = require_line(
+        value.get("acquired_at"),
+        field="acquired_at",
+        maximum=64,
+    )
+    expires_at = require_line(
+        value.get("expires_at"),
+        field="expires_at",
+        maximum=64,
+    )
+    if _timestamp_epoch(expires_at) <= _timestamp_epoch(acquired_at):
+        raise MaestroError(
+            "ORCH_HOST_RECEIPT_INVALID",
+            "Host receipt capability leases must have a finite positive lifetime.",
+        )
+    capabilities = require_refs(
+        value.get("capabilities"),
+        field="capabilities",
+        allow_empty=True,
+        maximum=32,
+    )
+    require_refs(
+        value.get("source_evidence_refs"),
+        field="source_evidence_refs",
+        allow_empty=False,
+    )
+    metadata = value.get("metadata")
+    if (
+        not isinstance(metadata, dict)
+        or set(metadata) != {"requested", "recommended", "applied"}
+        or not all(isinstance(metadata[field], dict) for field in metadata)
+        or any(
+            set(metadata[field]) != _HOST_METADATA_FIELDS
+            for field in ("requested", "recommended", "applied")
+        )
+    ):
+        raise MaestroError(
+            "ORCH_TELEMETRY_INFERRED",
+            "Host receipt metadata must keep requested, recommended, and applied values separate.",
+        )
+    for field in ("model", "reasoning_effort", "tools", "permissions", "tokens", "cost"):
+        if field not in metadata["applied"]:
+            raise MaestroError(
+                "ORCH_TELEMETRY_INFERRED",
+                f"Host-applied metadata must explicitly retain {field}.",
+            )
+    applied = metadata["applied"]
+    for field in ("model", "reasoning_effort"):
+        if (
+            applied[field] != "not_observed"
+            and (
+                not isinstance(applied[field], str)
+                or not applied[field]
+            )
+        ):
+            raise MaestroError(
+                "ORCH_TELEMETRY_INFERRED",
+                f"Host-applied {field} must be observed text or not_observed.",
+            )
+    for field in ("tools", "permissions"):
+        if applied[field] != "not_observed":
+            require_refs(
+                applied[field],
+                field=f"metadata.applied.{field}",
+                allow_empty=True,
+            )
+    for field in ("tokens", "cost"):
+        if (
+            applied[field] != "not_observed"
+            and (
+                not isinstance(applied[field], (int, float))
+                or isinstance(applied[field], bool)
+                or applied[field] < 0
+            )
+        ):
+            raise MaestroError(
+                "ORCH_TELEMETRY_INFERRED",
+                f"Host-applied {field} must be a non-negative observation or not_observed.",
+            )
+    observation_sources = value.get("observation_sources")
+    if (
+        not isinstance(observation_sources, dict)
+        or set(observation_sources) != _OBSERVATION_SOURCE_FIELDS
+        or any(
+            source not in _OBSERVATION_SOURCES
+            for source in observation_sources.values()
+        )
+    ):
+        raise MaestroError(
+            "ORCH_TELEMETRY_INFERRED",
+            "Every Host identity, capability, and applied value requires an exact observation source.",
+        )
+    observed_values = {
+        "participant_instance_id": value["participant_instance_id"],
+        "producer_principal_id": value["producer_principal_id"],
+        "invocation_id": value["invocation_id"],
+        "context_instance_id": value["context_instance_id"],
+        "capability_lease_id": value["capability_lease_id"],
+        "capabilities": value["capabilities"],
+        "read_only": value["read_only"],
+        **metadata["applied"],
+    }
+    for field, source in observation_sources.items():
+        observed = observed_values[field]
+        if source == "not_observed" and observed != "not_observed" and observed != []:
+            raise MaestroError(
+                "ORCH_TELEMETRY_INFERRED",
+                f"Unobserved Host value {field} must remain not_observed.",
+            )
+        if source in _OBSERVED_SOURCES and (
+            observed == "not_observed" or observed == []
+        ):
+            raise MaestroError(
+                "ORCH_HOST_RECEIPT_INVALID",
+                f"Observed Host value {field} cannot be empty.",
+            )
+    resumption = value.get("resumption")
+    if (
+        not isinstance(resumption, dict)
+        or set(resumption) != _RESUMPTION_FIELDS
+        or resumption.get("status")
+        not in {"attested", "not_observed", "not_applicable"}
+        or resumption.get("source") not in _OBSERVATION_SOURCES
+    ):
+        raise MaestroError(
+            "ORCH_HOST_RECEIPT_INVALID",
+            "Host receipt resumption evidence is invalid.",
+        )
+    if resumption["status"] == "attested":
+        require_identity(
+            resumption.get("context_instance_id"),
+            field="resumption.context_instance_id",
+        )
+        require_digest(
+            resumption.get("checkpoint_digest"),
+            field="resumption.checkpoint_digest",
+        )
+        if resumption["source"] not in _OBSERVED_SOURCES:
+            raise MaestroError(
+                "ORCH_CORRECTION_RESUME_UNATTESTED",
+                "Context resumption must be Host-attested.",
+            )
+    elif (
+        resumption.get("context_instance_id") != "not_observed"
+        or resumption.get("checkpoint_digest") != "not_observed"
+    ):
+        raise MaestroError(
+            "ORCH_CORRECTION_RESUME_UNATTESTED",
+            "Unavailable resumption values must remain not_observed.",
+        )
+    key, key_id = signing_key(
+        repo_path,
+        purpose=ORCHESTRATION_HOST_RECEIPT_KEY_PURPOSE,
+        create=False,
+    )
+    if (
+        value.get("receipt_id") != receipt_identity(value)
+        or not authenticated(value, key=key, expected_key_id=key_id)
+    ):
+        raise MaestroError(
+            "ORCH_HOST_RECEIPT_INVALID",
+            "Host receipt authentication or content address is invalid.",
+        )
+    expected = {
+        "root_request_id": expected_root_request_id,
+        "root_execution_id": expected_root_execution_id,
+        "workflow_instance_id": expected_workflow_instance_id,
+        "stage_spec_id": expected_stage_spec_id,
+        "role_spec_id": expected_role_spec_id,
+    }
+    for field, expected_value in expected.items():
+        if expected_value is not None and value.get(field) != expected_value:
+            raise MaestroError(
+                "ORCH_ROOT_LINEAGE_MISMATCH",
+                f"Host receipt {field} differs from the dispatch request.",
+            )
+    missing = sorted(set(required_capabilities) - set(capabilities))
+    if missing:
+        raise MaestroError(
+            "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+            "Host receipt lacks required capabilities: " + ", ".join(missing),
+        )
+    if require_read_only is not None and value["read_only"] != require_read_only:
+        raise MaestroError(
+            "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+            "Host receipt read-only capability differs from the RoleSpec.",
+        )
+    return copy.deepcopy(value)
+
+
+def host_receipt_digest(receipt: Mapping[str, Any]) -> str:
+    return sha256_text(canonical_json(receipt))
+
+
+def _receipt_group(
+    receipts_by_role: Mapping[str, Any],
+    role_spec_id: str,
+) -> list[Mapping[str, Any]]:
+    value = receipts_by_role.get(role_spec_id)
+    if value is None:
+        return []
+    if isinstance(value, Mapping):
+        return [value]
+    if (
+        isinstance(value, Sequence)
+        and not isinstance(value, (str, bytes))
+        and all(isinstance(item, Mapping) for item in value)
+    ):
+        return list(value)
+    raise MaestroError(
+        "ORCH_INDEPENDENCE_EVIDENCE_INVALID",
+        "Independence evidence must be grouped by RoleSpec.",
+    )
+
+
+def validate_independence(
+    definition: Mapping[str, Any],
+    receipts_by_role: Mapping[str, Any],
+) -> None:
+    profile = evidence_profile(definition)
+    dimensions = {
+        "participant": "participant_instance_id",
+        "principal": "producer_principal_id",
+        "invocation": "invocation_id",
+        "context": "context_instance_id",
+        "capability-lease": "capability_lease_id",
+    }
+    sources = {
+        "participant": "participant_instance_id",
+        "principal": "producer_principal_id",
+        "invocation": "invocation_id",
+        "context": "context_instance_id",
+        "capability-lease": "capability_lease_id",
+    }
+    for edge in definition["responsibility_plan"]["independence_edges"]:
+        if not edge["mandatory"]:
+            continue
+        left_group = _receipt_group(
+            receipts_by_role,
+            edge["left_role_spec_id"],
+        )
+        right_group = _receipt_group(
+            receipts_by_role,
+            edge["right_role_spec_id"],
+        )
+        if not left_group or not right_group:
+            continue
+        for left in left_group:
+            for right in right_group:
+                if edge["high_risk"] and (
+                    left["issued_by"] in _CURRENT_HOST_SOURCES
+                    or right["issued_by"] in _CURRENT_HOST_SOURCES
+                ):
+                    raise MaestroError(
+                        "HPC_CURRENT_HOST_FORBIDDEN",
+                        "A high-risk mandatory responsibility cannot use current_host or a shared main context.",
+                    )
+                if profile == PUBLIC_CODEX_EVIDENCE_PROFILE:
+                    for receipt in (left, right):
+                        if (
+                            receipt.get("schema_version")
+                            != CONTEXT_EVIDENCE_VERSION
+                            or receipt["observation_sources"][
+                                "context_instance_id"
+                            ]
+                            != "public_host_returned"
+                            or receipt["runtime_binding"]["coverage"]
+                            != "complete_stream"
+                        ):
+                            raise MaestroError(
+                                "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+                                "Public-Codex operational independence requires a "
+                                "returned, isolated Host thread context.",
+                            )
+                    if (
+                        left["context_instance_id"]
+                        == right["context_instance_id"]
+                    ):
+                        raise MaestroError(
+                            "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+                            "Public-Codex operational contexts collide.",
+                        )
+                    continue
+                if profile == SCRIPTED_TEST_EVIDENCE_PROFILE:
+                    for receipt in (left, right):
+                        if (
+                            receipt.get("schema_version")
+                            != CONTEXT_EVIDENCE_VERSION
+                            or receipt["observation_sources"][
+                                "context_instance_id"
+                            ]
+                            != "scripted_test"
+                            or receipt["runtime_binding"]["coverage"]
+                            != "scripted_test"
+                        ):
+                            raise MaestroError(
+                                "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+                                "Scripted independence requires explicit test-only contexts.",
+                            )
+                    if (
+                        left["context_instance_id"]
+                        == right["context_instance_id"]
+                    ):
+                        raise MaestroError(
+                            "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+                            "Scripted operational contexts collide.",
+                        )
+                    continue
+                if profile == STRICT_PRINCIPAL_EVIDENCE_PROFILE and any(
+                    receipt["observation_sources"][
+                        "producer_principal_id"
+                    ]
+                    != "external_broker_attested"
+                    or receipt["producer_principal_id"] == "not_observed"
+                    for receipt in (left, right)
+                ):
+                    raise MaestroError(
+                        "ORCH_STRICT_PRINCIPAL_UNAVAILABLE",
+                        "Strict security-principal independence requires "
+                        "externally attested distinct principals.",
+                    )
+                unavailable = [
+                    dimension
+                    for dimension in edge["dimensions"]
+                    if left["observation_sources"][sources[dimension]]
+                    not in _OBSERVED_SOURCES
+                    or right["observation_sources"][sources[dimension]]
+                    not in _OBSERVED_SOURCES
+                    or left[dimensions[dimension]] == "not_observed"
+                    or right[dimensions[dimension]] == "not_observed"
+                ]
+                if edge["high_risk"] and unavailable:
+                    raise MaestroError(
+                        "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+                        "Host did not attest mandatory independence dimensions: "
+                        + ", ".join(sorted(unavailable)),
+                    )
+                collisions = [
+                    dimension
+                    for dimension in edge["dimensions"]
+                    if left[dimensions[dimension]]
+                    == right[dimensions[dimension]]
+                ]
+                if collisions:
+                    raise MaestroError(
+                        "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+                        "Host receipts do not satisfy mandatory independence dimensions: "
+                        + ", ".join(sorted(collisions)),
+                    )
+
+
+def validate_attempt_independence(
+    definition: Mapping[str, Any],
+    receipts_by_role: Mapping[str, Any],
+    *,
+    current_wave_role_ids: Sequence[str] = (),
+    prior_completed_role_ids: Sequence[str] = (),
+    fresh_current_role_ids: Sequence[str] | None = None,
+) -> None:
+    """Validate post-turn invocation and event separation before admission."""
+
+    if evidence_profile(definition) not in {
+        PUBLIC_CODEX_EVIDENCE_PROFILE,
+        SCRIPTED_TEST_EVIDENCE_PROFILE,
+    }:
+        return
+    current_roles = set(current_wave_role_ids)
+    prior_roles = set(prior_completed_role_ids)
+    fresh_roles = (
+        current_roles
+        if fresh_current_role_ids is None
+        else set(fresh_current_role_ids)
+    )
+    for edge in definition["responsibility_plan"]["independence_edges"]:
+        if not edge["mandatory"]:
+            continue
+        left_group = _receipt_group(
+            receipts_by_role,
+            edge["left_role_spec_id"],
+        )
+        right_group = _receipt_group(
+            receipts_by_role,
+            edge["right_role_spec_id"],
+        )
+        edge_roles = {
+            edge["left_role_spec_id"],
+            edge["right_role_spec_id"],
+        }
+        current_edge_roles = current_roles & edge_roles
+        if not current_edge_roles:
+            continue
+        if len(current_edge_roles) == 1:
+            prior_endpoint = next(iter(edge_roles - current_edge_roles))
+            if prior_endpoint not in prior_roles:
+                continue
+        if not current_edge_roles.issubset(fresh_roles):
+            raise MaestroError(
+                "ORCH_ATTEMPT_EVIDENCE_MISSING",
+                "A due mandatory peer lacks fresh or admitted attempt evidence.",
+            )
+        if not left_group or not right_group:
+            raise MaestroError(
+                "ORCH_ATTEMPT_EVIDENCE_MISSING",
+                "A due mandatory peer lacks fresh or admitted attempt evidence.",
+            )
+        for left in left_group:
+            for right in right_group:
+                collisions = []
+                if left["thread_id"] == right["thread_id"]:
+                    collisions.append("thread")
+                if left["turn_id"] == right["turn_id"]:
+                    collisions.append("turn")
+                if (
+                    left["lifecycle"]["event_chain_sha256"]
+                    == right["lifecycle"]["event_chain_sha256"]
+                ):
+                    collisions.append("event-chain")
+                if collisions:
+                    raise MaestroError(
+                        "ORCH_ATTEMPT_INDEPENDENCE_COLLISION",
+                        "Public-Codex attempts do not satisfy invocation/effect "
+                        "isolation: " + ", ".join(collisions),
+                    )
+
+
+def _generic_semantic_validator(
+    stage: Mapping[str, Any],
+    value: Mapping[str, Any],
+) -> dict[str, Any]:
+    """Validate the generic result semantics beyond its transport shape."""
+
+    claim_ids = sorted(claim["claim_id"] for claim in value["claims"])
+    if value["status"] == "completed" and not value["evidence_refs"]:
+        raise MaestroError(
+            "ORCH_SEMANTIC_VALIDATION_FAILED",
+            "A completed generic result requires at least one evidence reference.",
+        )
+    for claim in value["claims"]:
+        if not claim["statement"].strip() or not claim["evidence_refs"]:
+            raise MaestroError(
+                "ORCH_SEMANTIC_VALIDATION_FAILED",
+                "Every generic claim requires a statement and evidence.",
+            )
+    return {
+        "validator_kind": "generic-result",
+        "validated_claim_ids": claim_ids,
+        "required_claim_ids": list(
+            stage["output_contract"]["required_claim_ids"]
+        ),
+    }
+
+
+def _source_ranked_research_validator(
+    stage: Mapping[str, Any],
+    value: Mapping[str, Any],
+) -> dict[str, Any]:
+    """Validate a closed, source-ranked ResearchPacket payload."""
+
+    payload = value["payload"]
+    fields = {"schema_version", "sources", "claims", "synthesis_limitations"}
+    if not isinstance(payload, dict) or set(payload) != fields:
+        raise MaestroError(
+            "ORCH_SEMANTIC_VALIDATION_FAILED",
+            "ResearchPacket payload must match the closed source-ranked contract.",
+        )
+    if payload["schema_version"] != "maestro_source_ranked_research_packet_v1":
+        raise MaestroError(
+            "ORCH_SEMANTIC_VALIDATION_FAILED",
+            "ResearchPacket schema_version is unsupported.",
+        )
+    sources = payload["sources"]
+    if not isinstance(sources, list) or not sources or len(sources) > 64:
+        raise MaestroError(
+            "ORCH_SEMANTIC_VALIDATION_FAILED",
+            "ResearchPacket requires a bounded non-empty source set.",
+        )
+    source_ids: list[str] = []
+    source_types: list[str] = []
+    for ordinal, source in enumerate(sources, start=1):
+        source_fields = {
+            "source_id",
+            "rank",
+            "source_type",
+            "locator",
+            "content_sha256",
+            "limitations",
+        }
+        if (
+            not isinstance(source, dict)
+            or set(source) != source_fields
+            or source.get("rank") != ordinal
+            or source.get("source_type") not in _SOURCE_RANKS
+        ):
+            raise MaestroError(
+                "ORCH_SEMANTIC_VALIDATION_FAILED",
+                "ResearchPacket sources must be closed and contiguously ranked.",
+            )
+        source_ids.append(
+            require_identity(source.get("source_id"), field="source_id")
+        )
+        source_types.append(source["source_type"])
+        require_line(source.get("locator"), field="locator")
+        require_digest(source.get("content_sha256"), field="content_sha256")
+        require_refs(source.get("limitations"), field="limitations")
+    if len(source_ids) != len(set(source_ids)) or "primary" not in source_types:
+        raise MaestroError(
+            "ORCH_SEMANTIC_VALIDATION_FAILED",
+            "ResearchPacket source IDs must be unique and include primary evidence.",
+        )
+    research_claims = payload["claims"]
+    if (
+        not isinstance(research_claims, list)
+        or not research_claims
+        or len(research_claims) > 64
+    ):
+        raise MaestroError(
+            "ORCH_SEMANTIC_VALIDATION_FAILED",
+            "ResearchPacket requires bounded source-linked claims.",
+        )
+    result_claim_ids = {claim["claim_id"] for claim in value["claims"]}
+    payload_claim_ids: list[str] = []
+    for claim in research_claims:
+        claim_fields = {
+            "claim_id",
+            "statement",
+            "source_ids",
+            "evidence_refs",
+        }
+        if not isinstance(claim, dict) or set(claim) != claim_fields:
+            raise MaestroError(
+                "ORCH_SEMANTIC_VALIDATION_FAILED",
+                "ResearchPacket claims must match the closed claim contract.",
+            )
+        claim_id = require_identity(claim.get("claim_id"), field="claim_id")
+        payload_claim_ids.append(claim_id)
+        require_line(claim.get("statement"), field="statement")
+        linked_sources = require_refs(
+            claim.get("source_ids"),
+            field="source_ids",
+            allow_empty=False,
+        )
+        if not set(linked_sources).issubset(source_ids):
+            raise MaestroError(
+                "ORCH_SEMANTIC_VALIDATION_FAILED",
+                "ResearchPacket claim references an unknown source.",
+            )
+        require_refs(
+            claim.get("evidence_refs"),
+            field="evidence_refs",
+            allow_empty=False,
+        )
+    if (
+        len(payload_claim_ids) != len(set(payload_claim_ids))
+        or set(payload_claim_ids) != result_claim_ids
+    ):
+        raise MaestroError(
+            "ORCH_SEMANTIC_VALIDATION_FAILED",
+            "ResearchPacket claims must exactly match the Host result claims.",
+        )
+    require_refs(
+        payload["synthesis_limitations"],
+        field="synthesis_limitations",
+    )
+    return {
+        "validator_kind": "source-ranked-research",
+        "validated_claim_ids": sorted(payload_claim_ids),
+        "source_count": len(sources),
+        "source_types": source_types,
+    }
+
+
+_SEMANTIC_VALIDATORS: dict[
+    tuple[str, str],
+    Callable[[Mapping[str, Any], Mapping[str, Any]], dict[str, Any]],
+] = {
+    ("generic-validator", "v1"): _generic_semantic_validator,
+    (
+        "source-ranked-research-validator",
+        "v1",
+    ): _source_ranked_research_validator,
+}
+
+
+def semantic_validator_binding(
+    validator_id: str,
+    validator_version: str,
+) -> dict[str, str]:
+    """Resolve and content-bind one exact registered semantic validator."""
+
+    implementation = _SEMANTIC_VALIDATORS.get(
+        (validator_id, validator_version)
+    )
+    if implementation is None:
+        raise MaestroError(
+            "ORCH_SEMANTIC_VALIDATOR_UNRESOLVED",
+            f"No semantic validator is registered for {validator_id}@{validator_version}.",
+        )
+    try:
+        source = inspect.getsource(implementation)
+    except (OSError, TypeError) as exc:
+        raise MaestroError(
+            "ORCH_SEMANTIC_VALIDATOR_UNRESOLVED",
+            "The semantic validator implementation source is unavailable.",
+        ) from exc
+    implementation_digest = sha256_text(
+        canonical_json(
+            {
+                "schema_version": _VALIDATOR_SOURCE_VERSION,
+                "validator_id": validator_id,
+                "validator_version": validator_version,
+                "implementation_source": source,
+            }
+        )
+    )
+    return {
+        "validator_id": validator_id,
+        "validator_version": validator_version,
+        "validator_digest": implementation_digest,
+    }
+
+
+def _execute_semantic_validator(
+    stage: Mapping[str, Any],
+    value: Mapping[str, Any],
+) -> tuple[dict[str, str], dict[str, Any]]:
+    output = stage["output_contract"]
+    binding = semantic_validator_binding(
+        output["validator_id"],
+        output["validator_version"],
+    )
+    if output["validator_digest"] != binding["validator_digest"]:
+        raise MaestroError(
+            "ORCH_SEMANTIC_VALIDATOR_DIGEST_MISMATCH",
+            "The StageSpec semantic validator digest does not match the resolved implementation.",
+        )
+    implementation = _SEMANTIC_VALIDATORS[
+        (binding["validator_id"], binding["validator_version"])
+    ]
+    result = implementation(stage, value)
+    if not isinstance(result, dict):
+        raise MaestroError(
+            "ORCH_SEMANTIC_VALIDATION_FAILED",
+            "The semantic validator did not return a closed result object.",
+        )
+    return binding, result
+
+
+def validate_semantic_result(
+    stage: Mapping[str, Any],
+    value: Any,
+    *,
+    participant_receipt: Mapping[str, Any],
+    completed_at: str,
+) -> tuple[dict[str, Any], dict[str, Any]]:
+    if not isinstance(value, dict) or set(value) != _GENERIC_RESULT_FIELDS:
+        raise MaestroError(
+            "ORCH_PACKET_ADMISSION_FAILED",
+            "Host result does not match the closed generic result contract.",
+        )
+    if value["status"] not in {"completed", "blocked", "failed", "cancelled"}:
+        raise MaestroError(
+            "ORCH_PACKET_ADMISSION_FAILED",
+            "Host result status is invalid.",
+        )
+    claims = value["claims"]
+    if (
+        not isinstance(claims, list)
+        or len(claims) > 64
+        or not all(
+            isinstance(claim, dict)
+            and set(claim) == {"claim_id", "statement", "evidence_refs"}
+            and isinstance(claim["claim_id"], str)
+            and isinstance(claim["statement"], str)
+            and isinstance(claim["evidence_refs"], list)
+            for claim in claims
+        )
+    ):
+        raise MaestroError(
+            "ORCH_PACKET_ADMISSION_FAILED",
+            "Host result claims are invalid.",
+        )
+    claim_ids = [claim["claim_id"] for claim in claims]
+    if len(claim_ids) != len(set(claim_ids)):
+        raise MaestroError(
+            "ORCH_PACKET_ADMISSION_FAILED",
+            "Host result claim IDs must be unique.",
+        )
+    required = stage["output_contract"]["required_claim_ids"]
+    missing = sorted(set(required) - set(claim_ids))
+    if value["status"] == "completed" and missing:
+        raise MaestroError(
+            "ORCH_PACKET_ADMISSION_FAILED",
+            "Completed Host result is missing required claims: " + ", ".join(missing),
+        )
+    for field in (
+        "evidence_refs",
+        "authority_refs",
+        "limitations",
+        "conflicts",
+        "gaps",
+    ):
+        if not isinstance(value[field], list) or len(value[field]) > 64:
+            raise MaestroError(
+                "ORCH_PACKET_ADMISSION_FAILED",
+                f"Host result {field} must be a bounded list.",
+            )
+    require_line(value["return_intent"], field="return_intent", maximum=100)
+    if not isinstance(value["payload"], dict):
+        raise MaestroError(
+            "ORCH_PACKET_ADMISSION_FAILED",
+            "Host result payload must be an object.",
+        )
+    output = stage["output_contract"]
+    validator_binding, validator_result = _execute_semantic_validator(
+        stage,
+        value,
+    )
+    receipt = {
+        "schema_version": SEMANTIC_RECEIPT_VERSION,
+        "receipt_id": "",
+        "validator_id": output["validator_id"],
+        "validator_version": output["validator_version"],
+        "validator_digest": output["validator_digest"],
+        "validator_implementation_digest": validator_binding[
+            "validator_digest"
+        ],
+        "stage_spec_id": stage["stage_spec_id"],
+        "participant_instance_id": participant_receipt[
+            "participant_instance_id"
+        ],
+        "host_receipt_id": participant_receipt["receipt_id"],
+        "status": "PASS",
+        "validated_input_sha256": sha256_text(canonical_json(value)),
+        "validator_result": copy.deepcopy(validator_result),
+        "validator_result_sha256": sha256_text(
+            canonical_json(validator_result)
+        ),
+        "required_claim_ids": list(required),
+        "present_claim_ids": sorted(claim_ids),
+        "validated_at": completed_at,
+    }
+    candidate = copy.deepcopy(receipt)
+    candidate["receipt_id"] = ""
+    receipt["receipt_id"] = sha256_text(canonical_json(candidate))
+    return copy.deepcopy(value), receipt
+
+
+def result_output_schema(stage: Mapping[str, Any]) -> dict[str, Any]:
+    required_claim_ids = stage["output_contract"]["required_claim_ids"]
+    issue_schema = {
+        "type": "object",
+        "additionalProperties": False,
+        "required": ["summary", "evidence_refs"],
+        "properties": {
+            "summary": {"type": "string"},
+            "evidence_refs": {
+                "type": "array",
+                "items": {"type": "string"},
+            },
