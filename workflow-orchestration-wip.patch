+    if not path.exists():
+        return []
+    values: list[dict[str, Any]] = []
+    for number, line in enumerate(
+        path.read_text(encoding="utf-8").splitlines(),
+        start=1,
+    ):
+        try:
+            value = json.loads(line)
+        except json.JSONDecodeError as exc:
+            raise MaestroError(
+                "ORCH_REPLAY_DIVERGENCE",
+                f"Invalid event JSON on line {number}.",
+            ) from exc
+        if not isinstance(value, dict):
+            raise MaestroError(
+                "ORCH_REPLAY_DIVERGENCE",
+                f"Event line {number} is not an object.",
+            )
+        values.append(value)
+    return values
+
+
+def _artifact_path(repo: Path, reference: str) -> Path:
+    return safe_target(repo, reference)
+
+
+@contextmanager
+def _run_store_lock(
+    repo: Path,
+    root_execution_id: str,
+) -> Iterator[None]:
+    """Exclude stale or concurrent writers from one controller event store."""
+
+    if fcntl is None:
+        raise MaestroError(
+            "ORCH_RUNTIME_AUTHORITY_CONFLICT",
+            "The orchestration event store requires an interprocess lock.",
+        )
+    lock_path = safe_target(
+        repo,
+        (
+            ".maestro/state/orchestration/run-locks/"
+            + root_execution_id
+            + ".lock"
+        ),
+    )
+    lock_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    flags = os.O_RDWR | os.O_CREAT
+    if hasattr(os, "O_NOFOLLOW"):
+        flags |= os.O_NOFOLLOW
+    descriptor = os.open(lock_path, flags, 0o600)
+    details = os.fstat(descriptor)
+    if not stat.S_ISREG(details.st_mode) or details.st_nlink != 1:
+        os.close(descriptor)
+        raise MaestroError(
+            "ORCH_RUNTIME_AUTHORITY_CONFLICT",
+            "The orchestration event-store lock is not one regular file.",
+        )
+    try:
+        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    except BlockingIOError as exc:
+        os.close(descriptor)
+        raise MaestroError(
+            "ORCH_RUNTIME_AUTHORITY_CONFLICT",
+            "Another controller instance is updating this run.",
+        ) from exc
+    try:
+        yield
+    finally:
+        fcntl.flock(descriptor, fcntl.LOCK_UN)
+        os.close(descriptor)
+
+
+def validate_implementation_authorization(
+    repo_path: str | Path,
+    definition: Mapping[str, Any],
+    *,
+    root_request_id: str,
+) -> dict[str, Any]:
+    """Validate the exact PlanRevision3 + prior design-gate + scope chain."""
+
+    repo = ensure_repo(repo_path)
+    authorization = definition["authorization"]
+    design_binding = authorization["design_gate"]
+    scope_binding = authorization["scope_judgment"]
+    if (
+        authorization.get("decision_packet_plan_revision") != 3
+        or design_binding.get("decision_packet_plan_revision") != 2
+    ):
+        raise MaestroError(
+            "ORCH_IMPLEMENTATION_AUTHORIZATION_FAILED",
+            "Implementation authorization must bind exact PlanRevision 3 over the PlanRevision 2 design gate.",
+        )
+    decision_path = _artifact_path(
+        repo,
+        authorization["decision_packet_ref"],
+    )
+    design_gate_path = _artifact_path(
+        repo,
+        design_binding["judgment_ref"],
+    )
+    scope_path = _artifact_path(
+        repo,
+        scope_binding["judgment_ref"],
+    )
+    if (
+        file_sha256(decision_path)
+        != authorization["decision_packet_sha256"]
+        or file_sha256(design_gate_path)
+        != design_binding["judgment_sha256"]
+        or file_sha256(scope_path) != scope_binding["judgment_sha256"]
+    ):
+        raise MaestroError(
+            "ORCH_IMPLEMENTATION_AUTHORIZATION_FAILED",
+            "DecisionPacket, design gate, or scope judgment digest is mismatched.",
+        )
+    decision = read_json(decision_path)
+    design_gate = read_json(design_gate_path)
+    scope = read_json(scope_path)
+    decision_root = decision.get("root_binding")
+    decision_choice = decision.get("decision")
+    design_root = design_gate.get("root_binding")
+    design_provenance = design_gate.get("provenance")
+    scope_root = scope.get("root_binding")
+    scope_provenance = scope.get("provenance")
+    scope_decision = scope.get("decision_packet")
+    scope_lineage = scope.get("lineage")
+    prior_revision = design_binding["decision_packet_plan_revision"]
+    revision_history = decision.get("plan_revision_history")
+    prior_history = (
+        next(
+            (
+                item
+                for item in revision_history
+                if isinstance(item, dict)
+                and item.get("plan_revision") == prior_revision
+            ),
+            None,
+        )
+        if isinstance(revision_history, list)
+        else None
+    )
+    scope_correction = decision.get("implementation_scope_correction")
+    root_lineage_fields = ("root_run_id", "observation_id")
+    if any(
+        not isinstance(decision_root, dict)
+        or not isinstance(design_root, dict)
+        or not isinstance(scope_root, dict)
+        or not isinstance(decision_root.get(field), str)
+        or decision_root.get(field) != design_root.get(field)
+        or decision_root.get(field) != scope_root.get(field)
+        for field in root_lineage_fields
+    ):
+        raise MaestroError(
+            "ORCH_IMPLEMENTATION_AUTHORIZATION_FAILED",
+            "Authorization artifacts do not share the exact root run and observation.",
+        )
+    binding_evidence_path = decision_root.get("binding_evidence_path")
+    binding_evidence_sha256 = design_root.get(
+        "binding_evidence_sha256"
+    )
+    if (
+        not isinstance(binding_evidence_path, str)
+        or not binding_evidence_path
+        or design_root.get("binding_evidence_path")
+        != binding_evidence_path
+        or scope_root.get("binding_evidence_path")
+        != binding_evidence_path
+        or not isinstance(binding_evidence_sha256, str)
+        or len(binding_evidence_sha256) != 64
+        or any(
+            character not in "0123456789abcdef"
+            for character in binding_evidence_sha256
+        )
+        or scope_root.get("binding_evidence_sha256")
+        != binding_evidence_sha256
+        or scope_root.get("binding_evidence_integrity_state") != "match"
+    ):
+        raise MaestroError(
+            "ORCH_IMPLEMENTATION_AUTHORIZATION_FAILED",
+            "Authorization artifacts do not bind one integrity-matched root observation.",
+        )
+    if (
+        decision.get("schema_version") != "ApprovedDecisionPacket_v1"
+        or decision.get("plan_revision")
+        != authorization["decision_packet_plan_revision"]
+        or decision.get("prior_decision_sha256")
+        != design_binding["decision_packet_sha256"]
+        or not isinstance(decision_root, dict)
+        or decision_root.get("root_request_id") != root_request_id
+        or not isinstance(decision_choice, dict)
+        or decision_choice.get("owner_policy_choice_remaining") is not False
+        or not isinstance(prior_history, dict)
+        or prior_history.get("decision_sha256")
+        != design_binding["decision_packet_sha256"]
+        or prior_history.get("judgment_path")
+        != design_binding["judgment_ref"]
+        or prior_history.get("judgment_sha256")
+        != design_binding["judgment_sha256"]
+        or prior_history.get("judgment_decision") != "PASS"
+        or prior_history.get("scope")
+        != "preimplementation_design_gate_only"
+        or not isinstance(scope_correction, dict)
+        or scope_correction.get("prior_decision_sha256")
+        != design_binding["decision_packet_sha256"]
+        or scope_correction.get("correction_of_judgment_path")
+        != design_binding["judgment_ref"]
+        or scope_correction.get("correction_of_judgment_sha256")
+        != design_binding["judgment_sha256"]
+        or scope_correction.get("owner_policy_choice_remaining") is not False
+    ):
+        raise MaestroError(
+            "ORCH_IMPLEMENTATION_AUTHORIZATION_FAILED",
+            "The DecisionPacket does not bind the exact prior PASS lineage.",
+        )
+    if (
+        design_gate.get("schema_version")
+        != "PreImplementationCompletionJudgment_v2"
+        or design_gate.get("decision") != design_binding["required_decision"]
+        or design_gate.get("decision_scope")
+        != "preimplementation_design_gate_only"
+        or design_gate.get("decision_packet_sha256")
+        != design_binding["decision_packet_sha256"]
+        or design_gate.get("decision_packet_plan_revision") != prior_revision
+        or not isinstance(design_root, dict)
+        or design_root.get("root_request_id") != root_request_id
+        or not isinstance(design_provenance, dict)
+        or design_provenance.get("source_edit_authority") is not False
+        or design_provenance.get(
+            "identity_distinct_from_decision_resolver"
+        )
+        is not True
+        or "read-only"
+        not in str(design_provenance.get("mode", "")).casefold()
+    ):
+        raise MaestroError(
+            "ORCH_IMPLEMENTATION_AUTHORIZATION_FAILED",
+            "The prior design gate is not the exact identity-distinct read-only PASS.",
+        )
+    design_criteria = design_gate.get("criteria")
+    satisfied_design = {
+        criterion.get("id")
+        for criterion in design_criteria
+        if isinstance(criterion, dict)
+        and criterion.get("state") == "satisfied"
+    } if isinstance(design_criteria, list) else set()
+    if satisfied_design != set(design_binding["criterion_ids"]):
+        raise MaestroError(
+            "ORCH_IMPLEMENTATION_AUTHORIZATION_FAILED",
+            "The prior design gate does not satisfy exactly the CC criterion family.",
+        )
+    if (
+        scope.get("schema_version") != scope_binding["schema_version"]
+        or scope.get("decision") != scope_binding["required_decision"]
+        or scope.get("decision_scope")
+        != "plan_revision_3_bounded_release_manifest_authorization_only"
+        or not isinstance(scope_decision, dict)
+        or scope_decision.get("path")
+        != authorization["decision_packet_ref"]
+        or scope_decision.get("sha256")
+        != authorization["decision_packet_sha256"]
+        or scope_decision.get("plan_revision")
+        != authorization["decision_packet_plan_revision"]
+        or scope_decision.get("packet_id") != decision.get("packet_id")
+        or not isinstance(scope_lineage, dict)
+        or scope_lineage.get("prior_plan_revision") != prior_revision
+        or scope_lineage.get("prior_decision_sha256")
+        != design_binding["decision_packet_sha256"]
+        or scope_lineage.get("prior_judgment_path")
+        != design_binding["judgment_ref"]
+        or scope_lineage.get("prior_judgment_sha256")
+        != design_binding["judgment_sha256"]
+        or scope_lineage.get("prior_judgment_decision") != "PASS"
+        or scope_lineage.get("prior_judgment_scope")
+        != "preimplementation_design_gate_only"
+        or not isinstance(scope_root, dict)
+        or scope_root.get("root_request_id") != root_request_id
+        or not isinstance(scope_provenance, dict)
+        or scope_provenance.get("source_edit_authority") is not False
+        or scope_provenance.get(
+            "identity_distinct_from_decision_resolver"
+        )
+        is not True
+        or scope_provenance.get(
+            "identity_distinct_from_implementation_writer"
+        )
+        is not True
+        or "read-only"
+        not in str(scope_provenance.get("mode", "")).casefold()
+    ):
+        raise MaestroError(
+            "ORCH_IMPLEMENTATION_AUTHORIZATION_FAILED",
+            "The scope judgment does not bind the exact PlanRevision3 authorization chain.",
+        )
+    scope_criteria = scope.get("criteria")
+    satisfied_scope = {
+        criterion.get("id")
+        for criterion in scope_criteria
+        if isinstance(criterion, dict)
+        and criterion.get("state") == "satisfied"
+    } if isinstance(scope_criteria, list) else set()
+    if satisfied_scope != set(scope_binding["criterion_ids"]):
+        raise MaestroError(
+            "ORCH_IMPLEMENTATION_AUTHORIZATION_FAILED",
+            "The scope judgment does not satisfy exactly the ISJ3 criterion family.",
+        )
+    authorized_paths = decision.get("authorized_paths")
+    if not isinstance(authorized_paths, dict):
+        raise MaestroError(
+            "ORCH_IMPLEMENTATION_AUTHORIZATION_FAILED",
+            "DecisionPacket has no exact authorized path registry.",
+        )
+    listed: set[str] = set()
+    for field in (
+        "source_create",
+        "source_modify_if_required",
+        "schema_create",
+        "schema_modify_if_required",
+        "docs_create",
+        "docs_modify",
+        "tests_create",
+        "tests_modify_if_required",
+    ):
+        values = authorized_paths.get(field)
+        if not isinstance(values, list) or not all(
+            isinstance(value, str) for value in values
+        ):
+            raise MaestroError(
+                "ORCH_IMPLEMENTATION_AUTHORIZATION_FAILED",
+                f"DecisionPacket authorized_paths.{field} is invalid.",
+            )
+        listed.update(values)
+    if set(authorization["writer_allowed_paths"]) != listed:
+        raise MaestroError(
+            "ORCH_IMPLEMENTATION_AUTHORIZATION_FAILED",
+            "Workflow writer paths differ from the exact DecisionPacket authorization.",
+        )
+    if checkout_base_revision(repo) != authorization["base_revision"]:
+        raise MaestroError(
+            "ORCH_BASE_REVISION_DRIFT",
+            "Workflow Definition base revision differs from checkout HEAD.",
+        )
+    return {
+        "decision_packet_sha256": authorization["decision_packet_sha256"],
+        "design_gate_judgment_sha256": design_binding["judgment_sha256"],
+        "scope_judgment_sha256": scope_binding["judgment_sha256"],
+        "decision_packet_plan_revision": authorization[
+            "decision_packet_plan_revision"
+        ],
+        "design_gate_plan_revision": prior_revision,
+        "root_request_id": root_request_id,
+        "design_gate": design_binding["required_decision"],
+        "scope_judgment": scope_binding["required_decision"],
+        "identity_distinct": True,
+        "read_only": True,
+    }
+
+
+class OrchestrationController:
+    """Single per-run authority for deterministic DAG progression."""
+
+    def __init__(
+        self,
+        repo_path: str | Path,
+        *,
+        definition: Mapping[str, Any],
+        state: Mapping[str, Any],
+        events: Sequence[Mapping[str, Any]],
+        host_boundary: HostBoundary | None = None,
+        now: Callable[[], str] = _timestamp,
+    ) -> None:
+        self.repo = ensure_repo(repo_path)
+        self.definition = validate_workflow_definition(definition)
+        self.state = copy.deepcopy(dict(state))
+        self.events = [copy.deepcopy(dict(event)) for event in events]
+        self.host_boundary = host_boundary
+        self.now = now
+        self._active_sessions: dict[str, HostSession] = {}
+
+    @property
+    def run_root(self) -> Path:
+        return safe_target(
+            self.repo,
+            (
+                ".maestro/state/orchestration/runs/"
+                + self.state["root_execution_id"]
+            ),
+        )
+
+    @classmethod
+    def start(
+        cls,
+        repo_path: str | Path,
+        *,
+        definition: Mapping[str, Any],
+        root_request_id: str,
+        root_execution_id: str,
+        workflow_instance_id: str,
+        expected_owner_workflow_digest: str | None = None,
+        expected_workflow_policy_digest: str | None = None,
+        expected_workflow_source_binding: Mapping[str, Any] | None = None,
+        flags: Mapping[str, bool] | None = None,
+        host_boundary: HostBoundary | None = None,
+        now: Callable[[], str] = _timestamp,
+    ) -> "OrchestrationController":
+        repo = ensure_repo(repo_path)
+        validated = validate_workflow_definition(definition)
+        validate_owner_workflow_binding(
+            validated,
+            expected_owner_workflow_digest,
+            expected_workflow_policy_digest,
+            expected_workflow_source_binding,
+        )
+        authorization_binding = validate_implementation_authorization(
+            repo,
+            validated,
+            root_request_id=root_request_id,
+        )
+        registered_at = now()
+        register_runtime_authority(
+            repo,
+            root_request_id=root_request_id,
+            root_execution_id=root_execution_id,
+            workflow_instance_id=workflow_instance_id,
+            definition_digest=validated["definition_digest"],
+            registered_at=registered_at,
+        )
+        event = build_event(
+            None,
+            event_type="RUN_STARTED",
+            payload={
+                "definition_id": validated["definition_id"],
+                "definition_revision": validated["definition_revision"],
+                "definition_digest": validated["definition_digest"],
+                "plan_revision": validated["definition_revision"],
+                "flags": dict(flags or {}),
+                "authorization_binding": authorization_binding,
+                "execution_mode": (
+                    "single-context-direct"
+                    if validated["direct_path"]["allowed"]
+                    else "managed-independent"
+                ),
+            },
+            occurred_at=registered_at,
+            root_request_id=root_request_id,
+            root_execution_id=root_execution_id,
+            workflow_instance_id=workflow_instance_id,
+        )
+        state = apply_event(None, event, validated)
+        controller = cls(
+            repo,
+            definition=validated,
+            state=state,
+            events=[event],
+            host_boundary=host_boundary,
+            now=now,
+        )
+        with _run_store_lock(repo, root_execution_id):
+            if controller.run_root.exists():
+                raise MaestroError(
+                    "ORCH_REPLAY_DIVERGENCE",
+                    "The root execution store already exists.",
+                )
+            controller._persist_all()
+        return controller
+
+    @classmethod
+    def resume(
+        cls,
+        repo_path: str | Path,
+        *,
+        root_execution_id: str,
+        host_boundary: HostBoundary | None = None,
+        now: Callable[[], str] = _timestamp,
+    ) -> "OrchestrationController":
+        repo = ensure_repo(repo_path)
+        root = safe_target(
+            repo,
+            f".maestro/state/orchestration/runs/{root_execution_id}",
+        )
+        definition = read_json(root / "definition.json")
+        events = _read_json_lines(root / "events.jsonl")
+        state = replay(definition, events)
+        persisted = read_json(root / "state.json")
+        if canonical_json(state) != canonical_json(persisted):
+            raise MaestroError(
+                "ORCH_REPLAY_DIVERGENCE",
+                "Persisted controller state differs from deterministic replay.",
+            )
+        assert_runtime_authority(
+            repo,
+            root_request_id=state["root_request_id"],
+            root_execution_id=state["root_execution_id"],
+            definition_digest=state["definition_digest"],
+        )
+        return cls(
+            repo,
+            definition=definition,
+            state=state,
+            events=events,
+            host_boundary=host_boundary,
+            now=now,
+        )
+
+    def _persist_all(self) -> None:
+        self.run_root.mkdir(parents=True, exist_ok=True, mode=0o700)
+        atomic_write(
+            self.run_root / "definition.json",
+            (canonical_json(self.definition) + "\n").encode("utf-8"),
+        )
+        atomic_write(
+            self.run_root / "events.jsonl",
+            (
+                "".join(canonical_json(event) + "\n" for event in self.events)
+            ).encode("utf-8"),
+        )
+        atomic_write(
+            self.run_root / "state.json",
+            (canonical_json(self.state) + "\n").encode("utf-8"),
+        )
+        atomic_write(
+            self.run_root / "store.json",
+            (
+                canonical_json(
+                    {
+                        "schema_version": RUN_STORE_VERSION,
+                        "root_request_id": self.state["root_request_id"],
+                        "root_execution_id": self.state[
+                            "root_execution_id"
+                        ],
+                        "workflow_instance_id": self.state[
+                            "workflow_instance_id"
+                        ],
+                        "definition_digest": self.definition[
+                            "definition_digest"
+                        ],
+                        "state_sha256": state_digest(self.state),
+                        "event_count": len(self.events),
+                    }
+                )
+                + "\n"
+            ).encode("utf-8"),
+        )
+
+    def _assert_persisted_head(self) -> None:
+        """Reject a stale in-memory controller before it can append an event."""
+
+        state_path = self.run_root / "state.json"
+        events_path = self.run_root / "events.jsonl"
+        store_path = self.run_root / "store.json"
+        if not state_path.exists() or not events_path.exists() or not store_path.exists():
+            raise MaestroError(
+                "ORCH_REPLAY_DIVERGENCE",
+                "The authoritative orchestration event store is incomplete.",
+            )
+        persisted_state = read_json(state_path)
+        persisted_events = _read_json_lines(events_path)
+        persisted_store = read_json(store_path)
+        if (
+            canonical_json(persisted_state) != canonical_json(self.state)
+            or canonical_json(persisted_events) != canonical_json(self.events)
+            or persisted_store.get("state_sha256") != state_digest(self.state)
+            or persisted_store.get("event_count") != len(self.events)
+        ):
+            raise MaestroError(
+                "ORCH_RUNTIME_AUTHORITY_CONFLICT",
+                "This controller instance is stale relative to the authoritative event store.",
+            )
+
+    def _record(self, event_type: str, payload: Mapping[str, Any]) -> None:
+        if event_type == "CORRECTION_ACCEPTED":
+            stage = stage_specs(self.definition)[payload["stage_spec_id"]]
+            role = role_specs(self.definition)[stage["role_spec_id"]]
+            executor = executor_profiles(self.definition)[
+                role["executor_profile_id"]
+            ]
+            for field in (
+                "original_participant_receipt",
+                "resumed_participant_receipt",
+            ):
+                receipt = payload.get(field)
+                validate_host_receipt(
+                    self.repo,
+                    receipt,
+                    expected_evidence_profile=evidence_profile(
+                        self.definition
+                    ),
+                    expected_root_request_id=self.state[
+                        "root_request_id"
+                    ],
+                    expected_root_execution_id=self.state[
+                        "root_execution_id"
+                    ],
+                    expected_workflow_instance_id=self.state[
+                        "workflow_instance_id"
+                    ],
+                    expected_stage_spec_id=payload.get(
+                        "stage_spec_id"
+                    ),
+                    required_capabilities=role[
+                        "capability_requirements"
+                    ],
+                    require_read_only=role["read_only"],
+                    executor_permissions=executor["permissions"],
+                    executor_tools=executor["tools"],
+                    context_policy=executor["context_policy"],
+                )
+        with _run_store_lock(
+            self.repo,
+            self.state["root_execution_id"],
+        ):
+            self._assert_persisted_head()
+            event = build_event(
+                self.state,
+                event_type=event_type,
+                payload=payload,
+                occurred_at=self.now(),
+                root_request_id=self.state["root_request_id"],
+                root_execution_id=self.state["root_execution_id"],
+                workflow_instance_id=self.state["workflow_instance_id"],
+            )
+            self.state = apply_event(self.state, event, self.definition)
+            self.events.append(event)
+            self._persist_all()
+
+    def _artifact_write(
+        self,
+        kind: str,
+        identity: str,
+        value: Mapping[str, Any],
+    ) -> str:
+        relative = f"{kind}/{identity}.json"
+        target = self.run_root / relative
+        if target.exists():
+            existing = read_json(target)
+            if canonical_json(existing) != canonical_json(value):
+                raise MaestroError(
+                    "ORCH_REPLAY_DIVERGENCE",
+                    f"Immutable {kind} artifact cannot be rebound.",
+                )
+        else:
+            atomic_write(
+                target,
+                (canonical_json(value) + "\n").encode("utf-8"),
+            )
+        return relative
+
+    def _packet_by_digest(self, digest: str) -> dict[str, Any]:
+        target = self.run_root / "packets" / f"{digest}.json"
+        packet = read_json(target)
+        if (
+            not isinstance(packet, dict)
+            or packet.get("packet_digest") != digest
+            or packet_content_digest(packet) != digest
+        ):
+            raise MaestroError(
+                "ORCH_PACKET_ADMISSION_FAILED",
+                "Stored Packet filename, embedded digest, and content address differ.",
+            )
+        return packet
+
+    def _participant_receipt_for_packet(
+        self,
+        packet: Mapping[str, Any],
+    ) -> dict[str, Any]:
+        context_receipt_id = packet.get("context_receipt_id")
+        context_receipt_digest = packet.get("context_receipt_digest")
+        if not isinstance(context_receipt_id, str):
+            raise MaestroError(
+                "ORCH_CORRECTION_PRODUCER_MISMATCH",
+                "Packet does not bind explicit context evidence.",
+            )
+        target = (
+            self.run_root
+            / "context-receipts"
+            / f"{context_receipt_id}.json"
+        )
+        stage = stage_specs(self.definition)[packet["stage_spec_id"]]
+        role = role_specs(self.definition)[packet["role_spec_id"]]
+        executor = executor_profiles(self.definition)[
+            role["executor_profile_id"]
+        ]
+        receipt = validate_context_evidence(
+            self.repo,
+            read_json(target),
+            expected_evidence_profile=evidence_profile(self.definition),
+            expected_root_request_id=self.state["root_request_id"],
+            expected_root_execution_id=self.state["root_execution_id"],
+            expected_workflow_instance_id=self.state[
+                "workflow_instance_id"
+            ],
+            expected_stage_spec_id=packet["stage_spec_id"],
+            expected_role_spec_id=stage["role_spec_id"],
+            expected_attempt_id=packet["attempt_id"],
+            required_capabilities=role["capability_requirements"],
+            require_read_only=role["read_only"],
+            executor_permissions=executor["permissions"],
+            executor_tools=executor["tools"],
+            context_policy=executor["context_policy"],
+        )
+        if (
+            context_receipt_digest != host_receipt_digest(receipt)
+            or receipt["receipt_id"] != context_receipt_id
+            or receipt["participant_instance_id"]
+            != packet["producer_participant_instance_id"]
+            or receipt["producer_principal_id"]
+            != packet["producer_principal_id"]
+            or receipt["context_instance_id"]
+            != packet["producer_context_instance_id"]
+            or receipt["capability_lease_id"]
+            != packet["capability_lease_id"]
+        ):
+            raise MaestroError(
+                "ORCH_CORRECTION_PRODUCER_MISMATCH",
+                "Packet context evidence binding is mismatched.",
+            )
+        return receipt
+
+    def _attempt_receipt_for_packet(
+        self,
+        packet: Mapping[str, Any],
+        *,
+        context_receipt: Mapping[str, Any],
+    ) -> dict[str, Any]:
+        receipt_id = packet.get("attempt_receipt_id")
+        receipt_digest = packet.get("attempt_receipt_digest")
+        if not isinstance(receipt_id, str):
+            raise MaestroError(
+                "ORCH_CORRECTION_TARGET_PACKET_MISMATCH",
+                "Packet does not bind explicit attempt evidence.",
+            )
+        target = (
+            self.run_root
+            / "attempt-receipts"
+            / f"{receipt_id}.json"
+        )
+        if not target.is_file():
+            raise MaestroError(
+                "ORCH_CORRECTION_TARGET_PACKET_MISMATCH",
+                "Packet attempt evidence is unavailable.",
+            )
+        receipt = validate_attempt_evidence(
+            self.repo,
+            read_json(target),
+            context_receipt=context_receipt,
+            expected_evidence_profile=evidence_profile(self.definition),
+            expected_root_request_id=self.state["root_request_id"],
+            expected_root_execution_id=self.state["root_execution_id"],
+            expected_workflow_instance_id=self.state[
+                "workflow_instance_id"
+            ],
+            expected_stage_spec_id=packet["stage_spec_id"],
+            expected_role_spec_id=packet["role_spec_id"],
+            expected_attempt_id=packet["attempt_id"],
+            expected_input_projection_sha256=packet[
+                "input_projection_sha256"
+            ],
+        )
+        if (
+            receipt.get("receipt_id") != receipt_id
+            or host_receipt_digest(receipt) != receipt_digest
+        ):
+            raise MaestroError(
+                "ORCH_CORRECTION_TARGET_PACKET_MISMATCH",
+                "Packet attempt evidence binding is mismatched.",
+            )
+        semantic_matches = []
+        semantic_root = self.run_root / "semantic-receipts"
+        if semantic_root.exists():
+            for path in sorted(semantic_root.glob("*.json")):
+                candidate = read_json(path)
+                if (
+                    semantic_receipt_digest(candidate)
+                    == packet.get("validation_receipt_digest")
+                ):
+                    semantic_matches.append(candidate)
+        if (
+            len(semantic_matches) != 1
+            or receipt["semantic_validation_receipt_id"]
+            != semantic_matches[0].get("receipt_id")
+        ):
+            raise MaestroError(
+                "ORCH_CORRECTION_TARGET_PACKET_MISMATCH",
+                "Attempt evidence does not bind the Packet semantic receipt.",
+            )
+        return receipt
+
+    def _settle_inactive(self) -> bool:
+        changed = False
+        stages = stage_specs(self.definition)
+        for stage_id, stage in sorted(stages.items()):
+            runtime = self.state["stage_states"][stage_id]
+            dependencies_settled = all(
+                self.state["stage_states"][dependency]["status"]
+                in {"completed", "skipped"}
+                for dependency in stage["dependencies"]
+            )
+            if (
+                runtime["status"] == "pending"
+                and dependencies_settled
+                and not condition_active(stage["condition"], self.state)
+            ):
+                self._record(
+                    "STAGE_SKIPPED",
+                    {
+                        "stage_spec_id": stage_id,
+                        "condition": copy.deepcopy(stage["condition"]),
+                    },
+                )
+                changed = True
+        return changed
+
+    def _new_attempt(
+        self,
+        stage_id: str,
+        *,
+        semantic_generation: int | None = None,
+    ) -> dict[str, Any]:
+        runtime = self.state["stage_states"][stage_id]
+        stage = stage_specs(self.definition)[stage_id]
+        generation = (
+            runtime["semantic_generation"]
+            if semantic_generation is None
+            else semantic_generation
+        )
+        if (
+            not isinstance(generation, int)
+            or generation < runtime["semantic_generation"]
+            or generation > runtime["semantic_generation"] + 1
+        ):
+            raise MaestroError(
+                "ORCH_CORRECTION_TARGET_GENERATION_MISMATCH",
+                "Attempt generation must be current or the next correction generation.",
+            )
+        ordinal = len(runtime["attempt_ids"]) + 1
+        seed = sha256_text(
+            canonical_json(
+                {
+                    "root_execution_id": self.state["root_execution_id"],
+                    "stage_spec_id": stage_id,
+                    "semantic_generation": generation,
+                    "transport_attempt_ordinal": ordinal,
+                }
+            )
+        )
+        return {
+            "attempt_id": f"attempt-{seed[:40]}",
+            "assignment_id": (
+                f"assignment-{stage_id}-g{generation}"
+            ),
+            "stage_spec_id": stage_id,
+            "role_spec_id": runtime["role_spec_id"],
+            "semantic_generation": generation,
+            "transport_attempt_ordinal": ordinal,
+            "status": "requested",
+            "dispatch_idempotency_key": f"dispatch-{seed}",
+            "writer_lineage_id": (
+                (
+                    "writer-lineage-"
+                    + sha256_text(
+                        canonical_json(
+                            {
+                                "root_execution_id": self.state[
+                                    "root_execution_id"
+                                ],
+                                "role_spec_id": stage["role_spec_id"],
+                            }
+                        )
+                    )[:40]
+                )
+                if stage["side_effect"] == "repository_mutation"
+                else None
+            ),
+            "requested_at": self.now(),
+        }
+
+    def _acquire_wave(
+        self,
+        wave: Sequence[str],
+    ) -> tuple[dict[str, HostSession], dict[str, dict[str, Any]]]:
+        # Authenticate all admitted post-turn evidence before opening another
+        # Host. A corrupt historical attempt must never be discovered only
+        # after the next turn has already produced effects.
+        self._admitted_attempt_receipts_by_role()
+        sessions: dict[str, HostSession] = {}
+        attempts: dict[str, dict[str, Any]] = {}
+        wave_role_ids = [
+            stage_specs(self.definition)[stage_id]["role_spec_id"]
+            for stage_id in wave
+        ]
+        if len(wave_role_ids) != len(set(wave_role_ids)):
+            raise MaestroError(
+                "ORCH_CONCURRENT_ROLE_COLLISION",
+                "One dispatch wave cannot contain multiple StageSpecs for one RoleSpec.",
+            )
+        receipts_by_role = self._admitted_context_receipts_by_role()
+        boundary = self.host_boundary
+        if boundary is None:
+            boundary = CodexHostBoundary(self.repo)
+            self.host_boundary = boundary
+        try:
+            for stage_id in wave:
+                attempt = self._new_attempt(stage_id)
+                session = boundary.acquire(
+                    definition=self.definition,
+                    state=self.state,
+                    stage_spec_id=stage_id,
+                    attempt_id=attempt["attempt_id"],
+                )
+                sessions[stage_id] = session
+                stage = stage_specs(self.definition)[stage_id]
+                role = role_specs(self.definition)[stage["role_spec_id"]]
+                executor = executor_profiles(self.definition)[
+                    role["executor_profile_id"]
+                ]
+                receipt = validate_host_receipt(
+                    self.repo,
+                    session.participant_receipt,
+                    expected_evidence_profile=evidence_profile(
+                        self.definition
+                    ),
+                    expected_root_request_id=self.state["root_request_id"],
+                    expected_root_execution_id=self.state[
+                        "root_execution_id"
+                    ],
+                    expected_workflow_instance_id=self.state[
+                        "workflow_instance_id"
+                    ],
+                    expected_stage_spec_id=stage_id,
+                    expected_role_spec_id=stage["role_spec_id"],
+                    expected_attempt_id=attempt["attempt_id"],
+                    required_capabilities=role["capability_requirements"],
+                    require_read_only=role["read_only"],
+                    executor_permissions=executor["permissions"],
+                    executor_tools=executor["tools"],
+                    context_policy=executor["context_policy"],
+                )
+                session.participant_receipt = receipt
+                attempts[stage_id] = attempt
+                self._artifact_write(
+                    (
+                        "context-receipts"
+                        if receipt["schema_version"]
+                        == CONTEXT_EVIDENCE_VERSION
+                        else "host-receipts"
+                    ),
+                    receipt["receipt_id"],
+                    receipt,
+                )
+            for stage_id, session in sessions.items():
+                receipt = session.participant_receipt
+                receipts_by_role.setdefault(
+                    receipt["role_spec_id"],
+                    [],
+                ).append(receipt)
+            validate_independence(self.definition, receipts_by_role)
+            for stage_id, session in sessions.items():
+                receipt = session.participant_receipt
+                if (
+                    self.definition["risk_level"] in {"high", "critical"}
+                    and receipt["issued_by"]
+                    in {"current_host", "shared_main_context"}
+                ):
+                    raise MaestroError(
+                        "HPC_CURRENT_HOST_FORBIDDEN",
+                        "High-risk managed execution cannot import current_host authority.",
+                    )
+                context_v2 = (
+                    receipt["schema_version"] == CONTEXT_EVIDENCE_VERSION
+                )
+                receipt_digest_field = (
+                    "context_receipt_digest"
+                    if context_v2
+                    else "host_receipt_digest"
+                )
+                self._record(
+                    (
+                        "CONTEXT_EVIDENCE_COLLECTED"
+                        if context_v2
+                        else "CAPABILITY_LEASED"
+                    ),
+                    {
+                        "stage_spec_id": stage_id,
+                        "participant_instance_id": receipt[
+                            "participant_instance_id"
+                        ],
+                        receipt_digest_field: host_receipt_digest(receipt),
+                        "participant": {
+                            "participant_instance_id": receipt[
+                                "participant_instance_id"
+                            ],
+                            "role_spec_id": receipt["role_spec_id"],
+                            "producer_principal_id": receipt[
+                                "producer_principal_id"
+                            ],
+                            "context_instance_id": receipt[
+                                "context_instance_id"
+                            ],
+                            "capability_lease_id": receipt[
+                                "capability_lease_id"
+                            ],
+                            "read_only": receipt["read_only"],
+                            "issued_by": receipt["issued_by"],
+                            "host_receipt_digest": host_receipt_digest(
+                                receipt
+                            ),
+                            "resumption": copy.deepcopy(
+                                receipt["resumption"]
+                            ),
+                            "observation_sources": copy.deepcopy(
+                                receipt["observation_sources"]
+                            ),
+                            "metadata": copy.deepcopy(receipt["metadata"]),
+                        },
+                    },
+                )
+            return sessions, attempts
+        except Exception:
+            for session in sessions.values():
+                session.close()
+            raise
+
+    def _admitted_packets(self) -> list[dict[str, Any]]:
+        packets: list[dict[str, Any]] = []
+        seen: set[str] = set()
+        for event in self.events:
+            event_type = event.get("event_type")
+            if event_type not in {
+                "PACKET_ACCEPTED",
+                "CORRECTION_ACCEPTED",
+            }:
+                continue
+            payload = event.get("payload")
+            embedded_packet = (
+                payload.get("response_packet")
+                if event_type == "CORRECTION_ACCEPTED"
+                and isinstance(payload, dict)
+                else None
+            )
+            digest = (
+                embedded_packet.get("packet_digest")
+                if isinstance(embedded_packet, dict)
+                else (
+                    payload.get("packet_digest")
+                    if isinstance(payload, dict)
+                    else None
+                )
+            )
+            if not isinstance(digest, str) or digest in seen:
+                if digest in seen:
+                    continue
+                raise MaestroError(
+                    "ORCH_PACKET_ADMISSION_FAILED",
+                    "Accepted Packet event lacks a usable Packet digest.",
+                )
+            packet = self._packet_by_digest(digest)
+            if (
+                embedded_packet is not None
+                and canonical_json(embedded_packet)
+                != canonical_json(packet)
+            ):
+                raise MaestroError(
+                    "ORCH_PACKET_ADMISSION_FAILED",
+                    "Correction event and immutable response Packet differ.",
+                )
+            if event_type == "CORRECTION_ACCEPTED":
+                seen.add(digest)
+                packets.append(packet)
+                continue
+            event_bindings = {
+                "packet_id": "packet_id",
+                "stage_spec_id": "stage_spec_id",
+                "role_spec_id": "role_spec_id",
+                "attempt_id": "attempt_id",
+                "semantic_generation": "semantic_generation",
+                "context_receipt_id": "context_receipt_id",
+                "context_receipt_digest": "context_receipt_digest",
+                "attempt_receipt_id": "attempt_receipt_id",
+                "attempt_receipt_digest": "attempt_receipt_digest",
+                "validation_receipt_digest": "validation_receipt_digest",
+            }
+            if any(
+                payload.get(event_field) != packet.get(packet_field)
+                for event_field, packet_field in event_bindings.items()
+            ):
+                raise MaestroError(
+                    "ORCH_PACKET_ADMISSION_FAILED",
+                    "Accepted Packet event and immutable Packet differ.",
+                )
+            seen.add(digest)
+            packets.append(packet)
+        return packets
+
+    def _admitted_context_receipts_by_role(
+        self,
+    ) -> dict[str, list[dict[str, Any]]]:
+        result: dict[str, list[dict[str, Any]]] = {}
+        for packet in self._admitted_packets():
+            receipt = self._participant_receipt_for_packet(packet)
+            result.setdefault(packet["role_spec_id"], []).append(receipt)
+        return result
+
+    def _admitted_attempt_receipts_by_role(
+        self,
+    ) -> dict[str, list[dict[str, Any]]]:
+        result: dict[str, list[dict[str, Any]]] = {}
+        for packet in self._admitted_packets():
+            context = self._participant_receipt_for_packet(packet)
+            receipt = self._attempt_receipt_for_packet(
+                packet,
+                context_receipt=context,
+            )
+            result.setdefault(packet["role_spec_id"], []).append(receipt)
+        return result
+
+    def _prepare_dispatch(
+        self,
+        stage_id: str,
+        session: HostSession,
+        attempt: Mapping[str, Any],
+    ) -> tuple[dict[str, Any], str]:
+        predecessor_packets = {
+            summary["packet_digest"]: self._packet_by_digest(
+                summary["packet_digest"]
+            )
+            for summary in self.state["packets"].values()
+        }
+        projection = stage_input_projection(
+            definition=self.definition,
+            state=self.state,
+            stage_spec_id=stage_id,
+            predecessor_packets=predecessor_packets,
+        )
+        projection_sha256 = projection["projection_sha256"]
+        self._artifact_write(
+            "projections",
+            projection_sha256,
+            projection,
+        )
+        self._record(
+            "DISPATCH_REQUESTED",
+            {
+                "stage_spec_id": stage_id,
+                "attempt_id": attempt["attempt_id"],
+                "attempt": copy.deepcopy(dict(attempt)),
+                "participant_instance_id": session.participant_receipt[
+                    "participant_instance_id"
+                ],
+                "input_projection_sha256": projection_sha256,
+            },
+        )
+        self._record(
+            "ATTEMPT_STARTED",
+            {
+                "stage_spec_id": stage_id,
+                "attempt_id": attempt["attempt_id"],
+                "effect_state": "not_started",
+            },
+        )
+        self._active_sessions[stage_id] = session
+        return projection, projection_sha256
+
+    def _dispatch_one(
+        self,
+        stage_id: str,
+        session: HostSession,
+        projection: Mapping[str, Any],
+        projection_sha256: str,
+    ) -> HostDispatchOutcome:
+        return session.dispatch(
+            projection=projection,
+            input_projection_sha256=projection_sha256,
+        )
+
+    def _admit_outcome(
+        self,
+        *,
+        stage_id: str,
+        attempt: Mapping[str, Any],
+        session: HostSession,
+        projection_sha256: str,
+        outcome: HostDispatchOutcome,
+    ) -> None:
+        attempt_evidence = validate_attempt_evidence(
+            self.repo,
+            outcome.completion_receipt,
+            context_receipt=session.participant_receipt,
+            expected_evidence_profile=evidence_profile(self.definition),
+            expected_root_request_id=self.state["root_request_id"],
+            expected_root_execution_id=self.state["root_execution_id"],
+            expected_workflow_instance_id=self.state[
+                "workflow_instance_id"
+            ],
+            expected_stage_spec_id=stage_id,
+            expected_role_spec_id=stage_specs(self.definition)[stage_id][
+                "role_spec_id"
+            ],
+            expected_attempt_id=attempt["attempt_id"],
+            expected_input_projection_sha256=projection_sha256,
+        )
+        self._artifact_write(
+            "semantic-receipts",
+            outcome.semantic_validation_receipt["receipt_id"],
+            outcome.semantic_validation_receipt,
+        )
+        self._artifact_write(
+            "attempt-receipts",
+            attempt_evidence["receipt_id"],
+            attempt_evidence,
+        )
+        if outcome.result["status"] != "completed":
+            self._record(
+                "STAGE_BLOCKED",
+                {
+                    "stage_spec_id": stage_id,
+                    "code": "ORCH_STAGE_RETURNED_" + outcome.result[
+                        "status"
+                    ].upper(),
+                    "recovery_kind": "typed_return",
+                    "evidence_refs": outcome.result["evidence_refs"],
+                },
+            )
+            return
+        payload_ref = (
+            "payloads/"
+            + sha256_text(canonical_json(outcome.result["payload"]))
+            + ".json"
+        )
+        packet, payload = build_packet(
+            repo_path=self.repo,
+            definition=self.definition,
+            state=self.state,
+            stage_spec_id=stage_id,
+            attempt_id=attempt["attempt_id"],
+            participant_receipt=session.participant_receipt,
+            result=outcome.result,
+            semantic_validation_receipt=outcome.semantic_validation_receipt,
+            attempt_receipt=attempt_evidence,
+            input_projection_sha256=projection_sha256,
+            payload_ref=payload_ref,
+            produced_at=outcome.completion_receipt["completed_at"],
+            base_revision=self.definition["authorization"]["base_revision"],
+        )
+        self._artifact_write(
+            "payloads",
+            packet["payload_sha256"],
+            payload,
+        )
+        self._artifact_write(
+            "packets",
+            packet["packet_digest"],
+            packet,
+        )
+        role = role_specs(self.definition)[
+            stage_specs(self.definition)[stage_id]["role_spec_id"]
+        ]
+        repair_request: tuple[str, list[str], list[str]] | None = None
+        if role["verifier"] and outcome.result["return_intent"] == "repair":
+            repair = outcome.result["payload"]
+            if (
+                repair.get("verdict") != "REJECT_REPAIRABLE"
+                or not isinstance(repair.get("claim_ids"), list)
+                or not isinstance(repair.get("paths"), list)
+            ):
+                raise MaestroError(
+                    "ORCH_PACKET_ADMISSION_FAILED",
+                    "Verifier repair return lacks a typed verdict, claim scope, or path scope.",
+                )
+            mutation_stages = [
+                candidate_id
+                for candidate_id, candidate in stage_specs(
+                    self.definition
+                ).items()
+                if candidate["side_effect"] == "repository_mutation"
+            ]
+            if len(mutation_stages) != 1:
+                raise MaestroError(
+                    "ORCH_WRITER_FENCE_CONFLICT",
+                    "Verifier repair requires exactly one mutation StageSpec.",
+                )
+            repair_request = (
+                mutation_stages[0],
+                list(repair["claim_ids"]),
+                list(repair["paths"]),
+            )
+        self._record(
+            "PACKET_ACCEPTED",
+            {
+                "stage_spec_id": stage_id,
+                "packet_id": packet["packet_id"],
+                "packet_digest": packet["packet_digest"],
+                "semantic_generation": packet["semantic_generation"],
+                "stage_instance_id": packet["stage_instance_id"],
+                "role_spec_id": packet["role_spec_id"],
+                "producer_participant_instance_id": packet[
+                    "producer_participant_instance_id"
+                ],
+                "producer_principal_id": packet[
+                    "producer_principal_id"
+                ],
+                "producer_context_instance_id": packet[
+                    "producer_context_instance_id"
+                ],
+                "attempt_id": attempt["attempt_id"],
+                "validation_receipt_digest": packet[
+                    "validation_receipt_digest"
+                ],
+                "context_receipt_id": packet["context_receipt_id"],
+                "context_receipt_digest": packet[
+                    "context_receipt_digest"
+                ],
+                "attempt_receipt_id": packet["attempt_receipt_id"],
+                "attempt_receipt_digest": packet[
+                    "attempt_receipt_digest"
+                ],
+                "claim_ids": [
+                    claim["claim_id"] for claim in packet["claims"]
+                ],
+                "effect_state": outcome.effect_state,
+            },
+        )
+        if repair_request is not None:
+            self.request_writer_repair(
+                stage_spec_id=repair_request[0],
+                claim_ids=repair_request[1],
+                paths=repair_request[2],
+                verifier_packet_digest=packet["packet_digest"],
+            )
+
+    def _record_failure(
+        self,
+        *,
+        stage_id: str,
+        attempt: Mapping[str, Any],
+        error: Exception,
+    ) -> None:
+        stage = stage_specs(self.definition)[stage_id]
+        code = (
+            error.code
+            if isinstance(error, MaestroError)
+            else "ORCH_HOST_ATTEMPT_FAILED"
+        )
+        semantic = (
+            code != "ORCH_ATTEMPT_EVIDENCE_MISSING"
+            and code.startswith(_SEMANTIC_FAILURE_PREFIXES)
+        )
+        nonretryable_host_effect = code.startswith(
+            _NONRETRYABLE_HOST_EFFECT_PREFIXES
+        )
+        mutation = stage["side_effect"] == "repository_mutation"
+        attempts_used = len(
+            self.state["stage_states"][stage_id]["attempt_ids"]
+        )
+        retry_limit = stage["max_transport_retries"]
+        if mutation:
+            self._record(
+                "RECONCILIATION_REQUIRED",
+                {
+                    "stage_spec_id": stage_id,
+                    "attempt_id": attempt["attempt_id"],
+                    "code": code,
+                    "evidence_refs": [f"error:{code}"],
+                },
+            )
+        elif nonretryable_host_effect:
+            self._record(
+                "STAGE_BLOCKED",
+                {
+                    "stage_spec_id": stage_id,
+                    "code": code,
+                    "recovery_kind": "host_quiescence",
+                    "evidence_refs": [f"error:{code}"],
+                },
+            )
+        elif semantic:
+            self._record(
+                "PACKET_REJECTED",
+                {
+                    "stage_spec_id": stage_id,
+                    "attempt_id": attempt["attempt_id"],
+                    "code": code,
+                    "evidence_refs": [f"error:{code}"],
+                },
+            )
+        else:
+            self._record(
+                "ATTEMPT_FAILED",
+                {
+                    "stage_spec_id": stage_id,
+                    "attempt_id": attempt["attempt_id"],
+                    "code": code,
+                    "recovery_kind": "transport_retry",
+                    "retry_allowed": attempts_used <= retry_limit,
+                    "evidence_refs": [f"error:{code}"],
+                },
+            )
+
+    def _dispatch_wave(self, wave: Sequence[str]) -> None:
+        sessions, attempts = self._acquire_wave(wave)
+        prepared: dict[str, tuple[dict[str, Any], str]] = {}
+        fences: dict[str, CheckoutWriterFence] = {}
+        try:
+            for stage_id in wave:
+                session = sessions[stage_id]
+                stage = stage_specs(self.definition)[stage_id]
+                if stage["side_effect"] == "repository_mutation":
+                    fence = CheckoutWriterFence(
+                        self.repo,
+                        root_execution_id=self.state[
+                            "root_execution_id"
+                        ],
+                        stage_instance_id=(
+                            f"{stage_id}:g"
+                            f"{self.state['stage_states'][stage_id]['semantic_generation']}"
+                        ),
+                        participant_instance_id=session.participant_receipt[
+                            "participant_instance_id"
+                        ],
+                        allowed_paths=self.definition["authorization"][
+                            "writer_allowed_paths"
+                        ],
+                        expected_base_revision=self.definition[
+                            "authorization"
+                        ]["base_revision"],
+                        acquired_at=self.now(),
+                    )
+                    fence.acquire()
+                    fences[stage_id] = fence
+                prepared[stage_id] = self._prepare_dispatch(
+                    stage_id,
+                    session,
+                    attempts[stage_id],
+                )
+            results: dict[str, HostDispatchOutcome | Exception] = {}
+            if len(wave) > 1:
+                with ThreadPoolExecutor(max_workers=len(wave)) as pool:
+                    futures = {
+                        pool.submit(
+                            self._dispatch_one,
+                            stage_id,
+                            sessions[stage_id],
+                            prepared[stage_id][0],
+                            prepared[stage_id][1],
+                        ): stage_id
+                        for stage_id in wave
+                    }
+                    for future in as_completed(futures):
+                        stage_id = futures[future]
+                        try:
+                            results[stage_id] = future.result()
+                        except Exception as exc:  # captured as typed event
+                            results[stage_id] = exc
+            else:
+                stage_id = wave[0]
+                try:
+                    results[stage_id] = self._dispatch_one(
+                        stage_id,
+                        sessions[stage_id],
+                        prepared[stage_id][0],
+                        prepared[stage_id][1],
+                    )
+                except Exception as exc:  # captured as typed event
+                    results[stage_id] = exc
+            attempt_receipts_by_role = (
+                self._admitted_attempt_receipts_by_role()
+            )
+            prior_completed_role_ids = set(
+                attempt_receipts_by_role
+            )
+            current_wave_role_ids = {
+                stage_specs(self.definition)[stage_id]["role_spec_id"]
+                for stage_id in wave
+            }
+            fresh_current_role_ids: set[str] = set()
+            for stage_id, result in results.items():
+                if isinstance(result, HostDispatchOutcome):
+                    validated_attempt = validate_attempt_evidence(
+                        self.repo,
+                        result.completion_receipt,
+                        context_receipt=sessions[
+                            stage_id
+                        ].participant_receipt,
+                        expected_evidence_profile=evidence_profile(
+                            self.definition
+                        ),
+                        expected_root_request_id=self.state[
+                            "root_request_id"
+                        ],
+                        expected_root_execution_id=self.state[
+                            "root_execution_id"
+                        ],
+                        expected_workflow_instance_id=self.state[
+                            "workflow_instance_id"
+                        ],
+                        expected_stage_spec_id=stage_id,
+                        expected_role_spec_id=stage_specs(
+                            self.definition
+                        )[stage_id]["role_spec_id"],
+                        expected_attempt_id=attempts[stage_id][
+                            "attempt_id"
+                        ],
+                        expected_input_projection_sha256=prepared[
+                            stage_id
+                        ][1],
+                    )
+                    role_id = validated_attempt["role_spec_id"]
+                    attempt_receipts_by_role.setdefault(
+                        role_id,
+                        [],
+                    ).append(validated_attempt)
+                    fresh_current_role_ids.add(role_id)
+            try:
+                validate_attempt_independence(
+                    self.definition,
+                    attempt_receipts_by_role,
+                    current_wave_role_ids=sorted(
+                        current_wave_role_ids
+                    ),
+                    prior_completed_role_ids=sorted(
+                        prior_completed_role_ids
+                    ),
+                    fresh_current_role_ids=sorted(
+                        fresh_current_role_ids
+                    ),
+                )
+            except MaestroError as exc:
+                for stage_id, result in list(results.items()):
+                    if isinstance(result, HostDispatchOutcome):
+                        results[stage_id] = exc
+            for stage_id in sorted(wave):
+                result = results[stage_id]
+                if isinstance(result, Exception):
+                    self._record_failure(
+                        stage_id=stage_id,
+                        attempt=attempts[stage_id],
+                        error=result,
+                    )
+                    continue
+                try:
+                    fence = fences.get(stage_id)
+                    if fence is not None:
+                        effect = fence.effect_receipt(
+                            completion_receipt=result.completion_receipt,
+                            observed_at=self.now(),
+                        )
+                        self._artifact_write(
+                            "effect-receipts",
+                            effect["effect_receipt_id"],
+                            effect,
+                        )
+                    self._admit_outcome(
+                        stage_id=stage_id,
+                        attempt=attempts[stage_id],
+                        session=sessions[stage_id],
+                        projection_sha256=prepared[stage_id][1],
+                        outcome=result,
+                    )
+                except Exception as exc:
+                    self._record_failure(
+                        stage_id=stage_id,
+                        attempt=attempts[stage_id],
+                        error=exc,
+                    )
+        finally:
+            for stage_id, fence in fences.items():
+                fence.release(released_at=self.now())
+            for stage_id, session in sessions.items():
+                session.close()
+                self._active_sessions.pop(stage_id, None)
+
+    def progress(self, *, max_waves: int | None = None) -> dict[str, Any]:
+        assert_runtime_authority(
+            self.repo,
+            root_request_id=self.state["root_request_id"],
+            root_execution_id=self.state["root_execution_id"],
+            definition_digest=self.definition["definition_digest"],
+        )
+        completed_waves = 0
+        while self.state["status"] == "running":
+            self._settle_inactive()
+            checkpoint = next_reached_owner_checkpoint(
+                self.definition,
+                self.state,
+            )
+            if checkpoint is not None:
+                request = build_owner_checkpoint_request(
+                    definition=self.definition,
+                    state=self.state,
+                    workflow_step_id=checkpoint["step_id"],
+                    checkpoint_digest=state_digest(self.state),
+                )
+                self._record(
+                    "DECISION_REQUESTED",
+                    {
+                        "decision_id": request["decision_id"],
+                        "request": request,
+                    },
+                )
+                break
+            ready = deterministic_ready_set(self.definition, self.state)
+            for stage_id in ready:
+                self._record("STAGE_READY", {"stage_spec_id": stage_id})
+            waves = dispatch_waves(self.definition, self.state)
+            if not waves:
+                if active_terminal_candidate(self.definition, self.state):
+                    self._record(
+                        "RUN_TERMINAL_CANDIDATE",
+                        {
+                            "state_sha256": state_digest(self.state),
+                            "terminal_authority": "candidate-only",
+                            "outcome_judge_mode": self.definition[
+                                "outcome_judge_mode"
+                            ],
+                        },
+                    )
+                elif any(
+                    runtime["status"] in {"blocked", "reconciling"}
+                    for runtime in self.state["stage_states"].values()
+                ):
+                    self._record(
+                        "RUN_BLOCKED",
+                        {
+                            "reason": "one-or-more-stages-blocked",
+                            "state_sha256": state_digest(self.state),
+                        },
+                    )
+                break
+            for wave in waves:
+                if max_waves is not None and completed_waves >= max_waves:
+                    return self.status()
+                try:
+                    self._dispatch_wave(wave)
+                except MaestroError as exc:
+                    if exc.code not in {
+                        "HPC_CURRENT_HOST_FORBIDDEN",
+                        "ORCH_MANDATORY_CAPABILITY_UNAVAILABLE",
+                        "ORCH_STRICT_PRINCIPAL_UNAVAILABLE",
+                        "ORCH_HOST_SELF_ATTESTATION_FORBIDDEN",
+                        "ORCH_HOST_RETURNED_BOUNDARY_MISMATCH",
+                        "CODEX_HOST_SCOPED_SANDBOX_UNAVAILABLE",
+                        "CODEX_HOST_SCOPED_SANDBOX_MISMATCH",
+                    }:
+                        raise
+                    for stage_id in wave:
+                        runtime = self.state["stage_states"][stage_id]
+                        if runtime["status"] in {
+                            "pending",
+                            "ready",
+                            "dispatching",
+                            "running",
+                        }:
+                            self._record(
+                                "STAGE_BLOCKED",
+                                {
+                                    "stage_spec_id": stage_id,
+                                    "code": exc.code,
+                                    "recovery_kind": (
+                                        "capability_acquisition"
+                                    ),
+                                    "evidence_refs": [
+                                        f"host-capability:{exc.code}"
+                                    ],
+                                },
+                            )
+                completed_waves += 1
+                if self.state["status"] != "running":
+                    break
+        return self.status()
+
+    def cancel(self, *, stage_spec_id: str, reason: str) -> dict[str, Any]:
+        runtime = self.state["stage_states"].get(stage_spec_id)
+        if not isinstance(runtime, dict):
+            raise MaestroError(
+                "ORCH_STAGE_INVALID",
+                "Cancellation references an unknown StageSpec.",
+            )
+        self._record(
+            "CANCELLATION_REQUESTED",
+            {
+                "stage_spec_id": stage_spec_id,
+                "reason": reason,
+            },
+        )
+        session = self._active_sessions.get(stage_spec_id)
+        if session is None:
+            effect_state = (
+                "unknown"
+                if stage_specs(self.definition)[stage_spec_id][
+                    "side_effect"
+                ]
+                == "repository_mutation"
+                else "no-writes"
+            )
+            acknowledgment = {
+                "status": "controller-acknowledged",
+                "effect_state": effect_state,
+                "reason": reason,
+            }
+        else:
+            acknowledgment = session.cancel(reason=reason)
+        self._record(
+            "CANCELLATION_ACKNOWLEDGED",
+            {
+                "stage_spec_id": stage_spec_id,
+                "effect_state": acknowledgment["effect_state"],
+                "acknowledgment": acknowledgment,
+            },
+        )
+        if acknowledgment["effect_state"] == "unknown":
+            self._record(
+                "RECONCILIATION_REQUIRED",
+                {
+                    "stage_spec_id": stage_spec_id,
+                    "evidence_refs": ["cancellation:unknown-effect"],
+                },
+            )
+        return self.status()
+
+    def reconcile(
+        self,
+        *,
+        stage_spec_id: str,
+        classification: str,
+        next_action: str,
+        evidence_refs: Sequence[str],
+    ) -> dict[str, Any]:
+        self._record(
+            "RECONCILIATION_RESOLVED",
+            {
+                "stage_spec_id": stage_spec_id,
+                "classification": classification,
+                "next_action": next_action,
+                "evidence_refs": list(evidence_refs),
+            },
+        )
+        return self.status()
+
+    def resolve_decision(
+        self,
+        *,
+        decision_id: str,
+        checkpoint_digest: str,
+        option_id: str,
+        owner_authority_ref: str,
+    ) -> dict[str, Any]:
+        request = self.state["decisions"].get(decision_id)
+        if not isinstance(request, dict):
+            raise MaestroError(
+                "ORCH_DECISION_INVALID",
+                "Decision resolution references no pending request.",
+            )
+        if request.get("schema_version") == OWNER_CHECKPOINT_REQUEST_VERSION:
+            resolution = build_owner_checkpoint_resolution(
+                definition=self.definition,
+                state=self.state,
+                request=request,
+                checkpoint_digest=checkpoint_digest,
+                option_id=option_id,
+                owner_authority_ref=owner_authority_ref,
+            )
+        else:
+            resolution = build_decision_resolution(
+                request=request,
+                root_request_id=self.state["root_request_id"],
+                checkpoint_digest=checkpoint_digest,
+                option_id=option_id,
+                owner_authority_ref=owner_authority_ref,
+            )
+        self._record(
+            "DECISION_RESOLVED",
+            {
+                "decision_id": decision_id,
+                "resolution": resolution,
+            },
+        )
+        if request.get("schema_version") == OWNER_CHECKPOINT_REQUEST_VERSION:
+            entry = next(
+                item
+                for item in self.definition["responsibility_plan"][
+                    "workflow_step_mapping"
+                ]["entries"]
+                if item["step_id"] == request["workflow_step_id"]
+            )
+            if option_id != entry["checkpoint"]["resume_option_id"]:
+                self._record(
+                    "RUN_BLOCKED",
+                    {
+                        "reason": "owner-checkpoint-did-not-resume",
+                        "state_sha256": state_digest(self.state),
+                    },
+                )
+        return self.status()
+
+    def invalidate_for_correction(
+        self,
+        *,
+        source_stage_spec_id: str,
+    ) -> dict[str, Any]:
+        del source_stage_spec_id
+        raise MaestroError(
+            "ORCH_CORRECTION_TARGET_REQUIRED",
+            "Semantic generation cannot advance without an exact "
+            "CorrectionRequest, Host-resumed original context, authenticated "
+            "CorrectionResponse, and admitted replacement Packet.",
+        )
+
+    def correct_stage(
+        self,
+        *,
+        source_stage_spec_id: str,
+        target_claim_ids: Sequence[str],
+        defects_or_questions: Sequence[str],
+        required_new_evidence: Sequence[str],
+    ) -> dict[str, Any]:
+        runtime = self.state["stage_states"].get(source_stage_spec_id)
+        summary = self.state["packets"].get(source_stage_spec_id)
+        if (
+            not isinstance(runtime, dict)
+            or runtime["status"] != "completed"
+            or not isinstance(summary, dict)
+        ):
+            raise MaestroError(
+                "ORCH_CORRECTION_TARGET_PACKET_MISMATCH",
+                "Correction requires the currently admitted completed Packet.",
+            )
+        packet = self._packet_by_digest(summary["packet_digest"])
+        original_receipt = self._participant_receipt_for_packet(packet)
+        original_attempt_receipt = self._attempt_receipt_for_packet(
+            packet,
+            context_receipt=original_receipt,
+        )
+        try:
+            request = build_correction_request(
+                definition=self.definition,
+                state=self.state,
+                packet=packet,
+                participant_receipt=original_receipt,
+                attempt_receipt=original_attempt_receipt,
+                target_claim_ids=target_claim_ids,
+                defects_or_questions=defects_or_questions,
+                required_new_evidence=required_new_evidence,
+            )
+        except MaestroError as exc:
+            if exc.code in {
+                "ORIGINAL_PRODUCER_CONTEXT_UNAVAILABLE",
+                "ORCH_CORRECTION_RESUME_UNATTESTED",
+                "ORCH_STRICT_PRINCIPAL_UNAVAILABLE",
+            }:
+                self._record(
+                    "CORRECTION_BLOCKED",
+                    {
+                        "stage_spec_id": source_stage_spec_id,
+                        "code": exc.code,
+                        "target_packet_digest": packet["packet_digest"],
+                        "evidence_refs": [
+                            f"correction-context:{exc.code}"
+                        ],
+                    },
+                )
+            raise
+        self._artifact_write(
+            "correction-requests",
+            request["correction_request_id"],
+            request,
+        )
+        next_generation = runtime["semantic_generation"] + 1
+        attempt = self._new_attempt(
+            source_stage_spec_id,
+            semantic_generation=next_generation,
+        )
+        boundary = self.host_boundary
+        if boundary is None:
+            boundary = CodexHostBoundary(self.repo)
+            self.host_boundary = boundary
+        session: HostSession | None = None
+        fence: CheckoutWriterFence | None = None
+        try:
+            try:
+                session = boundary.resume(
+                    definition=self.definition,
+                    state=self.state,
+                    stage_spec_id=source_stage_spec_id,
+                    attempt_id=attempt["attempt_id"],
+                    correction_request=request,
+                )
+            except MaestroError as exc:
+                if exc.code in {
+                    "ORIGINAL_PRODUCER_CONTEXT_UNAVAILABLE",
+                    "ORCH_CORRECTION_CONTEXT_MISMATCH",
+                    "ORCH_CORRECTION_REPLACEMENT_FORBIDDEN",
+                    "ORCH_CORRECTION_RESUME_UNATTESTED",
+                }:
+                    self._record(
+                        "CORRECTION_BLOCKED",
+                        {
+                            "stage_spec_id": source_stage_spec_id,
+                            "code": exc.code,
+                            "target_packet_digest": packet[
+                                "packet_digest"
+                            ],
+                            "evidence_refs": [
+                                f"correction-resume:{exc.code}"
+                            ],
+                        },
+                    )
+                raise
+            stage = stage_specs(self.definition)[source_stage_spec_id]
+            role = role_specs(self.definition)[stage["role_spec_id"]]
+            executor = executor_profiles(self.definition)[
+                role["executor_profile_id"]
+            ]
+            resumed_receipt = validate_host_receipt(
+                self.repo,
+                session.participant_receipt,
+                expected_evidence_profile=evidence_profile(
+                    self.definition
+                ),
+                expected_root_request_id=self.state["root_request_id"],
+                expected_root_execution_id=self.state[
+                    "root_execution_id"
+                ],
+                expected_workflow_instance_id=self.state[
+                    "workflow_instance_id"
+                ],
+                expected_stage_spec_id=source_stage_spec_id,
+                expected_role_spec_id=stage["role_spec_id"],
+                expected_attempt_id=attempt["attempt_id"],
+                required_capabilities=role["capability_requirements"],
+                require_read_only=role["read_only"],
+                executor_permissions=executor["permissions"],
+                executor_tools=executor["tools"],
+                context_policy=executor["context_policy"],
+            )
+            session.participant_receipt = resumed_receipt
+            context_receipts_by_role = (
+                self._admitted_context_receipts_by_role()
+            )
+            context_receipts_by_role.setdefault(
+                resumed_receipt["role_spec_id"],
+                [],
+            ).append(resumed_receipt)
+            validate_independence(
+                self.definition,
+                context_receipts_by_role,
+            )
+            self._artifact_write(
+                "context-receipts",
+                resumed_receipt["receipt_id"],
+                resumed_receipt,
+            )
+            predecessor_packets = {
+                admitted["packet_digest"]: self._packet_by_digest(
+                    admitted["packet_digest"]
+                )
+                for stage_id, admitted in self.state["packets"].items()
+                if stage_id != source_stage_spec_id
+            }
+            base_projection = stage_input_projection(
+                definition=self.definition,
+                state=self.state,
+                stage_spec_id=source_stage_spec_id,
+                predecessor_packets=predecessor_packets,
+            )
+            projection = {
+                "schema_version": (
+                    "maestro_orchestration_correction_projection_v1"
+                ),
+                "base_projection": base_projection,
+                "correction_request": request,
+            }
+            projection_sha256 = sha256_text(canonical_json(projection))
+            self._artifact_write(
+                "projections",
+                projection_sha256,
+                projection,
+            )
+            if stage["side_effect"] == "repository_mutation":
+                fence = CheckoutWriterFence(
+                    self.repo,
+                    root_execution_id=self.state["root_execution_id"],
+                    stage_instance_id=(
+                        f"{source_stage_spec_id}:g{next_generation}"
+                    ),
+                    participant_instance_id=resumed_receipt[
+                        "participant_instance_id"
+                    ],
+                    allowed_paths=self.definition["authorization"][
+                        "writer_allowed_paths"
+                    ],
+                    expected_base_revision=self.definition[
+                        "authorization"
+                    ]["base_revision"],
+                    acquired_at=self.now(),
+                )
+                fence.acquire()
+            outcome = session.dispatch(
+                projection=projection,
+                input_projection_sha256=projection_sha256,
+            )
+            if outcome.result.get("status") != "completed":
+                raise MaestroError(
+                    "ORCH_CORRECTION_TARGET_REQUIRED",
+                    "A CorrectionResponse must return a semantically completed result.",
+                )
+            self._artifact_write(
+                "semantic-receipts",
+                outcome.semantic_validation_receipt["receipt_id"],
+                outcome.semantic_validation_receipt,
+            )
+            resumed_attempt_receipt = validate_attempt_evidence(
+                self.repo,
+                outcome.completion_receipt,
+                context_receipt=resumed_receipt,
+                expected_evidence_profile=evidence_profile(
+                    self.definition
+                ),
+                expected_root_request_id=self.state["root_request_id"],
+                expected_root_execution_id=self.state[
+                    "root_execution_id"
+                ],
+                expected_workflow_instance_id=self.state[
+                    "workflow_instance_id"
+                ],
+                expected_stage_spec_id=source_stage_spec_id,
+                expected_role_spec_id=stage["role_spec_id"],
+                expected_attempt_id=attempt["attempt_id"],
+                expected_input_projection_sha256=projection_sha256,
+            )
+            attempt_receipts_by_role = (
+                self._admitted_attempt_receipts_by_role()
+            )
+            prior_completed_role_ids = set(
+                attempt_receipts_by_role
+            )
+            attempt_receipts_by_role.setdefault(
+                resumed_attempt_receipt["role_spec_id"],
+                [],
+            ).append(resumed_attempt_receipt)
+            validate_attempt_independence(
+                self.definition,
+                attempt_receipts_by_role,
+                current_wave_role_ids=[stage["role_spec_id"]],
+                prior_completed_role_ids=sorted(
+                    prior_completed_role_ids
+                ),
+                fresh_current_role_ids=[stage["role_spec_id"]],
+            )
+            self._artifact_write(
+                "attempt-receipts",
+                resumed_attempt_receipt["receipt_id"],
+                resumed_attempt_receipt,
+            )
+            if fence is not None:
+                effect = fence.effect_receipt(
+                    completion_receipt=outcome.completion_receipt,
+                    observed_at=self.now(),
+                )
+                self._artifact_write(
+                    "effect-receipts",
+                    effect["effect_receipt_id"],
+                    effect,
+                )
+            payload_ref = (
+                "payloads/"
+                + sha256_text(canonical_json(outcome.result["payload"]))
+                + ".json"
+            )
+            response_packet, response_payload = build_packet(
+                repo_path=self.repo,
+                definition=self.definition,
+                state=self.state,
+                stage_spec_id=source_stage_spec_id,
+                attempt_id=attempt["attempt_id"],
+                participant_receipt=resumed_receipt,
+                result=outcome.result,
+                semantic_validation_receipt=(
+                    outcome.semantic_validation_receipt
+                ),
+                attempt_receipt=resumed_attempt_receipt,
+                input_projection_sha256=projection_sha256,
+                payload_ref=payload_ref,
+                produced_at=outcome.completion_receipt["completed_at"],
+                base_revision=self.definition["authorization"][
+                    "base_revision"
+                ],
+                semantic_generation=next_generation,
+            )
+            response = build_correction_response(
+                request=request,
+                participant_receipt=resumed_receipt,
+                attempt_receipt=resumed_attempt_receipt,
+                new_attempt_id=attempt["attempt_id"],
+                response_packet_digest=response_packet["packet_digest"],
+                answered_claim_ids=list(target_claim_ids),
+                evidence_refs=outcome.result["evidence_refs"],
+            )
+            self._artifact_write(
+                "payloads",
+                response_packet["payload_sha256"],
+                response_payload,
+            )
+            self._artifact_write(
+                "packets",
+                response_packet["packet_digest"],
+                response_packet,
+            )
+            self._artifact_write(
+                "correction-responses",
+                response["response_id"],
+                response,
+            )
+            from .contracts import dependent_stage_ids
+
+            self._record(
+                "CORRECTION_ACCEPTED",
+                {
+                    "stage_spec_id": source_stage_spec_id,
+                    "descendant_stage_spec_ids": dependent_stage_ids(
+                        self.definition,
+                        [source_stage_spec_id],
+                    ),
+                    "request": request,
+                    "response": response,
+                    "target_packet": packet,
+                    "response_packet": response_packet,
+                    "original_participant_receipt": original_receipt,
+                    "resumed_participant_receipt": resumed_receipt,
+                    "original_attempt_receipt": original_attempt_receipt,
+                    "resumed_attempt_receipt": resumed_attempt_receipt,
+                    "attempt": attempt,
+                },
+            )
+        finally:
+            if fence is not None:
+                fence.release(released_at=self.now())
+            if session is not None:
+                session.close()
+        return self.status()
+
+    def record_rebuttal(
+        self,
+        *,
+        conflict_id: str,
+        responding_packet_digest: str,
+        disposition: str,
+        new_evidence_refs: Sequence[str],
+        resulting_status: str,
+    ) -> dict[str, Any]:
+        conflict = self.state["conflicts"].get(conflict_id)
+        if not isinstance(conflict, dict):
+            raise MaestroError(
+                "ORCH_CONFLICT_INVALID",
+                "Rebuttal references no admitted ConflictRecord.",
+            )
+        packets = {
+            digest: self._packet_by_digest(digest)
+            for digest in conflict["packet_digests"]
+        }
+        request = build_rebuttal_request(
+            state=self.state,
+            conflict=conflict,
+            packets_by_digest=packets,
+        )
+        response = build_rebuttal_response(
+            state=self.state,
+            conflict=conflict,
+            request=request,
+            responding_packet_digest=responding_packet_digest,
+            disposition=disposition,
+            new_evidence_refs=new_evidence_refs,
+            resulting_status=resulting_status,
+        )
+        self._artifact_write(
+            "rebuttal-requests",
+            request["request_id"],
+            request,
+        )
+        self._artifact_write(
+            "rebuttal-responses",
+            response["response_id"],
+            response,
+        )
+        self._record(
+            "REBUTTAL_RECORDED",
+            {
+                "conflict_id": conflict_id,
+                "request": request,
+                "response": response,
+            },
+        )
+        return self.status()
+
+    def request_writer_repair(
+        self,
+        *,
+        stage_spec_id: str,
+        claim_ids: Sequence[str],
+        paths: Sequence[str],
+        verifier_packet_digest: str,
+    ) -> dict[str, Any]:
+        if not set(paths).issubset(
+            self.definition["authorization"]["writer_allowed_paths"]
+        ):
+            raise MaestroError(
+                "ORCH_WRITER_SCOPE_VIOLATION",
+                "Writer repair paths exceed exact source authorization.",
+            )
+        self._record(
+            "WRITER_REPAIR_REQUESTED",
+            {
+                "stage_spec_id": stage_spec_id,
+                "claim_ids": list(claim_ids),
+                "paths": list(paths),
+                "verifier_packet_digest": verifier_packet_digest,
+            },
+        )
+        return self.status()
+
+    def replay_state(self) -> dict[str, Any]:
+        return replay(self.definition, self.events)
+
+    def status(self) -> dict[str, Any]:
+        return {
+            "runtime_authority": RUNTIME_AUTHORITY,
+            "root_request_id": self.state["root_request_id"],
+            "root_execution_id": self.state["root_execution_id"],
+            "workflow_instance_id": self.state["workflow_instance_id"],
+            "definition_id": self.state["definition_id"],
+            "definition_revision": self.state["definition_revision"],
+            "definition_digest": self.state["definition_digest"],
+            "evidence_profile": evidence_profile(self.definition),
+            "plan_revision": self.state["plan_revision"],
+            "controller_revision": self.state["revision"],
+            "status": self.state["status"],
+            "ready_stage_spec_ids": deterministic_ready_set(
+                self.definition,
+                self.state,
+            ),
+            "pending_decision_requests": [
+                copy.deepcopy(decision)
+                for _, decision in sorted(self.state["decisions"].items())
+                if isinstance(decision, dict)
+                and decision.get("status") == "pending"
+            ],
+            "stage_states": copy.deepcopy(self.state["stage_states"]),
+            "state_sha256": state_digest(self.state),
+            "terminal_authority": (
+                "candidate-only"
+                if self.state["status"] == "terminal_candidate"
+                else "none"
+            ),
+        }
