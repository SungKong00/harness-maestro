+def build_workflow_definition(
+    *,
+    definition_id: str,
+    definition_revision: int,
+    risk_level: str,
+    outcome_judge_mode: str,
+    evidence_profile: str = PUBLIC_CODEX_EVIDENCE_PROFILE,
+    direct_path: Mapping[str, Any],
+    authorization: Mapping[str, Any],
+    executor_profiles: Sequence[Mapping[str, Any]],
+    lens_bindings: Sequence[Mapping[str, Any]],
+    pack_hints: Sequence[Mapping[str, Any]],
+    concerns: Sequence[Mapping[str, Any]],
+    roles: Sequence[Mapping[str, Any]],
+    stages: Sequence[Mapping[str, Any]],
+    independence_edges: Sequence[Mapping[str, Any]],
+    workflow_policy: Mapping[str, Any] | None = None,
+    workflow_source_binding: Mapping[str, Any] | None = None,
+    workflow_step_mapping: Mapping[str, Any] | None = None,
+    runtime_limits: Mapping[str, int] | None = None,
+) -> dict[str, Any]:
+    effective_workflow_policy = (
+        copy.deepcopy(dict(workflow_policy))
+        if workflow_policy is not None
+        else build_workflow_policy(risk=risk_level)
+    )
+    require_workflow_policy(
+        effective_workflow_policy,
+        risk=risk_level,
+    )
+    effective_mapping = (
+        copy.deepcopy(dict(workflow_step_mapping))
+        if workflow_step_mapping is not None
+        else build_workflow_step_mapping(
+            effective_workflow_policy,
+            [],
+        )
+    )
+    effective_source_binding = (
+        copy.deepcopy(dict(workflow_source_binding))
+        if workflow_source_binding is not None
+        else build_workflow_source_binding(effective_workflow_policy)
+    )
+    responsibility_plan = {
+        "schema_version": RESPONSIBILITY_PLAN_VERSION,
+        "plan_id": "",
+        "workflow_policy": effective_workflow_policy,
+        "owner_workflow_digest": owner_workflow_digest(
+            effective_workflow_policy
+        ),
+        "workflow_source_binding": effective_source_binding,
+        "workflow_step_mapping": effective_mapping,
+        "concerns": copy.deepcopy(list(concerns)),
+        "roles": copy.deepcopy(list(roles)),
+        "stages": copy.deepcopy(list(stages)),
+        "independence_edges": copy.deepcopy(list(independence_edges)),
+    }
+    responsibility_plan["plan_id"] = responsibility_plan_id(responsibility_plan)
+    definition = {
+        "schema_version": DEFINITION_VERSION,
+        "definition_id": definition_id,
+        "definition_revision": definition_revision,
+        "definition_digest": "",
+        "runtime_authority": RUNTIME_AUTHORITY,
+        "risk_level": risk_level,
+        "outcome_judge_mode": outcome_judge_mode,
+        "evidence_profile": evidence_profile,
+        "direct_path": copy.deepcopy(dict(direct_path)),
+        "runtime_limits": copy.deepcopy(dict(runtime_limits or RUNTIME_LIMITS)),
+        "authorization": copy.deepcopy(dict(authorization)),
+        "executor_profiles": copy.deepcopy(list(executor_profiles)),
+        "lens_bindings": copy.deepcopy(list(lens_bindings)),
+        "pack_hints": {
+            "schema_version": PACK_HINTS_VERSION,
+            "hints": copy.deepcopy(list(pack_hints)),
+        },
+        "responsibility_plan": responsibility_plan,
+        "metadata_policy": {
+            "requested_recommended_applied_separate": True,
+            "unobserved_applied_value": "not_observed",
+        },
+    }
+    definition["definition_digest"] = definition_digest(definition)
+    return validate_workflow_definition(definition)
