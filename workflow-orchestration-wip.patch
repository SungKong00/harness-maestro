diff --git a/src/maestro/workflow/packs/product_design.py b/src/maestro/workflow/packs/product_design.py
new file mode 100644
index 0000000000000000000000000000000000000000..00c553f13cadb75bd58db9665946442e0b59880d
--- /dev/null
+++ b/src/maestro/workflow/packs/product_design.py
@@ -0,0 +1,484 @@
+from __future__ import annotations
+
+import re
+from html.parser import HTMLParser
+from pathlib import Path
+from typing import Any
+
+from maestro.errors import MaestroError
+from maestro.util import (
+    canonical_json,
+    ensure_repo,
+    file_sha256,
+    safe_target,
+    sha256_text,
+)
+
+from ..outcomes import build_outcome_contract
+
+
+PRODUCT_DESIGN_EVIDENCE_VERSION = (
+    "maestro_product_design_workflow_evidence_v1"
+)
+PRODUCT_DESIGN_CRITERIA = (
+    "task-fit",
+    "material-alternatives",
+    "contextual-reference-transfer",
+    "falsification-reviewed",
+    "owner-decision-ready",
+    "rendered-verification",
+)
+
+
+class _HTMLObservation(HTMLParser):
+    def __init__(self) -> None:
+        super().__init__(convert_charrefs=True)
+        self.tags: list[str] = []
+        self.text: list[str] = []
+        self.ignored_text_depth = 0
+
+    def handle_starttag(
+        self,
+        tag: str,
+        attrs: list[tuple[str, str | None]],
+    ) -> None:
+        if tag in {"style", "script"}:
+            self.ignored_text_depth += 1
+        semantic_attrs = sorted(
+            (
+                key,
+                value,
+            )
+            for key, value in attrs
+            if key
+            in {
+                "aria-label",
+                "aria-labelledby",
+                "role",
+                "type",
+            }
+        )
+        self.tags.append(
+            canonical_json({"tag": tag, "attrs": semantic_attrs})
+        )
+
+    def handle_endtag(self, tag: str) -> None:
+        self.tags.append(f"/{tag}")
+        if tag in {"style", "script"}:
+            self.ignored_text_depth = max(
+                0, self.ignored_text_depth - 1
+            )
+
+    def handle_data(self, data: str) -> None:
+        if self.ignored_text_depth:
+            return
+        normalized = re.sub(r"\s+", " ", data).strip()
+        if normalized:
+            self.text.append(normalized)
+
+
+def build_product_design_outcome_contract(
+    *,
+    outcome_statement: str,
+    primary_user: str,
+    job_to_be_done: str,
+    constraints: list[str],
+    authority: str,
+) -> dict[str, Any]:
+    return build_outcome_contract(
+        outcome_statement=outcome_statement,
+        primary_user=primary_user,
+        job_to_be_done=job_to_be_done,
+        success_criteria=[
+            {
+                "criterion_id": "task-fit",
+                "statement": (
+                    "The result supports every declared primary user task."
+                ),
+                "evidence_requirements": [
+                    "observed task-flow coverage",
+                    "result artifact",
+                ],
+            },
+            {
+                "criterion_id": "material-alternatives",
+                "statement": (
+                    "Compared alternatives differ in information architecture or interaction model, not surface styling alone."
+                ),
+                "evidence_requirements": [
+                    "alternative structure observation",
+                    "alternative content observation",
+                ],
+            },
+            {
+                "criterion_id": "contextual-reference-transfer",
+                "statement": (
+                    "Every adopted reference element has source context and a task-specific transfer rationale."
+                ),
+                "evidence_requirements": [
+                    "reference observation artifact",
+                    "transfer rationale",
+                ],
+            },
+            {
+                "criterion_id": "falsification-reviewed",
+                "statement": (
+                    "Counterexamples and decision-changing objections were reviewed before selection."
+                ),
+                "evidence_requirements": [
+                    "falsification artifact",
+                    "counterexample review",
+                ],
+            },
+            {
+                "criterion_id": "owner-decision-ready",
+                "statement": (
+                    "Any owner decision required before implementation is explicitly recorded."
+                ),
+                "evidence_requirements": [
+                    "owner decision requirement",
+                    "owner decision reference when required",
+                ],
+            },
+            {
+                "criterion_id": "rendered-verification",
+                "statement": (
+                    "Required rendered, responsive, accessibility, and interaction scenarios pass."
+                ),
+                "evidence_requirements": [
+                    "rendered scenario artifact",
+                    "verification result",
+                ],
+            },
+        ],
+        rejection_conditions=[
+            "owner rejects the selected direction",
+            "result solves a different task",
+            "alternatives are surface-only variants",
+            "reference transfer lacks observed context",
+            "counterexample or falsification review is missing",
+            "implementation starts before a required owner decision",
+            "required verification fails",
+        ],
+        constraints=constraints,
+        authority=authority,
+    )
+
+
+def _regular_file(repo: Path, relative_path: Any) -> Path:
+    if (
+        not isinstance(relative_path, str)
+        or not relative_path
+        or Path(relative_path).is_absolute()
+    ):
+        raise MaestroError(
+            "PRODUCT_DESIGN_EVIDENCE_PATH_INVALID",
+            "Product Design evidence paths must be repository-relative.",
+        )
+    target = safe_target(repo, relative_path)
+    if (
+        not target.exists()
+        or not target.is_file()
+        or target.is_symlink()
+    ):
+        raise MaestroError(
+            "PRODUCT_DESIGN_EVIDENCE_MISSING",
+            f"Product Design evidence file is unavailable: {relative_path}",
+        )
+    return target
+
+
+def observe_product_design_artifacts(
+    repo_path: str | Path,
+    *,
+    artifact_ids: list[str],
+    required_task_ids: list[str],
+    alternatives: list[dict[str, Any]],
+    reference_transfers: list[dict[str, Any]],
+    verification_scenarios: list[dict[str, Any]],
+    owner_disposition: str = "not-recorded",
+    falsification_artifact_paths: list[str] | None = None,
+    owner_decision_required: bool = False,
+    owner_decision_ref: str | None = None,
+) -> dict[str, Any]:
+    repo = ensure_repo(repo_path)
+    observed_alternatives: list[dict[str, Any]] = []
+    for alternative in alternatives:
+        if (
+            not isinstance(alternative, dict)
+            or set(alternative)
+            != {"alternative_id", "artifact_path", "task_ids"}
+        ):
+            raise MaestroError(
+                "PRODUCT_DESIGN_ALTERNATIVE_INVALID",
+                "Alternative observation requires ID, artifact path, and task IDs.",
+            )
+        target = _regular_file(repo, alternative["artifact_path"])
+        source = target.read_text(encoding="utf-8")
+        parser = _HTMLObservation()
+        parser.feed(source)
+        observed_alternatives.append(
+            {
+                "alternative_id": alternative["alternative_id"],
+                "artifact_id": file_sha256(target),
+                "artifact_path": alternative["artifact_path"],
+                "task_ids": list(alternative["task_ids"]),
+                "structure_digest": sha256_text(
+                    canonical_json(parser.tags)
+                ),
+                "content_digest": sha256_text(
+                    canonical_json(parser.text)
+                ),
+                "surface_digest": sha256_text(source),
+            }
+        )
+    observed_transfers: list[dict[str, Any]] = []
+    for transfer in reference_transfers:
+        if (
+            not isinstance(transfer, dict)
+            or set(transfer)
+            != {
+                "transfer_id",
+                "observation_artifact_path",
+                "target_rationale",
+            }
+        ):
+            raise MaestroError(
+                "PRODUCT_DESIGN_TRANSFER_INVALID",
+                "Reference transfer requires an observation artifact and target rationale.",
+            )
+        observation = _regular_file(
+            repo, transfer["observation_artifact_path"]
+        )
+        observed_transfers.append(
+            {
+                **transfer,
+                "observation_artifact_id": file_sha256(
+                    observation
+                ),
+            }
+        )
+    observed_scenarios: list[dict[str, Any]] = []
+    for scenario in verification_scenarios:
+        if (
+            not isinstance(scenario, dict)
+            or set(scenario)
+            != {"scenario_id", "artifact_path", "status"}
+            or scenario["status"] not in {"pass", "fail"}
+        ):
+            raise MaestroError(
+                "PRODUCT_DESIGN_SCENARIO_INVALID",
+                "Verification scenario requires ID, artifact, and pass/fail status.",
+            )
+        artifact = _regular_file(repo, scenario["artifact_path"])
+        observed_scenarios.append(
+            {
+                **scenario,
+                "artifact_id": file_sha256(artifact),
+            }
+        )
+    observed_falsification_artifacts = [
+        {
+            "artifact_path": relative_path,
+            "artifact_id": file_sha256(
+                _regular_file(repo, relative_path)
+            ),
+        }
+        for relative_path in (falsification_artifact_paths or [])
+    ]
+    if not isinstance(owner_decision_required, bool) or (
+        owner_decision_ref is not None
+        and (
+            not isinstance(owner_decision_ref, str)
+            or not owner_decision_ref.strip()
+        )
+    ):
+        raise MaestroError(
+            "PRODUCT_DESIGN_OWNER_DECISION_INVALID",
+            "Owner decision evidence must declare whether a decision is required and provide a non-empty reference when present.",
+        )
+    value = {
+        "schema_version": PRODUCT_DESIGN_EVIDENCE_VERSION,
+        "artifact_ids": list(artifact_ids),
+        "required_task_ids": list(required_task_ids),
+        "alternatives": observed_alternatives,
+        "reference_transfers": observed_transfers,
+        "falsification_artifacts": observed_falsification_artifacts,
+        "verification_scenarios": observed_scenarios,
+        "owner_disposition": owner_disposition,
+        "owner_decision_required": owner_decision_required,
+        "owner_decision_ref": owner_decision_ref,
+    }
+    if owner_disposition not in {
+        "not-recorded",
+        "accepted",
+        "rejected",
+    }:
+        raise MaestroError(
+            "PRODUCT_DESIGN_OWNER_DISPOSITION_INVALID",
+            "Owner disposition must be not-recorded, accepted, or rejected.",
+        )
+    return value
+
+
+def evaluate_product_design_outcome(
+    outcome_contract: dict[str, Any],
+    result_artifact_ids: list[str],
+    evidence: dict[str, Any],
+) -> dict[str, Any]:
+    if (
+        not isinstance(evidence, dict)
+        or evidence.get("schema_version")
+        != PRODUCT_DESIGN_EVIDENCE_VERSION
+        or evidence.get("artifact_ids") != result_artifact_ids
+    ):
+        raise MaestroError(
+            "PRODUCT_DESIGN_EVIDENCE_INVALID",
+            "Product Design Outcome Judge requires the exact observed result artifacts.",
+        )
+    required_tasks = set(evidence["required_task_ids"])
+    alternatives = evidence["alternatives"]
+    covered_tasks = {
+        task_id
+        for alternative in alternatives
+        for task_id in alternative["task_ids"]
+    }
+    task_fit = required_tasks.issubset(covered_tasks)
+    material_alternatives = (
+        len(alternatives) >= 2
+        and len(
+            {
+                (
+                    alternative["structure_digest"],
+                    alternative["content_digest"],
+                    tuple(alternative["task_ids"]),
+                )
+                for alternative in alternatives
+            }
+        )
+        >= 2
+    )
+    contextual_transfers = bool(evidence["reference_transfers"]) and all(
+        transfer["target_rationale"].strip()
+        and transfer["observation_artifact_id"]
+        for transfer in evidence["reference_transfers"]
+    )
+    falsification_reviewed = bool(
+        evidence["falsification_artifacts"]
+    )
+    owner_decision_ready = (
+        not evidence["owner_decision_required"]
+        or (
+            isinstance(evidence["owner_decision_ref"], str)
+            and bool(evidence["owner_decision_ref"].strip())
+        )
+    )
+    rendered_verification = bool(
+        evidence["verification_scenarios"]
+    ) and all(
+        scenario["status"] == "pass"
+        for scenario in evidence["verification_scenarios"]
+    )
+    status_by_criterion = {
+        "task-fit": task_fit,
+        "material-alternatives": material_alternatives,
+        "contextual-reference-transfer": contextual_transfers,
+        "falsification-reviewed": falsification_reviewed,
+        "owner-decision-ready": owner_decision_ready,
+        "rendered-verification": rendered_verification,
+    }
+    failure_codes: list[str] = []
+    if evidence["owner_disposition"] == "rejected":
+        failure_codes.append("product-design.owner-rejection")
+    if not task_fit:
+        failure_codes.append("product-design.task-mismatch")
+    if not material_alternatives:
+        failure_codes.append(
+            "product-design.superficial-alternatives"
+        )
+    if not contextual_transfers:
+        failure_codes.append(
+            "product-design.inappropriate-reference-transfer"
+        )
+    if not falsification_reviewed:
+        failure_codes.append(
+            "product-design.falsification-missing"
+        )
+    if not owner_decision_ready:
+        failure_codes.append(
+            "product-design.owner-decision-missing"
+        )
+    if not rendered_verification:
+        failure_codes.append(
+            "product-design.verification-failure"
+        )
+    if "product-design.owner-decision-missing" in failure_codes:
+        verdict = "NEEDS_DECISION"
+        correction_intent = "request_owner_decision"
+    elif "product-design.task-mismatch" in failure_codes:
+        verdict = "CONTINUE"
+        correction_intent = "reopen_outcome"
+    elif (
+        "product-design.inappropriate-reference-transfer"
+        in failure_codes
+    ):
+        verdict = "CONTINUE"
+        correction_intent = "reopen_evidence"
+    elif (
+        "product-design.owner-rejection" in failure_codes
+        or "product-design.superficial-alternatives"
+        in failure_codes
+        or "product-design.falsification-missing" in failure_codes
+    ):
+        verdict = "CONTINUE"
+        correction_intent = "reopen_decision"
+    elif "product-design.verification-failure" in failure_codes:
+        verdict = "CONTINUE"
+        correction_intent = "reopen_execution"
+    else:
+        verdict = "DONE"
+        correction_intent = None
+    evidence_ids = list(evidence["artifact_ids"])
+    assessments = []
+    expected_criteria = [
+        criterion["criterion_id"]
+        for criterion in outcome_contract["success_criteria"]
+    ]
+    if tuple(expected_criteria) != PRODUCT_DESIGN_CRITERIA:
+        raise MaestroError(
+            "PRODUCT_DESIGN_OUTCOME_CONTRACT_MISMATCH",
+            "Product Design evaluator requires the Pack-defined generic Outcome Contract.",
+        )
+    for criterion_id in expected_criteria:
+        passed = status_by_criterion[criterion_id]
+        assessments.append(
+            {
+                "criterion_id": criterion_id,
+                "status": "met" if passed else "not_met",
+                "evidence_artifact_ids": evidence_ids,
+                "finding": (
+                    f"{criterion_id} is supported by observed artifacts."
+                    if passed
+                    else f"{criterion_id} is contradicted by observed artifacts."
+                ),
+            }
+        )
+    return {
+        "criteria_assessments": assessments,
+        "failure_codes": failure_codes,
+        "verdict": verdict,
+        "correction_intent": correction_intent,
+        "summary": (
+            "Observed result satisfies the Product Design outcome contract."
+            if not failure_codes
+            else "Observed result violates one or more Product Design outcome criteria."
+        ),
+    }
+
+
+__all__ = [
+    "PRODUCT_DESIGN_EVIDENCE_VERSION",
+    "build_product_design_outcome_contract",
+    "evaluate_product_design_outcome",
+    "observe_product_design_artifacts",
+]
diff --git a/src/maestro/workflow/packs/product_design_compatibility.py b/src/maestro/workflow/packs/product_design_compatibility.py
new file mode 100644
index 0000000000000000000000000000000000000000..f1fffedf90f1c8e1897b110acab02a34e3186123
--- /dev/null
+++ b/src/maestro/workflow/packs/product_design_compatibility.py
@@ -0,0 +1,26 @@
+from __future__ import annotations
+
+from maestro.errors import MaestroError
+
+
+_LEGACY_STAGE_TO_INTENT = {
+    "reference-research": "reopen_evidence",
+    "design-proposal": "reopen_decision",
+    "implementation": "reopen_execution",
+    "outcome-review": "reopen_outcome",
+}
+
+
+def map_legacy_product_design_stage(stage: str) -> str:
+    """Translate persisted v1 Product Design stage values without fallback."""
+
+    try:
+        return _LEGACY_STAGE_TO_INTENT[stage]
+    except (KeyError, TypeError) as exc:
+        raise MaestroError(
+            "PRODUCT_DESIGN_LEGACY_STAGE_UNMAPPED",
+            "Legacy Product Design stage has no explicit correction-intent mapping.",
+        ) from exc
+
+
+__all__ = ["map_legacy_product_design_stage"]
diff --git a/src/maestro/workflow/projection.py b/src/maestro/workflow/projection.py
new file mode 100644
index 0000000000000000000000000000000000000000..46f35fd95772c68cf5f6e3abfb6f5e2366618c6a
--- /dev/null
+++ b/src/maestro/workflow/projection.py
@@ -0,0 +1,114 @@
+from __future__ import annotations
+
+from typing import Any
+
+from maestro.errors import MaestroError
+from maestro.work.ledger import (
+    append_execution_event,
+    producer_binding,
+    validate_execution_ledger,
+)
+
+from .contracts import validate_workflow_definition
+from .kernel import (
+    validate_workflow_event,
+    validate_workflow_state,
+)
+
+
+WORKFLOW_PROJECTION_VERSION = "maestro_workflow_projection_v1"
+
+
+def project_workflow(
+    definition: dict[str, Any],
+    state: dict[str, Any],
+    events: list[dict[str, Any]],
+) -> dict[str, Any]:
+    if (
+        not validate_workflow_definition(definition)
+        or not validate_workflow_state(state, definition)
+        or not isinstance(events, list)
+        or len(events) != state["revision"]
+        or not all(
+            validate_workflow_event(event, definition)
+            for event in events
+        )
+    ):
+        raise MaestroError(
+            "WORKFLOW_PROJECTION_INPUT_INVALID",
+            "Workflow projection requires valid state and complete history.",
+        )
+    return {
+        "schema_version": WORKFLOW_PROJECTION_VERSION,
+        "workflow_instance_id": state["workflow_instance_id"],
+        "root_request_id": state["root_request_id"],
+        "definition_id": state["definition_id"],
+        "revision": state["revision"],
+        "state_id": state["state_id"],
+        "status": state["status"],
+        "phase": state["phase"],
+        "current_stage": state["current_stage"],
+        "checkpoint_id": state["checkpoint_id"],
+        "outcome_contract_artifact_id": state[
+            "outcome_contract_artifact_id"
+        ],
+        "structural_verdict_artifact_id": state[
+            "structural_verdict_artifact_id"
+        ],
+        "latest_outcome_judgment": state[
+            "latest_outcome_judgment"
+        ],
+        "artifact_ids": [
+            artifact["artifact_id"] for artifact in state["artifacts"]
+        ],
+        "invalidated_artifact_ids": list(
+            state["invalidated_artifact_ids"]
+        ),
+        "correction_count": state["correction_count"],
+        "responsibility_boundary_expansions": state[
+            "responsibility_boundary_expansions"
+        ],
+        "event_ids": [event["event_id"] for event in events],
+    }
+
+
+def append_workflow_projection(
+    execution_ledger: dict[str, Any],
+    *,
+    definition: dict[str, Any],
+    state: dict[str, Any],
+    events: list[dict[str, Any]],
+    recorded_at: str,
+) -> tuple[dict[str, Any], bool]:
+    if not validate_execution_ledger(
+        execution_ledger, allow_empty=True
+    ):
+        raise MaestroError(
+            "EXECUTION_LEDGER_INVALID",
+            "Workflow projection requires a valid execution ledger.",
+        )
+    projection = project_workflow(definition, state, events)
+    return append_execution_event(
+        execution_ledger,
+        event_type="workflow_projected",
+        idempotency_key=(
+            "workflow:"
+            f"{state['workflow_instance_id']}:revision:{state['revision']}"
+        ),
+        producer=producer_binding(
+            "maestro_core",
+            capability="deterministic",
+            event_coverage="partial_stream",
+            correlation_id=state["workflow_instance_id"],
+        ),
+        payload={"workflow_projection": projection},
+        measurement=None,
+        recorded_at=recorded_at,
+    )
+
+
+__all__ = [
+    "WORKFLOW_PROJECTION_VERSION",
+    "append_workflow_projection",
+    "project_workflow",
+]
diff --git a/src/maestro/workflow/runtime.py b/src/maestro/workflow/runtime.py
new file mode 100644
index 0000000000000000000000000000000000000000..1b357917bbab1e0ae1353d2e01f0d67db5011810
--- /dev/null
+++ b/src/maestro/workflow/runtime.py
@@ -0,0 +1,1054 @@
+from __future__ import annotations
+
+import copy
+from pathlib import Path
+from typing import Any
+
+from maestro.errors import MaestroError
+from maestro.util import canonical_json, ensure_repo, safe_target, sha256_text
+
+from .adapters import map_correction_intent_to_stage
+from .artifacts import put_json_artifact, read_json_artifact
+from .checkpoints import WorkflowCheckpointStore
+from .contracts import build_command, build_workflow_definition
+from .kernel import empty_workflow_state, reduce_command
+from .outcomes import (
+    build_outcome_contract,
+    validate_outcome_judgment,
+)
+from .projection import project_workflow
+
+
+WORKFLOW_RUNTIME_AUTHORITY = "workflow-kernel-v1"
+WORKFLOW_RUNTIME_FINALIZATION_AUTHORITY = "legacy-completion-bridge"
+WORKFLOW_RUNTIME_NAMESPACE = "maestro-runtime"
+_EXECUTION_STAGE = "execution"
+_OUTCOME_REVIEW_STAGE = "outcome-review"
+
+
+def runtime_workflow_definition(
+    outcome_judge_mode: str = "shadow",
+) -> dict[str, Any]:
+    """Return the stable generic definition used by managed Maestro runs."""
+
+    if outcome_judge_mode == "automatic":
+        raise MaestroError(
+            "OUTCOME_JUDGE_AUTOMATIC_NOT_ACTIVATED",
+            "Automatic Outcome Judge is unavailable until actual manual calibration, explicit owner approval, and activation validation are complete.",
+        )
+    return build_workflow_definition(
+        workflow_key="maestro-runtime",
+        version=1,
+        initial_stage=_EXECUTION_STAGE,
+        stages=[_EXECUTION_STAGE, _OUTCOME_REVIEW_STAGE],
+        terminal_stages=[_OUTCOME_REVIEW_STAGE],
+        transitions=[
+            {
+                "from_stage": _EXECUTION_STAGE,
+                "to_stage": _EXECUTION_STAGE,
+                "trigger": "activity_completed",
+            },
+            {
+                "from_stage": _EXECUTION_STAGE,
+                "to_stage": _OUTCOME_REVIEW_STAGE,
+                "trigger": "activity_completed",
+            },
+            {
+                "from_stage": _OUTCOME_REVIEW_STAGE,
+                "to_stage": _EXECUTION_STAGE,
+                "trigger": "decision_resolved",
+            },
+        ],
+        outcome_judge_mode=outcome_judge_mode,
+    )
+
+
+def _runtime_outcome_judge_mode(
+    plan_summary: dict[str, Any],
+) -> str:
+    mode = plan_summary.get("outcome_judge_mode", "shadow")
+    if mode not in {"shadow", "manual"}:
+        raise MaestroError(
+            "WORKFLOW_RUNTIME_OUTCOME_JUDGE_MODE_INVALID",
+            "Managed workflow Outcome Judge mode must be shadow or manual while automatic activation is unavailable.",
+        )
+    return mode
+
+
+def _workflow_instance_id(observation_id: str) -> str:
+    if (
+        not isinstance(observation_id, str)
+        or len(observation_id) != 32
+        or any(
+            character not in "0123456789abcdef"
+            for character in observation_id
+        )
+    ):
+        raise MaestroError(
+            "WORKFLOW_RUNTIME_OBSERVATION_INVALID",
+            "Workflow runtime requires one valid observation identity.",
+        )
+    return f"workflow-{observation_id}"
+
+
+def _checkpoint_store(
+    repo: Path,
+    *,
+    observation_id: str,
+) -> WorkflowCheckpointStore:
+    target = safe_target(
+        repo,
+        f".maestro/state/workflows/{observation_id}.json",
+    )
+    return WorkflowCheckpointStore(target)
+
+
+def _snapshot(
+    definition: dict[str, Any],
+    checkpoint: dict[str, Any],
+    *,
+    changed: bool,
+    activity_state: str | None = None,
+) -> dict[str, Any]:
+    return {
+        "authority": WORKFLOW_RUNTIME_AUTHORITY,
+        "definition": copy.deepcopy(definition),
+        "state": copy.deepcopy(checkpoint["state"]),
+        "events": copy.deepcopy(checkpoint["events"]),
+        "projection": project_workflow(
+            definition,
+            checkpoint["state"],
+            checkpoint["events"],
+        ),
+        "checkpoint_id": checkpoint["checkpoint_id"],
+        "changed": changed,
+        "activity_state": activity_state,
+    }
+
+
+def _plan_assignment_ids(plan_summary: dict[str, Any]) -> list[str]:
+    assignments = (
+        plan_summary.get("assignments")
+        if isinstance(plan_summary, dict)
+        else None
+    )
+    if (
+        not isinstance(assignments, list)
+        or not assignments
+        or len(assignments) > 5
+    ):
+        raise MaestroError(
+            "WORKFLOW_RUNTIME_PLAN_INVALID",
+            "Managed workflow runtime requires one to five Assignments.",
+        )
+    assignment_ids = [
+        assignment.get("assignment_id")
+        for assignment in assignments
+        if isinstance(assignment, dict)
+    ]
+    if (
+        len(assignment_ids) != len(assignments)
+        or any(
+            not isinstance(assignment_id, str)
+            or not assignment_id.strip()
+            for assignment_id in assignment_ids
+        )
+        or len(assignment_ids) != len(set(assignment_ids))
+    ):
+        raise MaestroError(
+            "WORKFLOW_RUNTIME_PLAN_INVALID",
+            "Managed workflow runtime requires unique Assignment identities.",
+        )
+    return assignment_ids
+
+
+def _runtime_plan_contract(
+    plan_summary: dict[str, Any],
+) -> dict[str, Any]:
+    contract = copy.deepcopy(plan_summary)
+    contract.pop("execution_receipts_required", None)
+    return contract
+
+
+def _runtime_outcome_contract(
+    plan_summary: dict[str, Any],
+) -> dict[str, Any]:
+    objective = plan_summary.get("objective")
+    if not isinstance(objective, str) or not objective.strip():
+        objective = (
+            "Complete the attached managed plan "
+            f"{plan_summary.get('plan_id', 'unknown')}."
+        )
+    plan_digest = sha256_text(
+        canonical_json(_runtime_plan_contract(plan_summary))
+    )
+    return build_outcome_contract(
+        outcome_statement=objective,
+        primary_user="request-owner",
+        job_to_be_done=objective,
+        success_criteria=[
+            {
+                "criterion_id": "requested-outcome",
+                "statement": (
+                    "The actual result directly satisfies the request owner's stated outcome."
+                ),
+                "evidence_requirements": [
+                    "actual terminal result artifacts",
+                    "independent Completion Judge assessment",
+                ],
+            }
+        ],
+        rejection_conditions=[
+            "the owner rejects the result",
+            "the result solves a different task",
+            "required verification fails",
+            "the result lacks evidence for the requested outcome",
+        ],
+        constraints=[f"plan-summary-digest:{plan_digest}"],
+        authority="request-derived",
+    )
+
+
+def _plan_digest_from_outcome_contract(
+    outcome_contract: dict[str, Any],
+) -> str | None:
+    prefix = "plan-summary-digest:"
+    matches = [
+        item[len(prefix) :]
+        for item in outcome_contract.get("constraints", [])
+        if isinstance(item, str) and item.startswith(prefix)
+    ]
+    return matches[0] if len(matches) == 1 else None
+
+
+def _assignment_activity_id(
+    assignment_id: str,
+    correction_count: int,
+) -> str:
+    identity = canonical_json(
+        {
+            "assignment_id": assignment_id,
+            "correction_count": correction_count,
+        }
+    )
+    return f"assignment-{sha256_text(identity)[:32]}"
+
+
+def initialize_plan_workflow(
+    repo_path: str | Path,
+    *,
+    observation_id: str,
+    root_request_id: str,
+    plan_summary: dict[str, Any],
+) -> dict[str, Any]:
+    """Initialize or replay the mandatory workflow for one attached plan."""
+
+    repo = ensure_repo(repo_path)
+    assignment_ids = _plan_assignment_ids(plan_summary)
+    workflow_instance_id = _workflow_instance_id(observation_id)
+    definition = runtime_workflow_definition(
+        _runtime_outcome_judge_mode(plan_summary)
+    )
+    store = _checkpoint_store(repo, observation_id=observation_id)
+    existing = store.load(definition)
+    if existing is not None:
+        state = existing["state"]
+        if (
+            state["root_request_id"] != root_request_id
+            or state["workflow_instance_id"] != workflow_instance_id
+        ):
+            raise MaestroError(
+                "WORKFLOW_RUNTIME_BINDING_CONFLICT",
+                "Stored workflow belongs to a different root request.",
+            )
+        contract_artifact = next(
+            (
+                artifact
+                for artifact in state["artifacts"]
+                if artifact["artifact_id"]
+                == state["outcome_contract_artifact_id"]
+            ),
+            None,
+        )
+        expected_plan_digest = sha256_text(
+            canonical_json(_runtime_plan_contract(plan_summary))
+        )
+        outcome_contract = (
+            read_json_artifact(repo, contract_artifact)
+            if isinstance(contract_artifact, dict)
+            else None
+        )
+        if (
+            not isinstance(contract_artifact, dict)
+            or not isinstance(outcome_contract, dict)
+            or _plan_digest_from_outcome_contract(outcome_contract)
+            != expected_plan_digest
+        ):
+            raise MaestroError(
+                "WORKFLOW_RUNTIME_PLAN_CONFLICT",
+                "Stored workflow is bound to a different plan summary.",
+            )
+        return _snapshot(definition, existing, changed=False)
+
+    outcome_contract = put_json_artifact(
+        repo,
+        artifact_type="OutcomeContract",
+        namespace=WORKFLOW_RUNTIME_NAMESPACE,
+        root_request_id=root_request_id,
+        workflow_instance_id=workflow_instance_id,
+        payload=_runtime_outcome_contract(plan_summary),
+        producer="maestro-observation",
+    )
+    state = empty_workflow_state(
+        definition,
+        workflow_instance_id=workflow_instance_id,
+        root_request_id=root_request_id,
+    )
+    command = build_command(
+        workflow_instance_id=workflow_instance_id,
+        root_request_id=root_request_id,
+        definition_id=definition["definition_id"],
+        expected_revision=state["revision"],
+        idempotency_key="workflow:start",
+        command_type="START_WORKFLOW",
+        payload={
+            "outcome_contract": outcome_contract,
+            "responsibility_boundaries": assignment_ids,
+        },
+    )
+    state, emitted = reduce_command(state, definition, command)
+    checkpoint, changed = store.save(definition, state, emitted)
+    return _snapshot(definition, checkpoint, changed=changed)
+
+
+def _load_plan_workflow(
+    repo_path: str | Path,
+    *,
+    observation_id: str,
+    root_request_id: str,
+    plan_summary: dict[str, Any],
+) -> tuple[Path, dict[str, Any], dict[str, Any]]:
+    repo = ensure_repo(repo_path)
+    initialized = initialize_plan_workflow(
+        repo,
+        observation_id=observation_id,
+        root_request_id=root_request_id,
+        plan_summary=plan_summary,
+    )
+    definition = initialized["definition"]
+    store = _checkpoint_store(repo, observation_id=observation_id)
+    checkpoint = store.load(definition)
+    assert checkpoint is not None
+    return repo, definition, checkpoint
+
+
+def request_assignment_activity(
+    repo_path: str | Path,
+    *,
+    observation_id: str,
+    root_request_id: str,
+    plan_summary: dict[str, Any],
+    assignment_id: str,
+) -> dict[str, Any]:
+    """Durably request one Assignment before its external effect starts."""
+
+    assignment_ids = _plan_assignment_ids(plan_summary)
+    if assignment_id not in assignment_ids:
+        raise MaestroError(
+            "WORKFLOW_RUNTIME_ASSIGNMENT_INVALID",
+            "Assignment is not present in the workflow plan.",
+        )
+    repo, definition, checkpoint = _load_plan_workflow(
+        repo_path,
+        observation_id=observation_id,
+        root_request_id=root_request_id,
+        plan_summary=plan_summary,
+    )
+    activity_id = _assignment_activity_id(
+        assignment_id,
+        checkpoint["state"]["correction_count"],
+    )
+    matching_completion = next(
+        (
+            event
+            for event in checkpoint["events"]
+            if event["event_type"] == "ActivityCompleted"
+            and event["payload"].get("activity_id") == activity_id
+        ),
+        None,
+    )
+    if matching_completion is not None:
+        return _snapshot(
+            definition,
+            checkpoint,
+            changed=False,
+            activity_state="completed",
+        )
+    pending = checkpoint["state"]["pending_activity"]
+    if pending is not None:
+        if pending.get("activity_id") != activity_id:
+            raise MaestroError(
+                "WORKFLOW_RUNTIME_ACTIVITY_BUSY",
+                "Another Assignment Activity is already pending.",
+            )
+        return _snapshot(
+            definition,
+            checkpoint,
+            changed=False,
+            activity_state="reconciliation-required",
+        )
+    if checkpoint["state"]["current_stage"] != _EXECUTION_STAGE:
+        raise MaestroError(
+            "WORKFLOW_RUNTIME_OUTCOME_REVIEW_ACTIVE",
+            "Assignment execution cannot start after outcome review begins.",
+        )
+    command = build_command(
+        workflow_instance_id=checkpoint["state"][
+            "workflow_instance_id"
+        ],
+        root_request_id=root_request_id,
+        definition_id=definition["definition_id"],
+        expected_revision=checkpoint["state"]["revision"],
+        idempotency_key=f"assignment-request:{activity_id}",
+        command_type="REQUEST_ACTIVITY",
+        payload={
+            "activity_id": activity_id,
+            "activity_type": "maestro-assignment",
+            "input_artifact_ids": [],
+        },
+    )
+    state, emitted = reduce_command(
+        checkpoint["state"], definition, command
+    )
+    events = [*checkpoint["events"], *emitted]
+    saved, changed = _checkpoint_store(
+        repo, observation_id=observation_id
+    ).save(definition, state, events)
+    return _snapshot(
+        definition,
+        saved,
+        changed=changed,
+        activity_state="started",
+    )
+
+
+def complete_assignment_activity(
+    repo_path: str | Path,
+    *,
+    observation_id: str,
+    root_request_id: str,
+    plan_summary: dict[str, Any],
+    assignment_id: str,
+    stage_result: dict[str, Any],
+    assignments_terminal: bool,
+    allow_terminal_import: bool = False,
+) -> dict[str, Any]:
+    """Record one terminal Assignment result in the authoritative workflow."""
+
+    repo, definition, checkpoint = _load_plan_workflow(
+        repo_path,
+        observation_id=observation_id,
+        root_request_id=root_request_id,
+        plan_summary=plan_summary,
+    )
+    activity_id = _assignment_activity_id(
+        assignment_id,
+        checkpoint["state"]["correction_count"],
+    )
+    result_artifact = put_json_artifact(
+        repo,
+        artifact_type="EvidencePacket",
+        namespace=WORKFLOW_RUNTIME_NAMESPACE,
+        root_request_id=root_request_id,
+        workflow_instance_id=checkpoint["state"][
+            "workflow_instance_id"
+        ],
+        payload=copy.deepcopy(stage_result),
+        producer="maestro-observation",
+    )
+    existing_completion = next(
+        (
+            event
+            for event in checkpoint["events"]
+            if event["event_type"] == "ActivityCompleted"
+            and event["payload"].get("activity_id") == activity_id
+        ),
+        None,
+    )
+    if existing_completion is not None:
+        if (
+            existing_completion["payload"].get("result_artifact")
+            != result_artifact
+        ):
+            raise MaestroError(
+                "WORKFLOW_RUNTIME_RESULT_CONFLICT",
+                "Assignment Activity already contains different terminal evidence.",
+            )
+        return _snapshot(
+            definition,
+            checkpoint,
+            changed=False,
+            activity_state="completed",
+        )
+    pending = checkpoint["state"]["pending_activity"]
+    if pending is None:
+        if not allow_terminal_import:
+            raise MaestroError(
+                "WORKFLOW_RUNTIME_ACTIVITY_NOT_STARTED",
+                "Assignment Activity must be requested before terminal evidence is recorded.",
+            )
+        requested = request_assignment_activity(
+            repo,
+            observation_id=observation_id,
+            root_request_id=root_request_id,
+            plan_summary=plan_summary,
+            assignment_id=assignment_id,
+        )
+        definition = requested["definition"]
+        checkpoint = _checkpoint_store(
+            repo, observation_id=observation_id
+        ).load(definition)
+        assert checkpoint is not None
+        pending = checkpoint["state"]["pending_activity"]
+    if (
+        not isinstance(pending, dict)
+        or pending.get("activity_id") != activity_id
+    ):
+        raise MaestroError(
+            "WORKFLOW_RUNTIME_ACTIVITY_BINDING_MISMATCH",
+            "Terminal evidence does not match the pending Assignment Activity.",
+        )
+    command = build_command(
+        workflow_instance_id=checkpoint["state"][
+            "workflow_instance_id"
+        ],
+        root_request_id=root_request_id,
+        definition_id=definition["definition_id"],
+        expected_revision=checkpoint["state"]["revision"],
+        idempotency_key=(
+            "assignment-terminal:"
+            + sha256_text(
+                canonical_json(
+                    {
+                        "assignment_id": assignment_id,
+                        "payload_digest": result_artifact[
+                            "payload_digest"
+                        ],
+                    }
+                )
+            )
+        ),
+        command_type="COMPLETE_ACTIVITY",
+        payload={
+            "activity_id": activity_id,
+            "result_artifact": result_artifact,
+            "next_stage": (
+                _OUTCOME_REVIEW_STAGE
+                if assignments_terminal
+                else _EXECUTION_STAGE
+            ),
+        },
+    )
+    state, emitted = reduce_command(
+        checkpoint["state"], definition, command
+    )
+    events = [*checkpoint["events"], *emitted]
+    saved, changed = _checkpoint_store(
+        repo, observation_id=observation_id
+    ).save(definition, state, events)
+    return _snapshot(
+        definition,
+        saved,
+        changed=changed,
+        activity_state="completed",
+    )
+
+
+def _state_artifact(
+    checkpoint: dict[str, Any],
+    artifact_id: str | None,
+) -> dict[str, Any] | None:
+    return next(
+        (
+            artifact
+            for artifact in checkpoint["state"]["artifacts"]
+            if artifact["artifact_id"] == artifact_id
+        ),
+        None,
+    )
+
+
+def _save_runtime_command(
+    repo: Path,
+    *,
+    observation_id: str,
+    definition: dict[str, Any],
+    checkpoint: dict[str, Any],
+    command_type: str,
+    idempotency_key: str,
+    payload: dict[str, Any],
+) -> tuple[dict[str, Any], bool]:
+    state, emitted = reduce_command(
+        checkpoint["state"],
+        definition,
+        build_command(
+            workflow_instance_id=checkpoint["state"][
+                "workflow_instance_id"
+            ],
+            root_request_id=checkpoint["state"]["root_request_id"],
+            definition_id=definition["definition_id"],
+            expected_revision=checkpoint["state"]["revision"],
+            idempotency_key=idempotency_key,
+            command_type=command_type,
+            payload=payload,
+        ),
+    )
+    return _checkpoint_store(
+        repo, observation_id=observation_id
+    ).save(
+        definition,
+        state,
+        [*checkpoint["events"], *emitted],
+    )
+
+
+def prepare_outcome_review(
+    repo_path: str | Path,
+    *,
+    observation_id: str,
+    root_request_id: str,
+    plan_summary: dict[str, Any],
+    stage_results: list[dict[str, Any]],
+    verifier_result: str,
+) -> dict[str, Any]:
+    """Close the structural gate and return the exact Judge input."""
+
+    repo, definition, checkpoint = _load_plan_workflow(
+        repo_path,
+        observation_id=observation_id,
+        root_request_id=root_request_id,
+        plan_summary=plan_summary,
+    )
+    assignment_ids = _plan_assignment_ids(plan_summary)
+    observed_ids = [
+        item.get("assignment_id")
+        for item in stage_results
+        if isinstance(item, dict)
+    ]
+    if (
+        checkpoint["state"]["current_stage"] != _OUTCOME_REVIEW_STAGE
+        or checkpoint["state"]["phase"] != "running"
+        or observed_ids != assignment_ids
+        or verifier_result not in {"passed", "failed", "not_run"}
+    ):
+        raise MaestroError(
+            "WORKFLOW_RUNTIME_OUTCOME_REVIEW_NOT_READY",
+            "Outcome review requires ordered terminal evidence for every planned Assignment.",
+        )
+    structural_payload = {
+        "schema_version": "maestro_runtime_structural_verdict_v1",
+        "status": "PASS",
+        "assignment_results": [
+            {
+                "assignment_id": item["assignment_id"],
+                "status": item["status"],
+                "evidence_refs": list(item.get("evidence_refs", [])),
+            }
+            for item in stage_results
+        ],
+        "verifier_result": verifier_result,
+    }
+    structural_artifact = put_json_artifact(
+        repo,
+        artifact_type="VerificationVerdict",
+        namespace=WORKFLOW_RUNTIME_NAMESPACE,
+        root_request_id=root_request_id,
+        workflow_instance_id=checkpoint["state"][
+            "workflow_instance_id"
+        ],
+        payload=structural_payload,
+        producer="maestro-structural-gate",
+    )
+    existing_id = checkpoint["state"][
+        "structural_verdict_artifact_id"
+    ]
+    changed = False
+    if existing_id is None:
+        checkpoint, changed = _save_runtime_command(
+            repo,
+            observation_id=observation_id,
+            definition=definition,
+            checkpoint=checkpoint,
+            command_type="RECORD_STRUCTURAL_VERDICT",
+            idempotency_key=(
+                "outcome-review:structural:"
+                + structural_artifact["artifact_id"]
+            ),
+            payload={
+                "verdict_artifact": structural_artifact,
+                "status": "PASS",
+            },
+        )
+    elif existing_id != structural_artifact["artifact_id"]:
+        raise MaestroError(
+            "WORKFLOW_RUNTIME_STRUCTURAL_VERDICT_CONFLICT",
+            "Outcome review is already bound to different structural evidence.",
+        )
+    contract_artifact = _state_artifact(
+        checkpoint,
+        checkpoint["state"]["outcome_contract_artifact_id"],
+    )
+    if not isinstance(contract_artifact, dict):
+        raise MaestroError(
+            "WORKFLOW_RUNTIME_OUTCOME_CONTRACT_MISSING",
+            "The initial Outcome Contract artifact is unavailable.",
+        )
+    outcome_contract = read_json_artifact(repo, contract_artifact)
+    result_artifacts = [
+        event["payload"]["result_artifact"]
+        for event in checkpoint["events"]
+        if event["event_type"] == "ActivityCompleted"
+        and event["payload"]["result_artifact"]["artifact_id"]
+        not in checkpoint["state"]["invalidated_artifact_ids"]
+    ]
+    return {
+        **_snapshot(definition, checkpoint, changed=changed),
+        "judge_input": {
+            "schema_version": "maestro_outcome_judge_input_v1",
+            "outcome_contract": outcome_contract,
+            "outcome_contract_artifact": contract_artifact,
+            "structural_verdict_artifact": structural_artifact,
+            "result_artifacts": result_artifacts,
+            "mode": definition["outcome_judge_mode"],
+        },
+    }
+
+
+def record_outcome_judgment(
+    repo_path: str | Path,
+    *,
+    observation_id: str,
+    root_request_id: str,
+    plan_summary: dict[str, Any],
+    judgment: dict[str, Any],
+) -> dict[str, Any]:
+    """Record a read-only judgment and interrupt only in manual mode."""
+
+    repo, definition, checkpoint = _load_plan_workflow(
+        repo_path,
+        observation_id=observation_id,
+        root_request_id=root_request_id,
+        plan_summary=plan_summary,
+    )
+    contract_artifact = _state_artifact(
+        checkpoint,
+        checkpoint["state"]["outcome_contract_artifact_id"],
+    )
+    if not isinstance(contract_artifact, dict):
+        raise MaestroError(
+            "WORKFLOW_RUNTIME_OUTCOME_CONTRACT_MISSING",
+            "The initial Outcome Contract artifact is unavailable.",
+        )
+    outcome_contract = read_json_artifact(repo, contract_artifact)
+    expected_result_ids = [
+        event["payload"]["result_artifact"]["artifact_id"]
+        for event in checkpoint["events"]
+        if event["event_type"] == "ActivityCompleted"
+        and event["payload"]["result_artifact"]["artifact_id"]
+        not in checkpoint["state"]["invalidated_artifact_ids"]
+    ]
+    if (
+        not validate_outcome_judgment(judgment, outcome_contract)
+        or judgment["mode"] != definition["outcome_judge_mode"]
+        or judgment["structural_verdict_artifact_id"]
+        != checkpoint["state"]["structural_verdict_artifact_id"]
+        or judgment["result_artifact_ids"] != expected_result_ids
+    ):
+        raise MaestroError(
+            "WORKFLOW_RUNTIME_OUTCOME_JUDGMENT_INVALID",
+            "Outcome Judgment must bind the exact initial contract, structural verdict, and actual result artifacts.",
+        )
+    judgment_artifact = put_json_artifact(
+        repo,
+        artifact_type="OutcomeJudgment",
+        namespace=WORKFLOW_RUNTIME_NAMESPACE,
+        root_request_id=root_request_id,
+        workflow_instance_id=checkpoint["state"][
+            "workflow_instance_id"
+        ],
+        payload=copy.deepcopy(judgment),
+        producer="outcome-judge",
+    )
+    already_recorded = next(
+        (
+            event
+            for event in checkpoint["events"]
+            if event["event_type"] == "OutcomeJudgmentRecorded"
+            and event["payload"]["judgment_artifact"]["artifact_id"]
+            == judgment_artifact["artifact_id"]
+        ),
+        None,
+    )
+    if already_recorded is not None:
+        return _snapshot(definition, checkpoint, changed=False)
+    correction_fingerprint = (
+        sha256_text(
+            canonical_json(
+                {
+                    "failure_codes": judgment["failure_codes"],
+                    "result_artifact_ids": expected_result_ids,
+                    "correction_intent": judgment[
+                        "correction_intent"
+                    ],
+                }
+            )
+        )
+        if judgment["verdict"] == "CONTINUE"
+        else None
+    )
+    checkpoint, _ = _save_runtime_command(
+        repo,
+        observation_id=observation_id,
+        definition=definition,
+        checkpoint=checkpoint,
+        command_type="RECORD_OUTCOME_JUDGMENT",
+        idempotency_key=(
+            "outcome-review:judgment:"
+            + judgment_artifact["artifact_id"]
+        ),
+        payload={
+            "judgment_artifact": judgment_artifact,
+            "verdict": judgment["verdict"],
+            "correction_intent": judgment["correction_intent"],
+            "correction_fingerprint": correction_fingerprint,
+        },
+    )
+    if definition["outcome_judge_mode"] == "shadow":
+        return _snapshot(definition, checkpoint, changed=True)
+    decision_request_artifact = put_json_artifact(
+        repo,
+        artifact_type="DecisionRequest",
+        namespace=WORKFLOW_RUNTIME_NAMESPACE,
+        root_request_id=root_request_id,
+        workflow_instance_id=checkpoint["state"][
+            "workflow_instance_id"
+        ],
+        payload={
+            "schema_version": "maestro_outcome_decision_request_v1",
+            "judgment_id": judgment["judgment_id"],
+            "suggested_verdict": judgment["verdict"],
+            "correction_intent": judgment["correction_intent"],
+            "summary": judgment["summary"],
+            "failure_codes": list(judgment["failure_codes"]),
+        },
+        producer="maestro-workflow",
+    )
+    saved, changed = _save_runtime_command(
+        repo,
+        observation_id=observation_id,
+        definition=definition,
+        checkpoint=checkpoint,
+        command_type="REQUEST_DECISION",
+        idempotency_key=(
+            "outcome-review:decision-request:"
+            + judgment_artifact["artifact_id"]
+        ),
+        payload={
+            "request_artifact": decision_request_artifact,
+        },
+    )
+    return _snapshot(definition, saved, changed=changed)
+
+
+_RUNTIME_CORRECTION_STAGE_MAPPING = {
+    "reopen_evidence": _EXECUTION_STAGE,
+    "reopen_decision": _EXECUTION_STAGE,
+    "reopen_execution": _EXECUTION_STAGE,
+    "reopen_outcome": _EXECUTION_STAGE,
+}
+
+
+def resolve_outcome_decision(
+    repo_path: str | Path,
+    *,
+    observation_id: str,
+    root_request_id: str,
+    plan_summary: dict[str, Any],
+    checkpoint_id: str,
+    decision_ref: str,
+    verdict: str,
+    correction_intent: str | None,
+    responsibility_boundary_additions: list[str] | None = None,
+) -> dict[str, Any]:
+    """Resume a manual judgment at the exact pending checkpoint."""
+
+    repo, definition, checkpoint = _load_plan_workflow(
+        repo_path,
+        observation_id=observation_id,
+        root_request_id=root_request_id,
+        plan_summary=plan_summary,
+    )
+    if (
+        definition["outcome_judge_mode"] != "manual"
+        or not isinstance(checkpoint_id, str)
+        or len(checkpoint_id) != 64
+        or not isinstance(decision_ref, str)
+        or not decision_ref.strip()
+        or verdict not in {"DONE", "CONTINUE", "BLOCKED"}
+    ):
+        raise MaestroError(
+            "WORKFLOW_RUNTIME_DECISION_INVALID",
+            "Manual resolution requires an explicit decision at the pending checkpoint.",
+        )
+    latest = checkpoint["state"]["latest_outcome_judgment"]
+    if not isinstance(latest, dict):
+        raise MaestroError(
+            "WORKFLOW_RUNTIME_OUTCOME_JUDGMENT_MISSING",
+            "Manual resolution requires the recorded Outcome Judgment.",
+        )
+    resolution_artifact = put_json_artifact(
+        repo,
+        artifact_type="DecisionResolution",
+        namespace=WORKFLOW_RUNTIME_NAMESPACE,
+        root_request_id=root_request_id,
+        workflow_instance_id=checkpoint["state"][
+            "workflow_instance_id"
+        ],
+        payload={
+            "schema_version": "maestro_outcome_decision_resolution_v1",
+            "decision_ref": decision_ref,
+            "judgment_artifact_id": latest["artifact_id"],
+            "checkpoint_id": checkpoint_id,
+            "verdict": verdict,
+            "correction_intent": correction_intent,
+        },
+        producer="request-owner",
+    )
+    existing = next(
+        (
+            event
+            for event in checkpoint["events"]
+            if event["event_type"] == "DecisionResolved"
+            and event["payload"]["resolution_artifact"][
+                "artifact_id"
+            ]
+            == resolution_artifact["artifact_id"]
+        ),
+        None,
+    )
+    if existing is not None:
+        return _snapshot(definition, checkpoint, changed=False)
+    pending = checkpoint["state"]["pending_decision"]
+    if (
+        checkpoint["state"]["phase"] != "waiting_decision"
+        or not isinstance(pending, dict)
+        or pending["checkpoint_id"] != checkpoint_id
+    ):
+        raise MaestroError(
+            "WORKFLOW_CHECKPOINT_MISMATCH",
+            "Decision resolution must resume the exact pending checkpoint.",
+        )
+    if verdict == "CONTINUE":
+        if correction_intent is None:
+            raise MaestroError(
+                "WORKFLOW_RUNTIME_CORRECTION_INTENT_MISSING",
+                "CONTINUE requires an explicit generic correction intent.",
+            )
+        return_stage = map_correction_intent_to_stage(
+            definition=definition,
+            correction_intent=correction_intent,
+            stage_mapping=_RUNTIME_CORRECTION_STAGE_MAPPING,
+        )
+        invalidated = [
+            event["payload"]["result_artifact"]["artifact_id"]
+            for event in checkpoint["events"]
+            if event["event_type"] == "ActivityCompleted"
+            and event["payload"]["result_artifact"]["artifact_id"]
+            not in checkpoint["state"]["invalidated_artifact_ids"]
+        ]
+        correction_fingerprint = sha256_text(
+            canonical_json(
+                {
+                    "judgment_artifact_id": latest["artifact_id"],
+                    "correction_intent": correction_intent,
+                    "invalidated_artifact_ids": invalidated,
+                }
+            )
+        )
+    else:
+        if correction_intent is not None:
+            raise MaestroError(
+                "WORKFLOW_RUNTIME_DECISION_INTENT_INVALID",
+                "Only CONTINUE may carry a correction intent.",
+            )
+        return_stage = None
+        invalidated = []
+        correction_fingerprint = None
+    additions = list(responsibility_boundary_additions or [])
+    saved, changed = _save_runtime_command(
+        repo,
+        observation_id=observation_id,
+        definition=definition,
+        checkpoint=checkpoint,
+        command_type="RESOLVE_DECISION",
+        idempotency_key=(
+            "outcome-review:decision-resolution:"
+            + resolution_artifact["artifact_id"]
+        ),
+        payload={
+            "resolution_artifact": resolution_artifact,
+            "checkpoint_id": checkpoint_id,
+            "verdict": verdict,
+            "return_stage": return_stage,
+            "invalidated_artifact_ids": invalidated,
+            "correction_fingerprint": correction_fingerprint,
+            "responsibility_boundary_additions": additions,
+        },
+    )
+    return _snapshot(definition, saved, changed=changed)
+
+
+def workflow_checkpoint_path(
+    repo_path: str | Path,
+    *,
+    observation_id: str,
+) -> Path:
+    repo = ensure_repo(repo_path)
+    return safe_target(
+        repo,
+        f".maestro/state/workflows/{observation_id}.json",
+    )
+
+
+def load_runtime_workflow(
+    repo_path: str | Path,
+    *,
+    observation_id: str,
+    root_request_id: str,
+    plan_summary: dict[str, Any],
+) -> dict[str, Any]:
+    """Return the replay-validated current managed workflow snapshot."""
+
+    _, definition, checkpoint = _load_plan_workflow(
+        repo_path,
+        observation_id=observation_id,
+        root_request_id=root_request_id,
+        plan_summary=plan_summary,
+    )
+    return _snapshot(definition, checkpoint, changed=False)
+
+
+__all__ = [
+    "WORKFLOW_RUNTIME_AUTHORITY",
+    "WORKFLOW_RUNTIME_FINALIZATION_AUTHORITY",
+    "WORKFLOW_RUNTIME_NAMESPACE",
+    "complete_assignment_activity",
+    "initialize_plan_workflow",
+    "load_runtime_workflow",
+    "prepare_outcome_review",
+    "record_outcome_judgment",
+    "request_assignment_activity",
+    "resolve_outcome_decision",
+    "runtime_workflow_definition",
+    "workflow_checkpoint_path",
+]
