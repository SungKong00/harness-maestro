index 0000000000000000000000000000000000000000..4c3400db4914017844604f415947aa0751aceba4
--- /dev/null
+++ b/src/maestro/display_language.py
@@ -0,0 +1,107 @@
+from __future__ import annotations
+
+from typing import Any
+
+
+DISPLAY_LANGUAGE_KOREAN = "ko"
+DISPLAY_LANGUAGE_UNVERIFIED = "unverified"
+LANGUAGE_MISMATCH = "language_mismatch"
+
+_HANGUL_RANGES = (
+    ("\u1100", "\u11ff"),
+    ("\u3130", "\u318f"),
+    ("\ua960", "\ua97f"),
+    ("\uac00", "\ud7a3"),
+    ("\ud7b0", "\ud7ff"),
+)
+
+
+def contains_hangul(value: Any) -> bool:
+    if not isinstance(value, str):
+        return False
+    return any(
+        start <= character <= end
+        for character in value
+        for start, end in _HANGUL_RANGES
+    )
+
+
+def expected_display_language(value: Any) -> str:
+    return (
+        DISPLAY_LANGUAGE_KOREAN
+        if contains_hangul(value)
+        else DISPLAY_LANGUAGE_UNVERIFIED
+    )
+
+
+def narrative_language_state(
+    value: Any,
+    *,
+    expected: str,
+) -> str:
+    if value is None:
+        return "unavailable"
+    if expected != DISPLAY_LANGUAGE_KOREAN:
+        return "unverified"
+    return "matched" if contains_hangul(value) else LANGUAGE_MISMATCH
+
+
+def work_card_display_language(
+    card: dict[str, Any],
+    *,
+    expected: str,
+) -> dict[str, Any]:
+    detail = card.get("detail")
+    detail = detail if isinstance(detail, dict) else {}
+    fields = {
+        # role is a structured identifier such as reviewer or verifier, not
+        # user-facing narrative text.
+        "role": "unverified",
+        "task_summary": narrative_language_state(
+            card.get("task_summary"),
+            expected=expected,
+        ),
+        "result_summary": narrative_language_state(
+            card.get("result_summary"),
+            expected=expected,
+        ),
+        "finding": narrative_language_state(
+            detail.get("finding"),
+            expected=expected,
+        ),
+        "conclusion": narrative_language_state(
+            detail.get("conclusion"),
+            expected=expected,
+        ),
+        "decision": narrative_language_state(
+            detail.get("decision"),
+            expected=expected,
+        ),
+        "completion_criteria": narrative_language_state(
+            detail.get("completion_criteria"),
+            expected=expected,
+        ),
+        "handoff_purpose": narrative_language_state(
+            (
+                detail.get("handoff", {}).get("purpose")
+                if isinstance(detail.get("handoff"), dict)
+                else None
+            ),
+            expected=expected,
+        ),
+    }
+    states = set(fields.values())
+    state = (
+        LANGUAGE_MISMATCH
+        if LANGUAGE_MISMATCH in states
+        else (
+            "matched"
+            if expected == DISPLAY_LANGUAGE_KOREAN
+            else "unverified"
+        )
+    )
+    return {
+        "expected": expected,
+        "state": state,
+        "fields": fields,
+    }
diff --git a/src/maestro/document_impact.py b/src/maestro/document_impact.py
new file mode 100644
index 0000000000000000000000000000000000000000..d76b208d3db070f7bf594fe01c16c068ede2c347
--- /dev/null
+++ b/src/maestro/document_impact.py
@@ -0,0 +1,622 @@
+from __future__ import annotations
+
+import copy
+import re
+from pathlib import Path, PurePosixPath
+from typing import Any, Iterable
+
+from .documents import select_documents
+from .errors import MaestroError
+from .util import (
+    canonical_json,
+    ensure_repo,
+    file_sha256,
+    safe_target,
+    sha256_text,
+)
+
+DOCUMENT_IMPACT_VERSION = "maestro_document_impact_v1"
+DOCUMENT_IMPACT_CLOSURE_VERSION = "maestro_document_impact_closure_v1"
+MAX_CHANGED_PATHS = 32
+MAX_IMPACT_DOCUMENTS = 16
+
+_DIGEST = re.compile(r"^[a-f0-9]{64}$")
+_DOCUMENT_ROLES = {
+    "project": "constraint",
+    "architecture": "constraint",
+    "governance": "constraint",
+    "decision": "constraint",
+    "convention": "constraint",
+    "plan": "coordination",
+    "runbook": "procedure",
+}
+_DISPOSITIONS = {
+    "complied",
+    "not_applicable",
+    "updated",
+    "deferred_by_owner",
+    "conflict",
+}
+
+
+def _issue(code: str, path: str, message: str) -> dict[str, str]:
+    return {"code": code, "path": path, "message": message}
+
+
+def _line(value: Any, maximum: int = 500) -> bool:
+    return (
+        isinstance(value, str)
+        and 0 < len(value.strip()) <= maximum
+        and not any(character in value for character in "\r\n\x00")
+    )
+
+
+def _relative_path(value: Any) -> bool:
+    if (
+        not isinstance(value, str)
+        or not value
+        or len(value) > 300
+        or "\\" in value
+        or any(character in value for character in "\r\n\x00")
+    ):
+        return False
+    parsed = PurePosixPath(value)
+    return (
+        not parsed.is_absolute()
+        and value == parsed.as_posix()
+        and value != "."
+        and ".." not in parsed.parts
+        and not value.startswith("./")
+    )
+
+
+def document_role(document_type: Any) -> str | None:
+    """Return the completion role for an authoritative document type."""
+
+    return (
+        _DOCUMENT_ROLES.get(document_type)
+        if isinstance(document_type, str)
+        else None
+    )
+
+
+def _governed_document(item: Any) -> dict[str, Any] | None:
+    if (
+        not isinstance(item, dict)
+        or not _relative_path(item.get("path"))
+        or not isinstance(item.get("sha256"), str)
+        or _DIGEST.fullmatch(item["sha256"]) is None
+        or not _line(item.get("document_type"), 100)
+        or not _line(item.get("reason"))
+    ):
+        return None
+    role = document_role(item["document_type"])
+    if role is None:
+        return None
+    return {
+        "path": item["path"],
+        "sha256": item["sha256"],
+        "document_type": item["document_type"],
+        "role": role,
+        "reason": item["reason"],
+    }
+
+
+def project_document_impact(selection: Any) -> dict[str, Any]:
+    """Bind the pre-write governed-document set to one document selection."""
+
+    if (
+        not isinstance(selection, dict)
+        or not isinstance(selection.get("selection_digest"), str)
+        or _DIGEST.fullmatch(selection["selection_digest"]) is None
+        or not isinstance(selection.get("target_paths"), list)
+    ):
+        raise MaestroError(
+            "DOCUMENT_IMPACT_SELECTION_INVALID",
+            "Document impact requires one intact Assignment document selection.",
+        )
+    documents: list[dict[str, Any]] = []
+    seen: set[str] = set()
+    for item in selection.get("documents", []):
+        governed = _governed_document(item)
+        if governed is None or governed["path"] in seen:
+            continue
+        seen.add(governed["path"])
+        documents.append(governed)
+    payload = {
+        "schema_version": DOCUMENT_IMPACT_VERSION,
+        "selection_digest": selection["selection_digest"],
+        "target_paths": copy.deepcopy(selection["target_paths"]),
+        "documents": documents,
+    }
+    return {
+        **payload,
+        "impact_digest": sha256_text(canonical_json(payload)),
+    }
+
+
+def valid_projected_document_impact(
+    value: Any,
+    *,
+    selection: Any,
+) -> bool:
+    if not isinstance(value, dict):
+        return False
+    try:
+        expected = project_document_impact(selection)
+    except MaestroError:
+        return False
+    return value == expected
+
+
+def _normalize_changed_paths(value: Any) -> list[str] | None:
+    if (
+        not isinstance(value, list)
+        or len(value) > MAX_CHANGED_PATHS
+        or not all(_relative_path(path) for path in value)
+    ):
+        return None
+    if len(value) != len(set(value)) or value != sorted(value):
+        return None
+    return list(value)
+
+
+def _current_digest(repo: Path, relative_path: str) -> str | None:
+    try:
+        target = safe_target(repo, relative_path)
+    except MaestroError:
+        return None
+    if target.is_symlink() or not target.is_file():
+        return None
+    return file_sha256(target)
+
+
+def reconcile_document_impact(
+    repo_path: str | Path,
+    *,
+    goal: str,
+    lens_ids: list[str],
+    planned_impact: dict[str, Any],
+    changed_paths: list[str],
+    decision_authorized: bool,
+) -> dict[str, Any]:
+    """Re-select documents from observed net paths and merge both evidence sets."""
+
+    repo = ensure_repo(repo_path)
+    normalized_paths = _normalize_changed_paths(changed_paths)
+    if normalized_paths is None:
+        raise MaestroError(
+            "DOCUMENT_IMPACT_CHANGED_PATHS_INVALID",
+            "Changed paths must be a sorted unique bounded repository-relative list.",
+        )
+    current_selection = select_documents(
+        repo,
+        goal,
+        lens_ids,
+        normalized_paths,
+        decision_authorized=decision_authorized,
+    )
+    current_documents = current_selection.get("required_documents")
+    if not isinstance(current_documents, list):
+        current_documents = current_selection.get("documents", [])
+    optional_coordination = [
+        item
+        for item in current_selection.get("optional_documents", [])
+        if (
+            isinstance(item, dict)
+            and item.get("document_type") == "plan"
+        )
+    ]
+    current_documents = [
+        *current_documents,
+        *optional_coordination,
+    ]
+
+    planned_by_path = {
+        item["path"]: item
+        for item in planned_impact.get("documents", [])
+        if isinstance(item, dict) and _relative_path(item.get("path"))
+    }
+    current_by_path: dict[str, dict[str, Any]] = {}
+    for item in current_documents:
+        governed = _governed_document(item)
+        if governed is not None:
+            current_by_path[governed["path"]] = governed
+
+    documents: list[dict[str, Any]] = []
+    for path in sorted(set(planned_by_path) | set(current_by_path)):
+        planned = planned_by_path.get(path)
+        current = current_by_path.get(path)
+        source = current or planned
+        assert source is not None
+        documents.append(
+            {
+                "path": path,
+                "baseline_sha256": (
+                    planned.get("sha256")
+                    if isinstance(planned, dict)
+                    else None
+                ),
+                "current_sha256": _current_digest(repo, path),
+                "document_type": source["document_type"],
+                "role": source["role"],
+                "selection_phase": (
+                    "both"
+                    if planned is not None and current is not None
+                    else ("planned" if planned is not None else "changed")
+                ),
+            }
+        )
+    missing_evidence = [
+        item
+        for item in current_selection.get("missing_evidence", [])
+        if _line(item)
+    ][:8]
+    evidence_status = current_selection.get("evidence_status")
+    if evidence_status not in {"sufficient", "insufficient"}:
+        evidence_status = "insufficient"
+        if not missing_evidence:
+            missing_evidence = [
+                "Changed-path document selection did not return a verifiable evidence status."
+            ]
+    return {
+        "schema_version": "maestro_document_impact_reconciliation_v1",
+        "planned_impact_digest": planned_impact["impact_digest"],
+        "changed_paths": normalized_paths,
+        "evidence_status": evidence_status,
+        "missing_evidence": missing_evidence,
+        "documents": documents[:MAX_IMPACT_DOCUMENTS],
+        "overflow": len(documents) > MAX_IMPACT_DOCUMENTS,
+    }
+
+
+def _approval_is_owner_decision(value: Any) -> bool:
+    return (
+        isinstance(value, str)
+        and value.startswith("owner_decision:")
+        and _line(value)
+    )
+
+
+def _approval_is_convention_basis(value: Any) -> bool:
+    return (
+        _approval_is_owner_decision(value)
+        or (
+            isinstance(value, str)
+            and value.startswith("held_out_evaluation:")
+            and _line(value)
+        )
+    )
+
+
+def document_impact_closure_issues(
+    closure: Any,
+    *,
+    repo_path: str | Path,
+    goal: str,
+    lens_ids: list[str],
+    planned_impact: Any,
+    selection: Any,
+    decision_authorized: bool,
+    completed: bool,
+    observed_changed_paths: Iterable[str] | None = None,
+) -> list[dict[str, str]]:
+    """Validate one writer's document-impact closure against current evidence."""
+
+    issues: list[dict[str, str]] = []
+    if not valid_projected_document_impact(
+        planned_impact,
+        selection=selection,
+    ):
+        return [
+            _issue(
+                "PACKET_DOCUMENT_IMPACT_PROJECTION_INVALID",
+                "projection.document_impact",
+                "The writer requires the intact planned document-impact projection.",
+            )
+        ]
+    fields = {
+        "schema_version",
+        "planned_impact_digest",
+        "changed_paths",
+        "dispositions",
+    }
+    if not isinstance(closure, dict) or set(closure) != fields:
+        return [
+            _issue(
+                "PACKET_DOCUMENT_IMPACT_CLOSURE_INVALID",
+                "document_impact_closure",
+                "Document impact closure must contain only its version, planned digest, changed paths, and dispositions.",
+            )
+        ]
+    if closure.get("schema_version") != DOCUMENT_IMPACT_CLOSURE_VERSION:
+        issues.append(
+            _issue(
+                "PACKET_DOCUMENT_IMPACT_VERSION_INVALID",
+                "document_impact_closure.schema_version",
+                f"Expected {DOCUMENT_IMPACT_CLOSURE_VERSION}.",
+            )
+        )
+    if closure.get("planned_impact_digest") != planned_impact["impact_digest"]:
+        issues.append(
+            _issue(
+                "PACKET_DOCUMENT_IMPACT_DIGEST_MISMATCH",
+                "document_impact_closure.planned_impact_digest",
+                "Document impact closure is not bound to the planned impact digest.",
+            )
+        )
+    changed_paths = _normalize_changed_paths(closure.get("changed_paths"))
+    if changed_paths is None:
+        issues.append(
+            _issue(
+                "PACKET_CHANGED_PATHS_INVALID",
+                "document_impact_closure.changed_paths",
+                "Changed paths must be sorted, unique, bounded, and repository-relative.",
+            )
+        )
+        return issues
+    if observed_changed_paths is not None:
+        observed_values = list(observed_changed_paths)
+        if (
+            len(observed_values) > MAX_CHANGED_PATHS
+            or not all(
+                _relative_path(path)
+                for path in observed_values
+            )
+        ):
+            issues.append(
+                _issue(
+                    "PACKET_OBSERVED_CHANGED_PATHS_INVALID",
+                    "document_impact_closure.changed_paths",
+                    "The Host observed an invalid or over-broad changed-path set.",
+                )
+            )
+        else:
+            observed = sorted(set(observed_values))
+        if (
+            all(
+                _relative_path(path)
+                for path in observed_values
+            )
+            and len(observed_values) <= MAX_CHANGED_PATHS
+            and changed_paths != observed
+        ):
+            issues.append(
+                _issue(
+                    "PACKET_CHANGED_PATHS_MISMATCH",
+                    "document_impact_closure.changed_paths",
+                    "Declared changed paths do not match the Host-observed net repository effects.",
+                )
+            )
+    try:
+        reconciliation = reconcile_document_impact(
+            repo_path,
+            goal=goal,
+            lens_ids=lens_ids,
+            planned_impact=planned_impact,
+            changed_paths=changed_paths,
+            decision_authorized=decision_authorized,
+        )
+    except MaestroError as exc:
+        issues.append(
+            _issue(
+                "PACKET_DOCUMENT_RECONCILIATION_INVALID",
+                "document_impact_closure",
+                exc.message,
+            )
+        )
+        return issues
+    if reconciliation["overflow"]:
+        issues.append(
+            _issue(
+                "PACKET_DOCUMENT_IMPACT_LIMIT_EXCEEDED",
+                "document_impact_closure.dispositions",
+                "The merged planned and changed-path document set exceeds the bounded closure limit.",
+            )
+        )
+    if completed and reconciliation["evidence_status"] != "sufficient":
+        detail = "; ".join(reconciliation["missing_evidence"])
+        issues.append(
+            _issue(
+                "PACKET_DOCUMENT_RECONCILIATION_INSUFFICIENT",
+                "document_impact_closure",
+                "Changed-path document evidence is insufficient"
+                + (f": {detail}" if detail else "."),
+            )
+        )
+
+    expected = {
+        item["path"]: item
+        for item in reconciliation["documents"]
+    }
+    dispositions = closure.get("dispositions")
+    if (
+        not isinstance(dispositions, list)
+        or len(dispositions) > MAX_IMPACT_DOCUMENTS
+        or len(dispositions) != len(expected)
+    ):
+        issues.append(
+            _issue(
+                "PACKET_DOCUMENT_DISPOSITIONS_INVALID",
+                "document_impact_closure.dispositions",
+                "Document dispositions must cover the exact reconciled governed-document set.",
+            )
+        )
+        return issues
+
+    seen: set[str] = set()
+    has_conflict = False
+    disposition_fields = {
+        "path",
+        "baseline_sha256",
+        "current_sha256",
+        "document_type",
+        "role",
+        "selection_phase",
+        "disposition",
+        "reason",
+        "approval_ref",
+    }
+    for index, item in enumerate(dispositions):
+        item_path = f"document_impact_closure.dispositions[{index}]"
+        if (
+            not isinstance(item, dict)
+            or set(item) != disposition_fields
+            or not _line(item.get("reason"))
+            or not isinstance(item.get("disposition"), str)
+            or item["disposition"] not in _DISPOSITIONS
+        ):
+            issues.append(
+                _issue(
+                    "PACKET_DOCUMENT_DISPOSITION_INVALID",
+                    item_path,
+                    "Document disposition does not satisfy the closed impact-report contract.",
+                )
+            )
+            continue
+        path = item.get("path")
+        if not isinstance(path, str):
+            issues.append(
+                _issue(
+                    "PACKET_DOCUMENT_DISPOSITION_MISMATCH",
+                    item_path,
+                    "Document disposition is duplicated or outside the reconciled set.",
+                )
+            )
+            continue
+        expected_item = expected.get(path)
+        if (
+            expected_item is None
+            or path in seen
+        ):
+            issues.append(
+                _issue(
+                    "PACKET_DOCUMENT_DISPOSITION_MISMATCH",
+                    item_path,
+                    "Document disposition is duplicated or outside the reconciled set.",
+                )
+            )
+            continue
+        seen.add(path)
+        for field in (
+            "baseline_sha256",
+            "current_sha256",
+            "document_type",
+            "role",
+            "selection_phase",
+        ):
+            if item.get(field) != expected_item[field]:
+                issues.append(
+                    _issue(
+                        "PACKET_DOCUMENT_DISPOSITION_EVIDENCE_MISMATCH",
+                        f"{item_path}.{field}",
+                        "Document disposition does not match the reconciled file evidence.",
+                    )
+                )
+        disposition = item["disposition"]
+        approval_ref = item.get("approval_ref")
+        path_changed = path in changed_paths
+        baseline = expected_item["baseline_sha256"]
+        current = expected_item["current_sha256"]
+        if disposition in {"complied", "not_applicable"}:
+            if path_changed or current is None or (
+                baseline is not None and baseline != current
+            ):
+                issues.append(
+                    _issue(
+                        "PACKET_DOCUMENT_UNCHANGED_DISPOSITION_INVALID",
+                        item_path,
+                        "Complied or not_applicable requires an unchanged, present document.",
+                    )
+                )
+            if approval_ref is not None:
+                issues.append(
+                    _issue(
+                        "PACKET_DOCUMENT_APPROVAL_UNEXPECTED",
+                        f"{item_path}.approval_ref",
+                        "Unchanged document dispositions do not carry approval.",
+                    )
+                )
+        elif disposition == "updated":
+            if (
+                not path_changed
+                or current is None
+                or (baseline is not None and baseline == current)
+            ):
+                issues.append(
+                    _issue(
+                        "PACKET_DOCUMENT_UPDATE_UNPROVED",
+                        item_path,
+                        "Updated requires an observed path change and a new current digest.",
+                    )
+                )
+            if item["document_type"] == "convention":
+                if not _approval_is_convention_basis(approval_ref):
+                    issues.append(
+                        _issue(
+                            "PACKET_CONVENTION_UPDATE_APPROVAL_REQUIRED",
+                            f"{item_path}.approval_ref",
+                            "An active Convention update requires an owner decision or accepted held-out evaluation.",
+                        )
+                    )
+            elif (
+                item["document_type"] == "decision"
+                and baseline is not None
+            ):
+                if not _approval_is_owner_decision(approval_ref):
+                    issues.append(
+                        _issue(
+                            "PACKET_DECISION_UPDATE_APPROVAL_REQUIRED",
+                            f"{item_path}.approval_ref",
+                            "Changing an existing decision record requires an owner decision; prefer superseding it.",
+                        )
+                    )
+            elif approval_ref is not None:
+                issues.append(
+                    _issue(
+                        "PACKET_DOCUMENT_APPROVAL_UNEXPECTED",
+                        f"{item_path}.approval_ref",
+                        "This document update does not require an approval reference.",
+                    )
+                )
+        elif disposition == "deferred_by_owner":
+            if (
+                path_changed
+                or current is None
+                or (baseline is not None and baseline != current)
+                or not _approval_is_owner_decision(approval_ref)
+            ):
+                issues.append(
+                    _issue(
+                        "PACKET_DOCUMENT_DEFERRAL_INVALID",
+                        item_path,
+                        "A deferral requires an unchanged document and one explicit owner_decision reference.",
+                    )
+                )
+        else:
+            has_conflict = True
+            if approval_ref is not None:
+                issues.append(
+                    _issue(
+                        "PACKET_DOCUMENT_APPROVAL_UNEXPECTED",
+                        f"{item_path}.approval_ref",
+                        "An unresolved conflict does not carry approval.",
+                    )
+                )
+    if seen != set(expected):
+        issues.append(
+            _issue(
+                "PACKET_DOCUMENT_DISPOSITION_SET_MISMATCH",
+                "document_impact_closure.dispositions",
+                "Document dispositions do not cover the exact reconciled set.",
+            )
+        )
+    if completed and has_conflict:
+        issues.append(
+            _issue(
+                "PACKET_DOCUMENT_CONFLICT_UNRESOLVED",
+                "document_impact_closure.dispositions",
+                "A writer cannot complete while a document-impact conflict remains open.",
+            )
+        )
+    return issues
