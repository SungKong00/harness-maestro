+def _definition(
+    *,
+    workflow_key: str = "generic-assured-work",
+    initial_stage: str = "implementation",
+    outcome_judge_mode: str = "shadow",
+    compatible_definition_digests: list[str] | None = None,
+) -> dict:
+    return build_workflow_definition(
+        workflow_key=workflow_key,
+        version=1,
+        initial_stage=initial_stage,
+        stages=[
+            "outcome-review",
+            "reference-research",
+            "design-proposal",
+            "implementation",
+            "verification",
+            "completion",
+        ],
+        terminal_stages=["completion"],
+        transitions=[
+            {
+                "from_stage": "implementation",
+                "to_stage": "verification",
+                "trigger": "activity_completed",
+            },
+            {
+                "from_stage": "verification",
+                "to_stage": "completion",
+                "trigger": "activity_completed",
+            },
+            *[
+                {
+                    "from_stage": source,
+                    "to_stage": target,
+                    "trigger": trigger,
+                }
+                for source in [
+                    "completion",
+                    "outcome-review",
+                    "reference-research",
+                    "design-proposal",
+                    "implementation",
+                    "verification",
+                ]
+                for target in [
+                    "outcome-review",
+                    "reference-research",
+                    "design-proposal",
+                    "implementation",
+                    "verification",
+                ]
+                for trigger in [
+                    "decision_resolved",
+                    "outcome_continue",
+                ]
+            ],
+        ],
+        outcome_judge_mode=outcome_judge_mode,
+        compatible_definition_digests=(
+            compatible_definition_digests
+        ),
+    )
