index 0000000000000000000000000000000000000000..3118a6e0626485637309c1fc9f19b1beeeb0e5b3
--- /dev/null
+++ b/src/maestro/workflow/calibration.py
@@ -0,0 +1,386 @@
+from __future__ import annotations
+
+import copy
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+from maestro.errors import MaestroError
+from maestro.util import canonical_json, read_json, sha256_text
+
+from .contracts import OUTCOME_VERDICTS, digest
+
+
+OUTCOME_JUDGE_CALIBRATION_RECORD_VERSION = (
+    "maestro_outcome_judge_calibration_record_v1"
+)
+OUTCOME_JUDGE_ACTIVATION_VERSION = (
+    "maestro_outcome_judge_activation_v1"
+)
+OUTCOME_JUDGE_OWNER_APPROVAL_VERSION = (
+    "maestro_outcome_judge_owner_approval_v1"
+)
+OUTCOME_JUDGE_ACTIVATION_VALIDATION_VERSION = (
+    "maestro_outcome_judge_activation_validation_v1"
+)
+OUTCOME_JUDGE_CALIBRATION_CASES = 20
+MAX_FALSE_DONE_COUNT = 0
+MAX_UNNECESSARY_CONTINUE_COUNT = 0
+_CALIBRATION_PATH = (
+    Path(__file__).resolve().parents[1]
+    / "resources"
+    / "outcome-judge-calibration.json"
+)
+
+
+def _line(value: Any, *, maximum: int = 500) -> bool:
+    return (
+        isinstance(value, str)
+        and value == value.strip()
+        and bool(value)
+        and len(value) <= maximum
+        and not any(character in value for character in "\r\n\x00")
+    )
+
+
+def _timestamp(value: Any) -> bool:
+    if not _line(value, maximum=64):
+        return False
+    try:
+        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except ValueError:
+        return False
+    return parsed.tzinfo is not None
+
+
+def _identity(value: dict[str, Any], field: str) -> str:
+    payload = copy.deepcopy(value)
+    payload[field] = ""
+    return sha256_text(canonical_json(payload))
+
+
+def _refs(value: Any, *, allow_empty: bool) -> bool:
+    return (
+        isinstance(value, list)
+        and (allow_empty or bool(value))
+        and len(value) <= 64
+        and len(value) == len(set(value))
+        and all(_line(item) for item in value)
+    )
+
+
+def validate_calibration_record(value: Any) -> bool:
+    fields = {
+        "schema_version",
+        "calibration_record_id",
+        "root_request_id",
+        "run_id",
+        "outcome_judgment_id",
+        "pack_id",
+        "pack_version",
+        "input_refs",
+        "evidence_refs",
+        "judge_observed_verdict",
+        "owner_expected_verdict",
+        "false_done",
+        "unnecessary_continue",
+        "judged_at",
+        "decision_ref",
+        "provenance",
+    }
+    if (
+        not isinstance(value, dict)
+        or set(value) != fields
+        or value.get("schema_version")
+        != OUTCOME_JUDGE_CALIBRATION_RECORD_VERSION
+        or not digest(value.get("calibration_record_id"))
+        or value["calibration_record_id"]
+        != _identity(value, "calibration_record_id")
+        or not _line(value.get("root_request_id"), maximum=200)
+        or not _line(value.get("run_id"), maximum=200)
+        or not digest(value.get("outcome_judgment_id"))
+        or not _line(value.get("pack_id"), maximum=100)
+        or not _line(value.get("pack_version"), maximum=100)
+        or not _refs(value.get("input_refs"), allow_empty=False)
+        or not _refs(value.get("evidence_refs"), allow_empty=False)
+        or value.get("judge_observed_verdict")
+        not in OUTCOME_VERDICTS
+        or value.get("owner_expected_verdict")
+        not in OUTCOME_VERDICTS
+        or not isinstance(value.get("false_done"), bool)
+        or not isinstance(value.get("unnecessary_continue"), bool)
+        or not _timestamp(value.get("judged_at"))
+        or not _line(value.get("decision_ref"))
+        or value.get("provenance") != "actual-manual"
+    ):
+        return False
+    return (
+        value["false_done"]
+        == (
+            value["judge_observed_verdict"] == "DONE"
+            and value["owner_expected_verdict"] != "DONE"
+        )
+        and value["unnecessary_continue"]
+        == (
+            value["judge_observed_verdict"] == "CONTINUE"
+            and value["owner_expected_verdict"] == "DONE"
+        )
+    )
+
+
+def build_calibration_record(**values: Any) -> dict[str, Any]:
+    record = {
+        "schema_version": OUTCOME_JUDGE_CALIBRATION_RECORD_VERSION,
+        "calibration_record_id": "",
+        **copy.deepcopy(values),
+        "provenance": "actual-manual",
+    }
+    record["calibration_record_id"] = _identity(
+        record, "calibration_record_id"
+    )
+    if not validate_calibration_record(record):
+        raise MaestroError(
+            "OUTCOME_JUDGE_CALIBRATION_RECORD_INVALID",
+            "Calibration requires an actual manual judgment bound to its request, evidence, and owner-confirmed expectation.",
+        )
+    return record
+
+
+def validate_activation_manifest(value: Any) -> bool:
+    fields = {
+        "schema_version",
+        "activation_id",
+        "evaluator_id",
+        "status",
+        "required_distinct_actual_requests",
+        "thresholds",
+        "calibration_record_refs",
+        "synthetic_fixture_refs",
+        "owner_approval_ref",
+        "activation_validation_ref",
+    }
+    return (
+        isinstance(value, dict)
+        and set(value) == fields
+        and value.get("schema_version")
+        == OUTCOME_JUDGE_ACTIVATION_VERSION
+        and digest(value.get("activation_id"))
+        and value["activation_id"] == _identity(value, "activation_id")
+        and _line(value.get("evaluator_id"), maximum=100)
+        and value.get("status") in {"draft", "unvalidated", "activated"}
+        and value.get("required_distinct_actual_requests")
+        == OUTCOME_JUDGE_CALIBRATION_CASES
+        and value.get("thresholds")
+        == {
+            "max_false_done_count": MAX_FALSE_DONE_COUNT,
+            "max_unnecessary_continue_count": (
+                MAX_UNNECESSARY_CONTINUE_COUNT
+            ),
+        }
+        and _refs(
+            value.get("calibration_record_refs"), allow_empty=True
+        )
+        and _refs(value.get("synthetic_fixture_refs"), allow_empty=True)
+        and (
+            value.get("owner_approval_ref") is None
+            or _line(value["owner_approval_ref"])
+        )
+        and (
+            value.get("activation_validation_ref") is None
+            or _line(value["activation_validation_ref"])
+        )
+    )
+
+
+def validate_owner_approval(value: Any) -> bool:
+    fields = {
+        "schema_version",
+        "approval_id",
+        "evaluator_id",
+        "decision",
+        "decision_ref",
+        "decided_at",
+    }
+    return (
+        isinstance(value, dict)
+        and set(value) == fields
+        and value.get("schema_version")
+        == OUTCOME_JUDGE_OWNER_APPROVAL_VERSION
+        and digest(value.get("approval_id"))
+        and value["approval_id"] == _identity(value, "approval_id")
+        and _line(value.get("evaluator_id"), maximum=100)
+        and value.get("decision")
+        == "approve-automatic-outcome-judge"
+        and _line(value.get("decision_ref"))
+        and not value["decision_ref"].startswith("docs/")
+        and _timestamp(value.get("decided_at"))
+    )
+
+
+def build_owner_approval(
+    *,
+    evaluator_id: str,
+    decision_ref: str,
+    decided_at: str,
+) -> dict[str, Any]:
+    value = {
+        "schema_version": OUTCOME_JUDGE_OWNER_APPROVAL_VERSION,
+        "approval_id": "",
+        "evaluator_id": evaluator_id,
+        "decision": "approve-automatic-outcome-judge",
+        "decision_ref": decision_ref,
+        "decided_at": decided_at,
+    }
+    value["approval_id"] = _identity(value, "approval_id")
+    if not validate_owner_approval(value):
+        raise MaestroError(
+            "OUTCOME_JUDGE_OWNER_APPROVAL_INVALID",
+            "Automatic activation requires a separate explicit owner decision record, not an ADR reference.",
+        )
+    return value
+
+
+def validate_activation_validation(value: Any) -> bool:
+    fields = {
+        "schema_version",
+        "validation_id",
+        "evaluator_id",
+        "calibration_record_refs",
+        "status",
+        "validated_at",
+    }
+    return (
+        isinstance(value, dict)
+        and set(value) == fields
+        and value.get("schema_version")
+        == OUTCOME_JUDGE_ACTIVATION_VALIDATION_VERSION
+        and digest(value.get("validation_id"))
+        and value["validation_id"]
+        == _identity(value, "validation_id")
+        and _line(value.get("evaluator_id"), maximum=100)
+        and _refs(
+            value.get("calibration_record_refs"), allow_empty=False
+        )
+        and value.get("status") == "PASS"
+        and _timestamp(value.get("validated_at"))
+    )
+
+
+def build_activation_validation(
+    *,
+    evaluator_id: str,
+    calibration_record_refs: list[str],
+    validated_at: str,
+) -> dict[str, Any]:
+    value = {
+        "schema_version": (
+            OUTCOME_JUDGE_ACTIVATION_VALIDATION_VERSION
+        ),
+        "validation_id": "",
+        "evaluator_id": evaluator_id,
+        "calibration_record_refs": list(calibration_record_refs),
+        "status": "PASS",
+        "validated_at": validated_at,
+    }
+    value["validation_id"] = _identity(value, "validation_id")
+    if not validate_activation_validation(value):
+        raise MaestroError(
+            "OUTCOME_JUDGE_ACTIVATION_VALIDATION_INVALID",
+            "Activation validation must PASS against the exact actual-manual record set.",
+        )
+    return value
+
+
+def automatic_activation_eligibility(
+    manifest: dict[str, Any],
+    *,
+    records: list[dict[str, Any]],
+    owner_approval: dict[str, Any] | None = None,
+    activation_validation: dict[str, Any] | None = None,
+) -> dict[str, Any]:
+    """Evaluate activation evidence; synthetic fixtures are never records."""
+
+    reasons: list[str] = []
+    if not validate_activation_manifest(manifest):
+        reasons.append("activation-manifest-invalid")
+        return {"eligible": False, "reasons": reasons}
+    if manifest["status"] != "activated":
+        reasons.append("activation-status-not-activated")
+    if not all(validate_calibration_record(record) for record in records):
+        reasons.append("actual-manual-record-invalid")
+    record_ids = [
+        record.get("calibration_record_id")
+        for record in records
+        if isinstance(record, dict)
+    ]
+    if record_ids != manifest["calibration_record_refs"]:
+        reasons.append("calibration-record-reference-mismatch")
+    distinct_requests = {
+        record["root_request_id"]
+        for record in records
+        if validate_calibration_record(record)
+    }
+    if len(distinct_requests) < OUTCOME_JUDGE_CALIBRATION_CASES:
+        reasons.append("insufficient-distinct-actual-requests")
+    if (
+        sum(bool(record.get("false_done")) for record in records)
+        > MAX_FALSE_DONE_COUNT
+    ):
+        reasons.append("false-done-threshold-exceeded")
+    if (
+        sum(
+            bool(record.get("unnecessary_continue"))
+            for record in records
+        )
+        > MAX_UNNECESSARY_CONTINUE_COUNT
+    ):
+        reasons.append("unnecessary-continue-threshold-exceeded")
+    if (
+        not validate_owner_approval(owner_approval)
+        or manifest["owner_approval_ref"]
+        != owner_approval["approval_id"]
+        or owner_approval["evaluator_id"]
+        != manifest["evaluator_id"]
+    ):
+        reasons.append("explicit-owner-approval-missing")
+    if (
+        not validate_activation_validation(activation_validation)
+        or manifest["activation_validation_ref"]
+        != activation_validation["validation_id"]
+        or activation_validation["evaluator_id"]
+        != manifest["evaluator_id"]
+        or activation_validation["calibration_record_refs"]
+        != manifest["calibration_record_refs"]
+    ):
+        reasons.append("activation-validation-missing")
+    return {"eligible": not reasons, "reasons": reasons}
+
+
+def load_outcome_judge_calibration() -> dict[str, Any]:
+    value = read_json(_CALIBRATION_PATH)
+    if not validate_activation_manifest(value):
+        raise MaestroError(
+            "OUTCOME_JUDGE_CALIBRATION_INVALID",
+            "Outcome Judge activation manifest is malformed.",
+        )
+    return value
+
+
+__all__ = [
+    "MAX_FALSE_DONE_COUNT",
+    "MAX_UNNECESSARY_CONTINUE_COUNT",
+    "OUTCOME_JUDGE_ACTIVATION_VERSION",
+    "OUTCOME_JUDGE_ACTIVATION_VALIDATION_VERSION",
+    "OUTCOME_JUDGE_CALIBRATION_CASES",
+    "OUTCOME_JUDGE_CALIBRATION_RECORD_VERSION",
+    "OUTCOME_JUDGE_OWNER_APPROVAL_VERSION",
+    "automatic_activation_eligibility",
+    "build_activation_validation",
+    "build_calibration_record",
+    "build_owner_approval",
+    "load_outcome_judge_calibration",
+    "validate_activation_manifest",
+    "validate_activation_validation",
+    "validate_calibration_record",
+    "validate_owner_approval",
+]
diff --git a/src/maestro/workflow/checkpoints.py b/src/maestro/workflow/checkpoints.py
new file mode 100644
index 0000000000000000000000000000000000000000..952aa9e683d3d6b4669943e6de20fd74e4106c43
--- /dev/null
+++ b/src/maestro/workflow/checkpoints.py
@@ -0,0 +1,179 @@
+from __future__ import annotations
+
+import copy
+from pathlib import Path
+from typing import Any
+
+from maestro.errors import MaestroError
+from maestro.util import (
+    atomic_write,
+    canonical_json,
+    pretty_json,
+    read_json,
+    sha256_text,
+)
+from maestro.work.ledger import observation_write_lock
+
+from .contracts import validate_workflow_definition
+from .kernel import (
+    replay_events,
+    validate_workflow_event,
+    validate_workflow_state,
+)
+
+
+WORKFLOW_CHECKPOINT_VERSION = "maestro_workflow_checkpoint_v1"
+
+
+def _identity(value: dict[str, Any]) -> str:
+    payload = copy.deepcopy(value)
+    payload["checkpoint_id"] = ""
+    return sha256_text(canonical_json(payload))
+
+
+def build_checkpoint(
+    definition: dict[str, Any],
+    state: dict[str, Any],
+    events: list[dict[str, Any]],
+) -> dict[str, Any]:
+    if (
+        not validate_workflow_definition(definition)
+        or not validate_workflow_state(state, definition)
+        or not isinstance(events, list)
+        or len(events) != state["revision"]
+        or not all(
+            validate_workflow_event(event, definition)
+            for event in events
+        )
+    ):
+        raise MaestroError(
+            "WORKFLOW_CHECKPOINT_INPUT_INVALID",
+            "Checkpoint requires a valid state and complete event history.",
+        )
+    replayed = replay_events(
+        definition,
+        workflow_instance_id=state["workflow_instance_id"],
+        root_request_id=state["root_request_id"],
+        events=events,
+    )
+    if replayed != state:
+        raise MaestroError(
+            "WORKFLOW_CHECKPOINT_REPLAY_MISMATCH",
+            "Checkpoint state must be exactly reproducible from events.",
+        )
+    value = {
+        "schema_version": WORKFLOW_CHECKPOINT_VERSION,
+        "checkpoint_id": "",
+        "definition_id": definition["definition_id"],
+        "workflow_instance_id": state["workflow_instance_id"],
+        "root_request_id": state["root_request_id"],
+        "revision": state["revision"],
+        "state": copy.deepcopy(state),
+        "events": copy.deepcopy(events),
+    }
+    value["checkpoint_id"] = _identity(value)
+    return value
+
+
+def validate_checkpoint(
+    value: Any,
+    definition: dict[str, Any],
+) -> bool:
+    fields = {
+        "schema_version",
+        "checkpoint_id",
+        "definition_id",
+        "workflow_instance_id",
+        "root_request_id",
+        "revision",
+        "state",
+        "events",
+    }
+    if (
+        not isinstance(value, dict)
+        or set(value) != fields
+        or value.get("schema_version")
+        != WORKFLOW_CHECKPOINT_VERSION
+        or value.get("definition_id") != definition.get("definition_id")
+        or value.get("checkpoint_id") != _identity(value)
+        or not isinstance(value.get("events"), list)
+        or value.get("revision") != len(value["events"])
+        or not validate_workflow_state(value.get("state"), definition)
+        or value["state"].get("revision") != value["revision"]
+        or value["state"].get("workflow_instance_id")
+        != value.get("workflow_instance_id")
+        or value["state"].get("root_request_id")
+        != value.get("root_request_id")
+    ):
+        return False
+    try:
+        replayed = replay_events(
+            definition,
+            workflow_instance_id=value["workflow_instance_id"],
+            root_request_id=value["root_request_id"],
+            events=value["events"],
+        )
+    except (KeyError, MaestroError, TypeError, ValueError):
+        return False
+    return replayed == value["state"]
+
+
+class WorkflowCheckpointStore:
+    def __init__(self, path: str | Path) -> None:
+        self.path = Path(path)
+
+    def load(
+        self,
+        definition: dict[str, Any],
+    ) -> dict[str, Any] | None:
+        if not self.path.exists():
+            return None
+        value = read_json(self.path)
+        if not validate_checkpoint(value, definition):
+            raise MaestroError(
+                "WORKFLOW_CHECKPOINT_INVALID",
+                "Stored workflow checkpoint is invalid or not replayable.",
+            )
+        return value
+
+    def save(
+        self,
+        definition: dict[str, Any],
+        state: dict[str, Any],
+        events: list[dict[str, Any]],
+    ) -> tuple[dict[str, Any], bool]:
+        checkpoint = build_checkpoint(definition, state, events)
+        with observation_write_lock(self.path):
+            existing = (
+                read_json(self.path)
+                if self.path.exists()
+                else None
+            )
+            if existing is not None:
+                if not validate_checkpoint(existing, definition):
+                    raise MaestroError(
+                        "WORKFLOW_CHECKPOINT_INVALID",
+                        "Stored workflow checkpoint is invalid.",
+                    )
+                if existing["checkpoint_id"] == checkpoint[
+                    "checkpoint_id"
+                ]:
+                    return existing, False
+                if existing["revision"] >= checkpoint["revision"]:
+                    raise MaestroError(
+                        "WORKFLOW_CHECKPOINT_STALE_REVISION",
+                        "Checkpoint save would overwrite equal or newer workflow history.",
+                    )
+            atomic_write(
+                self.path,
+                pretty_json(checkpoint).encode("utf-8"),
+            )
+        return checkpoint, True
+
+
+__all__ = [
+    "WORKFLOW_CHECKPOINT_VERSION",
+    "WorkflowCheckpointStore",
+    "build_checkpoint",
+    "validate_checkpoint",
+]
diff --git a/src/maestro/workflow/contracts.py b/src/maestro/workflow/contracts.py
new file mode 100644
index 0000000000000000000000000000000000000000..2063a954ae741238b68eefc75760490b0c436ab5
--- /dev/null
+++ b/src/maestro/workflow/contracts.py
@@ -0,0 +1,356 @@
+from __future__ import annotations
+
+import copy
+import re
+from typing import Any
+
+from maestro.errors import MaestroError
+from maestro.util import canonical_json, sha256_text
+
+
+WORKFLOW_DEFINITION_VERSION = "maestro_workflow_definition_v1"
+WORKFLOW_ARTIFACT_VERSION = "maestro_workflow_artifact_v1"
+WORKFLOW_COMMAND_VERSION = "maestro_workflow_command_v1"
+ARTIFACT_TYPES = {
+    "OutcomeContract",
+    "EvidencePacket",
+    "DecisionRequest",
+    "DecisionResolution",
+    "VerificationVerdict",
+    "OutcomeJudgment",
+}
+COMMAND_TYPES = {
+    "START_WORKFLOW",
+    "REGISTER_ARTIFACT",
+    "REQUEST_ACTIVITY",
+    "COMPLETE_ACTIVITY",
+    "FAIL_ACTIVITY",
+    "RECORD_STRUCTURAL_VERDICT",
+    "RECORD_OUTCOME_JUDGMENT",
+    "REQUEST_DECISION",
+    "RESOLVE_DECISION",
+    "BLOCK_WORKFLOW",
+}
+OUTCOME_VERDICTS = {
+    "DONE",
+    "CONTINUE",
+    "BLOCKED",
+    "NEEDS_DECISION",
+}
+TRANSITION_TRIGGERS = {
+    "activity_completed",
+    "outcome_continue",
+    "decision_resolved",
+}
+OUTCOME_JUDGE_MODES = {"shadow", "manual"}
+CORRECTION_INTENTS = {
+    "reopen_evidence",
+    "reopen_decision",
+    "reopen_execution",
+    "reopen_outcome",
+    "request_owner_decision",
+}
+MAX_STAGES = 32
+MAX_TRANSITIONS = 128
+MAX_CORRECTION_CYCLES = 2
+MAX_RESPONSIBILITY_BOUNDARY_EXPANSIONS = 1
+_KEY = re.compile(r"^[a-z0-9]+(?:[._-][a-z0-9]+)*$")
+
+
+def _line(value: Any, *, maximum: int = 500) -> bool:
+    return (
+        isinstance(value, str)
+        and value == value.strip()
+        and bool(value)
+        and len(value) <= maximum
+        and not any(character in value for character in "\r\n\x00")
+    )
+
+
+def digest(value: Any) -> bool:
+    return (
+        isinstance(value, str)
+        and len(value) == 64
+        and all(character in "0123456789abcdef" for character in value)
+    )
+
+
+def _identity(value: dict[str, Any], identity_field: str) -> str:
+    payload = copy.deepcopy(value)
+    payload[identity_field] = ""
+    return sha256_text(canonical_json(payload))
+
+
+def _unique_lines(
+    value: Any,
+    *,
+    maximum: int,
+    allow_empty: bool = True,
+) -> bool:
+    return (
+        isinstance(value, list)
+        and (allow_empty or bool(value))
+        and len(value) <= maximum
+        and len(value) == len(set(value))
+        and all(_line(item) for item in value)
+    )
+
+
+def validate_workflow_definition(value: Any) -> bool:
+    fields = {
+        "schema_version",
+        "definition_id",
+        "workflow_key",
+        "version",
+        "initial_stage",
+        "stages",
+        "terminal_stages",
+        "transitions",
+        "outcome_judge_mode",
+        "max_correction_cycles",
+        "max_responsibility_boundary_expansions",
+        "compatible_definition_digests",
+    }
+    if (
+        not isinstance(value, dict)
+        or set(value) != fields
+        or value.get("schema_version") != WORKFLOW_DEFINITION_VERSION
+        or not digest(value.get("definition_id"))
+        or value["definition_id"] != _identity(value, "definition_id")
+        or not _line(value.get("workflow_key"), maximum=100)
+        or _KEY.fullmatch(value["workflow_key"]) is None
+        or not isinstance(value.get("version"), int)
+        or isinstance(value.get("version"), bool)
+        or value["version"] < 1
+        or not _unique_lines(
+            value.get("stages"),
+            maximum=MAX_STAGES,
+            allow_empty=False,
+        )
+        or value.get("initial_stage") not in value["stages"]
+        or not _unique_lines(
+            value.get("terminal_stages"),
+            maximum=MAX_STAGES,
+            allow_empty=False,
+        )
+        or not set(value["terminal_stages"]).issubset(value["stages"])
+        or value.get("outcome_judge_mode")
+        not in OUTCOME_JUDGE_MODES
+        or value.get("max_correction_cycles")
+        != MAX_CORRECTION_CYCLES
+        or value.get("max_responsibility_boundary_expansions")
+        != MAX_RESPONSIBILITY_BOUNDARY_EXPANSIONS
+        or not isinstance(
+            value.get("compatible_definition_digests"), list
+        )
+        or len(value["compatible_definition_digests"]) > 16
+        or len(value["compatible_definition_digests"])
+        != len(set(value["compatible_definition_digests"]))
+        or not all(
+            digest(item)
+            for item in value["compatible_definition_digests"]
+        )
+    ):
+        return False
+    transitions = value.get("transitions")
+    if (
+        not isinstance(transitions, list)
+        or len(transitions) > MAX_TRANSITIONS
+    ):
+        return False
+    seen: set[tuple[str, str, str]] = set()
+    for transition in transitions:
+        if (
+            not isinstance(transition, dict)
+            or set(transition)
+            != {"from_stage", "to_stage", "trigger"}
+            or transition.get("from_stage") not in value["stages"]
+            or transition.get("to_stage") not in value["stages"]
+            or transition.get("trigger") not in TRANSITION_TRIGGERS
+        ):
+            return False
+        identity = (
+            transition["from_stage"],
+            transition["to_stage"],
+            transition["trigger"],
+        )
+        if identity in seen:
+            return False
+        seen.add(identity)
+    return True
+
+
+def build_workflow_definition(
+    *,
+    workflow_key: str,
+    version: int,
+    initial_stage: str,
+    stages: list[str],
+    terminal_stages: list[str],
+    transitions: list[dict[str, str]],
+    outcome_judge_mode: str = "shadow",
+    compatible_definition_digests: list[str] | None = None,
+) -> dict[str, Any]:
+    value = {
+        "schema_version": WORKFLOW_DEFINITION_VERSION,
+        "definition_id": "",
+        "workflow_key": workflow_key,
+        "version": version,
+        "initial_stage": initial_stage,
+        "stages": copy.deepcopy(stages),
+        "terminal_stages": copy.deepcopy(terminal_stages),
+        "transitions": copy.deepcopy(transitions),
+        "outcome_judge_mode": outcome_judge_mode,
+        "max_correction_cycles": MAX_CORRECTION_CYCLES,
+        "max_responsibility_boundary_expansions": (
+            MAX_RESPONSIBILITY_BOUNDARY_EXPANSIONS
+        ),
+        "compatible_definition_digests": copy.deepcopy(
+            compatible_definition_digests or []
+        ),
+    }
+    value["definition_id"] = _identity(value, "definition_id")
+    if not validate_workflow_definition(value):
+        raise MaestroError(
+            "WORKFLOW_DEFINITION_INVALID",
+            "Workflow definition violates the bounded generic contract.",
+        )
+    return value
+
+
+def validate_artifact_envelope(value: Any) -> bool:
+    fields = {
+        "schema_version",
+        "artifact_id",
+        "artifact_type",
+        "namespace",
+        "root_request_id",
+        "workflow_instance_id",
+        "payload_digest",
+        "payload_ref",
+        "producer",
+    }
+    return (
+        isinstance(value, dict)
+        and set(value) == fields
+        and value.get("schema_version") == WORKFLOW_ARTIFACT_VERSION
+        and digest(value.get("artifact_id"))
+        and value["artifact_id"] == _identity(value, "artifact_id")
+        and value.get("artifact_type") in ARTIFACT_TYPES
+        and _line(value.get("namespace"), maximum=100)
+        and _KEY.fullmatch(value["namespace"]) is not None
+        and _line(value.get("root_request_id"), maximum=200)
+        and _line(value.get("workflow_instance_id"), maximum=200)
+        and digest(value.get("payload_digest"))
+        and _line(value.get("payload_ref"), maximum=500)
+        and _line(value.get("producer"), maximum=100)
+    )
+
+
+def build_artifact_envelope(
+    *,
+    artifact_type: str,
+    namespace: str,
+    root_request_id: str,
+    workflow_instance_id: str,
+    payload_digest: str,
+    payload_ref: str,
+    producer: str,
+) -> dict[str, Any]:
+    value = {
+        "schema_version": WORKFLOW_ARTIFACT_VERSION,
+        "artifact_id": "",
+        "artifact_type": artifact_type,
+        "namespace": namespace,
+        "root_request_id": root_request_id,
+        "workflow_instance_id": workflow_instance_id,
+        "payload_digest": payload_digest,
+        "payload_ref": payload_ref,
+        "producer": producer,
+    }
+    value["artifact_id"] = _identity(value, "artifact_id")
+    if not validate_artifact_envelope(value):
+        raise MaestroError(
+            "WORKFLOW_ARTIFACT_INVALID",
+            "Artifact envelope violates the generic content-addressed contract.",
+        )
+    return value
+
+
+def validate_command(value: Any) -> bool:
+    fields = {
+        "schema_version",
+        "command_id",
+        "workflow_instance_id",
+        "root_request_id",
+        "definition_id",
+        "expected_revision",
+        "idempotency_key",
+        "command_type",
+        "payload",
+    }
+    return (
+        isinstance(value, dict)
+        and set(value) == fields
+        and value.get("schema_version") == WORKFLOW_COMMAND_VERSION
+        and digest(value.get("command_id"))
+        and value["command_id"] == _identity(value, "command_id")
+        and _line(value.get("workflow_instance_id"), maximum=200)
+        and _line(value.get("root_request_id"), maximum=200)
+        and digest(value.get("definition_id"))
+        and isinstance(value.get("expected_revision"), int)
+        and not isinstance(value.get("expected_revision"), bool)
+        and value["expected_revision"] >= 0
+        and _line(value.get("idempotency_key"), maximum=200)
+        and value.get("command_type") in COMMAND_TYPES
+        and isinstance(value.get("payload"), dict)
+    )
+
+
+def build_command(
+    *,
+    workflow_instance_id: str,
+    root_request_id: str,
+    definition_id: str,
+    expected_revision: int,
+    idempotency_key: str,
+    command_type: str,
+    payload: dict[str, Any],
+) -> dict[str, Any]:
+    value = {
+        "schema_version": WORKFLOW_COMMAND_VERSION,
+        "command_id": "",
+        "workflow_instance_id": workflow_instance_id,
+        "root_request_id": root_request_id,
+        "definition_id": definition_id,
+        "expected_revision": expected_revision,
+        "idempotency_key": idempotency_key,
+        "command_type": command_type,
+        "payload": copy.deepcopy(payload),
+    }
+    value["command_id"] = _identity(value, "command_id")
+    if not validate_command(value):
+        raise MaestroError(
+            "WORKFLOW_COMMAND_INVALID",
+            "Workflow command violates the bounded generic contract.",
+        )
+    return value
+
+
+__all__ = [
+    "ARTIFACT_TYPES",
+    "COMMAND_TYPES",
+    "MAX_CORRECTION_CYCLES",
+    "MAX_RESPONSIBILITY_BOUNDARY_EXPANSIONS",
+    "OUTCOME_VERDICTS",
+    "WORKFLOW_ARTIFACT_VERSION",
+    "WORKFLOW_COMMAND_VERSION",
+    "WORKFLOW_DEFINITION_VERSION",
+    "build_artifact_envelope",
+    "build_command",
+    "build_workflow_definition",
+    "digest",
+    "validate_artifact_envelope",
+    "validate_command",
+    "validate_workflow_definition",
+]
diff --git a/src/maestro/workflow/kernel.py b/src/maestro/workflow/kernel.py
