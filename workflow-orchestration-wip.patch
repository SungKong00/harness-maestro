+def _repository_snapshot_changed_paths(
+    repo: Path,
+    before: dict[str, Any],
+    after: dict[str, Any],
+) -> list[str]:
+    """Return exact net Git-visible paths changed during one bounded turn."""
+
+    before_paths = before.get("paths")
+    after_paths = after.get("paths")
+    if not isinstance(before_paths, dict) or not isinstance(after_paths, dict):
+        raise MaestroError(
+            "CODEX_HOST_EFFECT_AUDIT_INVALID",
+            "Repository effect snapshots must contain path fingerprints.",
+        )
+    changed = {
+        path
+        for path in set(before_paths) | set(after_paths)
+        if before_paths.get(path) != after_paths.get(path)
+    }
+    before_head = before.get("head")
+    after_head = after.get("head")
+    if (
+        isinstance(before_head, str)
+        and isinstance(after_head, str)
+        and before_head != after_head
+    ):
+        completed = subprocess.run(
+            [
+                "git",
+                "-C",
+                str(repo.resolve()),
+                "diff",
+                "--name-only",
+                "-z",
+                before_head,
+                after_head,
+                "--",
+            ],
+            check=True,
+            capture_output=True,
+            timeout=20,
+        )
+        changed.update(
+            value.decode("utf-8", errors="surrogateescape")
+            for value in completed.stdout.split(b"\0")
+            if value
+        )
+    return sorted(changed)
+
