+def route_source_binding(
+    policy: dict[str, Any],
+    *,
+    risk: str = "high",
+    intent: str = "review",
+    allowed_side_effects: list[str] | None = None,
+) -> dict[str, Any]:
+    return build_workflow_source_binding(
+        policy,
+        route_plan_id="a" * 64,
+        source_route_digest="b" * 64,
+        goal_digest="c" * 64,
+        route_risk=risk,
+        route_intent=intent,
+        task_contract={
+            "allowed_side_effects": allowed_side_effects or [],
+            "workflow_policy": policy,
+        },
+    )
