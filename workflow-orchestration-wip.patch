--- /dev/null
+++ b/src/maestro/workflow/outcomes.py
@@ -0,0 +1,358 @@
+from __future__ import annotations
+
+import copy
+import re
+from typing import Any, Callable
+
+from maestro.errors import MaestroError
+from maestro.util import canonical_json, sha256_text
+
+from .contracts import CORRECTION_INTENTS, OUTCOME_VERDICTS, digest
+
+
+OUTCOME_CONTRACT_VERSION = "maestro_outcome_contract_v1"
+OUTCOME_JUDGMENT_VERSION = "maestro_outcome_judgment_v1"
+CRITERION_STATUSES = {"met", "not_met", "unknown"}
+_NAMESPACED_CODE = re.compile(
+    r"^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
+)
+
+
+def _line(value: Any, *, maximum: int = 2000) -> bool:
+    return (
+        isinstance(value, str)
+        and value == value.strip()
+        and bool(value)
+        and len(value) <= maximum
+        and not any(character in value for character in "\r\n\x00")
+    )
+
+
+def _identity(value: dict[str, Any], field: str) -> str:
+    payload = copy.deepcopy(value)
+    payload[field] = ""
+    return sha256_text(canonical_json(payload))
+
+
+def validate_outcome_contract(value: Any) -> bool:
+    fields = {
+        "schema_version",
+        "contract_id",
+        "outcome_statement",
+        "primary_user",
+        "job_to_be_done",
+        "success_criteria",
+        "rejection_conditions",
+        "constraints",
+        "authority",
+    }
+    if (
+        not isinstance(value, dict)
+        or set(value) != fields
+        or value.get("schema_version") != OUTCOME_CONTRACT_VERSION
+        or not digest(value.get("contract_id"))
+        or value["contract_id"] != _identity(value, "contract_id")
+        or not _line(value.get("outcome_statement"))
+        or not _line(value.get("primary_user"))
+        or not _line(value.get("job_to_be_done"))
+        or value.get("authority")
+        not in {"request-derived", "owner-confirmed"}
+    ):
+        return False
+    criteria = value.get("success_criteria")
+    if (
+        not isinstance(criteria, list)
+        or not criteria
+        or len(criteria) > 16
+    ):
+        return False
+    criterion_ids: set[str] = set()
+    for criterion in criteria:
+        if (
+            not isinstance(criterion, dict)
+            or set(criterion)
+            != {
+                "criterion_id",
+                "statement",
+                "evidence_requirements",
+            }
+            or not _line(
+                criterion.get("criterion_id"), maximum=100
+            )
+            or criterion["criterion_id"] in criterion_ids
+            or not _line(criterion.get("statement"))
+            or not isinstance(
+                criterion.get("evidence_requirements"), list
+            )
+            or not criterion["evidence_requirements"]
+            or len(criterion["evidence_requirements"]) > 16
+            or len(criterion["evidence_requirements"])
+            != len(set(criterion["evidence_requirements"]))
+            or not all(
+                _line(item)
+                for item in criterion["evidence_requirements"]
+            )
+        ):
+            return False
+        criterion_ids.add(criterion["criterion_id"])
+    for field, allow_empty in (
+        ("rejection_conditions", False),
+        ("constraints", True),
+    ):
+        items = value.get(field)
+        if (
+            not isinstance(items, list)
+            or (not allow_empty and not items)
+            or len(items) > 32
+            or len(items) != len(set(items))
+            or not all(_line(item) for item in items)
+        ):
+            return False
+    return True
+
+
+def build_outcome_contract(
+    *,
+    outcome_statement: str,
+    primary_user: str,
+    job_to_be_done: str,
+    success_criteria: list[dict[str, Any]],
+    rejection_conditions: list[str],
+    constraints: list[str],
+    authority: str,
+) -> dict[str, Any]:
+    value = {
+        "schema_version": OUTCOME_CONTRACT_VERSION,
+        "contract_id": "",
+        "outcome_statement": outcome_statement,
+        "primary_user": primary_user,
+        "job_to_be_done": job_to_be_done,
+        "success_criteria": copy.deepcopy(success_criteria),
+        "rejection_conditions": copy.deepcopy(
+            rejection_conditions
+        ),
+        "constraints": copy.deepcopy(constraints),
+        "authority": authority,
+    }
+    value["contract_id"] = _identity(value, "contract_id")
+    if not validate_outcome_contract(value):
+        raise MaestroError(
+            "OUTCOME_CONTRACT_INVALID",
+            "Outcome Contract must capture observable user results and evidence requirements.",
+        )
+    return value
+
+
+def validate_outcome_judgment(
+    value: Any,
+    outcome_contract: dict[str, Any],
+) -> bool:
+    fields = {
+        "schema_version",
+        "judgment_id",
+        "outcome_contract_id",
+        "outcome_contract_digest",
+        "structural_verdict_artifact_id",
+        "result_artifact_ids",
+        "criteria_assessments",
+        "failure_codes",
+        "verdict",
+        "correction_intent",
+        "summary",
+        "mode",
+        "writes_performed",
+    }
+    if (
+        not validate_outcome_contract(outcome_contract)
+        or not isinstance(value, dict)
+        or set(value) != fields
+        or value.get("schema_version")
+        != OUTCOME_JUDGMENT_VERSION
+        or not digest(value.get("judgment_id"))
+        or value["judgment_id"] != _identity(value, "judgment_id")
+        or value.get("outcome_contract_id")
+        != outcome_contract["contract_id"]
+        or value.get("outcome_contract_digest")
+        != sha256_text(canonical_json(outcome_contract))
+        or not digest(
+            value.get("structural_verdict_artifact_id")
+        )
+        or not isinstance(value.get("result_artifact_ids"), list)
+        or not value["result_artifact_ids"]
+        or len(value["result_artifact_ids"]) > 32
+        or len(value["result_artifact_ids"])
+        != len(set(value["result_artifact_ids"]))
+        or not all(
+            digest(item) for item in value["result_artifact_ids"]
+        )
+        or value.get("verdict") not in OUTCOME_VERDICTS
+        or (
+            value.get("correction_intent") is not None
+            and not _line(
+                value["correction_intent"], maximum=100
+            )
+        )
+        or not _line(value.get("summary"))
+        or value.get("mode") not in {"shadow", "manual"}
+        or value.get("writes_performed") is not False
+    ):
+        return False
+    expected_ids = [
+        criterion["criterion_id"]
+        for criterion in outcome_contract["success_criteria"]
+    ]
+    assessments = value.get("criteria_assessments")
+    if (
+        not isinstance(assessments, list)
+        or len(assessments) != len(expected_ids)
+    ):
+        return False
+    actual_ids: list[str] = []
+    statuses: list[str] = []
+    for assessment in assessments:
+        if (
+            not isinstance(assessment, dict)
+            or set(assessment)
+            != {
+                "criterion_id",
+                "status",
+                "evidence_artifact_ids",
+                "finding",
+            }
+            or assessment.get("status")
+            not in CRITERION_STATUSES
+            or not isinstance(
+                assessment.get("evidence_artifact_ids"), list
+            )
+            or not assessment["evidence_artifact_ids"]
+            or len(assessment["evidence_artifact_ids"]) > 16
+            or len(assessment["evidence_artifact_ids"])
+            != len(set(assessment["evidence_artifact_ids"]))
+            or not all(
+                digest(item)
+                for item in assessment[
+                    "evidence_artifact_ids"
+                ]
+            )
+            or not _line(assessment.get("finding"))
+        ):
+            return False
+        actual_ids.append(assessment["criterion_id"])
+        statuses.append(assessment["status"])
+    failure_codes = value.get("failure_codes")
+    if (
+        actual_ids != expected_ids
+        or not isinstance(failure_codes, list)
+        or len(failure_codes) > 32
+        or len(failure_codes) != len(set(failure_codes))
+        or any(
+            not _line(code, maximum=100)
+            or _NAMESPACED_CODE.fullmatch(code) is None
+            for code in failure_codes
+        )
+    ):
+        return False
+    if value["verdict"] == "DONE":
+        return (
+            set(statuses) == {"met"}
+            and not failure_codes
+            and value["correction_intent"] is None
+        )
+    if (
+        value["verdict"] == "CONTINUE"
+        and value["correction_intent"]
+        not in CORRECTION_INTENTS - {"request_owner_decision"}
+    ):
+        return False
+    if value["verdict"] == "NEEDS_DECISION" and (
+        value["correction_intent"] != "request_owner_decision"
+    ):
+        return False
+    if value["verdict"] == "BLOCKED" and value["correction_intent"] is not None:
+        return False
+    return bool(failure_codes)
+
+
+def build_outcome_judgment(
+    draft: dict[str, Any],
+    *,
+    outcome_contract: dict[str, Any],
+    structural_verdict_artifact_id: str,
+    result_artifact_ids: list[str],
+    mode: str,
+) -> dict[str, Any]:
+    draft_fields = {
+        "criteria_assessments",
+        "failure_codes",
+        "verdict",
+        "correction_intent",
+        "summary",
+    }
+    if not isinstance(draft, dict) or set(draft) != draft_fields:
+        raise MaestroError(
+            "OUTCOME_JUDGMENT_DRAFT_INVALID",
+            "Outcome Judge draft fields are incomplete or unsupported.",
+        )
+    value = {
+        "schema_version": OUTCOME_JUDGMENT_VERSION,
+        "judgment_id": "",
+        "outcome_contract_id": outcome_contract["contract_id"],
+        "outcome_contract_digest": sha256_text(
+            canonical_json(outcome_contract)
+        ),
+        "structural_verdict_artifact_id": (
+            structural_verdict_artifact_id
+        ),
+        "result_artifact_ids": copy.deepcopy(result_artifact_ids),
+        **copy.deepcopy(draft),
+        "mode": mode,
+        "writes_performed": False,
+    }
+    value["judgment_id"] = _identity(value, "judgment_id")
+    if not validate_outcome_judgment(value, outcome_contract):
+        raise MaestroError(
+            "OUTCOME_JUDGMENT_INVALID",
+            "Outcome Judgment must assess every initial criterion with concrete evidence.",
+        )
+    return value
+
+
+def run_read_only_outcome_judge(
+    outcome_contract: dict[str, Any],
+    *,
+    structural_verdict_artifact_id: str,
+    result_artifact_ids: list[str],
+    evaluator: Callable[
+        [dict[str, Any], list[str]], dict[str, Any]
+    ],
+    mode: str = "shadow",
+) -> dict[str, Any]:
+    if not validate_outcome_contract(outcome_contract):
+        raise MaestroError(
+            "OUTCOME_CONTRACT_INVALID",
+            "Completion Judge requires the exact initial Outcome Contract.",
+        )
+    draft = evaluator(
+        copy.deepcopy(outcome_contract),
+        copy.deepcopy(result_artifact_ids),
+    )
+    return build_outcome_judgment(
+        draft,
+        outcome_contract=outcome_contract,
+        structural_verdict_artifact_id=(
+            structural_verdict_artifact_id
+        ),
+        result_artifact_ids=result_artifact_ids,
+        mode=mode,
+    )
+
+
+__all__ = [
+    "OUTCOME_CONTRACT_VERSION",
+    "OUTCOME_JUDGMENT_VERSION",
+    "build_outcome_contract",
+    "build_outcome_judgment",
+    "run_read_only_outcome_judge",
+    "validate_outcome_contract",
+    "validate_outcome_judgment",
+]
