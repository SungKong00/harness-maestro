+            "ORCH_WORKFLOW_SOURCE_BINDING_REQUIRED",
+            "Route-derived Controller starts require the exact validated Route v2 source binding.",
+        )
+    if expected_workflow_source_binding is not None:
+        expected_source_binding = _validate_workflow_source_binding(
+            expected_workflow_source_binding,
+            workflow_policy=policy,
