+                    "thread_id": thread_id,
+                    "session_id": (
+                        thread["sessionId"]
+                        if isinstance(thread.get("sessionId"), str)
+                        and thread["sessionId"]
+                        else "not_observed"
+                    ),
+                    "method": method,
+                },
+                runtime_binding={
+                    "source_interface": "codex-app-server",
+                    "runtime_version": runtime_version,
+                    "generated_schema_sha256": runtime_schema_digest,
+                    "coverage": "complete_stream",
+                },
+                host_returned={
+                    "model": observed["applied"]["model"],
+                    "reasoning_effort": observed["applied"][
+                        "reasoning_effort"
+                    ],
+                    "sandbox": returned_boundary["sandbox"],
+                    "approval_policy": returned_boundary[
+                        "approval_policy"
+                    ],
+                    "cwd": str(Path(returned_boundary["cwd"]).resolve()),
+                    "runtime_workspace_roots": returned_runtime_roots,
+                },
+                method_evidence={
+                    "request_sha256": sha256_text(
+                        canonical_json(thread_params)
+                    ),
+                    "response_sha256": sha256_text(
+                        canonical_json(thread_result)
+                    ),
+                },
+            )
+            before_snapshot = (
+                _repository_change_snapshot(self.repo)
+                if mutation
+                else _repository_effect_snapshot(self.repo)
+            )
+            return CodexHostSession(
+                repo=self.repo,
+                server=server,
+                definition=definition,
+                state=state,
+                stage=stage,
+                role=role,
+                executor=executor,
+                participant_receipt=receipt,
+                thread_id=thread_id,
+                runtime_binding=runtime_binding,
+                sandbox_policy=sandbox_policy,
+                runtime_workspace_roots=runtime_workspace_roots,
+                timeout_seconds=stage_timeout,
+                before_snapshot=before_snapshot,
+                mutation=mutation,
+            )
+        except Exception:
+            server.close()
+            raise
