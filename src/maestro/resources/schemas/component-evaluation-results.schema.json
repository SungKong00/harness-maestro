{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sungkong00.github.io/harness-maestro/schemas/component-evaluation-results.schema.json",
  "title": "Harness Maestro Registry component evaluation results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "definition_sha256",
    "cases_sha256",
    "evaluator",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "maestro_component_evaluation_results_v1"
    },
    "candidate_id": {
      "$ref": "#/$defs/id"
    },
    "definition_sha256": {
      "$ref": "#/$defs/digest"
    },
    "cases_sha256": {
      "$ref": "#/$defs/digest"
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "authoring_run_ref",
        "evaluation_run_ref",
        "observation_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fresh-context",
            "human"
          ]
        },
        "authoring_run_ref": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_run_ref": {
          "type": "string",
          "minLength": 1
        },
        "observation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 3,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "observed_outcome",
          "evidence_refs",
          "forbidden_behavior_results",
          "verdict"
        ],
        "properties": {
          "case_id": {
            "$ref": "#/$defs/id"
          },
          "observed_outcome": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden_behavior_results": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "behavior",
                "observed",
                "evidence_ref"
              ],
              "properties": {
                "behavior": {
                  "type": "string",
                  "minLength": 1
                },
                "observed": {
                  "const": false
                },
                "evidence_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "verdict": {
            "const": "pass"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
