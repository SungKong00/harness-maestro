{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sungkong00.github.io/harness-maestro/schemas/domain-index.schema.json",
  "title": "Harness Maestro Lens Domain Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domains"
  ],
  "properties": {
    "schema_version": {
      "const": "maestro_domain_index_v1"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "summary"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
