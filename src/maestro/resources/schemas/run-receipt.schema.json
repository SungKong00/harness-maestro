{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sungkong00.github.io/harness-maestro/schemas/run-receipt.schema.json",
  "title": "Harness Maestro Compact RunReceipt Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "risk",
    "route_depth",
    "selected_lenses",
    "executor_runs",
    "primary_executor_id",
    "executor_ids",
    "outcome",
    "evidence_refs",
    "duration_ms",
    "tokens",
    "correction_count",
    "agent_calls",
    "verifier_result",
    "command_artifact_ref"
  ],
  "properties": {
    "kind": {
      "enum": [
        "review_finding",
        "verification_failure",
        "correction",
        "run_summary"
      ],
      "default": "run_summary"
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "finding_severity": {
      "enum": [
        "medium",
        "high",
        "critical",
        null
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "route_depth": {
      "enum": [
        "fast",
        "standard",
        "deep"
      ]
    },
    "selected_lenses": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selected_expertise_packs": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selected_decision_guides": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expertise_research_mode": {
      "enum": [
        "reuse",
        "contextualize",
        "refresh",
        "discover"
      ]
    },
    "expertise_research_gate": {
      "enum": [
        "not-required",
        "satisfied",
        "in-plan",
        "open"
      ]
    },
    "executor_runs": {
      "type": "integer",
      "minimum": 1
    },
    "primary_executor_id": {
      "type": "string",
      "minLength": 1
    },
    "executor_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outcome": {
      "enum": [
        "completed",
        "failed",
        "corrected",
        "blocked",
        "no_change"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "duration_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "tokens": {
      "type": [
        "object",
        "null"
      ]
    },
    "experiment_id": {
      "type": "string"
    },
    "experiment_arm": {
      "type": "string"
    },
    "correction_count": {
      "type": "integer",
      "minimum": 0
    },
    "correction_summary": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "agent_calls": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "human_fix_required": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "decision_changed": {
      "type": "boolean"
    },
    "verifier_result": {
      "enum": [
        "passed",
        "failed",
        "not_run"
      ]
    },
    "command_artifact_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "plan_summary": {
      "$ref": "#/$defs/planSummary"
    },
    "stage_results": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/stageResult"
      }
    },
    "expertise_observations": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/expertiseObservation"
      }
    },
    "host_observation": {
      "$ref": "#/$defs/hostObservation"
    },
    "project_convention_action": {
      "enum": [
        "none",
        "created",
        "updated",
        "candidate",
        "needs_decision"
      ]
    },
    "project_convention_basis": {
      "enum": [
        "none",
        "same_run_candidate",
        "owner_decision",
        "held_out_evaluation"
      ],
      "default": "none"
    },
    "project_convention_path": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^docs/conventions/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.md$"
    },
    "project_convention_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "convention_sha256",
        "kind",
        "artifact"
      ],
      "properties": {
        "convention_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "owner_decision",
            "held_out_evaluation"
          ]
        },
        "decision_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "owner_decision"
            }
          },
          "required": [
            "decision_summary"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "held_out_evaluation"
            }
          },
          "not": {
            "required": [
              "decision_summary"
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hostObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "quality",
        "correlation_id",
        "actual_model",
        "tokens",
        "observed_at"
      ],
      "properties": {
        "schema_version": {
          "const": "maestro_host_observation_v1"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "quality": {
          "enum": [
            "host_reported",
            "host_delta"
          ]
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "actual_model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "tokens": {
          "$ref": "#/$defs/tokenSummary"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "anyOf": [
        {
          "required": [
            "actual_model"
          ],
          "properties": {
            "actual_model": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "tokens"
          ],
          "properties": {
            "tokens": {
              "type": "object"
            }
          }
        }
      ]
    },
    "tokenSummary": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total"
          ],
          "properties": {
            "input": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "output": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "cached": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "reasoning": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "total": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "parent_context_total": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "total_system": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      ]
    },
    "planSummary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "schema_version",
        "plan_id",
        "intent",
        "department",
        "assignments",
        "research"
      ],
      "properties": {
        "schema_version": {
          "const": "maestro_plan_summary_v1"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "department": {
          "type": "string",
          "minLength": 1
        },
        "assignments": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assignment_id",
              "kind",
              "executor_id",
              "depends_on",
              "planned_model",
              "reasoning_effort",
              "expertise_pack_ids",
              "decision_guide_ids"
            ],
            "properties": {
              "assignment_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "executor_id": {
                "type": "string",
                "minLength": 1
              },
              "depends_on": {
                "$ref": "#/$defs/stringList"
              },
              "planned_model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "reasoning_effort": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max",
                  "ultra"
                ]
              },
              "expertise_pack_ids": {
                "type": "array",
                "maxItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "decision_guide_ids": {
                "type": "array",
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "research": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "gate"
          ],
          "properties": {
            "mode": {
              "enum": [
                "reuse",
                "contextualize",
                "refresh",
                "discover"
              ]
            },
            "gate": {
              "enum": [
                "not-required",
                "satisfied",
                "in-plan",
                "open"
              ]
            }
          }
        }
      }
    },
    "stageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_id",
        "status",
        "actual_model",
        "duration_ms",
        "tokens",
        "evidence_refs"
      ],
      "properties": {
        "assignment_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "blocked",
            "skipped"
          ]
        },
        "actual_model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "duration_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tokens": {
          "$ref": "#/$defs/tokenSummary"
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expertiseObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "domain",
        "pack_id",
        "guide_id",
        "severity",
        "reusable",
        "resolution",
        "evidence_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "missing_pack",
            "missing_guide",
            "stale_guide",
            "trigger_miss",
            "unnecessary_research"
          ]
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "pack_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "guide_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "enum": [
            "medium",
            "high",
            "critical"
          ]
        },
        "reusable": {
          "type": "boolean"
        },
        "resolution": {
          "enum": [
            "reuse",
            "research",
            "manual_correction",
            "unresolved"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "project_convention_action": {
            "enum": [
              "created",
              "updated"
            ]
          }
        },
        "required": [
          "project_convention_action"
        ]
      },
      "then": {
        "required": [
          "project_convention_basis",
          "project_convention_path",
          "project_convention_evidence"
        ],
        "properties": {
          "project_convention_basis": {
            "enum": [
              "owner_decision",
              "held_out_evaluation"
            ]
          },
          "verifier_result": {
            "const": "passed"
          },
          "command_artifact_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "project_convention_action": {
            "enum": [
              "candidate",
              "needs_decision"
            ]
          }
        },
        "required": [
          "project_convention_action"
        ]
      },
      "then": {
        "required": [
          "project_convention_basis"
        ],
        "properties": {
          "project_convention_basis": {
            "const": "same_run_candidate"
          },
          "project_convention_path": {
            "type": "null"
          },
          "project_convention_evidence": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "review_finding",
              "verification_failure",
              "correction"
            ]
          }
        }
      },
      "then": {
        "required": [
          "fingerprint",
          "finding_severity"
        ],
        "properties": {
          "finding_severity": {
            "enum": [
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "run_summary"
          }
        }
      },
      "then": {
        "properties": {
          "finding_severity": {
            "type": "null"
          }
        }
      }
    }
  ]
}
