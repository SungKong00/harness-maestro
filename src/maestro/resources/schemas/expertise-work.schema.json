{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sungkong00.github.io/harness-maestro/schemas/expertise-work.schema.json",
  "title": "Harness Maestro multi-Pack work contracts",
  "oneOf": [
    {
      "$ref": "#/$defs/workPlan"
    },
    {
      "$ref": "#/$defs/workPacket"
    },
    {
      "$ref": "#/$defs/workClosure"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "idList": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "lineList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "workBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "responsibility",
        "pack_id",
        "guide_ids",
        "coverage_pair_ids",
        "depends_on",
        "external_prerequisite_item_ids",
        "read_only",
        "may_spawn",
        "model_route"
      ],
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/id"
        },
        "responsibility": {
          "$ref": "#/$defs/line"
        },
        "pack_id": {
          "$ref": "#/$defs/id"
        },
        "guide_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "coverage_pair_ids": {
          "$ref": "#/$defs/idList"
        },
        "depends_on": {
          "$ref": "#/$defs/idList"
        },
        "external_prerequisite_item_ids": {
          "$ref": "#/$defs/idList"
        },
        "read_only": {
          "const": true
        },
        "may_spawn": {
          "const": false
        },
        "model_route": {
          "$ref": "route-v2.schema.json#/$defs/compatibleModelRoute"
        }
      }
    },
    "legacyWorkBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "responsibility",
        "pack_id",
        "guide_ids",
        "coverage_pair_ids",
        "depends_on",
        "external_prerequisite_item_ids",
        "read_only",
        "may_spawn"
      ],
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/id"
        },
        "responsibility": {
          "$ref": "#/$defs/line"
        },
        "pack_id": {
          "$ref": "#/$defs/id"
        },
        "guide_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "coverage_pair_ids": {
          "$ref": "#/$defs/idList"
        },
        "depends_on": {
          "$ref": "#/$defs/idList"
        },
        "external_prerequisite_item_ids": {
          "$ref": "#/$defs/idList"
        },
        "read_only": {
          "const": true
        },
        "may_spawn": {
          "const": false
        }
      }
    },
    "compatibleWorkBatch": {
      "oneOf": [
        {
          "$ref": "#/$defs/workBatch"
        },
        {
          "$ref": "#/$defs/legacyWorkBatch"
        }
      ]
    },
    "workPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "work_plan_id",
        "coverage_id",
        "source_plan_id",
        "goal_digest",
        "pairs",
        "pack_research_requirements",
        "batches",
        "parallel_groups",
        "pair_assignment_policy",
        "writer_authority",
        "writes_performed"
      ],
      "properties": {
        "schema_version": {
          "const": "maestro_expertise_work_plan_v1"
        },
        "work_plan_id": {
          "$ref": "#/$defs/digest"
        },
        "coverage_id": {
          "$ref": "#/$defs/digest"
        },
        "source_plan_id": {
          "$ref": "#/$defs/digest"
        },
        "goal_digest": {
          "$ref": "#/$defs/digest"
        },
        "pairs": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object"
          }
        },
        "pack_research_requirements": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pack_id",
              "guide_ids",
              "pack_definition_digest",
              "mode",
              "reasons",
              "gate",
              "evidence_digest"
            ],
            "properties": {
              "pack_id": {
                "$ref": "#/$defs/id"
              },
              "guide_ids": {
                "$ref": "#/$defs/idList"
              },
              "pack_definition_digest": {
                "$ref": "#/$defs/digest"
              },
              "mode": {
                "enum": [
                  "reuse",
                  "contextualize",
                  "refresh"
                ]
              },
              "reasons": {
                "$ref": "#/$defs/lineList"
              },
              "gate": {
                "enum": [
                  "not-required",
                  "satisfied"
                ]
              },
              "evidence_digest": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/digest"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "batches": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/compatibleWorkBatch"
          }
        },
        "parallel_groups": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/idList"
          }
        },
        "pair_assignment_policy": {
          "const": "exactly-once"
        },
        "writer_authority": {
          "const": "NONE"
        },
        "writes_performed": {
          "const": false
        }
      }
    },
    "workPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "packet_digest",
        "work_plan_id",
        "batch_id",
        "status",
        "coverage_pair_ids",
        "criteria_applied",
        "recommendations",
        "evidence_refs",
        "conflicts",
        "unresolved",
        "writes_performed"
      ],
      "properties": {
        "schema_version": {
          "const": "maestro_expertise_work_packet_v1"
        },
        "packet_digest": {
          "$ref": "#/$defs/digest"
        },
        "work_plan_id": {
          "$ref": "#/$defs/digest"
        },
        "batch_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "completed",
            "blocked",
            "failed"
          ]
        },
        "coverage_pair_ids": {
          "$ref": "#/$defs/idList"
        },
        "criteria_applied": {
          "$ref": "#/$defs/lineList"
        },
        "recommendations": {
          "$ref": "#/$defs/lineList"
        },
        "evidence_refs": {
          "$ref": "#/$defs/lineList"
        },
        "conflicts": {
          "$ref": "#/$defs/lineList"
        },
        "unresolved": {
          "$ref": "#/$defs/lineList"
        },
        "writes_performed": {
          "const": false
        }
      }
    },
    "workClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "closure_id",
        "work_plan_id",
        "coverage_id",
        "source_plan_id",
        "status",
        "expected_pair_ids",
        "terminal_pair_ids",
        "batch_results",
        "conflicts",
        "unresolved",
        "execution_authority",
        "writes_performed"
      ],
      "properties": {
        "schema_version": {
          "const": "maestro_expertise_work_closure_v1"
        },
        "closure_id": {
          "$ref": "#/$defs/digest"
        },
        "work_plan_id": {
          "$ref": "#/$defs/digest"
        },
        "coverage_id": {
          "$ref": "#/$defs/digest"
        },
        "source_plan_id": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "enum": [
            "READY",
            "BLOCKED"
          ]
        },
        "expected_pair_ids": {
          "$ref": "#/$defs/idList"
        },
        "terminal_pair_ids": {
          "$ref": "#/$defs/idList"
        },
        "batch_results": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object"
          }
        },
        "conflicts": {
          "$ref": "#/$defs/lineList"
        },
        "unresolved": {
          "$ref": "#/$defs/lineList"
        },
        "execution_authority": {
          "const": "NONE"
        },
        "writes_performed": {
          "const": false
        }
      }
    }
  }
}
