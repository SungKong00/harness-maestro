{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sungkong00.github.io/harness-maestro/schemas/review-packet.schema.json",
  "title": "Harness Maestro Review Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "objective",
    "acceptance_criteria",
    "changed_artifacts",
    "relevant_conventions",
    "known_constraints",
    "selected_lens",
    "evidence_refs",
    "token_budget"
  ],
  "properties": {
    "schema_version": {
      "const": "maestro_review_packet_v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relevant_conventions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_lens": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "token_budget": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  }
}
