{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sungkong00.github.io/harness-maestro/schemas/event.schema.json",
  "title": "Harness Maestro Compact Operational Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "timestamp",
    "project_id",
    "checkout_id",
    "run_id",
    "framework_version",
    "registry_digest",
    "lens_definition_digests",
    "executor_definition_digests",
    "risk",
    "route_depth",
    "selected_lenses",
    "executor_runs",
    "primary_executor_id",
    "executor_ids",
    "kind",
    "outcome",
    "fingerprint",
    "evidence_refs",
    "duration_ms",
    "tokens",
    "correction_count",
    "agent_calls",
    "human_fix_required",
    "finding_severity",
    "decision_changed",
    "verifier_result",
    "command_artifact_ref",
    "project_convention_action",
    "project_convention_basis",
    "project_convention_path"
  ],
  "properties": {
    "schema_version": {
      "const": "maestro_event_v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "checkout_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "framework_version": {
      "type": "string",
      "minLength": 1
    },
    "registry_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lens_definition_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "executor_definition_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "expertise_pack_definition_digests": {
      "type": "object",
      "maxProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "route_depth": {
      "enum": [
        "fast",
        "standard",
        "deep"
      ]
    },
    "selected_lenses": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selected_expertise_packs": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selected_decision_guides": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expertise_research_mode": {
      "enum": [
        "reuse",
        "contextualize",
        "refresh",
        "discover"
      ]
    },
    "expertise_research_gate": {
      "enum": [
        "not-required",
        "satisfied",
        "in-plan",
        "open"
      ]
    },
    "executor_runs": {
      "type": "integer",
      "minimum": 1
    },
    "primary_executor_id": {
      "type": "string",
      "minLength": 1
    },
    "executor_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "kind": {
      "enum": [
        "review_finding",
        "verification_failure",
        "correction",
        "run_summary"
      ]
    },
    "outcome": {
      "enum": [
        "completed",
        "failed",
        "corrected",
        "blocked",
        "no_change"
      ]
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "duration_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "tokens": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total"
          ],
          "properties": {
            "input": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "output": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "cached": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "reasoning": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "total": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "parent_context_total": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "total_system": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      ]
    },
    "experiment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "experiment_arm": {
      "type": [
        "string",
        "null"
      ]
    },
    "correction_count": {
      "type": "integer",
      "minimum": 0
    },
    "correction_summary": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "agent_calls": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "human_fix_required": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "finding_severity": {
      "enum": [
        "medium",
        "high",
        "critical",
        null
      ]
    },
    "decision_changed": {
      "type": "boolean"
    },
    "verifier_result": {
      "enum": [
        "passed",
        "failed",
        "not_run"
      ]
    },
    "command_artifact_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "task_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "plan_summary": {
      "$ref": "#/$defs/planSummary"
    },
    "stage_results": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/stageResult"
      }
    },
    "expertise_observations": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/expertiseObservation"
      }
    },
    "host_observation": {
      "$ref": "#/$defs/hostObservation"
    },
    "project_convention_action": {
      "enum": [
        "none",
        "created",
        "updated",
        "candidate",
        "needs_decision"
      ]
    },
    "project_convention_basis": {
      "enum": [
        "none",
        "same_run_candidate",
        "owner_decision",
        "held_out_evaluation"
      ]
    },
    "project_convention_path": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^docs/conventions/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.md$"
    },
    "project_convention_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "convention_sha256",
        "kind",
        "assurance",
        "artifact"
      ],
      "properties": {
        "convention_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "enum": [
            "owner_decision",
            "held_out_evaluation"
          ]
        },
        "assurance": {
          "enum": [
            "owner_attested",
            "held_out_verified"
          ]
        },
        "decision_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "convention_usage": {
      "$ref": "#/$defs/conventionUsage"
    }
  },
  "$defs": {
    "conventionUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "selection_digest",
        "items"
      ],
      "properties": {
        "schema_version": {
          "const": "maestro_convention_usage_v1"
        },
        "selection_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "items": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/conventionUsageItem"
          }
        }
      }
    },
    "conventionUsageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "disposition",
        "reason",
        "approval_ref"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/conventions/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.md$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "disposition": {
          "enum": [
            "applied",
            "not_applicable",
            "waived",
            "conflict"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "approval_ref": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^owner_decision:\\S.+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "stringList": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hostObservation": {
      "oneOf": [
        {
          "$ref": "#/$defs/legacyHostObservation"
        },
        {
          "$ref": "#/$defs/hostObservationV2"
        }
      ]
    },
    "legacyHostObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "quality",
        "correlation_id",
        "actual_model",
        "tokens",
        "observed_at"
      ],
      "properties": {
        "schema_version": {
          "const": "maestro_host_observation_v1"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "quality": {
          "enum": [
            "host_reported",
            "host_delta"
          ]
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "actual_model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "tokens": {
          "$ref": "#/$defs/tokenSummary"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "anyOf": [
        {
          "required": [
            "actual_model"
          ],
          "properties": {
            "actual_model": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "tokens"
          ],
          "properties": {
            "tokens": {
              "type": "object"
            }
          }
        }
      ]
    },
    "hostObservationV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source",
        "quality",
        "correlation_id",
        "requested_model",
        "applied_model",
        "model_event_evidence",
        "reroutes",
        "tokens",
        "observed_at"
      ],
      "properties": {
        "schema_version": {
          "const": "maestro_host_observation_v2"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "quality": {
          "enum": [
            "host_reported",
            "host_delta"
          ]
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "requested_model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "requested_reasoning_effort": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "reasoning_effort_evidence": {
          "enum": [
            "unavailable",
            "host_request"
          ]
        },
        "applied_model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "model_event_evidence": {
          "enum": [
            "unavailable",
            "complete"
          ]
        },
        "reroutes": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from_model",
              "to_model",
              "reason"
            ],
            "properties": {
              "from_model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "to_model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[^\\r\\n\\u0000]+$"
              }
            }
          }
        },
        "tokens": {
          "$ref": "#/$defs/tokenSummary"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "anyOf": [
        {
          "required": [
            "requested_model"
          ],
          "properties": {
            "requested_model": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "applied_model"
          ],
          "properties": {
            "applied_model": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "tokens"
          ],
          "properties": {
            "tokens": {
              "type": "object"
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "model_event_evidence": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "applied_model": {
                "type": "null"
              },
              "reroutes": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "model_event_evidence": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "requested_model": {
                "type": "string"
              },
              "applied_model": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "tokenSummary": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total"
          ],
          "properties": {
            "input": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "output": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "cached": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "reasoning": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "total": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "parent_context_total": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "total_system": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      ]
    },
    "planSummary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "schema_version",
        "plan_id",
        "intent",
        "department",
        "assignments",
        "research"
      ],
      "properties": {
        "schema_version": {
          "const": "maestro_plan_summary_v1"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "department": {
          "type": "string",
          "minLength": 1
        },
        "assignments": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assignment_id",
              "kind",
              "executor_id",
              "depends_on",
              "planned_model",
              "reasoning_effort",
              "expertise_pack_ids",
              "decision_guide_ids"
            ],
            "properties": {
              "assignment_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "executor_id": {
                "type": "string",
                "minLength": 1
              },
              "depends_on": {
                "$ref": "#/$defs/stringList"
              },
              "planned_model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "reasoning_effort": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max",
                  "ultra"
                ]
              },
              "expertise_pack_ids": {
                "type": "array",
                "maxItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "decision_guide_ids": {
                "type": "array",
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "research": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "gate"
          ],
          "properties": {
            "mode": {
              "enum": [
                "reuse",
                "contextualize",
                "refresh",
                "discover"
              ]
            },
            "gate": {
              "enum": [
                "not-required",
                "satisfied",
                "in-plan",
                "open"
              ]
            }
          }
        }
      }
    },
    "stageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignment_id",
        "status",
        "actual_model",
        "duration_ms",
        "tokens",
        "evidence_refs"
      ],
      "properties": {
        "assignment_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "blocked",
            "skipped"
          ]
        },
        "actual_model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "model_evidence": {
          "enum": [
            "unavailable",
            "complete"
          ]
        },
        "duration_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tokens": {
          "$ref": "#/$defs/tokenSummary"
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "model_evidence"
            ],
            "properties": {
              "model_evidence": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "actual_model": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "model_evidence"
            ],
            "properties": {
              "model_evidence": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "actual_model": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "expertiseObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "domain",
        "pack_id",
        "guide_id",
        "severity",
        "reusable",
        "resolution",
        "evidence_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "missing_pack",
            "missing_guide",
            "stale_guide",
            "trigger_miss",
            "trigger_false_positive",
            "guide_not_loaded",
            "guide_ineffective",
            "pack_conflict",
            "unnecessary_research"
          ]
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "pack_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "guide_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "enum": [
            "medium",
            "high",
            "critical"
          ]
        },
        "reusable": {
          "type": "boolean"
        },
        "resolution": {
          "enum": [
            "reuse",
            "research",
            "manual_correction",
            "unresolved"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verifier_result": {
            "enum": [
              "passed",
              "failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "executor_ids": {
            "contains": {
              "const": "verifier"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "review_finding"
          }
        }
      },
      "then": {
        "properties": {
          "selected_lenses": {
            "minItems": 1
          },
          "finding_severity": {
            "enum": [
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "verification_failure"
          }
        }
      },
      "then": {
        "properties": {
          "verifier_result": {
            "const": "failed"
          },
          "executor_ids": {
            "contains": {
              "const": "verifier"
            }
          },
          "command_artifact_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "correction"
          }
        }
      },
      "then": {
        "properties": {
          "correction_count": {
            "minimum": 1
          }
        }
      }
    }
  ]
}
