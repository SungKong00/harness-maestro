{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sungkong00.github.io/harness-maestro/schemas/finding-packet.schema.json",
  "title": "Harness Maestro Finding Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lens_id",
    "verdict",
    "findings",
    "uncertainties",
    "inspected",
    "skipped"
  ],
  "properties": {
    "schema_version": {
      "const": "maestro_finding_packet_v1"
    },
    "lens_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "PASS",
        "FINDINGS",
        "BLOCK",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "location",
          "severity",
          "claim",
          "evidence_refs",
          "counterexample",
          "suggested_action",
          "fingerprint"
        ],
        "properties": {
          "location": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "medium",
              "high",
              "critical"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "counterexample": {
            "type": [
              "string",
              "null"
            ]
          },
          "suggested_action": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inspected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": [
              "FINDINGS",
              "BLOCK"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
