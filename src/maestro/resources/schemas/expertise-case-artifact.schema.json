{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sungkong00.github.io/harness-maestro/schemas/expertise-case-artifact.schema.json",
  "title": "Harness Maestro Expertise Case Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "baseline_observation",
    "candidate_observation",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "maestro_expertise_case_artifact_v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "baseline_observation": {
      "type": "string",
      "minLength": 1
    },
    "candidate_observation": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
