{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sungkong00.github.io/harness-maestro/schemas/research-packet.schema.json",
  "title": "Harness Maestro Research Packet v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "status",
    "workflow_owner",
    "decision_scope",
    "question",
    "decision_needed",
    "target_context",
    "date_checked",
    "depth",
    "lane_id",
    "wave",
    "lane_rationale",
    "artifacts_checked",
    "queries_used",
    "sources",
    "claims",
    "conflicts",
    "open_questions",
    "recommended_checklist_items",
    "rejected_claim_ids",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "maestro_research_packet_v2"
    },
    "packet_id": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked"
      ]
    },
    "workflow_owner": {
      "const": "maestro"
    },
    "decision_scope": {
      "const": "research_only"
    },
    "question": {
      "$ref": "#/$defs/text"
    },
    "decision_needed": {
      "$ref": "#/$defs/text"
    },
    "target_context": {
      "$ref": "#/$defs/text"
    },
    "date_checked": {
      "$ref": "#/$defs/date"
    },
    "depth": {
      "enum": [
        "quick",
        "normal",
        "deep"
      ]
    },
    "lane_id": {
      "enum": [
        "official",
        "repository",
        "field",
        "skeptic"
      ]
    },
    "wave": {
      "enum": [
        0,
        1
      ]
    },
    "lane_rationale": {
      "$ref": "#/$defs/text"
    },
    "artifacts_checked": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "queries_used": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "conflicts": {
      "$ref": "#/$defs/textList"
    },
    "open_questions": {
      "$ref": "#/$defs/textList"
    },
    "recommended_checklist_items": {
      "$ref": "#/$defs/textList"
    },
    "rejected_claim_ids": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "limitations": {
      "$ref": "#/$defs/textList"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{2,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^[^\\u0000]+$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "textList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/line"
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "locator",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "file",
            "url",
            "user-input",
            "command-output",
            "owner-decision"
          ]
        },
        "locator": {
          "$ref": "#/$defs/line"
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "owner-decision"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "locator": {
                "type": "string",
                "pattern": "^owner_decision:.+"
              },
              "sha256": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "tier",
        "title",
        "url",
        "artifact_ref",
        "source_role",
        "version_sensitive",
        "version",
        "checked_at",
        "inspected_evidence",
        "limitations"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "title": {
          "$ref": "#/$defs/line"
        },
        "url": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_role": {
          "enum": [
            "direct-evidence",
            "adjacent-comparator",
            "counterexample",
            "foundation-constraint",
            "skeptic"
          ]
        },
        "version_sensitive": {
          "type": "boolean"
        },
        "version": {
          "oneOf": [
            {
              "$ref": "#/$defs/line"
            },
            {
              "type": "null"
            }
          ]
        },
        "checked_at": {
          "$ref": "#/$defs/date"
        },
        "inspected_evidence": {
          "$ref": "#/$defs/text"
        },
        "limitations": {
          "$ref": "#/$defs/textList"
        }
      },
      "anyOf": [
        {
          "properties": {
            "url": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "artifact_ref": {
              "type": "string"
            }
          }
        }
      ]
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "reason"
      ],
      "properties": {
        "level": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "kind",
        "statement",
        "authority",
        "verification_status",
        "source_refs",
        "artifact_refs",
        "supporting_evidence",
        "conflicting_evidence",
        "applicability",
        "project_fit",
        "confidence",
        "adoption"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "fact",
            "policy",
            "preference",
            "prediction",
            "practice",
            "opinion",
            "risk"
          ]
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "authority": {
          "enum": [
            "authoritative",
            "derived",
            "advisory"
          ]
        },
        "verification_status": {
          "enum": [
            "verified",
            "supported",
            "inferred",
            "contested",
            "unknown",
            "rejected"
          ]
        },
        "source_refs": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "artifact_refs": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "supporting_evidence": {
          "$ref": "#/$defs/text"
        },
        "conflicting_evidence": {
          "$ref": "#/$defs/textList"
        },
        "applicability": {
          "$ref": "#/$defs/text"
        },
        "project_fit": {
          "$ref": "#/$defs/text"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "adoption": {
          "enum": [
            "rule",
            "checklist",
            "warning",
            "optional-pattern",
            "reject",
            "open-question"
          ]
        }
      }
    }
  }
}
