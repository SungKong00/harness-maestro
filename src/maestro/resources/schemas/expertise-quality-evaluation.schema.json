{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sungkong00.github.io/harness-maestro/schemas/expertise-quality-evaluation.schema.json",
  "title": "Harness Maestro Expertise Quality Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expertise_pack_id",
    "evaluated_on",
    "evaluator",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "maestro_expertise_quality_eval_v1",
        "maestro_expertise_quality_eval_v2"
      ]
    },
    "expertise_pack_id": {
      "$ref": "#/$defs/id"
    },
    "evaluated_on": {
      "type": "string",
      "format": "date"
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "authoring_run_ref",
        "evaluation_run_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fresh-context",
            "human"
          ]
        },
        "authoring_run_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evaluation_run_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "observation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_digest",
        "cases_sha256"
      ],
      "properties": {
        "candidate_digest": {
          "$ref": "#/$defs/digest"
        },
        "cases_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "artifact",
          "criterion_results",
          "forbidden_behavior_results",
          "verdict"
        ],
        "properties": {
          "case_id": {
            "$ref": "#/$defs/id"
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^evals/artifacts/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$"
              },
              "sha256": {
                "$ref": "#/$defs/digest"
              }
            }
          },
          "criterion_results": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criterion",
                "verdict",
                "evidence_ref"
              ],
              "properties": {
                "criterion": {
                  "$ref": "#/$defs/nonEmptyString"
                },
                "verdict": {
                  "enum": [
                    "pass",
                    "fail"
                  ]
                },
                "evidence_ref": {
                  "$ref": "#/$defs/nonEmptyString"
                }
              }
            }
          },
          "forbidden_behavior_results": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "behavior",
                "observed",
                "evidence_ref"
              ],
              "properties": {
                "behavior": {
                  "$ref": "#/$defs/nonEmptyString"
                },
                "observed": {
                  "type": "boolean"
                },
                "evidence_ref": {
                  "$ref": "#/$defs/nonEmptyString"
                }
              }
            }
          },
          "verdict": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "maestro_expertise_quality_eval_v2"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "subject"
        ],
        "properties": {
          "evaluator": {
            "required": [
              "observation_id"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "evaluator": {
            "not": {
              "required": [
                "observation_id"
              ]
            }
          }
        },
        "not": {
          "required": [
            "subject"
          ]
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}
