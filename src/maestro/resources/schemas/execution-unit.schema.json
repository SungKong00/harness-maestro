{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sungkong00.github.io/harness-maestro/schemas/execution-unit.schema.json",
  "title": "Harness Maestro Execution Unit Contracts",
  "oneOf": [
    {
      "$ref": "#/$defs/executionUnit"
    },
    {
      "$ref": "#/$defs/executionAttempt"
    },
    {
      "$ref": "#/$defs/executionUnitReceipt"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "reasoningEffort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "tokenSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output",
        "cached",
        "reasoning",
        "total"
      ],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "cached": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "providerReroute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_model",
        "to_model",
        "reason"
      ],
      "properties": {
        "from_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "to_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reason": {
          "$ref": "#/$defs/line"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface",
        "framework_version",
        "runtime_schema_digest",
        "run_id",
        "observation_id"
      ],
      "properties": {
        "interface": {
          "const": "codex_app_server"
        },
        "framework_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "runtime_schema_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "executionUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "unit_id",
        "unit_digest",
        "source_kind",
        "source_schema_version",
        "source_plan_id",
        "source_plan_digest",
        "source_unit_digest",
        "local_unit_id",
        "stage_kind",
        "executor_id",
        "read_only",
        "mutation_owner",
        "depends_on_unit_ids",
        "input_packet_types",
        "output_packet_type",
        "model_route",
        "host_executable",
        "execution_status"
      ],
      "properties": {
        "schema_version": {
          "const": "maestro_execution_unit_v1"
        },
        "unit_id": {
          "$ref": "#/$defs/digest"
        },
        "unit_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_kind": {
          "enum": [
            "route-assignment",
            "decision-assignment",
            "expertise-batch"
          ]
        },
        "source_schema_version": {
          "$ref": "#/$defs/line"
        },
        "source_plan_id": {
          "$ref": "#/$defs/digest"
        },
        "source_plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_unit_digest": {
          "$ref": "#/$defs/digest"
        },
        "local_unit_id": {
          "$ref": "#/$defs/localId"
        },
        "stage_kind": {
          "$ref": "#/$defs/line"
        },
        "executor_id": {
          "$ref": "#/$defs/line"
        },
        "read_only": {
          "type": "boolean"
        },
        "mutation_owner": {
          "type": "boolean"
        },
        "depends_on_unit_ids": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "input_packet_types": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "output_packet_type": {
          "$ref": "#/$defs/line"
        },
        "model_route": {
          "$ref": "route-v2.schema.json#/$defs/modelRoute"
        },
        "host_executable": {
          "type": "boolean"
        },
        "execution_status": {
          "enum": [
            "READY",
            "UPGRADE_REQUIRED",
            "NOT_APPLICABLE"
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "read_only": {
                  "const": true
                },
                "mutation_owner": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "read_only": {
                  "const": false
                },
                "mutation_owner": {
                  "const": true
                }
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "host_executable": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "execution_status": {
                "const": "READY"
              }
            }
          },
          "else": {
            "properties": {
              "execution_status": {
                "enum": [
                  "UPGRADE_REQUIRED",
                  "NOT_APPLICABLE"
                ]
              }
            }
          }
        }
      ]
    },
    "executionAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attempt_id",
        "attempt",
        "followup_of_attempt",
        "route_kind",
        "requested_class",
        "requested_model",
        "requested_reasoning_effort",
        "applied_model",
        "applied_reasoning_effort",
        "reasoning_effort_evidence",
        "status",
        "transition_trigger",
        "provider_reroutes",
        "thread_id",
        "turn_id",
        "duration_ms",
        "tokens",
        "writes_observed"
      ],
      "properties": {
        "schema_version": {
          "const": "maestro_execution_attempt_v1"
        },
        "attempt_id": {
          "$ref": "#/$defs/digest"
        },
        "attempt": {
          "enum": [
            1,
            2
          ]
        },
        "followup_of_attempt": {
          "enum": [
            null,
            1
          ]
        },
        "route_kind": {
          "enum": [
            "primary",
            "fallback"
          ]
        },
        "requested_class": {
          "enum": [
            "economy",
            "balanced",
            "frontier"
          ]
        },
        "requested_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requested_reasoning_effort": {
          "$ref": "#/$defs/reasoningEffort"
        },
        "applied_model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "applied_reasoning_effort": {
          "oneOf": [
            {
              "$ref": "#/$defs/reasoningEffort"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning_effort_evidence": {
          "enum": [
            "host-attested",
            "requested-only",
            "unavailable"
          ]
        },
        "status": {
          "enum": [
            "completed",
            "model-unavailable",
            "failed",
            "blocked",
            "interrupted"
          ]
        },
        "transition_trigger": {
          "enum": [
            null,
            "selected-model-unavailable"
          ]
        },
        "provider_reroutes": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/providerReroute"
          }
        },
        "thread_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "turn_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "tokens": {
          "oneOf": [
            {
              "$ref": "#/$defs/tokenSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "writes_observed": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "executionUnitReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "receipt_id",
        "unit_id",
        "unit_digest",
        "source_plan_digest",
        "local_unit_id",
        "model_route_id",
        "input_digest",
        "dependency_receipt_ids",
        "attempts",
        "output_packet_type",
        "output_packet_digest",
        "verification_assessment_id",
        "terminal_work_id",
        "terminal_status",
        "effect_state",
        "producer",
        "issued_at"
      ],
      "properties": {
        "schema_version": {
          "const": "maestro_execution_unit_receipt_v1"
        },
        "receipt_id": {
          "$ref": "#/$defs/digest"
        },
        "unit_id": {
          "$ref": "#/$defs/digest"
        },
        "unit_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "local_unit_id": {
          "$ref": "#/$defs/localId"
        },
        "model_route_id": {
          "$ref": "#/$defs/digest"
        },
        "input_digest": {
          "$ref": "#/$defs/digest"
        },
        "dependency_receipt_ids": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/executionAttempt"
          }
        },
        "output_packet_type": {
          "$ref": "#/$defs/line"
        },
        "output_packet_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification_assessment_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "terminal_work_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "terminal_status": {
          "enum": [
            "completed",
            "failed",
            "blocked",
            "interrupted"
          ]
        },
        "effect_state": {
          "enum": [
            "no-writes",
            "verified-writes",
            "unknown"
          ]
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
