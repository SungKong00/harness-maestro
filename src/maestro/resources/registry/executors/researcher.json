{
  "schema_version": "maestro_executor_v1",
  "kind": "executor",
  "executor_id": "researcher",
  "summary": "Inspect one bounded source lane and return tiered claims with provenance.",
  "model_policy": {
    "default_class": "balanced",
    "allowed_classes": [
      "economy",
      "balanced",
      "frontier"
    ],
    "default_reasoning_effort": "high",
    "maximum_auto_reasoning_effort": "xhigh",
    "automatic_escalations": 1,
    "fixed_model": false
  },
  "capabilities": [
    "inspect.fs",
    "inspect.network"
  ],
  "forbidden_capabilities": [
    "mutate.fs",
    "mutate.external"
  ],
  "context_policy": {
    "fresh_context_supported": true,
    "return_packet_only": true,
    "hide_other_lens_conclusions": true
  },
  "accepts": [
    "ResearchRequest",
    "ResearchLaneCard"
  ],
  "returns": [
    "ResearchPacket"
  ]
}
