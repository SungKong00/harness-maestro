{
  "schema_version": "maestro_executor_v1",
  "kind": "executor",
  "executor_id": "lens-reviewer",
  "summary": "Apply selected Lens cards to bounded evidence and return compact findings.",
  "model_policy": {
    "default_class": "balanced",
    "allowed_classes": [
      "economy",
      "balanced",
      "frontier"
    ],
    "default_reasoning_effort": "high",
    "maximum_auto_reasoning_effort": "xhigh",
    "automatic_escalations": 1,
    "fixed_model": false
  },
  "capabilities": [
    "inspect.fs",
    "inspect.network"
  ],
  "forbidden_capabilities": [
    "mutate.fs",
    "mutate.external"
  ],
  "context_policy": {
    "fresh_context_supported": true,
    "return_packet_only": true,
    "hide_other_lens_conclusions": true
  },
  "accepts": [
    "ReviewPacket",
    "LensCard"
  ],
  "returns": [
    "FindingPacket"
  ]
}
