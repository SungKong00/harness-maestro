{
  "schema_version": "maestro_executor_v1",
  "kind": "executor",
  "executor_id": "implementation-engineer",
  "summary": "Own one approved implementation boundary and its project-local writes.",
  "model_policy": {
    "default_class": "balanced",
    "allowed_classes": [
      "economy",
      "balanced",
      "frontier"
    ],
    "default_reasoning_effort": "medium",
    "maximum_auto_reasoning_effort": "xhigh",
    "automatic_escalations": 1,
    "fixed_model": false
  },
  "capabilities": [
    "inspect.fs",
    "mutate.fs",
    "exec.project-verifier"
  ],
  "forbidden_capabilities": [
    "mutate.external"
  ],
  "context_policy": {
    "fresh_context_supported": false,
    "return_packet_only": false,
    "hide_other_lens_conclusions": false
  },
  "accepts": [
    "TaskPacket",
    "FindingPacket"
  ],
  "returns": [
    "ChangeReceipt"
  ]
}
